/// 01 §21, §90 — a Member can belong to one or many branches.
model MembershipBranch {
  id               String    @id @default(uuid())
  membership_id    String
  branch_id        String
  is_primary       Boolean   @default(false)
  /// 01 §91 — whether access cascades to child branches.
  include_children Boolean   @default(false)
  started_at       DateTime  @default(now())
  ended_at         DateTime?

  membership Membership @relation(fields: [membership_id], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  @@unique([membership_id, branch_id])
  @@index([branch_id])
  @@map("membership_branches")
}

/// 01 §56–57 — per-member product access, evaluated before feature permissions.
model MembershipModuleAccess {
  id                 String    @id @default(uuid())
  membership_id      String
  module             ModuleKey
  enabled            Boolean   @default(true)
  granted_by_user_id String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  membership Membership @relation(fields: [membership_id], references: [id], onDelete: Cascade)

  @@unique([membership_id, module])
  @@map("membership_module_access")
}

// =====================================================================
// Roles & Permissions — 01 §44–63, §92–97, §111–114
// =====================================================================

/// 01 §46 — the global permission catalog. Keys follow `<module>.<resource>.<action>`. Every module's
/// "Permissions" section registers its keys here (06 §15, 07 §16, 14 §12, 17 §14, 18 §11, 19 §10, 20 §10,
/// 12 §52, 13 §13, 15 §8).
model Permission {
  id             String    @id @default(uuid())
  key            String    @unique
  module         ModuleKey
  resource       String
  action         String
  description    String?
  /// 01 §59 — requires elevated roles; surfaced in conflict warnings (01 §97).
  is_sensitive   Boolean   @default(false)
  /// 01 §60 — field-level permission marker.
  is_field_level Boolean   @default(false)
  created_at     DateTime  @default(now())

  roles  RolePermission[]
  grants PermissionGrant[]

  @@index([module])
  @@map("permissions")
}

/// 01 §44–45, §111 — reusable permission bundle. organization_id is null for system roles and
/// platform-provided templates (01 §111) that organizations clone.
model Role {
  id               String      @id @default(uuid())
  organization_id  String?
  name             String
  slug             String
  description      String?
  type             RoleType    @default(ORGANIZATION)
  status           RoleStatus  @default(PUBLISHED)
  is_system        Boolean     @default(false)
  /// Template this role was cloned from (01 §111).
  template_role_id String?
  /// Default scope type this role is intended for (01 §50).
  default_scope    ScopeType   @default(ORGANIZATION)
  /// Modules this role grants product access to when assigned (01 §109).
  modules          ModuleKey[] @default([])
  /// Incremented each time the role is published (01 §109). History in RoleVersion.
  version          Int         @default(1)
  published_at     DateTime?
  /// Role-level restrictions beyond per-permission conditions, e.g. { require_mfa: true, hide_rates: true } (01 §109).
  restrictions     Json?
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt

  organization         Organization?              @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  permissions          RolePermission[]
  versions             RoleVersion[]
  assignments          RoleAssignment[]
  invitations          Invitation[]
  group_mappings       SsoGroupMapping[]
  customer_memberships CustomerPortalMembership[]
  project_members      ProjectMember[]
  message_mentions     MessageMention[]
  wiki_checklists      WikiChecklist[]

  crm_dashboard_layouts CrmDashboardLayout[]
  crm_discount_policies CrmDiscountPolicy[]

  @@unique([organization_id, slug])
  @@index([organization_id, type])
  @@map("roles")
}

/// 01 §44, §53 — permissions bundled in a role, with optional explicit deny.
model RolePermission {
  role_id       String
  permission_id String
  effect        PermissionEffect @default(ALLOW)
  /// Optional field-level or resource-level restriction data (01 §48, §60).
  conditions    Json?

  role           Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission     Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)
  /// 01 §50, §109 — widest scope this permission may be exercised at (e.g. read invoices only at BRANCH); null = no limit beyond the assignment scope.
  max_scope_type ScopeType?

  @@id([role_id, permission_id])
  @@index([permission_id])
  @@map("role_permissions")
}

/// 01 §92–93 — a role given to a principal (Member or Service Account) within a scope.
/// scope_id references the Branch, Team, Project (05), Customer (02) or resource identified by scope_type.
model RoleAssignment {
  id                 String    @id @default(uuid())
  membership_id      String?
  service_account_id String?
  role_id            String
  scope_type         ScopeType @default(ORGANIZATION)
  scope_id           String?
  granted_by_user_id String?
  reason             String?
  valid_from         DateTime  @default(now())
  /// 01 §93 — temporary access; null means permanent.
  valid_until        DateTime?
  revoked_at         DateTime?
  created_at         DateTime  @default(now())

  membership      Membership?     @relation(fields: [membership_id], references: [id], onDelete: Cascade)
  service_account ServiceAccount? @relation(fields: [service_account_id], references: [id], onDelete: Cascade)
  role            Role            @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@index([membership_id])
  @@index([service_account_id])
  @@index([role_id])
  @@index([scope_type, scope_id])
  @@map("role_assignments")
}

/// 01 §49, §53 — explicit per-member allow or deny for one permission, outside any role.
model PermissionGrant {
  id                 String           @id @default(uuid())
  membership_id      String
  permission_id      String
  effect             PermissionEffect @default(ALLOW)
  scope_type         ScopeType        @default(ORGANIZATION)
  scope_id           String?
  granted_by_user_id String?
  reason             String?
  valid_from         DateTime         @default(now())
  valid_until        DateTime?
  revoked_at         DateTime?
  created_at         DateTime         @default(now())

  membership Membership @relation(fields: [membership_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@index([membership_id])
  @@index([permission_id])
  @@index([scope_type, scope_id])
  @@map("permission_grants")
}

/// 01 §94 — temporary delegation of selected responsibilities.
model Delegation {
  id                      String           @id @default(uuid())
  organization_id         String
  delegator_membership_id String
  delegate_membership_id  String
  /// Permission keys or role ids delegated.
  permission_keys         String[]         @default([])
  role_ids                String[]         @default([])
  scope_type              ScopeType        @default(ORGANIZATION)
  scope_id                String?
  status                  DelegationStatus @default(SCHEDULED)
  reason                  String?
  starts_at               DateTime
  ends_at                 DateTime
  revoked_at              DateTime?
  created_at              DateTime         @default(now())
  updated_at              DateTime         @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  delegator    Membership   @relation("DelegationDelegator", fields: [delegator_membership_id], references: [id], onDelete: Cascade)
  delegate     Membership   @relation("DelegationDelegate", fields: [delegate_membership_id], references: [id], onDelete: Cascade)

  @@index([organization_id, status])
  @@index([delegate_membership_id])
  @@map("delegations")
}

/// 01 §98 — how reviewers are resolved when an access review starts.
enum ReviewerStrategy {
  BRANCH_MANAGERS
  TEAM_LEADS
  LINE_MANAGER
  SPECIFIC
}

/// 01 §98 — periodic access review (certification campaign) over an organization, branch, team or module.
model AccessReview {
  id                       String             @id @default(uuid())
  organization_id          String
  name                     String
  description              String?
  status                   AccessReviewStatus @default(DRAFT)
  /// What is reviewed: ORGANIZATION, BRANCH, BRANCH_HIERARCHY or TEAM (scope_id).
  scope_type               ScopeType          @default(ORGANIZATION)
  scope_id                 String?
  /// Optional: only review members who hold access to these modules. Empty = all modules.
  modules                  ModuleKey[]        @default([])
  starts_at                DateTime?
  due_at                   DateTime
  completed_at             DateTime?
  created_by_membership_id String?
  created_at               DateTime           @default(now())
  updated_at               DateTime           @updatedAt

  organization            Organization       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  created_by              Membership?        @relation("AccessReviewCreator", fields: [created_by_membership_id], references: [id], onDelete: SetNull)
  items                   AccessReviewItem[]
  /// 01 §98 — how AccessReviewItem.reviewer_membership_id is resolved on Start; SPECIFIC uses reviewer_membership_ids.
  reviewer_strategy       ReviewerStrategy   @default(BRANCH_MANAGERS)
  reviewer_membership_ids String[]           @default([])

  @@index([organization_id, status])
  @@index([organization_id, due_at])
  @@map("access_reviews")
}

/// 01 §98 — one member's access inside an access review, with the reviewer's decision.
model AccessReviewItem {
  id                     String               @id @default(uuid())
  review_id              String
  /// Member whose access is reviewed.
  membership_id          String
  reviewer_membership_id String?
  decision               AccessReviewDecision @default(PENDING)
  decided_at             DateTime?
  comment                String?
  /// Roles, grants, module access and branch scopes at review time, so the decision stays meaningful later.
  access_snapshot        Json
  /// Set when a REVOKED / MODIFIED decision has been applied to RoleAssignment / PermissionGrant / MembershipModuleAccess.
  applied_at             DateTime?
  created_at             DateTime             @default(now())
  updated_at             DateTime             @updatedAt

  review     AccessReview @relation(fields: [review_id], references: [id], onDelete: Cascade)
  membership Membership   @relation("AccessReviewSubject", fields: [membership_id], references: [id], onDelete: Cascade)
  reviewer   Membership?  @relation("AccessReviewReviewer", fields: [reviewer_membership_id], references: [id], onDelete: SetNull)

  @@unique([review_id, membership_id])
  @@index([reviewer_membership_id, decision])
  @@map("access_review_items")
}

/// 01 §109 — immutable snapshot of a role each time it is published.
model RoleVersion {
  id                         String      @id @default(uuid())
  role_id                    String
  version                    Int
  name                       String
  description                String?
  default_scope              ScopeType
  modules                    ModuleKey[] @default([])
  /// [{ permission_key, effect, conditions }] as published.
  permissions                Json
  restrictions               Json?
  note                       String?
  published_by_membership_id String?
  published_at               DateTime    @default(now())

  role         Role        @relation(fields: [role_id], references: [id], onDelete: Cascade)
  published_by Membership? @relation("RoleVersionPublisher", fields: [published_by_membership_id], references: [id], onDelete: SetNull)

  @@unique([role_id, version])
  @@map("role_versions")
}

/// 01 §157 — one connected third-party service of an organization (OpenAI, Resend, Stripe, Twilio ...) with the
/// organization's OWN credentials, so provider keys do not live in the platform .env (01 §160). Secrets are write-only:
/// envelope-encrypted under the organization's VaultKey (17 §12), never returned by any API, never logged, never copied
/// into audit metadata (01 §158). Domain tables (08 PaymentProviderConnection, 11 CommProviderAccount) point here instead of storing credentials.
model IntegrationConnection {
  id                       String                      @id @default(uuid())
  organization_id          String
  provider                 IntegrationProvider
  category                 IntegrationCategory
  /// Label shown to admins ("OpenAI production", "Stripe EU test"). Unique per organization.
  name                     String
  status                   IntegrationStatus           @default(PENDING)
  mode                     IntegrationMode             @default(LIVE)
  credential_source        IntegrationCredentialSource @default(ORGANIZATION)
  /// base64 ciphertext (nonce + tag included) of ALL secret fields as one JSON object, e.g. { "api_key": "...", "webhook_secret": "..." }.
  /// Null for PLATFORM-source rows. Field names per provider: api/src/shared/constants/integration-providers.ts.
  secret_ciphertext        String?
  vault_key_id             String?
  /// Non-reversible per-field hints for lists, e.g. { "api_key": "sk-...a3f9" } (prefix + last 4 characters at most).
  secret_hints             Json?
  /// Non-secret settings per provider (default model, region, from address, publishable key, account id ...).
  config                   Json?
  /// Result of the last verification: { account_id, account_name, models, domains, country, capabilities ... }.
  capabilities             Json?
  /// Organization-set guardrails, e.g. { monthly_spend_limit_usd, requests_per_minute }; enforced by the integration layer before calling the provider.
  usage_limits             Json?
  /// Public, unguessable id used in the callback URL of providers that send webhooks; resolves organization + secret without exposing ids.
  webhook_token            String?                     @unique
  /// At most one default per organization, category and mode (enforced by the service). Modules resolve a connection by category + default (01 §159).
  is_default               Boolean                     @default(false)
  /// 01 §34 — restrict the connection to one branch; null = whole organization.
  branch_id                String?
  expires_at               DateTime?
  rotated_at               DateTime?
  last_verified_at         DateTime?
  last_used_at             DateTime?
  last_error               String?
  last_error_at            DateTime?
  created_by_membership_id String?
  connected_at             DateTime?
  disconnected_at          DateTime?
  created_at               DateTime                    @default(now())
  updated_at               DateTime                    @updatedAt

  organization                 Organization                @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  vault_key                    VaultKey?                   @relation(fields: [vault_key_id], references: [id], onDelete: Restrict)
  branch                       Branch?                     @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  created_by                   Membership?                 @relation("IntegrationConnectionCreator", fields: [created_by_membership_id], references: [id], onDelete: SetNull)
  usage                        IntegrationUsageDaily[]
  payment_provider_connections PaymentProviderConnection[]
  comm_provider_accounts       CommProviderAccount[]

  @@unique([organization_id, name])
  @@index([organization_id, category, status])
  @@index([organization_id, provider])
  @@map("integration_connections")
}

/// 01 §157 — daily usage of one connection for the usage view and spend guardrails. Written only by the integration layer.
model IntegrationUsageDaily {
  id                        String   @id @default(uuid())
  organization_id           String
  integration_connection_id String
  date                      DateTime @db.Date
  requests                  Int      @default(0)
  failures                  Int      @default(0)
  /// Provider units consumed; meaning depends on the category: tokens (AI), messages (EMAIL, SMS), minor currency units processed (PAYMENTS).
  units                     BigInt   @default(0)
  /// Estimated cost in millionths of cost_currency when the provider price is known; null otherwise.
  cost_micros               BigInt?
  cost_currency             String?
  /// Breakdown, e.g. AI: { input_tokens, output_tokens, by_model }.
  breakdown                 Json?

  organization           Organization          @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  integration_connection IntegrationConnection @relation(fields: [integration_connection_id], references: [id], onDelete: Cascade)

  @@unique([integration_connection_id, date])
  @@index([organization_id, date])
  @@map("integration_usage_daily")
}

// =====================================================================
// Invitations — 01 §65–66
// =====================================================================

model Invitation {
  id                   String             @id @default(uuid())
  organization_id      String
  email                String
  type                 MembershipType     @default(INTERNAL)
  /// MEMBER joins the organization (branch/team/role); CUSTOMER_PORTAL joins a customer company (customer_id) via the portal.
  audience             InvitationAudience @default(MEMBER)
  branch_id            String?
  team_id              String?
  role_id              String?
  /// Modules to enable on acceptance (01 §65).
  modules              ModuleKey[]        @default([])
  token_hash           String             @unique
  status               InvitationStatus   @default(PENDING)
  source               ProvisioningSource @default(MANUAL)
  message              String?
  invited_by_user_id   String?
  expires_at           DateTime
  accepted_at          DateTime?
  /// Membership created on acceptance.
  membership_id        String?
  /// 01 §79, 07 §2 — CRM Company (02) the invitee joins as a Customer Portal user; set instead of branch_id/team_id.
  customer_id          String?
  /// CustomerPortalMembership created on acceptance of a customer invitation.
  portal_membership_id String?
  cancelled_at         DateTime?
  rejected_at          DateTime?
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  team         Team?        @relation(fields: [team_id], references: [id], onDelete: SetNull)
  role         Role?        @relation(fields: [role_id], references: [id], onDelete: SetNull)
  invited_by   User?        @relation("InvitationInviter", fields: [invited_by_user_id], references: [id], onDelete: SetNull)
  customer     CrmCompany?  @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  /// 01 §65, §77 — where the role granted on acceptance applies (e.g. one PROJECT or RESOURCE for an external collaborator or guest); copied into RoleAssignment.scope_type / scope_id.
  scope_type   ScopeType    @default(ORGANIZATION)
  scope_id     String?
  /// 01 §65, §93 — access granted by this invitation ends at this date (copied into RoleAssignment.valid_until).
  valid_until  DateTime?
  /// 01 §66, 07 §2 — reminder tracking: last time the invitation email was (re)sent and how many times in total.
  last_sent_at DateTime?
  send_count   Int          @default(1)

  @@index([organization_id, status])
  @@index([email])
  @@index([expires_at])
  @@index([organization_id, customer_id])
  @@map("invitations")
}

// =====================================================================
// SSO & provisioning — 01 §68–71
// =====================================================================

/// 01 §69 — identity provider configuration per organization.
model SsoConfiguration {
  id                  String      @id @default(uuid())
  organization_id     String
  name                String
  protocol            SsoProtocol
  enabled             Boolean     @default(false)
  /// Issuer, entity id, metadata URL, client id, certificates, attribute mapping. Secrets are stored encrypted.
  config              Json
  auto_provision      Boolean     @default(false)
  /// 01 §67–68 — SCIM provisioning token hash and settings, when enabled.
  scim_enabled        Boolean     @default(false)
  scim_token_hash     String?
  scim_last_synced_at DateTime?
  created_at          DateTime    @default(now())
  updated_at          DateTime    @updatedAt

  organization   Organization      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  group_mappings SsoGroupMapping[]

  @@index([organization_id])
  @@map("sso_configurations")
}

/// 01 §71 — external IdP group → role / team / branch / module access.
model SsoGroupMapping {
  id                   String      @id @default(uuid())
  sso_configuration_id String
  external_group       String
  role_id              String?
  team_id              String?
  branch_id            String?
  modules              ModuleKey[] @default([])
  created_at           DateTime    @default(now())

  sso_configuration SsoConfiguration @relation(fields: [sso_configuration_id], references: [id], onDelete: Cascade)
  role              Role?            @relation(fields: [role_id], references: [id], onDelete: SetNull)
  team              Team?            @relation(fields: [team_id], references: [id], onDelete: SetNull)
  branch            Branch?          @relation(fields: [branch_id], references: [id], onDelete: SetNull)

  @@unique([sso_configuration_id, external_group])
  @@map("sso_group_mappings")
}

// =====================================================================
// API access & service accounts — 01 §75–76
// =====================================================================

/// 01 §76 — non-human identity for automation. Permissions come from RoleAssignment.
model ServiceAccount {
  id                  String               @id @default(uuid())
  organization_id     String
  owner_membership_id String?
  name                String
  purpose             String?
  status              ServiceAccountStatus @default(ACTIVE)
  expires_at          DateTime?
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt

  organization                    Organization         @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  owner                           Membership?          @relation(fields: [owner_membership_id], references: [id], onDelete: SetNull)
  role_assignments                RoleAssignment[]
  api_keys                        ApiKey[]
  mcp_tool_calls                  McpToolCall[]
  // 20 Automation
  default_for_automation_settings AutomationSettings[] @relation("AutomationSettingsDefaultServiceAccount")
  automation_rules                AutomationRule[]     @relation("AutomationRuleRunAs")
  automation_runs                 AutomationRun[]      @relation("AutomationRunRunAs")
  platform_events                 PlatformEvent[]      @relation("PlatformEventActorServiceAccount")

  @@unique([organization_id, name])
  @@index([organization_id, status])
  @@map("service_accounts")
}

/// 01 §75 — API credential owned by a Member or a Service Account. Never inherits unlimited permissions.
model ApiKey {
  id                 String    @id @default(uuid())
  organization_id    String
  membership_id      String?
  service_account_id String?
  name               String
  /// First characters shown to the user for identification.
  key_prefix         String
  key_hash           String    @unique
  /// Optional narrowing of the owner's permissions (permission keys).
  scopes             String[]  @default([])
  /// Where the key may act: ORGANIZATION, BRANCH, BRANCH_HIERARCHY, TEAM or PROJECT (01 §75). scopes[] narrows by permission key.
  scope_type         ScopeType @default(ORGANIZATION)
  scope_id           String?
  /// When the owner should rotate the key (01 §75 rotation).
  rotation_due_at    DateTime?
  expires_at         DateTime?
  last_used_at       DateTime?
  rotated_from_id    String?
  revoked_at         DateTime?
  created_at         DateTime  @default(now())

  organization      Organization       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  membership        Membership?        @relation(fields: [membership_id], references: [id], onDelete: Cascade)
  service_account   ServiceAccount?    @relation(fields: [service_account_id], references: [id], onDelete: Cascade)
  mcp_tool_calls    McpToolCall[]
  /// 01 §75 — per-key IP allow-list (CIDR). Empty = any address (the organization-wide policy still applies).
  allowed_ip_ranges String[]           @default([])
  usage             ApiKeyUsageDaily[]

  @@index([organization_id])
  @@index([membership_id])
  @@index([service_account_id])
  @@map("api_keys")
}

/// 01 §75, §136 — one MCP tool invocation by an AI agent, API key or service account (also members acting
/// through an MCP client). Sensitive tools wait in AWAITING_CONFIRMATION until a human holding the tool's
/// permission confirms. Feeds the agent overview (20 §12) and the audit trail; actor ids are plain ids so rows
/// survive key / account removal. Never stores secrets or full payloads: input_summary is redacted by the API.
model McpToolCall {
  id                         String            @id @default(uuid())
  organization_id            String
  /// `<module>_<resource>_<action>`, e.g. `crm_deals_update`.
  tool_name                  String
  /// Permission key the central authorization service checked (01 §136).
  permission_key             String?
  module                     ModuleKey?
  actor_type                 AuditActorType    @default(SERVICE_ACCOUNT)
  api_key_id                 String?
  service_account_id         String?
  /// Member the call acts for (key owner or the human behind an MCP client); plain id.
  actor_membership_id        String?
  /// Self-reported MCP client / agent name (e.g. "Claude Desktop", "Support triage agent").
  client_name                String?
  resource_type              String?
  resource_id                String?
  status                     McpToolCallStatus @default(SUCCEEDED)
  /// The tool is flagged sensitive: an AI caller needs human confirmation before it runs.
  requires_confirmation      Boolean           @default(false)
  confirmed_by_membership_id String?
  confirmed_at               DateTime?
  rejected_at                DateTime?
  /// Redacted arguments (ids, counts, field names); never secrets or message bodies.
  input_summary              Json?
  error_code                 String?
  duration_ms                Int?
  /// AuditEvent written for the underlying action; id only.
  audit_event_id             String?
  /// 20 AutomationRun when an automation step invoked the tool; id only.
  automation_run_id          String?
  created_at                 DateTime          @default(now())

  organization    Organization    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  api_key         ApiKey?         @relation(fields: [api_key_id], references: [id], onDelete: SetNull)
  service_account ServiceAccount? @relation(fields: [service_account_id], references: [id], onDelete: SetNull)

  @@index([organization_id, created_at])
  @@index([organization_id, status, created_at])
  @@index([organization_id, tool_name, created_at])
  @@index([api_key_id])
  @@index([service_account_id])
  @@index([actor_membership_id])
  @@map("mcp_tool_calls")
}

/// 01 §75, §136 — outcome of an MCP tool call.
enum McpToolCallStatus {
  SUCCEEDED
  FAILED
  DENIED
  AWAITING_CONFIRMATION
  REJECTED
  EXPIRED
}

/// 01 §75 — daily usage of one API key (requests, rejections, source IPs) for the key detail view and new-IP alerts.
/// Written only by the API gateway; rows are never edited.
model ApiKeyUsageDaily {
  id              String   @id @default(uuid())
  organization_id String
  api_key_id      String
  date            DateTime @db.Date
  requests        Int      @default(0)
  /// Requests rejected (invalid scope, IP not allowed, rate limited, permission denied).
  rejected        Int      @default(0)
  last_ip         String?
  /// Distinct source IPs seen that day; an IP absent from earlier days raises the new-IP alert.
  seen_ips        String[] @default([])

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  api_key      ApiKey       @relation(fields: [api_key_id], references: [id], onDelete: Cascade)

  @@unique([api_key_id, date])
  @@index([organization_id, date])
  @@map("api_key_usage_daily")
}

// =====================================================================
// Customer Portal identity — 01 §79
// =====================================================================

/// 01 §79 — a User's membership to a Customer (a CRM Company owned by docs/features/02, LOG-404)
/// inside an agency Organization. customer_id has no relation until the CRM module defines companies.
model CustomerPortalMembership {
  id                 String           @id @default(uuid())
  organization_id    String
  /// CRM Company id (02). No FK until LOG-404 is implemented.
  customer_id        String
  user_id            String
  /// Role of type CUSTOMER_PORTAL (01 §79 defaults: Owner, Administrator, Manager, Finance, Legal, Viewer).
  role_id            String?
  status             MembershipStatus @default(ACTIVE)
  invited_by_user_id String?
  joined_at          DateTime         @default(now())
  last_active_at     DateTime?
  deactivated_at     DateTime?
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt

  organization                  Organization                      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user                          User                              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role                          Role?                             @relation(fields: [role_id], references: [id], onDelete: SetNull)
  notifications                 Notification[]
  notification_settings         NotificationRecipientSettings?
  notification_preferences      NotificationPreference[]
  notification_digests          NotificationDigest[]
  announcement_acknowledgements AnnouncementAcknowledgement[]
  project_access                CustomerPortalMembershipProject[]
  deliverable_approvals         ProjectDeliverableApprover[]

  @@unique([organization_id, customer_id, user_id])
  @@index([customer_id])
  @@index([user_id])
  @@map("customer_portal_memberships")
}

/// 07 §2, §4 — restricts a portal user to specific customer-visible projects. No rows = every customer-visible project of the company.
model CustomerPortalMembershipProject {
  portal_membership_id String
  project_id           String
  organization_id      String
  created_at           DateTime @default(now())

  portal_membership CustomerPortalMembership @relation(fields: [portal_membership_id], references: [id], onDelete: Cascade)
  project           Project                  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  organization      Organization             @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@id([portal_membership_id, project_id])
  @@index([project_id])
  @@index([organization_id])
  @@map("customer_portal_membership_projects")
}

// =====================================================================
// Audit — 01 §99–100, §139
// =====================================================================

/// 01 §99, §139 — result of the audited action (filter "outcome" in the audit log).
enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

/// Immutable audit event. Identity and access changes are written here by module 01;
/// other modules append their own event types using the same table (06 §3, 07 §17, 09 "Audit Trail",
/// 12 §51, 14 §13, 15 §9, 17 §15, 18 §12, 19 §11, 20 §11).
model AuditEvent {
  id                       String         @id @default(uuid())
  organization_id          String?
  actor_type               AuditActorType @default(USER)
  actor_user_id            String?
  actor_service_account_id String?
  /// Stable key, e.g. `membership.role_assigned`, `user.login`, `sso.configuration_changed`.
  event_type               String
  resource_type            String?
  resource_id              String?
  /// Branch the event applies to (plain id, no relation: audit rows must survive branch deletion). Null = organization-wide.
  branch_id                String?
  /// Before/after values or event-specific payload.
  metadata                 Json?
  ip_address               String?
  user_agent               String?
  created_at               DateTime       @default(now())

  organization Organization? @relation(fields: [organization_id], references: [id], onDelete: SetNull)
  actor_user   User?         @relation("AuditActorUser", fields: [actor_user_id], references: [id], onDelete: SetNull)
  /// 01 §99, §139 — SUCCESS, FAILURE (attempt failed, e.g. user.login_failed) or DENIED (blocked by authorization).
  outcome      AuditOutcome  @default(SUCCESS)

  @@index([organization_id, created_at])
  @@index([organization_id, branch_id, created_at])
  @@index([actor_user_id, created_at])
  @@index([event_type])
  @@index([resource_type, resource_id])
  @@index([organization_id, outcome, created_at])
  @@map("audit_events")
}

