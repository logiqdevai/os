/// 10 "Employee Self-Service", "Attendance & Working Hours", "Capacity & Workload", "Leave Management" —
/// organization-wide HR configuration (one row per organization).
model EmployeeHrSettings {
  organization_id                      String                @id
  /// Default weekly capacity when an employee has no work schedule.
  default_weekly_hours                 Decimal               @default(40) @db.Decimal(5, 2)
  /// [{ weekday, start, end, break_minutes }] default schedule template; falls back to Organization.business_hours.
  default_schedule                     Json?
  /// 10 "Leave Management" — default approval chain.
  leave_approver_strategy              LeaveApproverStrategy @default(DIRECT_MANAGER)
  /// Flag overlapping leave in the same team above this share of members (conflict detection).
  leave_conflict_threshold_percent     Decimal?              @db.Decimal(5, 2)
  /// 10 "Attendance & Working Hours"
  attendance_required                  Boolean               @default(false)
  allowed_clock_sources                AttendanceSource[]    @default([WEB, MOBILE])
  late_tolerance_minutes               Int                   @default(0)
  /// Minutes worked beyond the scheduled day that count as overtime.
  overtime_threshold_minutes           Int                   @default(0)
  overtime_requires_approval           Boolean               @default(true)
  /// Pre-fill 18 Time Tracking daily total from attendance (never replaces time entries).
  prefill_time_entries_from_attendance Boolean               @default(false)
  /// 10 "Capacity & Workload" — utilization thresholds.
  target_utilization_percent           Decimal               @default(80) @db.Decimal(5, 2)
  overload_threshold_percent           Decimal               @default(100) @db.Decimal(5, 2)
  underutilized_threshold_percent      Decimal               @default(60) @db.Decimal(5, 2)
  /// 10 "Employee Self-Service" — employee-editable profile fields and whether edits need approval.
  self_service_editable_fields         String[]              @default([])
  profile_changes_require_approval     Boolean               @default(false)
  /// 10 "Employee Directory" — fields shown in the directory.
  directory_visible_fields             String[]              @default([])
  /// 10 "Notifications" — anniversary / birthday events emitted to 14.
  notify_birthdays                     Boolean               @default(true)
  notify_anniversaries                 Boolean               @default(true)
  updated_at                           DateTime              @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@map("employee_hr_settings")
}

// --- Employee ---------------------------------------------------------------------------

/// 10 "Employee Profiles", "Organization Structure", "Roles & Responsibilities", "Employee Availability",
/// "Employee Directory" — the HR record, 1:1 with a Membership (01 §80–81). Identity (name used for login, photo,
/// locale) stays on User; secondary branches and teams come from MembershipBranch / TeamMembership (01 §35).
/// Compensation, personal identifiers and bank details are field-level permissioned (01 §60).
model Employee {
  id                         String                     @id @default(uuid())
  organization_id            String
  membership_id              String                     @unique
  /// Human-readable Employee ID, e.g. EMP-0042 (NumberSequence, 03).
  employee_number            String
  // Personal information (10 "Employee Profiles")
  legal_first_name           String?
  legal_last_name            String?
  preferred_name             String?
  date_of_birth              DateTime?                  @db.Date
  gender                     String?
  nationality                String?
  /// Sensitive identifiers (01 §60).
  national_id_number         String?
  tax_id                     String?
  social_security_number     String?
  /// Sensitive; consumed by 09 payroll.
  /// Encrypted at the application layer (envelope encryption with the organization VaultKey, 17 §12); never returned in list endpoints.
  bank_details               Json?
  // Contact information
  work_email                 String?
  work_phone                 String?
  personal_email             String?
  personal_phone             String?
  address                    Json?
  /// 17 Document — profile photo override; falls back to User.profile_photo_url.
  photo_document_id          String?
  /// 17 Document — resume / CV.
  resume_document_id         String?
  // Employment details — current values; history in EmployeePosition
  job_title                  String?
  /// Position within the structure (e.g. "Frontend Engineer II").
  position                   String?
  /// Functional role label (10 "Roles & Responsibilities").
  role                       String?
  seniority_level            EmployeeSeniorityLevel?
  /// Team of kind DEPARTMENT (01 §43).
  department_team_id         String?
  primary_branch_id          String?
  manager_employee_id        String?
  employment_status          EmploymentStatus           @default(ONBOARDING)
  employment_status_since    DateTime?                  @db.Date
  employment_type            EmploymentType             @default(FULL_TIME)
  work_location              EmployeeWorkLocation       @default(OFFICE)
  hire_date                  DateTime?                  @db.Date
  probation_end_date         DateTime?                  @db.Date
  /// Fixed-term contract end.
  contract_end_date          DateTime?                  @db.Date
  notice_period_days         Int?
  termination_date           DateTime?                  @db.Date
  termination_reason         String?
  /// 10 "Employee Profiles" — typed reason (termination_reason keeps the free-text detail); set when offboarding starts.
  termination_kind           EmployeeTerminationKind?
  /// 10 "Employee Profiles" — whether the person may be rehired; null = not decided.
  rehire_eligible            Boolean?
  /// 10 "Roles & Responsibilities" / "Employee Profiles" — free-form lists; structured skills in EmployeeSkill.
  responsibilities           String[]                   @default([])
  areas_of_expertise         String[]                   @default([])
  technical_stack            String[]                   @default([])
  bio                        String?
  // Availability (10 "Employee Availability") — denormalized current state
  availability_status        EmployeeAvailabilityStatus @default(AVAILABLE)
  availability_note          String?
  availability_updated_at    DateTime?
  // Capacity (10 "Capacity & Workload")
  /// Overrides the active work schedule / HR settings default.
  weekly_capacity_hours      Decimal?                   @db.Decimal(5, 2)
  target_utilization_percent Decimal?                   @db.Decimal(5, 2)
  timezone                   String?
  // Lifecycle
  /// Onboarding tasks are Tasks linked via TaskLink(EMPLOYEE) (06 §13); workflows in 20.
  onboarding_completed_at    DateTime?
  offboarding_completed_at   DateTime?
  /// 10 "Employee Directory" — hide from the directory (e.g. silent contractors).
  directory_visible          Boolean                    @default(true)
  archived_at                DateTime?
  created_by_user_id         String?
  created_at                 DateTime                   @default(now())
  updated_at                 DateTime                   @updatedAt

  organization   Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  membership     Membership   @relation(fields: [membership_id], references: [id], onDelete: Cascade)
  department     Team?        @relation("EmployeeDepartment", fields: [department_team_id], references: [id], onDelete: SetNull)
  primary_branch Branch?      @relation("EmployeePrimaryBranch", fields: [primary_branch_id], references: [id], onDelete: SetNull)
  manager        Employee?    @relation("EmployeeManager", fields: [manager_employee_id], references: [id], onDelete: SetNull)
  direct_reports Employee[]   @relation("EmployeeManager")

  emergency_contacts      EmployeeEmergencyContact[]
  positions               EmployeePosition[]             @relation("EmployeePositionEmployee")
  managed_positions       EmployeePosition[]             @relation("EmployeePositionManager")
  compensations           EmployeeCompensation[]
  skills                  EmployeeSkill[]
  certifications          EmployeeCertification[]
  trainings               EmployeeTraining[]
  languages               EmployeeLanguage[]
  work_schedules          EmployeeWorkSchedule[]
  availability_entries    EmployeeAvailabilityEntry[]
  leave_policies          EmployeeLeavePolicy[]
  leave_balances          LeaveBalance[]
  leave_requests          LeaveRequest[]                 @relation("LeaveRequestEmployee")
  covered_leave_requests  LeaveRequest[]                 @relation("LeaveRequestCover")
  attendance_records      AttendanceRecord[]
  attendance_summaries    AttendanceSummary[]
  capacity_periods        EmployeeCapacityPeriod[]
  performance_reviews     PerformanceReview[]
  performance_goals       PerformanceGoal[]
  performance_feedback    PerformanceFeedback[]
  improvement_plans       PerformanceImprovementPlan[]
  documents               EmployeeDocument[]
  hr_notes                EmployeeHrNote[]
  profile_change_requests EmployeeProfileChangeRequest[]

  equipment         EmployeeEquipment[]
  feedback_requests PerformanceFeedbackRequest[]

  @@unique([organization_id, employee_number])
  @@index([organization_id, employment_status])
  @@index([organization_id, department_team_id])
  @@index([organization_id, primary_branch_id])
  @@index([organization_id, availability_status])
  @@index([manager_employee_id])
  @@index([hire_date])
  @@index([date_of_birth])
  @@map("employees")
}

/// 10 "Employee Profiles" — emergency contacts.
model EmployeeEmergencyContact {
  id           String   @id @default(uuid())
  employee_id  String
  name         String
  relationship String?
  phone        String
  email        String?
  address      Json?
  is_primary   Boolean  @default(false)
  sort_order   Int      @default(0)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([employee_id])
  @@map("employee_emergency_contacts")
}

/// 10 "Roles & Responsibilities", "Organization Structure" — effective-dated position history (title, department,
/// branch, manager, seniority, employment type). The current row is mirrored onto Employee.
model EmployeePosition {
  id                  String                       @id @default(uuid())
  employee_id         String
  job_title           String
  position            String?
  role                String?
  seniority_level     EmployeeSeniorityLevel?
  employment_type     EmploymentType
  /// Team of kind DEPARTMENT (01 §43).
  department_team_id  String?
  branch_id           String?
  manager_employee_id String?
  effective_from      DateTime                     @db.Date
  effective_to        DateTime?                    @db.Date
  reason              EmployeePositionChangeReason @default(HIRE)
  note                String?
  created_by_user_id  String?
  created_at          DateTime                     @default(now())

  employee   Employee  @relation("EmployeePositionEmployee", fields: [employee_id], references: [id], onDelete: Cascade)
  manager    Employee? @relation("EmployeePositionManager", fields: [manager_employee_id], references: [id], onDelete: SetNull)
  department Team?     @relation("EmployeePositionDepartment", fields: [department_team_id], references: [id], onDelete: SetNull)
  branch     Branch?   @relation("EmployeePositionBranch", fields: [branch_id], references: [id], onDelete: SetNull)

  @@index([employee_id, effective_from])
  @@index([department_team_id])
  @@map("employee_positions")
}

// --- Compensation -----------------------------------------------------------------------

/// 10 "Compensation" — effective-dated compensation record (01 §81 source of truth; 01 §60 field-level permission).
/// cost_rate_hourly is consumed by 18 Time Tracking; billing_rate_default by 08 and 18. 09 creates payroll
/// expense records from this data; the expense itself is never stored here.
model EmployeeCompensation {
  id                        String          @id @default(uuid())
  employee_id               String
  effective_from            DateTime        @db.Date
  effective_to              DateTime?       @db.Date
  employment_type           EmploymentType
  pay_type                  EmployeePayType
  /// Base amount per pay type unit (month, hour, day or project).
  base_amount               Decimal         @db.Decimal(18, 2)
  currency                  String
  /// Sum of employer cost components per month (denormalized from components).
  employer_cost_monthly     Decimal?        @db.Decimal(18, 2)
  /// Total monthly employer cost (base + employer costs), used for cost-rate derivation.
  total_cost_monthly        Decimal?        @db.Decimal(18, 2)
  /// Hourly cost rate for project costing (18 §7 snapshots this).
  cost_rate_hourly          Decimal?        @db.Decimal(18, 2)
  /// Default hourly billing rate (08 catalog / project overrides take precedence).
  billing_rate_default      Decimal?        @db.Decimal(18, 2)
  billing_currency          String?
  /// Contracted hours used when deriving the cost rate for salaried staff.
  contracted_weekly_hours   Decimal?        @db.Decimal(5, 2)
  /// Bonus / commission scheme summary (details in components).
  bonus_scheme              String?
  commission_scheme         String?
  reason                    String?
  notes                     String?
  approved_by_membership_id String?
  approved_at               DateTime?
  created_by_user_id        String?
  created_at                DateTime        @default(now())
  updated_at                DateTime        @updatedAt

  employee   Employee                        @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  components EmployeeCompensationComponent[]

  @@index([employee_id, effective_from])
  @@map("employee_compensations")
}

/// 10 "Compensation" — employer costs (social contributions, insurance, benefits), allowances and bonus /
/// commission scheme lines. Either a fixed amount or a percentage of base.
model EmployeeCompensationComponent {
  id               String                    @id @default(uuid())
  compensation_id  String
  kind             CompensationComponentKind
  name             String
  amount           Decimal?                  @db.Decimal(18, 2)
  /// Percentage of base compensation when amount is null.
  percent_of_base  Decimal?                  @db.Decimal(5, 2)
  currency         String?
  frequency        CompensationFrequency     @default(MONTHLY)
  /// Scheme rules for bonus / commission (targets, tiers, triggers).
  rule             Json?
  /// Whether the component is paid to the employee (true) or an employer-only cost (false).
  paid_to_employee Boolean                   @default(false)
  sort_order       Int                       @default(0)
  created_at       DateTime                  @default(now())

  compensation EmployeeCompensation @relation(fields: [compensation_id], references: [id], onDelete: Cascade)

  @@index([compensation_id])
  @@map("employee_compensation_components")
}

// --- Skills -----------------------------------------------------------------------------

/// 10 "Skills Management" — organization skill catalogue (technical skills, languages, frameworks, platforms,
/// specializations). Searchable for project staffing.
model Skill {
  id              String        @id @default(uuid())
  organization_id String
  name            String
  slug            String
  category        SkillCategory @default(TECHNICAL)
  description     String?
  parent_skill_id String?
  archived_at     DateTime?
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  organization   Organization            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  parent         Skill?                  @relation("SkillHierarchy", fields: [parent_skill_id], references: [id], onDelete: SetNull)
  children       Skill[]                 @relation("SkillHierarchy")
  employees      EmployeeSkill[]
  certifications EmployeeCertification[]
  trainings      EmployeeTraining[]

  allocation_requirements ProjectAllocationSkill[]

  @@unique([organization_id, slug])
  @@index([organization_id, category])
  @@map("skills")
}

/// 10 "Skills Management", "Roles & Responsibilities" — skill per employee with proficiency, experience and
/// primary/secondary flag.
model EmployeeSkill {
  id                        String           @id @default(uuid())
  employee_id               String
  skill_id                  String
  proficiency               SkillProficiency @default(INTERMEDIATE)
  years_experience          Decimal?         @db.Decimal(4, 1)
  /// Primary skills vs secondary skills (10 "Roles & Responsibilities").
  is_primary                Boolean          @default(false)
  last_used_on              DateTime?        @db.Date
  /// Verified by a manager / HR.
  verified_by_membership_id String?
  verified_at               DateTime?
  notes                     String?
  created_at                DateTime         @default(now())
  updated_at                DateTime         @updatedAt

  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  skill    Skill    @relation(fields: [skill_id], references: [id], onDelete: Cascade)

  @@unique([employee_id, skill_id])
  @@index([skill_id, proficiency])
  @@map("employee_skills")
}

/// 10 "Skills Management", "Employee Profiles" — certifications; the certificate file is a 17 Document.
model EmployeeCertification {
  id             String    @id @default(uuid())
  employee_id    String
  skill_id       String?
  name           String
  issuer         String?
  credential_id  String?
  credential_url String?
  issued_on      DateTime? @db.Date
  expires_on     DateTime? @db.Date
  /// 17 Document — certificate file.
  document_id    String?
  notes          String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  skill    Skill?   @relation(fields: [skill_id], references: [id], onDelete: SetNull)

  @@index([employee_id])
  @@index([expires_on])
  @@map("employee_certifications")
}

/// 10 "Skills Management" — professional training records.
model EmployeeTraining {
  id           String                 @id @default(uuid())
  employee_id  String
  skill_id     String?
  title        String
  provider     String?
  /// course | workshop | conference | certification_prep | on_the_job | other
  kind         String?
  status       EmployeeTrainingStatus @default(PLANNED)
  start_date   DateTime?              @db.Date
  end_date     DateTime?              @db.Date
  hours        Decimal?               @db.Decimal(8, 2)
  cost         Decimal?               @db.Decimal(18, 2)
  currency     String?
  completed_at DateTime?
  /// 17 Document — completion certificate / material.
  document_id  String?
  notes        String?
  created_at   DateTime               @default(now())
  updated_at   DateTime               @updatedAt

  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  skill    Skill?   @relation(fields: [skill_id], references: [id], onDelete: SetNull)

  @@index([employee_id, status])
  @@map("employee_trainings")
}

/// 10 "Employee Profiles" — spoken languages.
model EmployeeLanguage {
  id          String              @id @default(uuid())
  employee_id String
  /// ISO 639-1 code.
  language    String
  proficiency LanguageProficiency @default(PROFESSIONAL)
  is_primary  Boolean             @default(false)
  created_at  DateTime            @default(now())

  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@unique([employee_id, language])
  @@map("employee_languages")
}

// --- Working hours & availability -----------------------------------------------------------

/// 10 "Attendance & Working Hours", "Capacity & Workload" — effective-dated working schedule (fixed, flexible or
/// shift). Defines expected hours and therefore capacity. Branch business hours (01 §121) are the fallback.
model EmployeeWorkSchedule {
  id             String               @id @default(uuid())
  employee_id    String
  name           String?
  schedule_type  EmployeeScheduleType @default(FIXED)
  effective_from DateTime             @db.Date
  effective_to   DateTime?            @db.Date
  timezone       String?
  weekly_hours   Decimal              @db.Decimal(5, 2)
  /// Flexible schedules: core hours everyone must be reachable, e.g. { start: "10:00", end: "15:00" }.
  core_hours     Json?
  work_location  EmployeeWorkLocation @default(OFFICE)
  created_at     DateTime             @default(now())
  updated_at     DateTime             @updatedAt

  employee Employee                  @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  days     EmployeeWorkScheduleDay[]

  @@index([employee_id, effective_from])
  @@map("employee_work_schedules")
}

/// 10 "Attendance & Working Hours" — one row per working weekday of a schedule.
model EmployeeWorkScheduleDay {
  id            String                @id @default(uuid())
  schedule_id   String
  /// 0 = Sunday … 6 = Saturday.
  weekday       Int
  /// "09:00" local time; null for flexible days.
  starts_at     String?
  ends_at       String?
  break_minutes Int                   @default(0)
  hours         Decimal               @db.Decimal(4, 2)
  work_location EmployeeWorkLocation?

  schedule EmployeeWorkSchedule @relation(fields: [schedule_id], references: [id], onDelete: Cascade)

  @@unique([schedule_id, weekday])
  @@map("employee_work_schedule_days")
}

/// 10 "Employee Availability" — time-boxed availability states (remote day, training, business travel, busy,
/// leave projection). Approved leave and holidays create entries with source LEAVE / HOLIDAY; the current state is
/// mirrored onto Employee.availability_status. Projected onto 19 Calendar as read-only items.
model EmployeeAvailabilityEntry {
  id                 String                     @id @default(uuid())
  organization_id    String
  employee_id        String
  status             EmployeeAvailabilityStatus
  starts_at          DateTime
  ends_at            DateTime
  all_day            Boolean                    @default(true)
  source             EmployeeAvailabilitySource @default(MANUAL)
  leave_request_id   String?
  /// 19 CalendarEvent — the projected or originating event.
  calendar_event_id  String?
  note               String?
  created_by_user_id String?
  created_at         DateTime                   @default(now())
  updated_at         DateTime                   @updatedAt

  organization  Organization  @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  employee      Employee      @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  leave_request LeaveRequest? @relation(fields: [leave_request_id], references: [id], onDelete: Cascade)

  @@index([employee_id, starts_at, ends_at])
  @@index([organization_id, status, starts_at])
  @@map("employee_availability_entries")
}

// --- Leave ------------------------------------------------------------------------------

/// 10 "Leave Management" — configurable leave types (vacation, sick, personal, maternity, paternity, unpaid, …).
model LeaveType {
  id                    String           @id @default(uuid())
  organization_id       String
  name                  String
  code                  String
  category              LeaveCategory
  color                 String?
  is_paid               Boolean          @default(true)
  requires_approval     Boolean          @default(true)
  /// e.g. doctor's note for sick leave beyond N days.
  requires_attachment   Boolean          @default(false)
  attachment_after_days Int?
  allows_half_day       Boolean          @default(true)
  /// Whether requests deduct from a LeaveBalance (false for unpaid / unlimited types).
  deducts_balance       Boolean          @default(true)
  min_notice_days       Int?
  max_consecutive_days  Int?
  /// Employment types the type applies to; empty = all.
  applies_to_types      EmploymentType[] @default([])
  sort_order            Int              @default(0)
  archived_at           DateTime?
  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt

  organization Organization   @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  policies     LeavePolicy[]
  balances     LeaveBalance[]
  requests     LeaveRequest[]

  @@unique([organization_id, code])
  @@index([organization_id, category])
  @@map("leave_types")
}

/// 10 "Leave Management" — entitlement and accrual rules for a leave type, optionally restricted to a branch
/// (local law) or employment types. Assigned to employees through EmployeeLeavePolicy; is_default applies to all.
model LeavePolicy {
  id                            String             @id @default(uuid())
  organization_id               String
  leave_type_id                 String
  branch_id                     String?
  name                          String
  accrual_method                LeaveAccrualMethod @default(ANNUAL_UPFRONT)
  annual_entitlement_days       Decimal            @db.Decimal(6, 2)
  /// Days accrued per month / per 100 hours worked, depending on accrual_method.
  accrual_rate                  Decimal?           @db.Decimal(6, 2)
  prorate_first_year            Boolean            @default(true)
  /// Extra days per completed year of service, capped by max_entitlement_days.
  seniority_bonus_days_per_year Decimal?           @db.Decimal(6, 2)
  max_entitlement_days          Decimal?           @db.Decimal(6, 2)
  carry_over_max_days           Decimal?           @db.Decimal(6, 2)
  /// Months after period end before carried-over days expire.
  carry_over_expiry_months      Int?
  allow_negative_balance        Boolean            @default(false)
  max_negative_days             Decimal?           @db.Decimal(6, 2)
  /// Balance period start (month 1–12, day); default calendar year.
  period_start_month            Int                @default(1)
  period_start_day              Int                @default(1)
  applies_to_types              EmploymentType[]   @default([])
  is_default                    Boolean            @default(false)
  effective_from                DateTime?          @db.Date
  effective_to                  DateTime?          @db.Date
  archived_at                   DateTime?
  created_at                    DateTime           @default(now())
  updated_at                    DateTime           @updatedAt

  organization Organization          @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  leave_type   LeaveType             @relation(fields: [leave_type_id], references: [id], onDelete: Cascade)
  branch       Branch?               @relation("LeavePolicyBranch", fields: [branch_id], references: [id], onDelete: SetNull)
  assignments  EmployeeLeavePolicy[]

  @@index([organization_id, leave_type_id])
  @@index([branch_id])
  @@map("leave_policies")
}

/// 10 "Leave Management" — explicit policy assignment per employee (overrides defaults).
model EmployeeLeavePolicy {
  id              String    @id @default(uuid())
  employee_id     String
  leave_policy_id String
  effective_from  DateTime  @db.Date
  effective_to    DateTime? @db.Date
  created_at      DateTime  @default(now())

  employee Employee    @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  policy   LeavePolicy @relation(fields: [leave_policy_id], references: [id], onDelete: Cascade)

  @@unique([employee_id, leave_policy_id, effective_from])
  @@index([leave_policy_id])
  @@map("employee_leave_policies")
}

/// 10 "Leave Management" — balance per employee, leave type and balance period.
/// available = entitled + accrued + carried_over + adjusted − used − pending.
model LeaveBalance {
  id                    String    @id @default(uuid())
  organization_id       String
  employee_id           String
  leave_type_id         String
  period_start          DateTime  @db.Date
  period_end            DateTime  @db.Date
  entitled_days         Decimal   @default(0) @db.Decimal(6, 2)
  accrued_days          Decimal   @default(0) @db.Decimal(6, 2)
  carried_over_days     Decimal   @default(0) @db.Decimal(6, 2)
  adjusted_days         Decimal   @default(0) @db.Decimal(6, 2)
  used_days             Decimal   @default(0) @db.Decimal(6, 2)
  /// Days in PENDING requests (reserved).
  pending_days          Decimal   @default(0) @db.Decimal(6, 2)
  /// When carried-over days expire.
  carry_over_expires_on DateTime? @db.Date
  last_accrued_at       DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  organization Organization              @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  employee     Employee                  @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  leave_type   LeaveType                 @relation(fields: [leave_type_id], references: [id], onDelete: Cascade)
  transactions LeaveBalanceTransaction[]

  @@unique([employee_id, leave_type_id, period_start])
  @@index([organization_id, period_start])
  @@map("leave_balances")
}

/// 10 "Leave Management" — ledger of balance movements (accruals, usage, adjustments, carry-over, expiry).
model LeaveBalanceTransaction {
  id                       String                      @id @default(uuid())
  leave_balance_id         String
  leave_request_id         String?
  type                     LeaveBalanceTransactionType
  /// Signed: positive adds to the balance, negative consumes it.
  days                     Decimal                     @db.Decimal(6, 2)
  effective_on             DateTime                    @db.Date
  reason                   String?
  created_by_membership_id String?
  created_at               DateTime                    @default(now())

  balance       LeaveBalance  @relation(fields: [leave_balance_id], references: [id], onDelete: Cascade)
  leave_request LeaveRequest? @relation(fields: [leave_request_id], references: [id], onDelete: SetNull)

  @@index([leave_balance_id, effective_on])
  @@index([leave_request_id])
  @@map("leave_balance_transactions")
}

/// 10 "Leave Management" — a leave / time-off request with approval workflow (01 §95 approval right; 20 workflow),
/// half-day support, conflict detection and calendar projection (19).
model LeaveRequest {
  id                             String             @id @default(uuid())
  organization_id                String
  employee_id                    String
  leave_type_id                  String
  status                         LeaveRequestStatus @default(DRAFT)
  start_date                     DateTime           @db.Date
  end_date                       DateTime           @db.Date
  start_day_part                 LeaveDayPart       @default(FULL_DAY)
  end_day_part                   LeaveDayPart       @default(FULL_DAY)
  /// Working days requested, excluding weekends and holidays (see days).
  total_days                     Decimal            @db.Decimal(6, 2)
  total_hours                    Decimal?           @db.Decimal(8, 2)
  reason                         String?
  /// 17 Document — e.g. medical certificate.
  attachment_document_id         String?
  /// Colleague covering during the absence.
  covering_employee_id           String?
  /// Membership expected to decide next (derived from LeaveApproverStrategy / workflow).
  current_approver_membership_id String?
  submitted_at                   DateTime?
  decided_at                     DateTime?
  decided_by_membership_id       String?
  decision_note                  String?
  cancelled_at                   DateTime?
  cancellation_reason            String?
  /// Conflict detection snapshot: overlapping team leave, project deadlines, insufficient balance.
  conflicts                      Json?
  has_conflicts                  Boolean            @default(false)
  /// 19 CalendarEvent created for approved leave.
  calendar_event_id              String?
  /// 20 AutomationRun driving the approval workflow.
  automation_run_id              String?
  created_at                     DateTime           @default(now())
  updated_at                     DateTime           @updatedAt

  organization      Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  employee          Employee     @relation("LeaveRequestEmployee", fields: [employee_id], references: [id], onDelete: Cascade)
  leave_type        LeaveType    @relation(fields: [leave_type_id], references: [id], onDelete: Restrict)
  covering_employee Employee?    @relation("LeaveRequestCover", fields: [covering_employee_id], references: [id], onDelete: SetNull)
  decided_by        Membership?  @relation("LeaveRequestDecider", fields: [decided_by_membership_id], references: [id], onDelete: SetNull)

  days                 LeaveRequestDay[]
  approvals            LeaveRequestApproval[]
  balance_transactions LeaveBalanceTransaction[]
  availability_entries EmployeeAvailabilityEntry[]

  @@index([organization_id, status])
  @@index([employee_id, start_date])
  @@index([organization_id, start_date, end_date])
  @@index([current_approver_membership_id, status])
  @@map("leave_requests")
}

/// 10 "Leave Management" — per-day breakdown of a request (half days, hours) for the leave calendar, team
/// availability and capacity.
model LeaveRequestDay {
  id               String       @id @default(uuid())
  leave_request_id String
  date             DateTime     @db.Date
  day_part         LeaveDayPart @default(FULL_DAY)
  hours            Decimal?     @db.Decimal(5, 2)

  leave_request LeaveRequest @relation(fields: [leave_request_id], references: [id], onDelete: Cascade)

  @@unique([leave_request_id, date])
  @@index([date])
  @@map("leave_request_days")
}

/// 10 "Leave Management" — approval steps (manager, HR, custom chain from 20).
model LeaveRequestApproval {
  id                     String                @id @default(uuid())
  leave_request_id       String
  step                   Int                   @default(1)
  approver_membership_id String
  decision               LeaveApprovalDecision @default(PENDING)
  decided_at             DateTime?
  comment                String?
  created_at             DateTime              @default(now())

  leave_request LeaveRequest @relation(fields: [leave_request_id], references: [id], onDelete: Cascade)
  approver      Membership   @relation("LeaveRequestApprover", fields: [approver_membership_id], references: [id], onDelete: Cascade)

  @@unique([leave_request_id, step, approver_membership_id])
  @@index([approver_membership_id, decision])
  @@map("leave_request_approvals")
}

/// 10 "Leave Management" — organization-wide public and company holidays. Branch-specific holidays are
/// BranchHoliday (01 §122); both reduce capacity and are projected onto the leave calendar.
model CompanyHoliday {
  id                    String             @id @default(uuid())
  organization_id       String
  name                  String
  date                  DateTime           @db.Date
  kind                  CompanyHolidayKind @default(COMPANY)
  is_half_day           Boolean            @default(false)
  recurring             Boolean            @default(false)
  /// 10 "Leave Management" — ISO 3166-1 alpha-2 country of an imported public holiday (static dataset, no provider); null = manual / company.
  country_code          String?
  /// Restrict to these branches; empty = whole organization.
  applies_to_branch_ids String[]           @default([])
  created_at            DateTime           @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, date, name])
  @@index([organization_id, date])
  @@map("company_holidays")
}

// --- Attendance -------------------------------------------------------------------------

/// 10 "Attendance & Working Hours" — one record per employee per calendar day aggregating clock sessions,
/// breaks, overtime and lateness against the work schedule. Presence only; work effort is 18 Time Tracking.
model AttendanceRecord {
  id                                 String               @id @default(uuid())
  organization_id                    String
  employee_id                        String
  date                               DateTime             @db.Date
  status                             AttendanceStatus     @default(CLOCKED_IN)
  work_location                      EmployeeWorkLocation @default(OFFICE)
  /// First clock-in / last clock-out of the day (denormalized from sessions).
  first_clock_in_at                  DateTime?
  last_clock_out_at                  DateTime?
  scheduled_minutes                  Int                  @default(0)
  worked_minutes                     Int                  @default(0)
  break_minutes                      Int                  @default(0)
  overtime_minutes                   Int                  @default(0)
  late_minutes                       Int                  @default(0)
  early_leave_minutes                Int                  @default(0)
  overtime_approved                  Boolean              @default(false)
  overtime_approved_by_membership_id String?
  overtime_approved_at               DateTime?
  /// 18 TimeEntry pre-filled from this record, if enabled.
  prefilled_time_entry_id            String?
  note                               String?
  /// Manual correction audit (full history in audit_events).
  edited_by_membership_id            String?
  edited_at                          DateTime?
  created_at                         DateTime             @default(now())
  updated_at                         DateTime             @updatedAt

  organization Organization        @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  employee     Employee            @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  sessions     AttendanceSession[]

  @@unique([employee_id, date])
  @@index([organization_id, date])
  @@index([organization_id, status])
  @@map("attendance_records")
}

/// 10 "Attendance & Working Hours" — a clock-in / clock-out pair; several per day are allowed.
model AttendanceSession {
  id                   String               @id @default(uuid())
  attendance_record_id String
  clock_in_at          DateTime
  clock_out_at         DateTime?
  work_location        EmployeeWorkLocation @default(OFFICE)
  clock_in_source      AttendanceSource     @default(WEB)
  clock_out_source     AttendanceSource?
  /// { lat, lng, accuracy } / ip captured at clock-in / out.
  clock_in_meta        Json?
  clock_out_meta       Json?
  note                 String?
  created_at           DateTime             @default(now())
  updated_at           DateTime             @updatedAt

  record AttendanceRecord  @relation(fields: [attendance_record_id], references: [id], onDelete: Cascade)
  breaks AttendanceBreak[]

  @@index([attendance_record_id, clock_in_at])
  @@map("attendance_sessions")
}

/// 10 "Attendance & Working Hours" — breaks inside a session.
model AttendanceBreak {
  id         String              @id @default(uuid())
  session_id String
  kind       AttendanceBreakKind @default(UNPAID)
  started_at DateTime
  ended_at   DateTime?
  note       String?

  session AttendanceSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id])
  @@map("attendance_breaks")
}

/// 10 "Attendance & Working Hours", "Dashboards & Reporting" — materialized weekly / monthly attendance summary
/// per employee (recomputed by a scheduled job, 20).
model AttendanceSummary {
  id                String             @id @default(uuid())
  organization_id   String
  employee_id       String
  period_type       EmployeePeriodType
  period_start      DateTime           @db.Date
  period_end        DateTime           @db.Date
  scheduled_minutes Int                @default(0)
  worked_minutes    Int                @default(0)
  break_minutes     Int                @default(0)
  overtime_minutes  Int                @default(0)
  days_present      Int                @default(0)
  days_remote       Int                @default(0)
  days_absent       Int                @default(0)
  days_on_leave     Int                @default(0)
  days_holiday      Int                @default(0)
  late_count        Int                @default(0)
  computed_at       DateTime           @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@unique([employee_id, period_type, period_start])
  @@index([organization_id, period_type, period_start])
  @@map("attendance_summaries")
}

// --- Capacity -------------------------------------------------------------------------

/// 10 "Capacity & Workload" — materialized capacity per employee and period: expected hours from the work
/// schedule minus leave and holidays (owned here), with snapshots of planned hours (05 §51 allocation) and logged
/// hours / utilization (18) for dashboards and the AI workforce assistant. 05 and 18 remain the sources.
model EmployeeCapacityPeriod {
  id                  String                 @id @default(uuid())
  organization_id     String
  employee_id         String
  period_type         EmployeePeriodType
  period_start        DateTime               @db.Date
  period_end          DateTime               @db.Date
  scheduled_hours     Decimal                @default(0) @db.Decimal(8, 2)
  leave_hours         Decimal                @default(0) @db.Decimal(8, 2)
  holiday_hours       Decimal                @default(0) @db.Decimal(8, 2)
  /// scheduled − leave − holiday.
  available_hours     Decimal                @default(0) @db.Decimal(8, 2)
  /// Snapshot from 05 ProjectAllocation (+ task estimates, 06).
  planned_hours       Decimal                @default(0) @db.Decimal(8, 2)
  /// Snapshot from 18 TimeEntry actuals.
  logged_hours        Decimal                @default(0) @db.Decimal(8, 2)
  /// planned / available.
  allocation_percent  Decimal?               @db.Decimal(5, 2)
  /// logged / available (computed by 18, mirrored here).
  utilization_percent Decimal?               @db.Decimal(5, 2)
  status              EmployeeCapacityStatus @default(BALANCED)
  /// Per-project breakdown [{ project_id, planned_hours, logged_hours }].
  breakdown           Json?
  computed_at         DateTime               @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@unique([employee_id, period_type, period_start])
  @@index([organization_id, period_type, period_start, status])
  @@map("employee_capacity_periods")
}

// --- Performance ------------------------------------------------------------------------

/// 10 "Performance Management" — a review cycle (e.g. "H1 2026") grouping reviews with a shared template.
model PerformanceReviewCycle {
  id                 String                       @id @default(uuid())
  organization_id    String
  name               String
  type               PerformanceReviewType        @default(ANNUAL)
  status             PerformanceReviewCycleStatus @default(PLANNED)
  period_start       DateTime                     @db.Date
  period_end         DateTime                     @db.Date
  due_date           DateTime?                    @db.Date
  /// Rating scale, competencies and questions: { scale_max, competencies: [...], questions: [...] }.
  template           Json?
  created_by_user_id String?
  created_at         DateTime                     @default(now())
  updated_at         DateTime                     @updatedAt

  organization Organization        @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  reviews      PerformanceReview[]

  feedback_requests PerformanceFeedbackRequest[]
  calibrations      PerformanceCalibration[]

  @@index([organization_id, status])
  @@map("performance_review_cycles")
}

/// 10 "Performance Management" — a performance review (self assessment + manager assessment + ratings).
model PerformanceReview {
  id                     String                  @id @default(uuid())
  organization_id        String
  employee_id            String
  cycle_id               String?
  reviewer_membership_id String?
  type                   PerformanceReviewType   @default(ANNUAL)
  status                 PerformanceReviewStatus @default(DRAFT)
  title                  String?
  period_start           DateTime                @db.Date
  period_end             DateTime                @db.Date
  due_date               DateTime?               @db.Date
  /// Markdown.
  self_assessment        String?
  self_submitted_at      DateTime?
  manager_assessment     String?
  manager_submitted_at   DateTime?
  /// Per competency ratings [{ key, label, rating, comment }].
  ratings                Json?
  overall_rating         Decimal?                @db.Decimal(4, 2)
  rating_scale_max       Int                     @default(5)
  strengths              String?
  improvement_areas      String?
  summary                String?
  /// Employee response after reading the review.
  employee_comment       String?
  completed_at           DateTime?
  acknowledged_at        DateTime?
  next_review_date       DateTime?               @db.Date
  /// 19 CalendarEvent — review meeting.
  meeting_event_id       String?
  /// 17 Document — exported / signed review.
  document_id            String?
  created_by_user_id     String?
  created_at             DateTime                @default(now())
  updated_at             DateTime                @updatedAt

  organization Organization            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  employee     Employee                @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  cycle        PerformanceReviewCycle? @relation(fields: [cycle_id], references: [id], onDelete: SetNull)
  reviewer     Membership?             @relation("PerformanceReviewer", fields: [reviewer_membership_id], references: [id], onDelete: SetNull)

  goals             PerformanceGoal[]
  feedback          PerformanceFeedback[]
  improvement_plans PerformanceImprovementPlan[]

  feedback_requests PerformanceFeedbackRequest[]
  calibrations      PerformanceCalibration[]

  @@index([organization_id, status])
  @@index([employee_id, period_start])
  @@index([reviewer_membership_id, status])
  @@index([cycle_id])
  @@map("performance_reviews")
}

/// 10 "Performance Management" — goals, objectives and key results (objective → key results via parent_goal_id),
/// optionally tied to a review or a Project (05).
model PerformanceGoal {
  id                       String                @id @default(uuid())
  organization_id          String
  employee_id              String
  review_id                String?
  parent_goal_id           String?
  project_id               String?
  kind                     PerformanceGoalKind   @default(GOAL)
  title                    String
  description              String?
  status                   PerformanceGoalStatus @default(NOT_STARTED)
  /// Weight among sibling goals.
  weight_percent           Decimal?              @db.Decimal(5, 2)
  target_value             Decimal?              @db.Decimal(18, 2)
  current_value            Decimal?              @db.Decimal(18, 2)
  unit                     String?
  progress_percent         Decimal               @default(0) @db.Decimal(5, 2)
  start_date               DateTime?             @db.Date
  due_date                 DateTime?             @db.Date
  completed_at             DateTime?
  /// Employee-visible by default; managers may keep draft goals private.
  employee_visible         Boolean               @default(true)
  created_by_membership_id String?
  created_at               DateTime              @default(now())
  updated_at               DateTime              @updatedAt

  organization Organization            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  employee     Employee                @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  review       PerformanceReview?      @relation(fields: [review_id], references: [id], onDelete: SetNull)
  parent       PerformanceGoal?        @relation("PerformanceGoalHierarchy", fields: [parent_goal_id], references: [id], onDelete: SetNull)
  children     PerformanceGoal[]       @relation("PerformanceGoalHierarchy")
  project      Project?                @relation(fields: [project_id], references: [id], onDelete: SetNull)
  updates      PerformanceGoalUpdate[]
  feedback     PerformanceFeedback[]

  @@index([organization_id, status])
  @@index([employee_id, status])
  @@index([review_id])
  @@index([parent_goal_id])
  @@index([project_id])
  @@map("performance_goals")
}

/// 10 "Performance Management" — progress check-ins on a goal (ongoing tracking).
model PerformanceGoalUpdate {
  id                   String                 @id @default(uuid())
  goal_id              String
  author_membership_id String?
  progress_percent     Decimal?               @db.Decimal(5, 2)
  current_value        Decimal?               @db.Decimal(18, 2)
  status               PerformanceGoalStatus?
  note                 String?
  created_at           DateTime               @default(now())

  goal PerformanceGoal @relation(fields: [goal_id], references: [id], onDelete: Cascade)

  @@index([goal_id, created_at])
  @@map("performance_goal_updates")
}

/// 10 "Performance Management" — manager feedback, employee (upward / self) feedback, peer feedback, performance
/// notes, achievements and recognition history. Continuous, not only inside reviews.
model PerformanceFeedback {
  id                   String                        @id @default(uuid())
  organization_id      String
  employee_id          String
  author_membership_id String?
  review_id            String?
  goal_id              String?
  project_id           String?
  kind                 PerformanceFeedbackKind
  visibility           PerformanceFeedbackVisibility @default(MANAGERS_ONLY)
  title                String?
  /// Markdown.
  body                 String
  rating               Decimal?                      @db.Decimal(4, 2)
  occurred_on          DateTime?                     @db.Date
  is_anonymous         Boolean                       @default(false)
  edited_at            DateTime?
  deleted_at           DateTime?
  created_at           DateTime                      @default(now())
  updated_at           DateTime                      @updatedAt

  organization Organization       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  employee     Employee           @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  author       Membership?        @relation("PerformanceFeedbackAuthor", fields: [author_membership_id], references: [id], onDelete: SetNull)
  review       PerformanceReview? @relation(fields: [review_id], references: [id], onDelete: SetNull)
  goal         PerformanceGoal?   @relation(fields: [goal_id], references: [id], onDelete: SetNull)
  project      Project?           @relation(fields: [project_id], references: [id], onDelete: SetNull)

  request PerformanceFeedbackRequest?

  @@index([employee_id, kind, created_at])
  @@index([organization_id, kind])
  @@index([review_id])
  @@map("performance_feedback")
}

/// 10 "Performance Management" — improvement plans (PIP) with check-ins and measurable items.
model PerformanceImprovementPlan {
  id                      String                           @id @default(uuid())
  organization_id         String
  employee_id             String
  review_id               String?
  status                  PerformanceImprovementPlanStatus @default(DRAFT)
  title                   String
  /// Why the plan was opened.
  reason                  String?
  /// Expected outcomes and support offered (markdown).
  objectives              String?
  start_date              DateTime                         @db.Date
  end_date                DateTime                         @db.Date
  check_in_frequency_days Int?
  next_check_in_on        DateTime?                        @db.Date
  manager_membership_id   String?
  hr_membership_id        String?
  outcome_note            String?
  closed_at               DateTime?
  /// 17 Document — signed plan.
  document_id             String?
  created_by_user_id      String?
  created_at              DateTime                         @default(now())
  updated_at              DateTime                         @updatedAt

  organization Organization                     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  employee     Employee                         @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  review       PerformanceReview?               @relation(fields: [review_id], references: [id], onDelete: SetNull)
  items        PerformanceImprovementPlanItem[]

  @@index([organization_id, status])
  @@index([employee_id, status])
  @@map("performance_improvement_plans")
}

/// 10 "Performance Management" — measurable items of an improvement plan.
model PerformanceImprovementPlanItem {
  id           String                           @id @default(uuid())
  plan_id      String
  title        String
  description  String?
  due_date     DateTime?                        @db.Date
  status       PerformanceImprovementItemStatus @default(OPEN)
  evaluated_at DateTime?
  note         String?
  sort_order   Int                              @default(0)
  created_at   DateTime                         @default(now())

  plan PerformanceImprovementPlan @relation(fields: [plan_id], references: [id], onDelete: Cascade)

  @@index([plan_id])
  @@map("performance_improvement_plan_items")
}

// --- Documents & notes --------------------------------------------------------------------

/// 10 "Employee Documents" — HR document index per employee (contracts, NDAs, IDs, signed agreements, HR forms).
/// The file is a 17 Document (employee scope, 17 §3); employment / contractor agreements may also be a Contract
/// (04) and signed through SignatureRequest (04). A row with status REQUESTED and no document_id is a document
/// request ("Notifications" → document requests).
model EmployeeDocument {
  id                         String                   @id @default(uuid())
  organization_id            String
  employee_id                String
  category                   EmployeeDocumentCategory @default(OTHER)
  title                      String
  description                String?
  status                     EmployeeDocumentStatus   @default(UPLOADED)
  /// 17 Document — the stored file; null while REQUESTED.
  document_id                String?
  contract_id                String?
  signature_request_id       String?
  requested_by_membership_id String?
  requested_at               DateTime?
  due_date                   DateTime?                @db.Date
  uploaded_by_user_id        String?
  uploaded_at                DateTime?
  verified_by_membership_id  String?
  verified_at                DateTime?
  rejection_reason           String?
  valid_from                 DateTime?                @db.Date
  expires_on                 DateTime?                @db.Date
  /// Visible to the employee in self-service ("Access HR documents", "Download employment documents").
  employee_visible           Boolean                  @default(true)
  /// Restricted to HR / explicit grants (01 §60).
  is_confidential            Boolean                  @default(false)
  note                       String?
  created_at                 DateTime                 @default(now())
  updated_at                 DateTime                 @updatedAt

  organization      Organization      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  employee          Employee          @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  contract          Contract?         @relation("EmployeeDocumentContract", fields: [contract_id], references: [id], onDelete: SetNull)
  signature_request SignatureRequest? @relation("EmployeeDocumentSignatureRequest", fields: [signature_request_id], references: [id], onDelete: SetNull)

  @@index([employee_id, category])
  @@index([organization_id, status])
  @@index([document_id])
  @@index([expires_on])
  @@map("employee_documents")
}

/// 10 "Internal Notes" — private HR notes (performance observations, meeting notes, HR comments, warnings) with
/// role-based visibility (01 §60). Kept separate from crm_notes so they never surface in generic note feeds,
/// search or exports, and so warnings can carry severity and employee acknowledgement.
model EmployeeHrNote {
  id                           String            @id @default(uuid())
  organization_id              String
  employee_id                  String
  author_membership_id         String?
  category                     HrNoteCategory    @default(HR_COMMENT)
  visibility                   HrNoteVisibility  @default(HR_AND_MANAGERS)
  /// Additional memberships allowed to read beyond the visibility rule.
  restricted_to_membership_ids String[]          @default([])
  /// Warning severity; null for non-warnings.
  severity                     HrNoteSeverity?
  title                        String?
  /// Markdown body.
  body                         String
  occurred_on                  DateTime?         @db.Date
  /// Employee acknowledgement (EMPLOYEE_VISIBLE warnings).
  requires_acknowledgement     Boolean           @default(false)
  acknowledged_at              DateTime?
  /// Related record (review, leave request, project …).
  related_entity_type          RecordEntityType?
  related_entity_id            String?
  /// 17 Document ids attached (signed warning letter, meeting minutes).
  attachment_document_ids      String[]          @default([])
  pinned                       Boolean           @default(false)
  edited_at                    DateTime?
  /// Previous bodies for edit history.
  edit_history                 Json?
  deleted_at                   DateTime?
  created_at                   DateTime          @default(now())
  updated_at                   DateTime          @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  author       Membership?  @relation("EmployeeHrNoteAuthor", fields: [author_membership_id], references: [id], onDelete: SetNull)

  @@index([employee_id, created_at])
  @@index([organization_id, category])
  @@index([related_entity_type, related_entity_id])
  @@map("employee_hr_notes")
}

// --- Self-service -------------------------------------------------------------------------

/// 10 "Employee Self-Service" — profile changes submitted by the employee that need HR approval
/// (EmployeeHrSettings.profile_changes_require_approval). Direct edits of allowed fields skip this table.
model EmployeeProfileChangeRequest {
  id                       String                      @id @default(uuid())
  organization_id          String
  employee_id              String
  status                   EmployeeChangeRequestStatus @default(PENDING)
  /// { field: { from, to } } for Employee / emergency contact / bank detail fields.
  changes                  Json
  employee_note            String?
  submitted_by_user_id     String?
  decided_by_membership_id String?
  decided_at               DateTime?
  decision_note            String?
  created_at               DateTime                    @default(now())
  updated_at               DateTime                    @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([organization_id, status])
  @@index([employee_id, status])
  @@map("employee_profile_change_requests")
}

/// 10 "Employee Profiles" — kind of equipment / asset handed to an employee.
enum EmployeeEquipmentType {
  LAPTOP
  PHONE
  MONITOR
  ACCESS_CARD
  VEHICLE
  OTHER
}

/// 10 "Employee Profiles" — physical condition of an assigned asset (set at handover, updated on return).
enum EmployeeEquipmentCondition {
  NEW
  GOOD
  FAIR
  DAMAGED
  LOST
}

/// 10 "Employee Profiles", "Roles & Responsibilities" — equipment and assets assigned to an employee (laptop, phone, access card).
/// Open items (returned_on null) form the "Equipment to return" list of offboarding.
model EmployeeEquipment {
  id                  String                     @id @default(uuid())
  organization_id     String
  employee_id         String
  asset_type          EmployeeEquipmentType      @default(OTHER)
  name                String
  serial_number       String?
  assigned_on         DateTime                   @db.Date
  expected_return_on  DateTime?                  @db.Date
  returned_on         DateTime?                  @db.Date
  condition           EmployeeEquipmentCondition @default(GOOD)
  /// 17 Document — signed handover form; id only.
  document_id         String?
  notes               String?
  assigned_by_user_id String?
  created_at          DateTime                   @default(now())
  updated_at          DateTime                   @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([organization_id, employee_id])
  @@index([employee_id, returned_on])
  @@index([document_id])
  @@map("employee_equipment")
}

/// 10 "Employee Profiles" — why employment ended (Employee.termination_kind); free-text detail stays in termination_reason.
enum EmployeeTerminationKind {
  RESIGNATION
  DISMISSAL
  END_OF_CONTRACT
  REDUNDANCY
  RETIREMENT
  MUTUAL_AGREEMENT
  OTHER
}

/// 10 "Performance Management" — lifecycle of a 360 feedback request.
enum PerformanceFeedbackRequestStatus {
  PENDING
  SUBMITTED
  DECLINED
  EXPIRED
  CANCELLED
}

/// 10 "Performance Management" — a request to a colleague for feedback about an employee (360 / peer feedback).
/// The answer is a PerformanceFeedback row linked through feedback_id.
model PerformanceFeedbackRequest {
  id                           String                           @id @default(uuid())
  organization_id              String
  /// The employee the feedback is about.
  employee_id                  String
  requested_by_membership_id   String?
  requested_from_membership_id String
  review_id                    String?
  cycle_id                     String?
  status                       PerformanceFeedbackRequestStatus @default(PENDING)
  due_date                     DateTime?                        @db.Date
  message                      String?
  /// The answer is submitted anonymously (copied to PerformanceFeedback.is_anonymous).
  is_anonymous                 Boolean                          @default(false)
  feedback_id                  String?                          @unique
  decline_reason               String?
  responded_at                 DateTime?
  created_at                   DateTime                         @default(now())
  updated_at                   DateTime                         @updatedAt

  organization   Organization            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  employee       Employee                @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  requested_by   Membership?             @relation("PerformanceFeedbackRequestRequester", fields: [requested_by_membership_id], references: [id], onDelete: SetNull)
  requested_from Membership              @relation("PerformanceFeedbackRequestRecipient", fields: [requested_from_membership_id], references: [id], onDelete: Cascade)
  review         PerformanceReview?      @relation(fields: [review_id], references: [id], onDelete: SetNull)
  cycle          PerformanceReviewCycle? @relation(fields: [cycle_id], references: [id], onDelete: SetNull)
  feedback       PerformanceFeedback?    @relation(fields: [feedback_id], references: [id], onDelete: SetNull)

  @@index([requested_from_membership_id, status])
  @@index([employee_id, status])
  @@index([organization_id, status])
  @@index([review_id])
  @@index([cycle_id])
  @@map("performance_feedback_requests")
}

/// 10 "Performance Management" — a calibration adjustment of a review rating (cycle calibration session). The original rating is kept;
/// the latest row per review is the calibrated rating and is written back to PerformanceReview.overall_rating.
model PerformanceCalibration {
  id                          String   @id @default(uuid())
  organization_id             String
  cycle_id                    String
  review_id                   String
  original_rating             Decimal? @db.Decimal(4, 2)
  calibrated_rating           Decimal  @db.Decimal(4, 2)
  reason                      String
  calibrated_by_membership_id String?
  created_at                  DateTime @default(now())

  organization Organization           @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  cycle        PerformanceReviewCycle @relation(fields: [cycle_id], references: [id], onDelete: Cascade)
  review       PerformanceReview      @relation(fields: [review_id], references: [id], onDelete: Cascade)

  @@index([cycle_id])
  @@index([review_id, created_at])
  @@index([organization_id])
  @@map("performance_calibrations")
}

/// 10 "Skills Management", "Project Assignments" — skills (and minimum proficiency) an open ProjectAllocation requires; drives the
/// "Find people" staffing match against EmployeeSkill. The allocation is owned by 05, the requirement is read and matched by 10.
model ProjectAllocationSkill {
  id              String           @id @default(uuid())
  organization_id String
  allocation_id   String
  skill_id        String
  min_proficiency SkillProficiency @default(INTERMEDIATE)
  is_required     Boolean          @default(true)
  created_at      DateTime         @default(now())

  organization Organization      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  allocation   ProjectAllocation @relation(fields: [allocation_id], references: [id], onDelete: Cascade)
  skill        Skill             @relation(fields: [skill_id], references: [id], onDelete: Cascade)

  @@unique([allocation_id, skill_id])
  @@index([skill_id])
  @@index([organization_id])
  @@map("project_allocation_skills")
}

/// 10 "Employee Directory", "Employee Profiles" — lifecycle of a bulk employee import (CSV / XLSX).
enum EmployeeImportStatus {
  PENDING
  VALIDATING
  PREVIEW
  IMPORTING
  COMPLETED
  FAILED
}

/// 10 "Employee Directory" — a CSV / XLSX employee import (mapping, preview, per-row errors). Same shape as CrmImportJob (02) and TimeImportJob (18).
model EmployeeImportJob {
  id                       String               @id @default(uuid())
  organization_id          String
  status                   EmployeeImportStatus @default(PENDING)
  file_name                String?
  /// 17 Document — the uploaded file; id only.
  document_id              String?
  /// Column to Employee field mapping used for the run.
  mapping                  Json?
  total_rows               Int                  @default(0)
  created_rows             Int                  @default(0)
  updated_rows             Int                  @default(0)
  skipped_rows             Int                  @default(0)
  error_rows               Int                  @default(0)
  /// [{ row, field, message }]
  errors                   Json?
  /// 17 Document — downloadable error report; id only.
  error_report_document_id String?
  started_at               DateTime?
  completed_at             DateTime?
  created_by_user_id       String?
  created_at               DateTime             @default(now())
  updated_at               DateTime             @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id, status])
  @@index([document_id])
  @@map("employee_import_jobs")
}

// =====================================================================
// 11 Communication Center — docs/features/11-communication-center.md (LOG-106)
// Owns: outbound email & SMS messages (CommMessage) with recipients, attachments, threads and
// provider delivery events; sender domains/identities, provider accounts and signatures; templates
// with versions and translations; campaigns (audiences, recipients, runs, approvals, tracked links);
// recipient lists, segments (saved filters over CRM), consent, suppression; daily stats; AI drafts.
// Does not own: contacts/companies (02), notification events/preferences/inbox (14 — 11 is only the
// email/SMS delivery channel, referenced by plain id), internal chat (12), inbound conversations
// and tickets (13), automation rules/jobs (20), attachments as files (17). Referenced by id only.
// Activity, review notes and change history go to audit_events / crm_notes (COMM_MESSAGE, CAMPAIGN).
// =====================================================================

/// 11 "Email Management", "SMS Management" — delivery channel of a message, template or campaign.
enum CommChannel {
  EMAIL
  SMS
}

/// 11 "Communication History", "Notification Delivery Provider" — why a message exists. Notification and
/// transactional sends are logged separately from customer communications and campaigns.
enum CommMessageKind {
  CUSTOMER
  CAMPAIGN
  TRANSACTIONAL
  NOTIFICATION
  INTERNAL
}

/// 11 "Communication History" — who or what originated the send ("Automation source", "User who sent").
enum CommMessageSource {
  MANUAL
  CAMPAIGN
  AUTOMATION
  MODULE
  NOTIFICATION
  API
}

/// 11 "Scheduling", "Delivery Tracking" — lifecycle of a single outbound message.
enum CommMessageStatus {
  DRAFT
  SCHEDULED
  QUEUED
  SENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
  CANCELLED
}

/// 11 "Delivery Tracking" — provider delivery events for email (delivered/opened/clicked/replied/bounced/
/// failed/unsubscribed/complained) and SMS (queued/sent/delivered/failed/read).
enum CommDeliveryEventType {
  QUEUED
  SENT
  DEFERRED
  DELIVERED
  OPENED
  CLICKED
  REPLIED
  READ
  BOUNCED
  COMPLAINED
  FAILED
  UNSUBSCRIBED
}

/// 11 "Recipients" — bounce handling.
enum CommBounceType {
  HARD
  SOFT
}

/// 11 "Recipients" — who a message recipient / list member is.
enum CommRecipientKind {
  CRM_CONTACT
  MEMBERSHIP
  PORTAL_USER
  EXTERNAL
}

/// 11 "Email Management" — to / cc / bcc.
enum CommRecipientRole {
  TO
  CC
  BCC
}

/// 11 "Delivery Tracking" — per-recipient status.
enum CommRecipientStatus {
  PENDING
  EXCLUDED
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  REPLIED
  BOUNCED
  FAILED
  UNSUBSCRIBED
}

/// 11 "Communication Templates" — template categories listed in the spec.
enum CommTemplateCategory {
  PROJECT_UPDATE
  MILESTONE_COMPLETION
  INVOICE_NOTIFICATION
  PAYMENT_CONFIRMATION
  PAYMENT_REMINDER
  SUBSCRIPTION_RENEWAL
  WELCOME
  CUSTOMER_ONBOARDING
  MEETING_REMINDER
  MAINTENANCE_ANNOUNCEMENT
  SERVICE_INTERRUPTION
  SUPPORT_RESPONSE
  MARKETING_CAMPAIGN
  HOLIDAY_GREETING
  /// 11 "Customer Communication", "Automation" — remaining communication topics named by the spec.
  DEVELOPMENT_UPDATE
  FEATURE_RELEASE
  BUG_FIX
  DOWNTIME_NOTIFICATION
  MEETING_INVITATION
  APPROVAL_REQUEST
  FEEDBACK_REQUEST
  CONTRACT_RENEWAL
  CONTRACT_EXPIRATION_REMINDER
  PROJECT_CREATED
  PROJECT_COMPLETED
  FAILED_PAYMENT
  CUSTOMER_FOLLOW_UP
  GENERAL_ANNOUNCEMENT
  NOTIFICATION
  OTHER
}

/// 11 "Communication Templates", "Notification Delivery Provider" — what a template is used for.
enum CommTemplateKind {
  COMMUNICATION
  CAMPAIGN
  NOTIFICATION
  SYSTEM
}

enum CommTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// 11 "Communication Templates" — version lifecycle.
enum CommTemplateVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// 11 "Email Management" — supported providers for email and SMS delivery.
enum CommProviderKind {
  RESEND
  SENDGRID
  POSTMARK
  MAILGUN
  AWS_SES
  SMTP
  TWILIO
  VONAGE
  MESSAGEBIRD
  CUSTOM
}

enum CommProviderAccountStatus {
