}

/// 01 §160 — ORGANIZATION = the organization's own key (default). PLATFORM = Logiqdev-provided key from the platform
/// environment, only for organizations Logiqdev explicitly enables (plan, trial, local development seeds).
enum IntegrationCredentialSource {
  ORGANIZATION
