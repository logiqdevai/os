  DISABLED
}

/// 11 "Email Management", "SMS Management" — a from-address or sender number must be verified before use.
enum CommSenderIdentityStatus {
  PENDING_VERIFICATION
  VERIFIED
  FAILED
  DISABLED
}

/// 11 "Marketing Campaigns", "Internal Collaboration", "Scheduling" — campaign lifecycle.
enum CampaignStatus {
  DRAFT
