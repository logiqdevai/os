/// 01 §73–74 — organization security policy.
model OrganizationSecurityPolicy {
  organization_id                 String           @id
  password_min_length             Int              @default(10)
  password_require_symbols        Boolean          @default(false)
  password_max_age_days           Int?
  mfa_policy                      MfaPolicy        @default(OPTIONAL)
  sso_required                    Boolean          @default(false)
  session_duration_minutes        Int              @default(43200)
  idle_timeout_minutes            Int?
  allowed_email_domains           String[]         @default([])
  /// Invitations limited to allowed domains.
  restrict_invitations_to_domains Boolean          @default(false)
  allowed_ip_ranges               String[]         @default([])
  /// ISO 3166-1 alpha-2 codes sign-in is allowed from; empty = no country restriction (01 §73 login restrictions).
  allowed_countries               String[]         @default([])
  /// 01 §73 — who may send invitations.
  invitation_policy               InvitationPolicy @default(PERMISSION_HOLDERS)
  /// 01 §72 — members may list and revoke their own sessions.
  members_can_view_sessions       Boolean          @default(true)
  /// Portal users may use the same policy or a lighter one (01 §79).
  portal_mfa_policy               MfaPolicy        @default(OPTIONAL)
  updated_at                      DateTime         @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@map("organization_security_policies")
}

/// 07 §14 — TLS certificate state of a verified custom domain.
enum DomainTlsStatus {
  PENDING
  ISSUED
  FAILED
}

/// 01 §134 — platform data classes that can carry a retention policy.
enum OrganizationRetentionDataClass {
  AUDIT_EVENTS
  SESSIONS
  INVITATIONS
  WEBHOOK_DELIVERIES
}

/// 01 §134 — what happens to data older than the retention period.
enum OrganizationRetentionAction {
  ARCHIVE
  DELETE
  ANONYMIZE
}

/// 01 §105 — lifecycle of the organization's own subscription to the platform.
enum OrganizationPlanStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

/// 01 §105 — platform invoice status (invoices issued by Logiqdev OS to the organization).
enum OrganizationPlanInvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

/// 01 §70 — verified corporate email domains.
model OrganizationDomain {
  id                 String                   @id @default(uuid())
  organization_id    String
  domain             String
  status             DomainVerificationStatus @default(PENDING)
  verification_token String
  verified_at        DateTime?
  /// Allow users with this email domain to discover and request to join (01 §70).
  allow_discovery    Boolean                  @default(false)
  /// Automatically provision membership on SSO login from this domain.
  auto_provision     Boolean                  @default(false)
  created_at         DateTime                 @default(now())
  updated_at         DateTime                 @updatedAt

  organization    Organization    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  /// 07 §14 — last DNS check per record, e.g. { txt: { ok, expected, found }, cname: { ok, expected, found } }.
  dns_check       Json?
  tls_status      DomainTlsStatus @default(PENDING)
  tls_expires_at  DateTime?
  last_checked_at DateTime?

  @@unique([domain])
  @@index([organization_id])
  @@map("organization_domains")
}

/// 01 §134 — retention of platform data (audit events, sessions, invitations, webhook deliveries), one policy per data class.
/// Documents and messages keep their own policies (17, 12). legal_hold suspends every purge for the class.
model OrganizationRetentionPolicy {
  id                       String                         @id @default(uuid())
  organization_id          String
  data_class               OrganizationRetentionDataClass
  /// Age in days after which `action` applies; null = keep indefinitely.
  retention_days           Int?
  action                   OrganizationRetentionAction    @default(ARCHIVE)
  legal_hold               Boolean                        @default(false)
  legal_hold_reason        String?
  last_run_at              DateTime?
  updated_by_membership_id String?
  created_at               DateTime                       @default(now())
  updated_at               DateTime                       @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  updated_by   Membership?  @relation("OrganizationRetentionPolicyUpdater", fields: [updated_by_membership_id], references: [id], onDelete: SetNull)

  @@unique([organization_id, data_class])
  @@index([updated_by_membership_id])
  @@map("organization_retention_policies")
}

/// 01 §105 — the organization's OWN subscription to Logiqdev OS (plan, seats, limits). Not the customer-facing Subscription of module 08.
/// Card data is never stored: payment_method keeps display info only (brand, last4, expiry); the provider customer id is a plain reference.
model OrganizationPlan {
  organization_id      String                 @id
  plan_key             String
  status               OrganizationPlanStatus @default(TRIALING)
  seats                Int                    @default(1)
  /// Plan limits, e.g. { storage_gb, ai_credits, api_requests_per_day, branches }. Usage is computed, not stored.
  limits               Json?
  billing_email        String?
  trial_ends_at        DateTime?
  current_period_start DateTime?
  current_period_end   DateTime?
  cancel_at_period_end Boolean                @default(false)
  payment_provider_ref String?
  /// Display only: { brand, last4, exp_month, exp_year }.
  payment_method       Json?
  updated_at           DateTime               @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@map("organization_plans")
}

/// 01 §105 — invoice issued by Logiqdev OS to the organization for its plan.
model OrganizationPlanInvoice {
  id                  String                        @id @default(uuid())
  organization_id     String
  number              String
  status              OrganizationPlanInvoiceStatus @default(OPEN)
  currency            String
  /// Total in minor currency units.
  amount_minor        Int
  period_start        DateTime?
  period_end          DateTime?
  issued_at           DateTime                      @default(now())
  due_at              DateTime?
  paid_at             DateTime?
  provider_invoice_id String?
  hosted_invoice_url  String?
  pdf_url             String?

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, number])
  @@index([organization_id, issued_at])
  @@map("organization_plan_invoices")
}

/// 01 §56 — which products are enabled for the organization.
model OrganizationModule {
  id              String    @id @default(uuid())
  organization_id String
  module          ModuleKey
  enabled         Boolean   @default(true)
  enabled_at      DateTime?
  disabled_at     DateTime?
  settings        Json?

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, module])
  @@map("organization_modules")
}

/// 01 §56 — what the organization's plan, trial or an operator override allows, per metered key
/// (`documents.storage_bytes`, `automation.runs_per_month`, `automation.ai_cost_cap_cents`, ...). One row per
/// organization and key; no row = the platform default for the key. Written by Logiqdev staff and by plan
/// changes (organizations.billing.manage); tenants only read their limits. Usage is computed by the owning
/// module (17 sums DocumentVersion.size_bytes, 20 counts AutomationRun per month), never stored here.
model OrganizationEntitlement {
  id              String                 @id @default(uuid())
  organization_id String
  /// Stable `<module>.<metric>` key from api/src/shared/constants/entitlement-keys.ts.
  key             String
  /// Limit in the key's unit (bytes, count, cents); null = unlimited.
  limit_value     BigInt?
  period          EntitlementPeriod      @default(LIFETIME)
  /// HARD blocks the action at the limit; SOFT only warns and raises a notification (14).
  enforcement     EntitlementEnforcement @default(HARD)
  source          EntitlementSource      @default(PLAN)
  /// Trial / temporary override end; null = until changed.
  valid_until     DateTime?
  note            String?
  set_by_user_id  String?
  created_at      DateTime               @default(now())
  updated_at      DateTime               @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, key])
  @@index([key])
  @@map("organization_entitlements")
}

/// 01 §56 — how often a metered entitlement resets.
enum EntitlementPeriod {
  LIFETIME
  MONTHLY
}

/// 01 §56 — what happens when usage reaches the limit.
enum EntitlementEnforcement {
  HARD
  SOFT
}

/// 01 §56 — where an entitlement value comes from.
enum EntitlementSource {
  PLAN
  TRIAL
  OVERRIDE
}

