// --- Providers & sender identities -------------------------------------------------

/// 11 "Email Management", "SMS Management" — a configured delivery provider account (API key stored
/// encrypted / as a secret reference). One default per channel per organization.
model CommProviderAccount {
  id                        String                    @id @default(uuid())
  organization_id           String
  channel                   CommChannel
  provider                  CommProviderKind
  name                      String
  status                    CommProviderAccountStatus @default(ACTIVE)
  is_default                Boolean                   @default(false)
  /// 01 §157 — the organization's own credentials (API key, webhook secret) for this provider. Secrets never live on this row.
  integration_connection_id String?
  /// Provider-specific settings (region, SMTP host/port, messaging service sid, tracking options…).
  settings                  Json?
  last_error                String?
  last_used_at              DateTime?
  created_by_user_id        String?
  created_at                DateTime                  @default(now())
  updated_at                DateTime                  @updatedAt

  organization           Organization           @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  integration_connection IntegrationConnection? @relation(fields: [integration_connection_id], references: [id], onDelete: SetNull)
  sender_domains         CommSenderDomain[]
  sender_identities      CommSenderIdentity[]
  messages               CommMessage[]

  @@index([organization_id, channel, status])
  @@index([integration_connection_id])
  @@map("comm_provider_accounts")
}

/// 11 "Email Management" — a sending domain with DNS verification (SPF / DKIM / DMARC / return-path).
/// Distinct from organization_domains (01 §70), which are login domains.
model CommSenderDomain {
  id                  String                 @id @default(uuid())
  organization_id     String
  provider_account_id String?
  domain              String
  status              CommSenderDomainStatus @default(PENDING)
  /// Provider-side domain id.
  provider_domain_id  String?
  /// DNS records to publish: [{ type, name, value, verified }].
  dns_records         Json?
  spf_verified_at     DateTime?
  dkim_verified_at    DateTime?
  dmarc_verified_at   DateTime?
  verified_at         DateTime?
  last_checked_at     DateTime?
  failure_reason      String?
  /// Subdomain used for link/open tracking, if any.
  tracking_domain     String?
  created_at          DateTime               @default(now())
  updated_at          DateTime               @updatedAt

  organization     Organization         @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  provider_account CommProviderAccount? @relation(fields: [provider_account_id], references: [id], onDelete: SetNull)
  identities       CommSenderIdentity[]

  @@unique([organization_id, domain])
  @@index([organization_id, status])
  @@map("comm_sender_domains")
}

/// 11 "Email Management", "SMS Management" — a verified from-address (email) or sender number / alphanumeric
/// sender id (SMS). May be scoped to a Branch (01 §120 branding). One default per channel.
model CommSenderIdentity {
  id                   String                   @id @default(uuid())
  organization_id      String
  branch_id            String?
  channel              CommChannel
  provider_account_id  String?
  sender_domain_id     String?
  /// Email address or E.164 number / alphanumeric sender id.
  address              String
  display_name         String?
  reply_to_address     String?
  status               CommSenderIdentityStatus @default(PENDING_VERIFICATION)
  is_default           Boolean                  @default(false)
  /// Provider-side identity id (verified sender, messaging service, phone number sid …).
  provider_identity_id String?
  verified_at          DateTime?
  failure_reason       String?
  /// Membership whose personal mailbox this identity represents, if not shared.
  membership_id        String?
  created_at           DateTime                 @default(now())
  updated_at           DateTime                 @updatedAt

  organization     Organization         @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  branch           Branch?              @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  provider_account CommProviderAccount? @relation(fields: [provider_account_id], references: [id], onDelete: SetNull)
  sender_domain    CommSenderDomain?    @relation(fields: [sender_domain_id], references: [id], onDelete: SetNull)
  membership       Membership?          @relation("CommSenderIdentityMembership", fields: [membership_id], references: [id], onDelete: SetNull)
  messages         CommMessage[]
  campaigns        Campaign[]
  templates        CommTemplate[]

  @@unique([organization_id, channel, address])
  @@index([organization_id, channel, status])
  @@index([branch_id])
  @@map("comm_sender_identities")
}

/// 11 "Email Management" — email signatures; organization-wide when membership_id is null, personal otherwise.
model CommSignature {
  id              String   @id @default(uuid())
  organization_id String
  membership_id   String?
  name            String
  body_html       String
  body_text       String?
  is_default      Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  membership   Membership?  @relation("CommSignatureMembership", fields: [membership_id], references: [id], onDelete: Cascade)

  @@index([organization_id, membership_id])
  @@map("comm_signatures")
}

// --- Templates ----------------------------------------------------------------------

/// 11 "Communication Templates" — reusable email / SMS template. Content lives in versions; the published
/// version is pointed to by current_version_id. Variables resolve against CRM (02), project (05) and
/// billing (08) data; branding comes from 01 §15 / §120. Kind NOTIFICATION templates are used by 14.
model CommTemplate {
  id                         String               @id @default(uuid())
  organization_id            String
  branch_id                  String?
  name                       String
  slug                       String
  description                String?
  channel                    CommChannel
  kind                       CommTemplateKind     @default(COMMUNICATION)
  category                   CommTemplateCategory @default(OTHER)
  status                     CommTemplateStatus   @default(DRAFT)
  /// Default language (BCP-47); other languages live in CommTemplateTranslation.
  language                   String               @default("en")
  /// Published version; null while only drafts exist.
  current_version_id         String?              @unique
  default_sender_identity_id String?
  /// 14 NotificationEventType key this template renders (kind NOTIFICATION); id only.
  notification_event_type_id String?
  /// Built-in templates shipped by the platform; editable copies are created per organization.
  is_system                  Boolean              @default(false)
  /// Apply organization/branch branded layout (header, footer, colors) around the body.
  use_branded_layout         Boolean              @default(true)
  /// Declared variables: [{ key, label, source: crm|project|billing|custom, required, sample }].
  variables                  Json?
  /// AI-generated template (11 "AI Communication Assistant").
  ai_generation_id           String?
  usage_count                Int                  @default(0)
  last_used_at               DateTime?
  archived_at                DateTime?
  created_by_membership_id   String?
  created_at                 DateTime             @default(now())
  updated_at                 DateTime             @updatedAt

  organization            Organization          @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  branch                  Branch?               @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  current_version         CommTemplateVersion?  @relation("CommTemplateCurrentVersion", fields: [current_version_id], references: [id], onDelete: SetNull)
  default_sender_identity CommSenderIdentity?   @relation(fields: [default_sender_identity_id], references: [id], onDelete: SetNull)
  created_by              Membership?           @relation("CommTemplateCreator", fields: [created_by_membership_id], references: [id], onDelete: SetNull)
  versions                CommTemplateVersion[] @relation("CommTemplateVersions")
  messages                CommMessage[]
  campaigns               Campaign[]
  ai_generations          CommAiGeneration[]

  @@unique([organization_id, slug])
  @@index([organization_id, channel, status])
  @@index([organization_id, kind, category])
  @@map("comm_templates")
}

/// 11 "Communication Templates" — immutable content snapshot per version: subject, preheader, HTML body,
/// plain-text body, editor design JSON. Conditional content uses template syntax inside the body.
model CommTemplateVersion {
  id                       String                    @id @default(uuid())
  template_id              String
  version                  Int
  status                   CommTemplateVersionStatus @default(DRAFT)
  subject                  String?
  preheader                String?
  /// Rich HTML email body (templating syntax for variables and conditionals). Null for SMS.
  body_html                String?
  /// Plain-text body (email fallback / SMS content).
  body_text                String?
  /// Visual editor document (blocks) used to regenerate body_html.
  design                   Json?
  /// Variables used by this version (derived at save time).
  variables                Json?
  /// Document ids (17) of attachments bundled with the template; ids only.
  attachment_document_ids  String[]                  @default([])
  change_note              String?
  published_at             DateTime?
  created_by_membership_id String?
  created_at               DateTime                  @default(now())
  updated_at               DateTime                  @updatedAt

  template     CommTemplate              @relation("CommTemplateVersions", fields: [template_id], references: [id], onDelete: Cascade)
  current_of   CommTemplate?             @relation("CommTemplateCurrentVersion")
  created_by   Membership?               @relation("CommTemplateVersionCreator", fields: [created_by_membership_id], references: [id], onDelete: SetNull)
  translations CommTemplateTranslation[]
  messages     CommMessage[]
  campaigns    Campaign[]

  @@unique([template_id, version])
  @@index([template_id, status])
  @@map("comm_template_versions")
}

/// 11 "Communication Templates" — multiple languages: a localized subject/body for a template version,
/// selected by recipient language (02 CrmContact.language, 01 §128 defaults).
model CommTemplateTranslation {
  id                        String    @id @default(uuid())
  version_id                String
  /// BCP-47 language tag.
  language                  String
  subject                   String?
  preheader                 String?
  body_html                 String?
  body_text                 String?
  /// Machine-translated by the AI assistant and not yet reviewed.
  is_machine_translated     Boolean   @default(false)
  reviewed_by_membership_id String?
  reviewed_at               DateTime?
  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt

  version CommTemplateVersion @relation(fields: [version_id], references: [id], onDelete: Cascade)

  @@unique([version_id, language])
  @@map("comm_template_translations")
}

// --- Messages -----------------------------------------------------------------------

/// 11 "Email Management", "Conversation threads" — groups outbound emails and their inbound replies
/// (captured by 13 and linked by support_conversation_id) under one subject for a contact / project.
model CommThread {
  id                      String      @id @default(uuid())
  organization_id         String
  subject                 String?
  channel                 CommChannel @default(EMAIL)
  contact_id              String?
  company_id              String?
  project_id              String?
  /// 13 SupportConversation holding inbound replies; id only.
  support_conversation_id String?
  /// Provider / RFC 5322 thread identifiers for reply matching.
  provider_thread_id      String?
  message_count           Int         @default(0)
  last_message_at         DateTime?
  archived_at             DateTime?
  created_at              DateTime    @default(now())
  updated_at              DateTime    @updatedAt

  organization Organization  @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  contact      CrmContact?   @relation(fields: [contact_id], references: [id], onDelete: SetNull)
  company      CrmCompany?   @relation(fields: [company_id], references: [id], onDelete: SetNull)
  project      Project?      @relation(fields: [project_id], references: [id], onDelete: SetNull)
  messages     CommMessage[]

  @@index([organization_id, last_message_at])
  @@index([contact_id])
  @@index([company_id])
  @@index([project_id])
  @@map("comm_threads")
}

/// 11 "Email Management", "SMS Management", "Communication History", "Scheduling", "Delivery Tracking" —
/// one outbound email or SMS to one primary recipient (cc/bcc in CommMessageRecipient). Campaign sends
/// create one CommMessage per recipient. Transactional sends from 03/04/08/13 and notification sends
/// from 14 are the same table with kind TRANSACTIONAL / NOTIFICATION so history and analytics are
/// complete, while UI history views filter by kind. Internal notes: crm_notes (COMM_MESSAGE).
model CommMessage {
  id                     String            @id @default(uuid())
  organization_id        String
  branch_id              String?
  channel                CommChannel
  kind                   CommMessageKind   @default(CUSTOMER)
  source                 CommMessageSource @default(MANUAL)
  status                 CommMessageStatus @default(DRAFT)
  thread_id              String?
  /// Reply chain inside a thread.
  in_reply_to_message_id String?

  // Content ("Rich HTML emails", "Plain text emails", "Personalized messages")
  template_id         String?
  /// 11 "Communication History" — topic of the message; copied from the template, or set directly for template-less sends so history can be filtered by topic.
  category            CommTemplateCategory?
  template_version_id String?
  subject             String?
  preheader           String?
  body_html           String?
  body_text           String?
  /// Variable values used to render the template (snapshot for audit / resend).
  render_context      Json?
  language            String?
  signature_id        String?
  /// Branded layout applied (01 §15 / §120 snapshot at send time).
  branding_snapshot   Json?

  // Sender ("User who sent the communication", ownership)
  sender_identity_id    String?
  from_address          String?
  from_name             String?
  reply_to_address      String?
  sent_by_membership_id String?
  owner_membership_id   String?

  // Primary recipient (cc/bcc and extra recipients in CommMessageRecipient)
  recipient_kind          CommRecipientKind @default(CRM_CONTACT)
  /// Email address or E.164 phone number.
  to_address              String
  to_name                 String?
  recipient_contact_id    String?
  recipient_membership_id String?
  /// Customer Portal User (01 §79); id only.
  recipient_user_id       String?
  company_id              String?
  project_id              String?

  // Origin ("Automation source", campaigns, modules, notifications)
  campaign_id              String?
  campaign_run_id          String?
  /// 11 "Automation" — 20 AutomationRule / AutomationRun that triggered this send; ids only.
  automation_rule_id       String?
  automation_run_id        String?
  /// 14 Notification / NotificationDelivery this message delivers (kind NOTIFICATION); ids only.
  notification_id          String?
  notification_delivery_id String?
  /// Record that caused a transactional send (PROPOSAL 03, CONTRACT 04, INVOICE 08, TICKET 13 …).
  source_entity_type       RecordEntityType?
  source_entity_id         String?
  ai_generation_id         String?

  // Scheduling & queue ("Scheduled sending", "Delay sending", "Time-zone aware delivery", "Queue management")
  scheduled_at      DateTime?
  /// IANA timezone the schedule was expressed in.
  schedule_timezone String?
  /// 20 ScheduledJob backing the schedule; id only.
  scheduled_job_id  String?
  priority          Int       @default(0)
  attempt_count     Int       @default(0)
  next_attempt_at   DateTime?
  last_error        String?

  // Provider & delivery ("Delivery Tracking")
  provider_account_id String?
  provider            CommProviderKind?
  provider_message_id String?
  queued_at           DateTime?
  sent_at             DateTime?
  delivered_at        DateTime?
  first_opened_at     DateTime?
  last_opened_at      DateTime?
  first_clicked_at    DateTime?
  replied_at          DateTime?
  read_at             DateTime?
  bounced_at          DateTime?
  bounce_type         CommBounceType?
  complained_at       DateTime?
  unsubscribed_at     DateTime?
  failed_at           DateTime?
  failure_reason      String?
  cancelled_at        DateTime?
  open_count          Int                      @default(0)
  click_count         Int                      @default(0)
  /// SMS: number of 160/70-char segments billed.
  sms_segment_count   Int?
  /// Provider cost for the send, if reported.
  cost                Decimal?                 @db.Decimal(18, 4)
  cost_currency       String?
  tracking_enabled    Boolean                  @default(true)
  /// Token embedded in the unsubscribe link / List-Unsubscribe header.
  unsubscribe_token   String?                  @unique
  is_test             Boolean                  @default(false)
  /// Raw provider headers / metadata (Message-ID, X-headers …).
  provider_metadata   Json?
  /// 11 "Communication History" — Postgres full-text search vector over subject + body; maintained by a database trigger (see migration). Not set by the API.
  search_vector       Unsupported("tsvector")?

  archived_at        DateTime?
  deleted_at         DateTime?
  created_by_user_id String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  organization         Organization         @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  branch               Branch?              @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  thread               CommThread?          @relation(fields: [thread_id], references: [id], onDelete: SetNull)
  in_reply_to          CommMessage?         @relation("CommMessageReplyChain", fields: [in_reply_to_message_id], references: [id], onDelete: SetNull)
  replies              CommMessage[]        @relation("CommMessageReplyChain")
  template             CommTemplate?        @relation(fields: [template_id], references: [id], onDelete: SetNull)
  template_version     CommTemplateVersion? @relation(fields: [template_version_id], references: [id], onDelete: SetNull)
  sender_identity      CommSenderIdentity?  @relation(fields: [sender_identity_id], references: [id], onDelete: SetNull)
  sent_by              Membership?          @relation("CommMessageSender", fields: [sent_by_membership_id], references: [id], onDelete: SetNull)
  owner                Membership?          @relation("CommMessageOwner", fields: [owner_membership_id], references: [id], onDelete: SetNull)
  recipient_contact    CrmContact?          @relation("CommMessageRecipientContact", fields: [recipient_contact_id], references: [id], onDelete: SetNull)
  recipient_membership Membership?          @relation("CommMessageRecipientMembership", fields: [recipient_membership_id], references: [id], onDelete: SetNull)
  company              CrmCompany?          @relation(fields: [company_id], references: [id], onDelete: SetNull)
  project              Project?             @relation(fields: [project_id], references: [id], onDelete: SetNull)
  campaign             Campaign?            @relation(fields: [campaign_id], references: [id], onDelete: SetNull)
  campaign_run         CampaignRun?         @relation(fields: [campaign_run_id], references: [id], onDelete: SetNull)
  provider_account     CommProviderAccount? @relation(fields: [provider_account_id], references: [id], onDelete: SetNull)
  ai_generation        CommAiGeneration?    @relation("CommAiGenerationMessage", fields: [ai_generation_id], references: [id], onDelete: SetNull)

  recipients          CommMessageRecipient[]
  attachments         CommMessageAttachment[]
  links               CommMessageLink[]
  delivery_events     CommDeliveryEvent[]
  tracked_links       CommTrackedLink[]
  campaign_recipient  CampaignRecipient?
  suppressions        CommSuppression[]
  proposal_deliveries ProposalDelivery[]
  invoice_reminders   InvoiceReminder[]
  crm_activities      CrmActivity[]
  sent_invoices       Invoice[]               @relation("InvoiceSentCommunication")

  @@unique([provider, provider_message_id])
  @@index([organization_id, status, scheduled_at])
  @@index([search_vector], type: Gin)
  @@index([organization_id, channel, kind, created_at])
  @@index([organization_id, status, next_attempt_at])
  @@index([recipient_contact_id, created_at])
  @@index([company_id, created_at])
  @@index([project_id, created_at])
  @@index([campaign_id, status])
  @@index([thread_id, created_at])
  @@index([sent_by_membership_id])
  @@index([source_entity_type, source_entity_id])
  @@index([notification_delivery_id])
  @@index([to_address])
  @@map("comm_messages")
}

/// 11 "Email Management" — every recipient of a message (the primary TO is duplicated here so
/// per-recipient delivery status is uniform), plus cc / bcc.
model CommMessageRecipient {
  id                    String              @id @default(uuid())
  message_id            String
  role                  CommRecipientRole   @default(TO)
  kind                  CommRecipientKind   @default(CRM_CONTACT)
  address               String
  name                  String?
  contact_id            String?
  membership_id         String?
  /// Customer Portal User (01 §79); id only.
  user_id               String?
  status                CommRecipientStatus @default(PENDING)
  provider_recipient_id String?
  delivered_at          DateTime?
  opened_at             DateTime?
  clicked_at            DateTime?
  bounced_at            DateTime?
  failed_at             DateTime?
  failure_reason        String?
  created_at            DateTime            @default(now())
  updated_at            DateTime            @updatedAt

  message         CommMessage         @relation(fields: [message_id], references: [id], onDelete: Cascade)
  contact         CrmContact?         @relation("CommMessageRecipientsContact", fields: [contact_id], references: [id], onDelete: SetNull)
  membership      Membership?         @relation("CommMessageRecipientsMembership", fields: [membership_id], references: [id], onDelete: SetNull)
  delivery_events CommDeliveryEvent[]

  @@unique([message_id, role, address])
  @@index([contact_id])
  @@index([membership_id])
  @@index([address])
  @@map("comm_message_recipients")
}

/// 11 "Email Management" — file attachments and inline images. Files are Documents (17); id only.
model CommMessageAttachment {
  id          String   @id @default(uuid())
  message_id  String
  /// 17 Document; id only.
  document_id String?
  filename    String
  mimetype    String?
  size        Int?
  /// Direct URL when the file is not a Document (e.g. generated invoice PDF from 08).
  url         String?
  /// Inline image referenced from body_html via cid:.
  is_inline   Boolean  @default(false)
  content_id  String?
  created_at  DateTime @default(now())

  message CommMessage @relation(fields: [message_id], references: [id], onDelete: Cascade)

  @@index([message_id])
  @@index([document_id])
  @@map("comm_message_attachments")
}

/// 11 "Customer Communication", "Communication History" — polymorphic link from a message to the records it
/// concerns (CRM_COMPANY / CRM_CONTACT / PROJECT / INVOICE / PROPOSAL / CONTRACT / TICKET / TASK …) so it
/// appears in the Customer 360 timeline (02 §18) and project history (05).
model CommMessageLink {
  id          String           @id @default(uuid())
  message_id  String
  entity_type RecordEntityType
  entity_id   String
  /// about | triggered_by | related
  relation    String           @default("related")
  created_at  DateTime         @default(now())

  message CommMessage @relation(fields: [message_id], references: [id], onDelete: Cascade)

  @@unique([message_id, entity_type, entity_id])
  @@index([entity_type, entity_id])
  @@map("comm_message_links")
}

/// 11 "Delivery Tracking" — append-only provider events (webhooks and sync). Idempotent through
/// provider_webhook_events (08) and the (provider, provider_event_id) unique.
model CommDeliveryEvent {
  id                        String                @id @default(uuid())
  organization_id           String
  message_id                String
  recipient_id              String?
  type                      CommDeliveryEventType
  occurred_at               DateTime
  provider                  CommProviderKind?
  provider_event_id         String?
  /// 08 ProviderWebhookEvent that carried this event.
  provider_webhook_event_id String?
  tracked_link_id           String?
  /// Click: target URL.
  url                       String?
  user_agent                String?
  ip_address                String?
  /// Bounce / failure details.
  bounce_type               CommBounceType?
  bounce_code               String?
  reason                    String?
  payload                   Json?
  created_at                DateTime              @default(now())

  organization           Organization          @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  message                CommMessage           @relation(fields: [message_id], references: [id], onDelete: Cascade)
  recipient              CommMessageRecipient? @relation(fields: [recipient_id], references: [id], onDelete: SetNull)
  provider_webhook_event ProviderWebhookEvent? @relation(fields: [provider_webhook_event_id], references: [id], onDelete: SetNull)
  tracked_link           CommTrackedLink?      @relation(fields: [tracked_link_id], references: [id], onDelete: SetNull)

  @@unique([provider, provider_event_id])
  @@index([message_id, occurred_at])
  @@index([organization_id, type, occurred_at])
  @@index([recipient_id])
  @@map("comm_delivery_events")
}

/// 11 "Delivery Tracking", "Analytics & Reporting" — rewritten links for click tracking, per message
/// (one-off sends) or per campaign (shared across its messages).
model CommTrackedLink {
  id                 String    @id @default(uuid())
  organization_id    String
  message_id         String?
  campaign_id        String?
  token              String    @unique
  original_url       String
  label              String?
  click_count        Int       @default(0)
  unique_click_count Int       @default(0)
  first_clicked_at   DateTime?
  last_clicked_at    DateTime?
  created_at         DateTime  @default(now())

  organization Organization        @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  message      CommMessage?        @relation(fields: [message_id], references: [id], onDelete: Cascade)
  campaign     Campaign?           @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  events       CommDeliveryEvent[]

  @@index([message_id])
  @@index([campaign_id])
  @@map("comm_tracked_links")
}

// --- Recipients, segments, consent & suppression ------------------------------------

/// 11 "Recipients" — a static recipient list of CRM contacts and/or members. Dynamic audiences are Segments.
model CommRecipientList {
  id                       String       @id @default(uuid())
  organization_id          String
  name                     String
  description              String?
  /// Restricts the list to recipients reachable on this channel; null = both.
  channel                  CommChannel?
  member_count             Int          @default(0)
  created_by_membership_id String?
  archived_at              DateTime?
  created_at               DateTime     @default(now())
  updated_at               DateTime     @updatedAt

  organization Organization              @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  created_by   Membership?               @relation("CommRecipientListCreator", fields: [created_by_membership_id], references: [id], onDelete: SetNull)
  members      CommRecipientListMember[]
  audiences    CampaignAudience[]

  @@unique([organization_id, name])
  @@map("comm_recipient_lists")
}

/// 11 "Recipients" — list membership: a CRM contact, a member, or an external address.
model CommRecipientListMember {
  id                     String            @id @default(uuid())
  list_id                String
  kind                   CommRecipientKind @default(CRM_CONTACT)
  contact_id             String?
  membership_id          String?
  /// External address when kind = EXTERNAL, or an override address for a contact.
  address                String?
  name                   String?
  added_by_membership_id String?
  created_at             DateTime          @default(now())

  list       CommRecipientList @relation(fields: [list_id], references: [id], onDelete: Cascade)
  contact    CrmContact?       @relation("CommRecipientListMemberContact", fields: [contact_id], references: [id], onDelete: Cascade)
  membership Membership?       @relation("CommRecipientListMemberMembership", fields: [membership_id], references: [id], onDelete: Cascade)

  @@unique([list_id, contact_id])
  @@unique([list_id, membership_id])
  @@unique([list_id, address])
  @@index([contact_id])
  @@map("comm_recipient_list_members")
}

/// 11 "Customer Segmentation" — a saved filter over CRM companies/contacts (02 §29 saved views, §24 custom
/// fields, §36 tags) combined with billing state (08) and project state (05). Evaluated at send time.
model Segment {
  id                       String            @id @default(uuid())
  organization_id          String
  name                     String
  description              String?
  entity_type              SegmentEntityType @default(CRM_CONTACT)
  /// Optional 02 SavedView whose filter this segment was created from.
  saved_view_id            String?
  /// Filter tree: { and: [ { field, op, value }, { or: [...] } ] } over CRM fields, custom fields, tags,
  /// subscription plan / billing status / outstanding invoices (08), active projects (05), last activity.
  definition               Json
  /// Restricts to recipients reachable on this channel; null = both.
  channel                  CommChannel?
  /// Exclude contacts without OPTED_IN consent on the campaign channel (default on for marketing).
  require_consent          Boolean           @default(true)
  last_evaluated_at        DateTime?
  last_count               Int?
  created_by_membership_id String?
  archived_at              DateTime?
  created_at               DateTime          @default(now())
  updated_at               DateTime          @updatedAt

  organization Organization       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  saved_view   SavedView?         @relation(fields: [saved_view_id], references: [id], onDelete: SetNull)
  created_by   Membership?        @relation("SegmentCreator", fields: [created_by_membership_id], references: [id], onDelete: SetNull)
  audiences    CampaignAudience[]

  @@unique([organization_id, name])
  @@index([organization_id, entity_type])
  @@map("segments")
}

/// 11 "Recipients" — consent / opt-in / unsubscribe state per CRM contact and channel, with evidence.
/// Source of truth for marketing sends; CrmContact.consent (02) is a denormalized summary.
model CommConsent {
  id                       String            @id @default(uuid())
  organization_id          String
  contact_id               String
  channel                  CommChannel
  status                   CommConsentStatus @default(UNKNOWN)
  source                   CommConsentSource @default(MANUAL)
  /// Marketing vs transactional scope; transactional messages never require consent.
  marketing_opted_in       Boolean           @default(false)
  consented_at             DateTime?
  withdrawn_at             DateTime?
  /// Double opt-in confirmation token and its expiry.
  confirmation_token       String?           @unique
  confirmation_expires_at  DateTime?
  confirmed_at             DateTime?
  /// Evidence: ip, user agent, form id, imported file, consent text version …
  evidence                 Json?
  notes                    String?
  updated_by_membership_id String?
  created_at               DateTime          @default(now())
  updated_at               DateTime          @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  contact      CrmContact   @relation("CommConsentContact", fields: [contact_id], references: [id], onDelete: Cascade)

  @@unique([contact_id, channel])
  @@index([organization_id, channel, status])
  @@map("comm_consents")
}

/// 11 "Recipients", "Delivery Tracking" — suppression list: addresses that must not be contacted on a channel
/// (unsubscribes, hard bounces, complaints, manual). Checked before every non-transactional send.
model CommSuppression {
  id                       String                @id @default(uuid())
  organization_id          String
  channel                  CommChannel
  /// Normalized email (lower-case) or E.164 number.
  address                  String
  reason                   CommSuppressionReason
  contact_id               String?
  /// Message / campaign that produced the bounce, complaint or unsubscribe.
  source_message_id        String?
  campaign_id              String?
  /// Soft bounces expire; hard suppressions have no expiry.
  expires_at               DateTime?
  /// Marketing-only suppression (transactional still allowed) vs all sends.
  blocks_transactional     Boolean               @default(false)
  notes                    String?
  created_by_membership_id String?
  removed_at               DateTime?
  removed_by_membership_id String?
  created_at               DateTime              @default(now())
  updated_at               DateTime              @updatedAt

  organization   Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  contact        CrmContact?  @relation("CommSuppressionContact", fields: [contact_id], references: [id], onDelete: SetNull)
  source_message CommMessage? @relation(fields: [source_message_id], references: [id], onDelete: SetNull)
  campaign       Campaign?    @relation(fields: [campaign_id], references: [id], onDelete: SetNull)

  @@unique([organization_id, channel, address])
  @@index([organization_id, reason])
  @@index([contact_id])
  @@map("comm_suppressions")
}

// --- Campaigns ----------------------------------------------------------------------

/// 11 "Marketing Campaigns", "Scheduling", "Internal Collaboration", "Analytics & Reporting" — a bulk email
/// or SMS send to an audience built from lists and segments. Campaign templates are campaigns with
/// is_template = true; duplication records duplicated_from_campaign_id. Recurring campaigns carry an
/// RRULE and are triggered by a 20 ScheduledJob; each occurrence is a CampaignRun.
model Campaign {
  id                          String         @id @default(uuid())
  organization_id             String
  branch_id                   String?
  name                        String
  description                 String?
  channel                     CommChannel
  status                      CampaignStatus @default(DRAFT)
  /// Promotional announcement, product launch, newsletter, … free-form tag; platform tags also apply.
  campaign_type               String?
  is_template                 Boolean        @default(false)
  duplicated_from_campaign_id String?

  // Content (template or inline)
  template_id             String?
  template_version_id     String?
  subject                 String?
  preheader               String?
  body_html               String?
  body_text               String?
  sender_identity_id      String?
  from_name               String?
  reply_to_address        String?
  /// Attachment Document ids (17); ids only.
  attachment_document_ids String[] @default([])
  tracking_enabled        Boolean  @default(true)
  /// UTM parameters appended to tracked links.
  utm                     Json?
  language                String?
  /// Only send to recipients with OPTED_IN consent on the channel.
  require_consent         Boolean  @default(true)

  // Scheduling
  scheduled_at               DateTime?
  schedule_timezone          String?
  /// Deliver at scheduled local time in each recipient's timezone.
  send_in_recipient_timezone Boolean   @default(false)
  /// RFC 5545 RRULE for recurring campaigns; null = one-off.
  recurrence_rule            String?
  recurrence_ends_at         DateTime?
  next_run_at                DateTime?
  /// 20 ScheduledJob driving the schedule; id only.
  scheduled_job_id           String?
  /// Max messages per hour (throttling); null = provider default.
  send_rate_per_hour         Int?

  // Lifecycle
  owner_membership_id       String?
  submitted_for_approval_at DateTime?
  approved_at               DateTime?
  approved_by_membership_id String?
  started_at                DateTime?
  paused_at                 DateTime?
  completed_at              DateTime?
  cancelled_at              DateTime?
  failure_reason            String?

  // Aggregated performance ("Campaign performance"), refreshed from delivery events
  audience_count        Int               @default(0)
  excluded_count        Int               @default(0)
  sent_count            Int               @default(0)
  delivered_count       Int               @default(0)
  opened_count          Int               @default(0)
  clicked_count         Int               @default(0)
  replied_count         Int               @default(0)
  bounced_count         Int               @default(0)
  failed_count          Int               @default(0)
  complained_count      Int               @default(0)
  unsubscribed_count    Int               @default(0)
  stats_refreshed_at    DateTime?
  // A/B test (variants in CampaignVariant)
  ab_test_enabled       Boolean           @default(false)
  ab_metric             CampaignAbMetric?
  /// Share of the audience that receives the test variants; the winner goes to the rest.
  ab_test_percent       Int?
  ab_wait_hours         Int?
  ab_winner_selected_at DateTime?
  /// Preference-center topic this campaign belongs to; recipients must be subscribed to it.
  topic_id              String?
  /// Last pre-send check: { checked_at, issues: [{ kind, severity, message }] } (links, spam score, unsubscribe link).
  preflight             Json?
  preflight_checked_at  DateTime?

  ai_generation_id         String?
  archived_at              DateTime?
  created_by_membership_id String?
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  organization     Organization         @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  branch           Branch?              @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  duplicated_from  Campaign?            @relation("CampaignDuplicate", fields: [duplicated_from_campaign_id], references: [id], onDelete: SetNull)
  duplicates       Campaign[]           @relation("CampaignDuplicate")
  template         CommTemplate?        @relation(fields: [template_id], references: [id], onDelete: SetNull)
  template_version CommTemplateVersion? @relation(fields: [template_version_id], references: [id], onDelete: SetNull)
  sender_identity  CommSenderIdentity?  @relation(fields: [sender_identity_id], references: [id], onDelete: SetNull)
  owner            Membership?          @relation("CampaignOwner", fields: [owner_membership_id], references: [id], onDelete: SetNull)
  approved_by      Membership?          @relation("CampaignApprover", fields: [approved_by_membership_id], references: [id], onDelete: SetNull)
  created_by       Membership?          @relation("CampaignCreator", fields: [created_by_membership_id], references: [id], onDelete: SetNull)
  ai_generation    CommAiGeneration?    @relation("CommAiGenerationCampaign", fields: [ai_generation_id], references: [id], onDelete: SetNull)
  topic            CommTopic?           @relation(fields: [topic_id], references: [id], onDelete: SetNull)
  variants         CampaignVariant[]

  audiences     CampaignAudience[]
  recipients    CampaignRecipient[]
  runs          CampaignRun[]
  approvals     CampaignApproval[]
  messages      CommMessage[]
  tracked_links CommTrackedLink[]
  suppressions  CommSuppression[]
  daily_stats   CommDailyStat[]

  @@index([organization_id, status])
  @@index([organization_id, channel, scheduled_at])
  @@index([organization_id, is_template])
  @@index([next_run_at])
  @@index([owner_membership_id])
  @@index([topic_id])
  @@map("campaigns")
}

/// 11 "Marketing Campaigns", "Customer Segmentation" — audience sources of a campaign: recipient lists and
/// segments, included or excluded. Resolved into CampaignRecipient rows when the campaign is scheduled.
model CampaignAudience {
  id          String               @id @default(uuid())
  campaign_id String
  mode        CampaignAudienceMode @default(INCLUDE)
  list_id     String?
  segment_id  String?
  sort_order  Int                  @default(0)
  created_at  DateTime             @default(now())

  campaign Campaign           @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  list     CommRecipientList? @relation(fields: [list_id], references: [id], onDelete: Cascade)
  segment  Segment?           @relation(fields: [segment_id], references: [id], onDelete: Cascade)

  @@unique([campaign_id, list_id])
  @@unique([campaign_id, segment_id])
  @@index([segment_id])
  @@map("campaign_audiences")
}

/// 11 "Marketing Campaigns", "Delivery Tracking" — resolved audience: one row per recipient per campaign
/// (per run for recurring campaigns). Links to the CommMessage created for the send.
model CampaignRecipient {
  id               String              @id @default(uuid())
  campaign_id      String
  run_id           String?
  /// A/B test variant this recipient was assigned to.
  variant_id       String?
  kind             CommRecipientKind   @default(CRM_CONTACT)
  address          String
  name             String?
  contact_id       String?
  membership_id    String?
  status           CommRecipientStatus @default(PENDING)
  /// Why the recipient was excluded (suppressed, no consent, invalid address, duplicate …).
  exclusion_reason String?
  message_id       String?             @unique
  /// Personalization values resolved for this recipient.
  render_context   Json?
  /// Local send time when send_in_recipient_timezone is on.
  scheduled_at     DateTime?
  sent_at          DateTime?
  created_at       DateTime            @default(now())
  updated_at       DateTime            @updatedAt

  campaign   Campaign         @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  run        CampaignRun?     @relation(fields: [run_id], references: [id], onDelete: Cascade)
  contact    CrmContact?      @relation("CampaignRecipientContact", fields: [contact_id], references: [id], onDelete: SetNull)
  membership Membership?      @relation("CampaignRecipientMembership", fields: [membership_id], references: [id], onDelete: SetNull)
  message    CommMessage?     @relation(fields: [message_id], references: [id], onDelete: SetNull)
  variant    CampaignVariant? @relation(fields: [variant_id], references: [id], onDelete: SetNull)

  @@unique([campaign_id, run_id, address])
  @@index([campaign_id, status])
  @@index([contact_id])
  @@index([run_id])
  @@index([variant_id])
  @@map("campaign_recipients")
}

/// 11 "Scheduling" — one execution of a campaign (recurring campaigns have many; one-off campaigns one).
model CampaignRun {
  id              String            @id @default(uuid())
  campaign_id     String
  run_number      Int
  status          CampaignRunStatus @default(PENDING)
  scheduled_for   DateTime
  started_at      DateTime?
  completed_at    DateTime?
  audience_count  Int               @default(0)
  sent_count      Int               @default(0)
  delivered_count Int               @default(0)
  failed_count    Int               @default(0)
  failure_reason  String?
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt

  campaign   Campaign            @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  recipients CampaignRecipient[]
  messages   CommMessage[]

  @@unique([campaign_id, run_number])
  @@index([campaign_id, status])
  @@index([scheduled_for])
  @@map("campaign_runs")
}

/// 11 "Internal Collaboration" — campaign review / approval by a member before sending.
model CampaignApproval {
  id                     String                   @id @default(uuid())
  campaign_id            String
  approver_membership_id String
  decision               CampaignApprovalDecision @default(PENDING)
  comment                String?
  requested_at           DateTime                 @default(now())
  decided_at             DateTime?

  campaign Campaign   @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  approver Membership @relation("CampaignApprovalApprover", fields: [approver_membership_id], references: [id], onDelete: Cascade)

  @@index([campaign_id, decision])
  @@index([approver_membership_id, decision])
  @@map("campaign_approvals")
}

// --- Analytics & AI -----------------------------------------------------------------

/// 11 "Analytics & Reporting" — daily rollup per organization / channel / kind (and per campaign) used for
/// sent counts, open / click / reply / bounce / delivery rates and exports. Rebuilt from delivery events.
model CommDailyStat {
  id                   String          @id @default(uuid())
  organization_id      String
  date                 DateTime        @db.Date
  channel              CommChannel
  kind                 CommMessageKind
  campaign_id          String?
  sent_count           Int             @default(0)
  delivered_count      Int             @default(0)
  opened_count         Int             @default(0)
  unique_opened_count  Int             @default(0)
  clicked_count        Int             @default(0)
  unique_clicked_count Int             @default(0)
  replied_count        Int             @default(0)
  bounced_count        Int             @default(0)
  failed_count         Int             @default(0)
  complained_count     Int             @default(0)
  unsubscribed_count   Int             @default(0)
  cost                 Decimal?        @db.Decimal(18, 4)
  updated_at           DateTime        @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  campaign     Campaign?    @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, date, channel, kind, campaign_id])
  @@index([organization_id, date])
  @@map("comm_daily_stats")
}

/// 11 "AI Communication Assistant" — a request to the assistant and its output (draft, rewrite, translation,
/// subject lines, summary). Linked to the message / template / campaign it produced or edited.
model CommAiGeneration {
  id                         String         @id @default(uuid())
  organization_id            String
  requested_by_membership_id String?
  task                       CommAiTaskKind
  channel                    CommChannel?
  /// User instructions.
  prompt                     String?
  /// Context passed to the model: contact / project / invoice summaries, source text, target language, tone.
  input                      Json?
  /// Generated result (text, or structured for subject lines / campaigns).
  output                     Json?
  model                      String?
  input_tokens               Int?
  output_tokens              Int?
  /// Whether the user kept the result.
  accepted                   Boolean?
  template_id                String?
  created_at                 DateTime       @default(now())

  organization Organization  @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  requested_by Membership?   @relation("CommAiGenerationRequester", fields: [requested_by_membership_id], references: [id], onDelete: SetNull)
  template     CommTemplate? @relation(fields: [template_id], references: [id], onDelete: SetNull)
  messages     CommMessage[] @relation("CommAiGenerationMessage")
  campaigns    Campaign[]    @relation("CommAiGenerationCampaign")

  @@index([organization_id, task, created_at])
  @@index([requested_by_membership_id])
  @@map("comm_ai_generations")
}

/// 11 "Marketing Campaigns" — metric that picks the A/B winner.
enum CampaignAbMetric {
  OPEN
  CLICK
}

/// 11 "Marketing Campaigns" — an A/B test variant of a campaign (subject / content). The test is configured on the campaign
/// (ab_test_enabled, ab_metric, ab_test_percent, ab_wait_hours); recipients carry their variant in CampaignRecipient.variant_id.
model CampaignVariant {
  id              String   @id @default(uuid())
  campaign_id     String
  /// A, B, C ...
  label           String
  subject         String?
  preheader       String?
  body_html       String?
  body_text       String?
  /// Share of the test group that receives this variant.
  share_percent   Int?
  is_winner       Boolean  @default(false)
  sent_count      Int      @default(0)
  delivered_count Int      @default(0)
  opened_count    Int      @default(0)
  clicked_count   Int      @default(0)
  sort_order      Int      @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  campaign   Campaign            @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  recipients CampaignRecipient[]

  @@unique([campaign_id, label])
  @@map("campaign_variants")
}

/// 11 "Customer Communication", "Recipients" — a preference-center topic (newsletter, product news, billing notices) a contact can subscribe to.
model CommTopic {
  id              String       @id @default(uuid())
  organization_id String
  name            String
  slug            String
  description     String?
  /// Restricts the topic to one channel; null = both.
  channel         CommChannel?
  default_opt_in  Boolean      @default(false)
  sort_order      Int          @default(0)
  archived_at     DateTime?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  organization  Organization            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  subscriptions CommTopicSubscription[]
  campaigns     Campaign[]

  @@unique([organization_id, slug])
  @@index([organization_id, archived_at])
  @@map("comm_topics")
}

/// 11 "Customer Communication", "Recipients" — a contact's per-topic opt-in state. Channel-level consent stays in CommConsent; a topic send
/// requires both.
model CommTopicSubscription {
  id                       String            @id @default(uuid())
  organization_id          String
  contact_id               String
  topic_id                 String
  status                   CommConsentStatus @default(UNKNOWN)
  source                   CommConsentSource @default(MANUAL)
  updated_by_membership_id String?
  created_at               DateTime          @default(now())
  updated_at               DateTime          @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  contact      CrmContact   @relation("CommTopicSubscriptionContact", fields: [contact_id], references: [id], onDelete: Cascade)
  topic        CommTopic    @relation(fields: [topic_id], references: [id], onDelete: Cascade)

  @@unique([contact_id, topic_id])
  @@index([organization_id, topic_id, status])
  @@map("comm_topic_subscriptions")
}

/// 11 "Email Management", "Scheduling", "Customer Communication" — organization-wide communication policy: approval, quiet hours,
/// frequency cap, footer address, double opt-in default, retention, locale. Default senders are CommSenderIdentity.is_default per channel.
model CommSettings {
  organization_id          String   @id
  /// Campaigns need a CampaignApproval before sending.
  approval_required        Boolean  @default(false)
  /// Only campaigns with at least this many recipients need approval; null = all.
  approval_min_recipients  Int?
  /// HH:mm in default_timezone (or the recipient's, with send_in_recipient_timezone).
  quiet_hours_start        String?
  quiet_hours_end          String?
  /// Marketing frequency cap per contact; null = no cap.
  max_marketing_per_week   Int?
  /// Postal address appended to marketing email footers.
  footer_address           String?
  double_opt_in_default    Boolean  @default(true)
  /// Days to keep message bodies; null = keep.
  retention_days_bodies    Int?
  /// Days to keep PII in delivery events (ip, user agent); null = keep.
  retention_days_event_pii Int?
  default_language         String?
  default_timezone         String?
  updated_by_membership_id String?
  updated_at               DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@map("comm_settings")
}

// =====================================================================
// 12 Messaging & Team Communication — docs/features/12-messaging-team-communication.md (LOG-313)
// Owns: channels (public/private/direct/group DM/project/customer/announcement/record conversations),
// channel membership & roles, messages, threads, edits/versions, reactions, mentions, attachment links,
// link previews, record shares, presence, read state, saved messages, reminders, pins, drafts, keywords,
// per-user channel sections, per-channel notification settings, moderation, retention, exports,
// integrations/bots, messaging webhooks, calls, channel templates and usage stats.
// Does not own: identity/Teams/guests/portal users (01), attachments as files (17 Document — id only),
// notification channels, global preferences, DND and the inbox (14), outbound email/SMS (11),
// support conversations/tickets (13), automation rules and the event bus (20), calendar events (19).
// Channel/member/moderation history is written to audit_events (12 §51).
// =====================================================================

/// 12 §2, §5, §6, §25 — kinds of conversation. DMs are channels of kind DIRECT / GROUP_DIRECT;
/// RECORD is the contextual conversation attached to a business record (12 §25).
enum ChannelKind {
  PUBLIC
  PRIVATE
  DIRECT
  GROUP_DIRECT
  PROJECT
  CUSTOMER
  ANNOUNCEMENT
  RECORD
}

/// 12 §7, §34 — discoverability of a channel inside its scope.
enum ChannelVisibility {
  DISCOVERABLE
  HIDDEN
}

/// 12 §6, §8 — lifecycle status; ARCHIVED channels are read-only (12 §8, §95).
enum ChannelStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

/// 12 §7, §29, §49 — who may post.
enum ChannelPostingPolicy {
  ALL_MEMBERS
  INTERNAL_MEMBERS_ONLY
  ADMINS_ONLY
  OWNERS_ONLY
}

/// 12 §9 — membership roles.
enum ChannelMemberRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
  EXTERNAL
  READ_ONLY
}

/// 12 §9, §93 — how a member entered the channel.
enum ChannelMembershipSource {
  MANUAL
  TEAM
  ROLE
  PROJECT
  CUSTOMER
  ORGANIZATION_DEFAULT
  TEMPLATE
  JOINED
  INTEGRATION
}

/// 12 §82 — guest types; access may expire (access_expires_at on the member).
enum ChannelGuestKind {
  SINGLE_CHANNEL
  MULTI_CHANNEL
  CUSTOMER
  PARTNER
  TEMPORARY
}

/// 12 §17, §79 — per-channel / per-conversation notification level layered on 14 §6.
enum ChannelNotificationLevel {
  ALL_MESSAGES
  MENTIONS_AND_DIRECT
  DIRECT_ONLY
  NOTHING
  CUSTOM
}

/// 12 §90 — optional channel digest instead of real-time notifications.
enum ChannelDigestFrequency {
  NONE
  HOURLY
  DAILY
  WEEKLY
}

/// 12 §10, §38, §45, §91 — origin of a message.
enum MessageKind {
  USER
  SYSTEM
  INTEGRATION
  VOICE
}

/// 12 §28, §57 — internal vs customer-visible messages inside customer-facing channels.
enum MessageVisibility {
  INTERNAL
  EXTERNAL
}

/// 12 §75 — delivery states. Drafts live in message_drafts; DELETED is a soft delete (12 §13).
enum MessageDeliveryStatus {
  SCHEDULED
  SENDING
  SENT
  DELIVERED
  FAILED
  RETRYING
  DELETED
}

/// 12 §15 — mention targets. CHANNEL = @channel/@here broadcast, EVERYONE = organization-wide,
/// CHANNEL_LINK = a #channel reference.
enum MessageMentionKind {
  MEMBER
  EXTERNAL_USER
  TEAM
  ROLE
  CHANNEL
  EVERYONE
  CHANNEL_LINK
}

/// 12 §22, §45 — attachment categories.
enum MessageAttachmentKind {
  IMAGE
  PDF
  DOCUMENT
  SPREADSHEET
  PRESENTATION
  VIDEO
  AUDIO
  VOICE_MESSAGE
  ARCHIVE
  OTHER
}

/// 12 §23 — link preview resolution state.
enum MessageLinkPreviewStatus {
  PENDING
  RESOLVED
  FAILED
  BLOCKED
}

/// 12 §4 — presence states; custom status is text/emoji on the same record.
enum MessagingPresenceState {
  ACTIVE
  AWAY
  DO_NOT_DISTURB
  OFFLINE
}

/// 12 §21 — reminder lifecycle.
enum MessageReminderStatus {
  PENDING
  TRIGGERED
  COMPLETED
  SNOOZED
  CANCELLED
}

/// 12 §54 — where a retention policy applies.
enum MessagingRetentionScope {
  ORGANIZATION
  BRANCH
  TEAM
  CHANNEL_KIND
  CHANNEL
}

/// 12 §54 — what happens after the retention period.
enum MessagingRetentionAction {
  UNLIMITED
  ARCHIVE
  DELETE
}

/// 12 §55 — export job lifecycle.
enum MessagingExportStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  EXPIRED
}

/// 12 §55 — export formats.
enum MessagingExportFormat {
  JSON
  CSV
  HTML
}

/// 12 §49, §64 — report lifecycle.
enum MessageReportStatus {
  OPEN
  UNDER_REVIEW
  ACTIONED
  DISMISSED
}

/// 12 §49–50 — moderation restriction kinds.
enum ChannelRestrictionKind {
  MUTED
  BANNED
}

/// 12 §37–38 — integration / bot sources. Inbound webhooks and bots post messages; external
/// providers are controlled event sources.
enum MessagingIntegrationKind {
  INBOUND_WEBHOOK
  BOT
  GITHUB
  GITLAB
  JIRA
  LINEAR
  GOOGLE_DRIVE
  NOTION
  MICROSOFT_365
  GOOGLE_WORKSPACE
  SLACK
  DISCORD
  CUSTOM
}

/// 12 §37, §50 — integration status.
enum MessagingIntegrationStatus {
  ACTIVE
  DISABLED
  ERROR
}

/// 12 §44 — call kinds.
enum ChannelCallKind {
  VOICE
  VIDEO
  HUDDLE
}

/// 12 §44 — call lifecycle.
enum ChannelCallStatus {
  RINGING
  IN_PROGRESS
  ENDED
  MISSED
  CANCELLED
  FAILED
}

/// 12 §93 — when a channel template is applied automatically.
enum ChannelTemplateTrigger {
  MANUAL
  PROJECT_CREATED
  CUSTOMER_CREATED
}

// --- Organization settings ---------------------------------------------------------

/// 12 §13, §14, §43, §53, §80, §85, §94 — organization-wide messaging configuration (one row per
/// organization). Global notification channels/DND/digest live in 14 §6; branding comes from 01 §15.
model MessagingSettings {
  organization_id                      String                   @id
  /// 12 §13 — deletion policy.
  allow_delete_own_messages            Boolean                  @default(true)
  /// 12 §13 — minutes after sending during which the author may delete; null = any time.
  delete_own_time_limit_minutes        Int?
  allow_admin_delete_messages          Boolean                  @default(true)
  /// 12 §13 — edit window in minutes; null = unlimited.
  edit_time_limit_minutes              Int?
  /// 12 §13 — keep message_versions on edit.
  preserve_edit_history                Boolean                  @default(true)
  /// 12 §14, §80 — allowed reaction emoji; empty = all.
  allowed_reactions                    String[]                 @default([])
  /// 12 §80 — custom emoji definitions [{ name, url }].
  custom_emoji                         Json?
  /// 12 §43, §53 — read receipts per conversation kind.
  read_receipts_direct                 Boolean                  @default(true)
  read_receipts_group                  Boolean                  @default(true)
  read_receipts_customer               Boolean                  @default(false)
  /// 12 §4, §53 — presence visibility: everyone | members | nobody.
  presence_visibility                  String                   @default("everyone")
  /// 12 §80 — default per-channel notification level for new members.
  default_notification_level           ChannelNotificationLevel @default(MENTIONS_AND_DIRECT)
  /// 12 §80 — default channel slugs every new member joins (12 §9 organization-wide channels).
  default_channel_ids                  String[]                 @default([])
  /// 12 §80, §94 — naming rules: { prefix_rules: {PROJECT: "project-", CUSTOMER: "customer-"}, pattern, lowercase }.
  channel_naming_rules                 Json?
  /// 12 §80 — file limits: { max_file_size_bytes, allowed_mime_types[], blocked_extensions[] } (12 §69, §85).
  file_policy                          Json?
  /// 12 §27, §80 — external participants allowed at all.
  external_access_enabled              Boolean                  @default(false)
  /// 12 §82 — guest access and default guest expiry days.
  guest_access_enabled                 Boolean                  @default(false)
  guest_default_expiry_days            Int?
  /// 12 §15, §80 — who may use @channel / @everyone: everyone | admins | owners.
  broadcast_mention_policy             String                   @default("admins")
  /// 12 §29, §80 — who may create announcement channels / post announcements.
  announcement_policy                  String                   @default("admins")
  /// 12 §26 — offer / auto-create a project channel on project creation (12 §93).
  auto_create_project_channels         Boolean                  @default(false)
  /// 12 §45, §71 — voice messages enabled.
  voice_messages_enabled               Boolean                  @default(true)
  /// 12 §44 — calls enabled and provider: internal | google_meet | zoom | teams | custom.
  calls_enabled                        Boolean                  @default(false)
  call_provider                        String?
  /// 12 §69 — rate limits: { messages_per_minute, uploads_per_hour, api_requests_per_minute, integration_events_per_minute }.
  rate_limits                          Json?
  /// 12 §85 — sensitive content controls: { external_sharing_warning, prevent_external_forwarding, restricted_file_types[], dlp_provider }.
  sensitive_content_controls           Json?
  /// 12 §50 — admins may search private messages/DMs under policy.
  admin_private_message_access_enabled Boolean                  @default(false)
  /// 12 §87 — notification previews may include message text (user may further restrict).
  notification_previews_include_text   Boolean                  @default(true)
  /// 12 §33, §80 — default sidebar sections for new members [{ name, channel_ids[] }].
  default_sections                     Json?
  created_at                           DateTime                 @default(now())
  updated_at                           DateTime                 @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@map("messaging_settings")
}

/// 12 §54 — message retention policy. Scope precedence: CHANNEL > CHANNEL_KIND > TEAM > BRANCH > ORGANIZATION.
model MessagingRetentionPolicy {
  id                     String                   @id @default(uuid())
  organization_id        String
  name                   String
  scope                  MessagingRetentionScope  @default(ORGANIZATION)
  branch_id              String?
  team_id                String?
  /// Set when scope = CHANNEL_KIND.
  channel_kind           ChannelKind?
  action                 MessagingRetentionAction @default(UNLIMITED)
  /// Days after creation before `action` applies; null for UNLIMITED.
  retention_days         Int?
  /// 12 §54 — the policy also applies to attachments (17 Documents are notified), reactions and metadata.
  applies_to_attachments Boolean                  @default(true)
  applies_to_reactions   Boolean                  @default(true)
  applies_to_metadata    Boolean                  @default(false)
  is_default             Boolean                  @default(false)
  created_by_user_id     String?
  last_applied_at        DateTime?
  created_at             DateTime                 @default(now())
  updated_at             DateTime                 @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [team_id], references: [id], onDelete: Cascade)
  channels     Channel[]

  @@index([organization_id, scope])
  @@index([branch_id])
  @@index([team_id])
  @@map("messaging_retention_policies")
}

/// 12 §93 — templates for recurring communication spaces (new project channel, customer onboarding).
model ChannelTemplate {
  id                  String                 @id @default(uuid())
  organization_id     String
  name                String
  description         String?
  channel_kind        ChannelKind            @default(PROJECT)
  trigger             ChannelTemplateTrigger @default(MANUAL)
  /// 12 §94 — slug pattern, e.g. "project-{project.slug}" / "customer-{company.slug}".
  name_pattern        String?
  default_description String?
  default_purpose     String?
  default_topic       String?
  posting_policy      ChannelPostingPolicy   @default(ALL_MEMBERS)
  visibility          ChannelVisibility      @default(DISCOVERABLE)
  external_access     Boolean                @default(false)
  /// 12 §93 — required members: { roles: [PROJECT_MANAGER, ACCOUNT_MANAGER, ASSIGNED_EMPLOYEES, STAKEHOLDERS, CUSTOMER], team_ids[], membership_ids[] }.
  member_rules        Json?
  /// 12 §93 — messages posted and pinned on creation [{ body, pin: true }] (project overview, dashboard links, onboarding docs).
  pinned_content      Json?
  /// 12 §93 — standard discussion sections / threads to seed [{ title }].
  discussion_sections Json?
  /// 12 §95 — auto-archive rule: { after_project_completed_days, after_inactive_days }.
  archive_rule        Json?
  retention_policy_id String?
  is_active           Boolean                @default(true)
  created_by_user_id  String?
  created_at          DateTime               @default(now())
  updated_at          DateTime               @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  channels     Channel[]

  @@unique([organization_id, name])
  @@index([organization_id, trigger])
  @@map("channel_templates")
}

// --- Channels --------------------------------------------------------------------

/// 12 §5–8, §25–29, §48 — every conversation: channels, DMs (DIRECT/GROUP_DIRECT), project and
/// customer channels, announcement channels and record conversations (RECORD, entity_type/entity_id).
/// Custom fields via custom_field_values, tags via taggings (RecordEntityType.CHANNEL).
model Channel {
  id                         String                    @id @default(uuid())
  organization_id            String
  kind                       ChannelKind
  visibility                 ChannelVisibility         @default(DISCOVERABLE)
  status                     ChannelStatus             @default(ACTIVE)
  /// 12 §7, §94 — unique handle (#general); null for DMs and record conversations.
  slug                       String?
  /// 12 §7 — channel name; null for DMs (derived from participants).
  name                       String?
  display_name               String?
  description                String?
  purpose                    String?
  /// 12 §48 — short current focus.
  topic                      String?
  icon_url                   String?
  /// Emoji or icon key shown before the name.
  icon                       String?
  color                      String?
  owner_membership_id        String?
  created_by_membership_id   String?
  /// 12 §3, §7 — Team / Branch scope.
  team_id                    String?
  /// 12 §9 — automatic membership rules (team / role based): { team_ids: string[], role_ids: string[], sync: boolean }. Members added by these rules get source TEAM / ROLE.
  membership_rules           Json?
  branch_id                  String?
  /// 12 §7, §26 — associated project (PROJECT channels; also set on RECORD conversations of project items).
  project_id                 String?
  /// 12 §7, §27 — associated customer (CRM company) for CUSTOMER channels.
  company_id                 String?
  /// 12 §7, §25 — associated business record for RECORD conversations (task, deal, ticket (13), proposal …).
  entity_type                RecordEntityType?
  entity_id                  String?
  /// 12 §7, §29, §49 — posting permissions.
  posting_policy             ChannelPostingPolicy      @default(ALL_MEMBERS)
  /// 12 §7, §27 — external participants (portal users / guests) may be added.
  external_access_enabled    Boolean                   @default(false)
  /// 12 §43 — read receipts for this conversation (null = organization default by kind).
  read_receipts_enabled      Boolean?
  /// 12 §7, §17 — default notification level for new members (null = organization default).
  default_notification_level ChannelNotificationLevel?
  /// 12 §9 — every new organization member is auto-joined (organization-wide channel).
  auto_join                  Boolean                   @default(false)
  /// 12 §29 — announcement messages in this channel require acknowledgement by default.
  require_acknowledgement    Boolean                   @default(false)
  /// 12 §85 — confidential label shown in the UI.
  is_confidential            Boolean                   @default(false)
  /// 12 §5 — stable key for DM de-duplication: sorted participant ids joined with ":".
  dm_key                     String?
  /// 12 §54 — explicit retention policy; null = inherited.
  retention_policy_id        String?
  /// 12 §93 — template this channel was created from.
  template_id                String?
  /// 12 §2 — temporary conversations expire (12 §95 auto-archive).
  expires_at                 DateTime?
  auto_archive_at            DateTime?
  archived_at                DateTime?
  archived_by_user_id        String?
  /// 12 §95 — reason: manual | project_completed | customer_inactive | expired | retention.
  archive_reason             String?
  deleted_at                 DateTime?
  deleted_by_user_id         String?
  /// Denormalized counters (12 §34, §77, §102).
  member_count               Int                       @default(0)
  message_count              Int                       @default(0)
  last_message_at            DateTime?
  /// 12 §37, §103 — integration ids connected to this channel (12 Integrations), plus misc settings.
  settings                   Json?
  created_at                 DateTime                  @default(now())
  updated_at                 DateTime                  @updatedAt

  organization     Organization              @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  owner            Membership?               @relation("ChannelOwner", fields: [owner_membership_id], references: [id], onDelete: SetNull)
  created_by       Membership?               @relation("ChannelCreator", fields: [created_by_membership_id], references: [id], onDelete: SetNull)
  team             Team?                     @relation(fields: [team_id], references: [id], onDelete: SetNull)
  branch           Branch?                   @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  project          Project?                  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  company          CrmCompany?               @relation(fields: [company_id], references: [id], onDelete: SetNull)
  retention_policy MessagingRetentionPolicy? @relation(fields: [retention_policy_id], references: [id], onDelete: SetNull)
  template         ChannelTemplate?          @relation(fields: [template_id], references: [id], onDelete: SetNull)

  members              ChannelMember[]
  messages             Message[]
  pins                 ChannelPin[]
  read_states          ChannelReadState[]
  drafts               MessageDraft[]
  section_items        ChannelSectionItem[]
  restrictions         ChannelMemberRestriction[]
  calls                ChannelCall[]
  attachments          MessageAttachment[]
  mentions_in_messages MessageMention[]           @relation("MessageMentionChannel")
  integrations         MessagingIntegration[]     @relation("IntegrationDefaultChannel")
  webhooks             OutboundWebhook[]          @relation("WebhookChannelFilter")
  usage_stats          MessagingUsageDaily[]
  primary_for_projects Project[]                  @relation("ProjectPrimaryChannel")

  invitations     ChannelInvitation[]
  access_requests ChannelAccessRequest[]

  @@unique([organization_id, slug])
  @@unique([organization_id, dm_key])
  @@unique([organization_id, entity_type, entity_id])
  @@index([organization_id, kind, status])
  @@index([organization_id, status, last_message_at])
  @@index([project_id])
  @@index([company_id])
  @@index([team_id])
  @@index([branch_id])
  @@index([owner_membership_id])
  @@index([auto_archive_at])
  @@map("channels")
}

/// 12 §9, §27, §82–83 — a participant of a channel: an internal Member (membership_id) or an external
/// participant (external_user_id — Customer Portal User 01 §79 or guest 01 §77–78). Exactly one is set.
/// Favorites, mute and last-viewed live here; notification settings in channel_notification_settings.
model ChannelMember {
  id                 String                  @id @default(uuid())
  channel_id         String
  membership_id      String?
  external_user_id   String?
  role               ChannelMemberRole       @default(MEMBER)
  source             ChannelMembershipSource @default(MANUAL)
  /// 12 §82 — set for guests / external participants.
  guest_kind         ChannelGuestKind?
  /// 12 §82 — guest access expires automatically.
  access_expires_at  DateTime?
  /// 12 §83 — identity marker shown next to external users ("ACME Corp — Guest").
  external_label     String?
  invited_by_user_id String?
  joined_at          DateTime                @default(now())
  left_at            DateTime?
  removed_at         DateTime?
  removed_by_user_id String?
  /// 12 §33 — favorites and recently viewed.
  is_favorite        Boolean                 @default(false)
  last_viewed_at     DateTime?
  /// 12 §17 — mute until (null = not muted; far future = indefinitely).
  muted_until        DateTime?
  /// 12 §93 — membership is required by the template / rule and cannot be left.
  is_required        Boolean                 @default(false)
  created_at         DateTime                @default(now())
  updated_at         DateTime                @updatedAt

  channel               Channel                     @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  membership            Membership?                 @relation(fields: [membership_id], references: [id], onDelete: Cascade)
  external_user         User?                       @relation("ChannelExternalMember", fields: [external_user_id], references: [id], onDelete: Cascade)
  notification_settings ChannelNotificationSetting?

  @@unique([channel_id, membership_id])
  @@unique([channel_id, external_user_id])
  @@index([membership_id, left_at])
  @@index([external_user_id])
  @@index([channel_id, role])
  @@index([access_expires_at])
  @@map("channel_members")
}

/// 12 §17, §79, §90 — per-channel / per-conversation notification settings layered on the global
/// preferences of 14 §6 (DND, quiet hours and delivery channels are evaluated by 14).
model ChannelNotificationSetting {
  channel_member_id          String                    @id
  /// null = inherit channel default, then organization default.
  level                      ChannelNotificationLevel?
  notify_thread_replies      Boolean                   @default(true)
  notify_reactions           Boolean                   @default(false)
  notify_keywords            Boolean                   @default(true)
  desktop_enabled            Boolean                   @default(true)
  mobile_enabled             Boolean                   @default(true)
  email_enabled              Boolean                   @default(false)
  /// Sound key or null for silent.
  sound                      String?
  /// 12 §17 — per-channel schedule override: { days: [1..7], start: "09:00", end: "18:00", timezone }.
  schedule                   Json?
  digest_frequency           ChannelDigestFrequency    @default(NONE)
  /// 12 §79 — notify immediately for customer (EXTERNAL) messages even when muted.
  priority_customer_messages Boolean                   @default(false)
  updated_at                 DateTime                  @updatedAt

  channel_member ChannelMember @relation(fields: [channel_member_id], references: [id], onDelete: Cascade)

  @@map("channel_notification_settings")
}

/// 12 §49–50 — moderation restrictions: mute or ban a participant in one channel (channel_id set)
/// or across the whole organization (channel_id null). Target is a Member or an external user.
model ChannelMemberRestriction {
  id                 String                 @id @default(uuid())
  organization_id    String
  channel_id         String?
  membership_id      String?
  external_user_id   String?
  kind               ChannelRestrictionKind
  reason             String?
  /// null = until lifted.
  expires_at         DateTime?
  created_by_user_id String?
  lifted_at          DateTime?
  lifted_by_user_id  String?
  created_at         DateTime               @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  channel      Channel?     @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  membership   Membership?  @relation("ChannelRestrictionTarget", fields: [membership_id], references: [id], onDelete: Cascade)

  @@index([organization_id, kind, lifted_at])
  @@index([channel_id, membership_id])
  @@index([membership_id])
  @@index([external_user_id])
  @@map("channel_member_restrictions")
}

// --- Messages --------------------------------------------------------------------

/// 12 §10–13, §28, §29, §38, §75, §91 — the message. Thread replies set parent_message_id (root only,
/// one level). Author is a Member, an external User, or an integration/bot (12 §38); SYSTEM messages
/// have no author. Permalink = /messaging/c/{channel_id}/m/{id} (12 §65).
model Message {
  id                        String                   @id @default(uuid())
  organization_id           String
  channel_id                String
  kind                      MessageKind              @default(USER)
  visibility                MessageVisibility        @default(INTERNAL)
  status                    MessageDeliveryStatus    @default(SENT)
  author_membership_id      String?
  /// 12 §27 — external participant author (Customer Portal User / guest).
  author_user_id            String?
  /// 12 §38 — integration or bot that posted the message.
  integration_id            String?
  /// 12 §11, §35 — markdown source.
  body                      String
  /// Structured rich-text document (editor JSON) when available.
  body_rich                 Json?
  /// Plain text rendering for search and notification previews (12 §30, §87).
  body_plain                String?
  /// 12 §12 — thread root; null for top-level messages.
  parent_message_id         String?
  reply_count               Int                      @default(0)
  last_reply_at             DateTime?
  /// 12 §11 — quoted message.
  quoted_message_id         String?
  /// 12 §11, §64 — forwarded / shared from another message.
  forwarded_from_message_id String?
  /// 12 §11 — scheduled messages: send at this time (status SCHEDULED until sent).
  scheduled_for             DateTime?
  sent_at                   DateTime?
  /// 12 §29 — important styling and acknowledgement tracking for announcements.
  is_announcement           Boolean                  @default(false)
  requires_acknowledgement  Boolean                  @default(false)
  /// 12 §13 — edit state; versions in message_versions when the organization preserves history.
  is_edited                 Boolean                  @default(false)
  edited_at                 DateTime?
  deleted_at                DateTime?
  deleted_by_user_id        String?
  /// 12 §13, §49 — self | admin | retention | moderation.
  delete_reason             String?
  /// 12 §47 — denormalized pin state (source of truth: channel_pins).
  pinned_at                 DateTime?
  /// 12 §91 — system event key (member_joined, member_left, channel_renamed, channel_archived, integration_connected, project_linked, customer_added, call_started …).
  system_event              String?
  /// 12 §38 — external source shown on integration messages (e.g. "GitHub") and the provider event id for idempotency.
  integration_source        String?
  external_event_id         String?
  /// 12 §39, §76 — client-generated idempotency key.
  client_message_id         String?
  /// 12 §30 — search facets.
  has_attachments           Boolean                  @default(false)
  has_links                 Boolean                  @default(false)
  has_record_shares         Boolean                  @default(false)
  reaction_count            Int                      @default(0)
  /// 12 §10 — free-form metadata (integration payload, formatting hints, failure reason).
  metadata                  Json?
  created_at                DateTime                 @default(now())
  updated_at                DateTime                 @updatedAt
  /// 12 §30 — Postgres full-text search vector over body_plain; maintained by a database trigger (see migration). Not set by the API.
  search_vector             Unsupported("tsvector")?

  organization   Organization          @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  channel        Channel               @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  author         Membership?           @relation("MessageAuthor", fields: [author_membership_id], references: [id], onDelete: SetNull)
  author_user    User?                 @relation("MessageExternalAuthor", fields: [author_user_id], references: [id], onDelete: SetNull)
  integration    MessagingIntegration? @relation(fields: [integration_id], references: [id], onDelete: SetNull)
  parent         Message?              @relation("MessageThread", fields: [parent_message_id], references: [id], onDelete: Cascade)
  replies        Message[]             @relation("MessageThread")
  quoted         Message?              @relation("MessageQuote", fields: [quoted_message_id], references: [id], onDelete: SetNull)
  quoted_by      Message[]             @relation("MessageQuote")
  forwarded_from Message?              @relation("MessageForward", fields: [forwarded_from_message_id], references: [id], onDelete: SetNull)
  forwards       Message[]             @relation("MessageForward")

  versions          MessageVersion[]
  reactions         MessageReaction[]
  mentions          MessageMention[]
  attachments       MessageAttachment[]
  link_previews     MessageLinkPreview[]
  record_shares     MessageRecordShare[]
  acknowledgements  MessageAcknowledgement[]
  read_receipts     MessageReadReceipt[]
  thread_followers  MessageThreadFollower[]
  pins              ChannelPin[]
  saved_by          SavedMessage[]
  reminders         MessageReminder[]
  reports           MessageReport[]
  drafts_replying   MessageDraft[]           @relation("DraftThreadRoot")
  last_read_in      ChannelReadState[]       @relation("ReadStateLastMessage")
  unread_from_in    ChannelReadState[]       @relation("ReadStateUnreadFrom")
  calls             ChannelCall[]
  project_decisions ProjectDecision[]        @relation("ProjectDecisionSourceMessage")

  created_tickets Ticket[] @relation("TicketSourceMessage")

  @@unique([channel_id, client_message_id])
  @@unique([integration_id, external_event_id])
  @@index([search_vector], type: Gin)
  @@index([channel_id, created_at])
  @@index([channel_id, parent_message_id, created_at])
  @@index([parent_message_id])
  @@index([organization_id, author_membership_id, created_at])
  @@index([organization_id, status, scheduled_for])
  @@index([organization_id, kind])
  @@index([author_user_id])
  @@map("messages")
}

/// 12 §13 — edit history (previous bodies) when the organization preserves it.
model MessageVersion {
  id                String   @id @default(uuid())
  message_id        String
  version           Int
  body              String
  body_rich         Json?
  edited_by_user_id String?
  /// When this version was superseded.
  created_at        DateTime @default(now())

  message Message @relation(fields: [message_id], references: [id], onDelete: Cascade)

  @@unique([message_id, version])
  @@map("message_versions")
}

/// 12 §14 — emoji reactions; one per (message, emoji, reactor). Reactor is a Member or an external user.
model MessageReaction {
  id               String   @id @default(uuid())
  message_id       String
  /// Unicode emoji or custom emoji name (12 §80).
  emoji            String
  membership_id    String?
  /// External participant reactor (01 §79); id only.
  external_user_id String?
  created_at       DateTime @default(now())

  message    Message     @relation(fields: [message_id], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [membership_id], references: [id], onDelete: Cascade)

  @@unique([message_id, emoji, membership_id])
  @@unique([message_id, emoji, external_user_id])
  @@index([membership_id])
  @@map("message_reactions")
}

/// 12 §15 — mentions extracted from a message; drives notifications (14) and mention counts (12 §19).
model MessageMention {
  id                   String             @id @default(uuid())
  message_id           String
  kind                 MessageMentionKind
  membership_id        String?
  /// External participant mentioned (01 §79); id only.
  external_user_id     String?
  team_id              String?
  role_id              String?
  /// CHANNEL_LINK target (#channel).
  mentioned_channel_id String?
  /// 12 §15, §18 — the mentioned member opened / cleared the mention (Mentions inbox read state).
  read_at              DateTime?
  created_at           DateTime           @default(now())

  message           Message     @relation(fields: [message_id], references: [id], onDelete: Cascade)
  membership        Membership? @relation("MessageMentionMember", fields: [membership_id], references: [id], onDelete: Cascade)
  team              Team?       @relation(fields: [team_id], references: [id], onDelete: Cascade)
  role              Role?       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  mentioned_channel Channel?    @relation("MessageMentionChannel", fields: [mentioned_channel_id], references: [id], onDelete: Cascade)

  @@index([message_id])
  @@index([membership_id, created_at])
  @@index([membership_id, read_at])
  @@index([team_id])
  @@index([role_id])
  @@index([external_user_id])
  @@map("message_mentions")
}

/// 12 §22, §45 — link between a message and a Document (17). File bytes, versions and access
/// permissions are owned by 17; metadata is denormalized here for listing "files in channel".
/// Vault entries (17 §12) cannot be attached.
model MessageAttachment {
  id                  String                @id @default(uuid())
  message_id          String
  channel_id          String
  /// 17 Document — the stored file.
  document_id         String
  kind                MessageAttachmentKind @default(OTHER)
  file_name           String
  mime_type           String?
  size_bytes          Int?
  /// 12 §45 — voice message / audio duration.
  duration_seconds    Int?
  /// 12 §22 — preview data: { thumbnail_url, width, height, waveform[] }.
  preview             Json?
  uploaded_by_user_id String?
  sort_order          Int                   @default(0)
  created_at          DateTime              @default(now())

  message Message @relation(fields: [message_id], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channel_id], references: [id], onDelete: Cascade)

  @@unique([message_id, document_id])
  @@index([channel_id, created_at])
  @@index([channel_id, kind])
  @@index([document_id])
  @@map("message_attachments")
}

/// 12 §23 — unfurled link previews. Internal application links resolve to a record (entity_type/entity_id)
/// and are rendered with a permission check at view time.
model MessageLinkPreview {
  id          String                   @id @default(uuid())
  message_id  String
  url         String
  domain      String?
  title       String?
  description String?
  image_url   String?
  status      MessageLinkPreviewStatus @default(PENDING)
  /// Internal link target (12 §23 — projects, tasks, customers, contacts, deals, proposals, contracts, invoices, payments, tickets, documents).
  entity_type RecordEntityType?
  entity_id   String?
  fetched_at  DateTime?
  sort_order  Int                      @default(0)
  created_at  DateTime                 @default(now())

  message Message @relation(fields: [message_id], references: [id], onDelete: Cascade)

  @@unique([message_id, url])
  @@index([entity_type, entity_id])
  @@map("message_link_previews")
}

/// 12 §24, §58–60 — a business record shared into a conversation with a preview snapshot.
/// Record access is re-checked when rendered; the snapshot is only a display cache.
model MessageRecordShare {
  id                String           @id @default(uuid())
  message_id        String
  entity_type       RecordEntityType
  entity_id         String
  /// 12 §24 — { name, status, owner, summary, metadata } captured at share time.
  snapshot          Json?
  snapshot_at       DateTime?
  shared_by_user_id String?
  sort_order        Int              @default(0)
  created_at        DateTime         @default(now())

  message Message @relation(fields: [message_id], references: [id], onDelete: Cascade)

  @@unique([message_id, entity_type, entity_id])
  @@index([entity_type, entity_id])
  @@map("message_record_shares")
}

/// 12 §29 — acknowledgement of an announcement that requires it.
model MessageAcknowledgement {
  message_id      String
  membership_id   String
  acknowledged_at DateTime @default(now())

  message    Message    @relation(fields: [message_id], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membership_id], references: [id], onDelete: Cascade)

  @@id([message_id, membership_id])
  @@index([membership_id])
  @@map("message_acknowledgements")
}

// --- Read state, threads, personal items ----------------------------------------------

/// 12 §19, §43 — per-participant read position in a channel (unread state for channels, read state for DMs).
/// Participant is a Member or an external user (id only).
model ChannelReadState {
  id                    String    @id @default(uuid())
  channel_id            String
  membership_id         String?
  external_user_id      String?
  last_read_message_id  String?
  last_read_at          DateTime?
  /// 12 §19 — "mark unread" from this message onward.
  marked_unread_from_id String?
  /// Denormalized counters, recomputed on write.
  unread_count          Int       @default(0)
  mention_count         Int       @default(0)
  updated_at            DateTime  @updatedAt

  channel            Channel     @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  membership         Membership? @relation(fields: [membership_id], references: [id], onDelete: Cascade)
  last_read_message  Message?    @relation("ReadStateLastMessage", fields: [last_read_message_id], references: [id], onDelete: SetNull)
  marked_unread_from Message?    @relation("ReadStateUnreadFrom", fields: [marked_unread_from_id], references: [id], onDelete: SetNull)

  @@unique([channel_id, membership_id])
  @@unique([channel_id, external_user_id])
  @@index([membership_id, unread_count])
  @@map("channel_read_states")
}

/// 12 §43 — per-message read receipts for DMs, group conversations and (when configured) customer conversations.
model MessageReadReceipt {
  message_id    String
  /// Member id or external user id (one participant id; both kinds share the key space).
  reader_id     String
  membership_id String?
  read_at       DateTime @default(now())

  message    Message     @relation(fields: [message_id], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [membership_id], references: [id], onDelete: Cascade)

  @@id([message_id, reader_id])
  @@index([membership_id, read_at])
  @@map("message_read_receipts")
}

/// 12 §12, §88 — members following a thread (root message) without subscribing to the channel.
model MessageThreadFollower {
  root_message_id String
  membership_id   String
  /// Follow without notifications.
  muted           Boolean   @default(false)
  /// 12 §88 — mark thread read.
  last_read_at    DateTime?
  /// auto (replied/mentioned) | manual
  source          String    @default("auto")
  created_at      DateTime  @default(now())

  root_message Message    @relation(fields: [root_message_id], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membership_id], references: [id], onDelete: Cascade)

  @@id([root_message_id, membership_id])
  @@index([membership_id, created_at])
  @@map("message_thread_followers")
}

/// 12 §47 — pinned messages per channel.
model ChannelPin {
  id                      String   @id @default(uuid())
  channel_id              String
  message_id              String
  pinned_by_membership_id String?
  sort_order              Int      @default(0)
  created_at              DateTime @default(now())

  channel   Channel     @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  message   Message     @relation(fields: [message_id], references: [id], onDelete: Cascade)
  pinned_by Membership? @relation("ChannelPinner", fields: [pinned_by_membership_id], references: [id], onDelete: SetNull)

  @@unique([channel_id, message_id])
  @@index([pinned_by_membership_id])
  @@map("channel_pins")
}

/// 12 §20 — personal saved/bookmarked messages with an optional note.
model SavedMessage {
  id            String   @id @default(uuid())
  membership_id String
  message_id    String
  note          String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  membership Membership @relation(fields: [membership_id], references: [id], onDelete: Cascade)
  message    Message    @relation(fields: [message_id], references: [id], onDelete: Cascade)

  @@unique([membership_id, message_id])
  @@index([membership_id, created_at])
  @@map("saved_messages")
}

/// 12 §20–21 — "remind me" on a message; triggers a notification (14) linking back to the message.
model MessageReminder {
  id              String                @id @default(uuid())
  organization_id String
  membership_id   String
  message_id      String
  remind_at       DateTime
  /// later_today | tomorrow | next_week | custom
  preset          String?
  note            String?
  status          MessageReminderStatus @default(PENDING)
  triggered_at    DateTime?
  completed_at    DateTime?
  /// 14 Notification id emitted when triggered; id only.
  notification_id String?
  created_at      DateTime              @default(now())
  updated_at      DateTime              @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  membership   Membership   @relation(fields: [membership_id], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [message_id], references: [id], onDelete: Cascade)

  @@index([organization_id, status, remind_at])
  @@index([membership_id, status])
  @@index([message_id])
  @@map("message_reminders")
}

/// 12 §46, §74 — unsent messages, private to the author, one per channel (+ thread) per author.
model MessageDraft {
  id                      String    @id @default(uuid())
  channel_id              String
  membership_id           String
  /// Draft reply inside a thread.
  thread_root_message_id  String?
  body                    String
  body_rich               Json?
  /// 17 Document ids already uploaded for this draft.
  attachment_document_ids String[]  @default([])
  /// Draft of a scheduled message (12 §11).
  scheduled_for           DateTime?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  channel     Channel    @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  membership  Membership @relation(fields: [membership_id], references: [id], onDelete: Cascade)
  thread_root Message?   @relation("DraftThreadRoot", fields: [thread_root_message_id], references: [id], onDelete: Cascade)

  @@unique([channel_id, membership_id, thread_root_message_id])
  @@index([membership_id, updated_at])
  @@map("message_drafts")
}

/// 12 §32, §79 — keyword subscriptions; matches in authorized conversations notify the member (14).
model MessagingKeyword {
  id               String    @id @default(uuid())
  organization_id  String
  membership_id    String
  keyword          String
  match_whole_word Boolean   @default(true)
  case_sensitive   Boolean   @default(false)
  /// 12 §32 — temporarily disabled.
  is_enabled       Boolean   @default(true)
  disabled_until   DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  membership   Membership   @relation(fields: [membership_id], references: [id], onDelete: Cascade)

  @@unique([membership_id, keyword])
  @@index([organization_id, is_enabled])
  @@map("messaging_keywords")
}

/// 12 §33, §72 — a member's custom sidebar sections (My Projects, Sales, …). Built-in groups
/// (favorites, DMs, channels, projects, customers, archived, unread) are computed, not stored.
model ChannelSection {
  id              String   @id @default(uuid())
  organization_id String
  membership_id   String
  name            String
  icon            String?
  sort_order      Int      @default(0)
  is_collapsed    Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Organization         @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  membership   Membership           @relation(fields: [membership_id], references: [id], onDelete: Cascade)
  items        ChannelSectionItem[]

  @@unique([membership_id, name])
  @@index([membership_id, sort_order])
  @@map("channel_sections")
}

/// 12 §33 — a channel placed in a member's custom section.
model ChannelSectionItem {
  section_id String
  channel_id String
  sort_order Int      @default(0)
  created_at DateTime @default(now())

  section ChannelSection @relation(fields: [section_id], references: [id], onDelete: Cascade)
  channel Channel        @relation(fields: [channel_id], references: [id], onDelete: Cascade)

  @@id([section_id, channel_id])
  @@index([channel_id])
  @@map("channel_section_items")
}

// --- Presence & member settings ---------------------------------------------------------

/// 12 §4, §41 — presence and custom status, one row per Member. Visibility follows organization
/// privacy settings (messaging_settings.presence_visibility) and the member's own override.
model MessagingPresence {
  membership_id      String                  @id
  organization_id    String
  state              MessagingPresenceState  @default(OFFLINE)
  /// Manually chosen state (Away / Do Not Disturb) that overrides automatic detection until cleared.
  manual_state       MessagingPresenceState?
  manual_state_until DateTime?
  /// 12 §4 — custom status.
  status_text        String?
  status_emoji       String?
  status_starts_at   DateTime?
  status_ends_at     DateTime?
  /// 12 §4 — automatic expiration of the custom status.
  status_expires_at  DateTime?
  last_seen_at       DateTime?
  /// Number of live connections (websocket sessions) currently open.
  active_connections Int                     @default(0)
  /// 12 §53 — member hides presence from others.
  presence_hidden    Boolean                 @default(false)
  updated_at         DateTime                @updatedAt

  membership   Membership   @relation(fields: [membership_id], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id, state])
  @@map("messaging_presence")
}

/// 12 §17, §43, §53, §73, §87 — messaging-specific per-member defaults. Global notification
/// preferences, DND and digests are 14 §6 (NotificationPreference); only messaging-local settings live here.
model MessagingMemberSettings {
  membership_id                   String                    @id
  /// 12 §17 — default level applied to channels the member joins.
  default_channel_level           ChannelNotificationLevel?
  default_dm_level                ChannelNotificationLevel?
  /// 12 §87 — include message text in notification previews.
  notification_previews_with_text Boolean                   @default(true)
  notification_sound              String?
  /// 12 §43, §53 — send read receipts to others.
  share_read_receipts             Boolean                   @default(true)
  /// 12 §41 — show typing indicator to others.
  share_typing_indicator          Boolean                   @default(true)
  /// 12 §73 — keyboard shortcut overrides { action: keys }.
  keyboard_shortcuts              Json?
  /// 12 §72 — sidebar layout preferences (collapsed built-in groups, sort mode, theme density).
  sidebar_preferences             Json?
  /// 12 §11 — send on Enter vs Cmd+Enter, markdown mode, emoji skin tone.
  composer_preferences            Json?
  updated_at                      DateTime                  @updatedAt

  membership Membership @relation(fields: [membership_id], references: [id], onDelete: Cascade)

  @@map("messaging_member_settings")
}

// --- Moderation ----------------------------------------------------------------------

/// 12 §49–50, §64, §69 — a message reported by a participant or flagged by spam detection.
model MessageReport {
  id                     String              @id @default(uuid())
  organization_id        String
  message_id             String
  reporter_membership_id String?
  /// External participant reporter; id only.
  reporter_user_id       String?
  /// spam | abuse | sensitive_data | off_topic | other | automated
  reason                 String
  details                String?
  status                 MessageReportStatus @default(OPEN)
  reviewed_by_user_id    String?
  reviewed_at            DateTime?
  /// none | message_deleted | member_muted | member_banned | member_removed | warning
  action_taken           String?
  resolution_note        String?
  created_at             DateTime            @default(now())
  updated_at             DateTime            @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [message_id], references: [id], onDelete: Cascade)
  reporter     Membership?  @relation("MessageReportReporter", fields: [reporter_membership_id], references: [id], onDelete: SetNull)

  @@index([organization_id, status, created_at])
  @@index([message_id])
  @@index([reporter_membership_id])
  @@map("message_reports")
}

// --- Retention & export ----------------------------------------------------------------

/// 12 §55, §106 — administrator export of messaging data; the produced file is a Document (17).
model MessagingExportJob {
  id                         String                @id @default(uuid())
  organization_id            String
  requested_by_membership_id String?
  status                     MessagingExportStatus @default(PENDING)
  format                     MessagingExportFormat @default(JSON)
  /// 12 §55 — scope: { branch_id, team_id, channel_ids[], channel_kinds[], membership_id, date_from, date_to, include_attachments_metadata, include_reactions, include_threads }.
  filters                    Json
  started_at                 DateTime?
  completed_at               DateTime?
  /// 17 Document holding the export archive; id only.
  result_document_id         String?
  /// Download link expiry.
  expires_at                 DateTime?
  message_count              Int?
  channel_count              Int?
  error                      String?
  created_at                 DateTime              @default(now())
  updated_at                 DateTime              @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  requested_by Membership?  @relation("MessagingExportRequester", fields: [requested_by_membership_id], references: [id], onDelete: SetNull)

  @@index([organization_id, status, created_at])
  @@index([requested_by_membership_id])
  @@map("messaging_export_jobs")
}

// --- Integrations, bots & webhooks -----------------------------------------------------

/// 12 §37–38, §50, §61, §92 — an integration or bot allowed to post into channels. Inbound webhook
/// integrations authenticate with a hashed token; provider integrations hold their config. Internal
/// module events (finance, CRM, projects …) arrive through 20 Automation "post message" actions.
model MessagingIntegration {
  id                    String                     @id @default(uuid())
  organization_id       String
  kind                  MessagingIntegrationKind
  status                MessagingIntegrationStatus @default(ACTIVE)
  name                  String
  description           String?
  /// Bot identity shown on messages (12 §38 — clearly marked as external source).
  bot_display_name      String?
  bot_avatar_url        String?
  /// Default target channel; integrations may also target channels per event.
  default_channel_id    String?
  /// Channel ids this integration may post to; empty = default channel only.
  allowed_channel_ids   String[]                   @default([])
  /// Inbound webhook token hash (never plain text); provider credentials are stored in config encrypted.
  inbound_token_hash    String?
  /// Provider configuration: repositories, projects, event filters, mapping rules.
  config                Json?
  /// 12 §92 — subscribed event keys (github.pull_request.opened, finance.invoice.paid …).
  subscribed_events     String[]                   @default([])
  /// 12 §69 — integration rate limit (events per minute); null = organization default.
  rate_limit_per_minute Int?
  /// 20 OutboundWebhook / AutomationRule backing this integration when managed by the Automation Engine; id only.
  automation_rule_id    String?
  created_by_user_id    String?
  last_event_at         DateTime?
  last_error            String?
  last_error_at         DateTime?
  disconnected_at       DateTime?
  created_at            DateTime                   @default(now())
  updated_at            DateTime                   @updatedAt

  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  default_channel Channel?     @relation("IntegrationDefaultChannel", fields: [default_channel_id], references: [id], onDelete: SetNull)
  messages        Message[]

  @@unique([organization_id, name])
  @@index([organization_id, kind, status])
  @@index([default_channel_id])
  @@map("messaging_integrations")
}

// --- Calls -------------------------------------------------------------------------

/// 12 §5, §44 — voice/video calls and huddles started from a conversation. Media is provided by an
/// external provider or 19 Calendar meeting links; messaging keeps history and participants.
model ChannelCall {
  id                       String            @id @default(uuid())
  organization_id          String
  channel_id               String
  kind                     ChannelCallKind   @default(VOICE)
  status                   ChannelCallStatus @default(RINGING)
  started_by_membership_id String?
  title                    String?
  /// Provider: internal | google_meet | zoom | teams | custom.
  provider                 String?
  meeting_url              String?
  external_ref             String?
  /// 19 CalendarEvent when scheduled as a meeting; id only.
  calendar_event_id        String?
  /// System message announcing the call (12 §91).
  message_id               String?
  screen_sharing_used      Boolean           @default(false)
  started_at               DateTime          @default(now())
  ended_at                 DateTime?
  duration_seconds         Int?
  /// 17 Document holding the recording, if any; id only.
  recording_document_id    String?
  participant_count        Int               @default(0)
  created_at               DateTime          @default(now())
  updated_at               DateTime          @updatedAt

  organization Organization             @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  channel      Channel                  @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  started_by   Membership?              @relation("ChannelCallStarter", fields: [started_by_membership_id], references: [id], onDelete: SetNull)
  message      Message?                 @relation(fields: [message_id], references: [id], onDelete: SetNull)
  participants ChannelCallParticipant[]

  @@index([organization_id, status])
  @@index([channel_id, started_at])
  @@index([started_by_membership_id])
  @@map("channel_calls")
}

/// 12 §44 — call participants (Members or external users).
model ChannelCallParticipant {
  id               String    @id @default(uuid())
  call_id          String
  membership_id    String?
  /// External participant (01 §79); id only.
  external_user_id String?
  invited_at       DateTime  @default(now())
  joined_at        DateTime?
  left_at          DateTime?
  /// invited | joined | declined | missed | left
  state            String    @default("invited")

  call       ChannelCall @relation(fields: [call_id], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [membership_id], references: [id], onDelete: Cascade)

  @@unique([call_id, membership_id])
  @@unique([call_id, external_user_id])
  @@index([membership_id, joined_at])
  @@map("channel_call_participants")
}

// --- Analytics -----------------------------------------------------------------------

/// 12 §66, §104 — daily usage aggregates per organization (channel_id null) and per channel.
/// Usage-oriented, never per-employee productivity scoring.
model MessagingUsageDaily {
  id                      String   @id @default(uuid())
  organization_id         String
  channel_id              String?
  date                    DateTime @db.Date
  messages_count          Int      @default(0)
  direct_messages_count   Int      @default(0)
  threads_count           Int      @default(0)
  thread_replies_count    Int      @default(0)
  reactions_count         Int      @default(0)
  files_count             Int      @default(0)
  files_bytes             BigInt   @default(0)
  active_members_count    Int      @default(0)
  active_channels_count   Int      @default(0)
  external_messages_count Int      @default(0)
  mentions_count          Int      @default(0)
  /// 12 §66 — average time to first reply in seconds, where appropriate.
  avg_response_seconds    Int?
  /// 12 §66 — total unread volume snapshot at end of day.
  unread_snapshot         Int?
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  channel      Channel?     @relation(fields: [channel_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, channel_id, date])
  @@index([organization_id, date])
  @@map("messaging_usage_daily")
}

/// 12 §27, §82 — invitation lifecycle.
enum ChannelInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

/// 12 §27, §82, §109 Journey 4 — secure invitation of a guest / external person to a channel. The accepted person becomes a ChannelMember
/// (external_user_id); only the hash of the token is stored.
model ChannelInvitation {
  id                 String                  @id @default(uuid())
  organization_id    String
  channel_id         String
  email              String
  name               String?
  role               ChannelMemberRole       @default(GUEST)
  guest_kind         ChannelGuestKind?
  /// 12 §83 — identity marker shown next to the guest ("ACME Corp · Guest").
  external_label     String?
  /// Access of the resulting ChannelMember expires at this time.
  access_expires_at  DateTime?
  token_hash         String                  @unique
  status             ChannelInvitationStatus @default(PENDING)
  invited_by_user_id String?
  /// Invitation link validity.
  expires_at         DateTime
  accepted_at        DateTime?
  /// User created / matched on acceptance; id only.
  external_user_id   String?
  revoked_at         DateTime?
  last_sent_at       DateTime?
  created_at         DateTime                @default(now())
  updated_at         DateTime                @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  channel      Channel      @relation(fields: [channel_id], references: [id], onDelete: Cascade)

  @@index([channel_id, status])
  @@index([organization_id, status])
  @@index([email])
  @@index([expires_at])
  @@map("channel_invitations")
}

/// 12 §9, §34, §49 — what a member asks for.
enum ChannelAccessRequestKind {
  JOIN
  POST
}

/// 12 §9, §34, §49 — decision state.
enum ChannelAccessRequestStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

/// 12 §9, §34, §49 — request to join a private / hidden channel or to post in a restricted channel (posting_policy). Decided by channel
/// admins / messaging.channel_members.manage.
model ChannelAccessRequest {
  id                 String                     @id @default(uuid())
  organization_id    String
  channel_id         String
  membership_id      String
  kind               ChannelAccessRequestKind   @default(JOIN)
  note               String?
  status             ChannelAccessRequestStatus @default(PENDING)
  decided_by_user_id String?
  decided_at         DateTime?
  decision_note      String?
  created_at         DateTime                   @default(now())
  updated_at         DateTime                   @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  channel      Channel      @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  membership   Membership   @relation("ChannelAccessRequestMember", fields: [membership_id], references: [id], onDelete: Cascade)

  @@index([channel_id, status])
  @@index([membership_id, status])
  @@index([organization_id, status])
  @@map("channel_access_requests")
}

/// 12 §54, §106 — legal hold: retention (MessagingRetentionPolicy) and deletion jobs skip held content while active (released_at null).
/// Scope = the listed channels and / or members, optionally limited to a date range.
model MessagingLegalHold {
  id                  String    @id @default(uuid())
  organization_id     String
  name                String
  reason              String
  channel_ids         String[]  @default([])
  membership_ids      String[]  @default([])
  date_from           DateTime? @db.Date
  date_to             DateTime? @db.Date
  created_by_user_id  String?
  released_at         DateTime?
  released_by_user_id String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id, released_at])
  @@map("messaging_legal_holds")
}

// =====================================================================
// 13 Customer Support & Communication Hub — docs/features/13-customer-support-communication-hub.md (LOG-342)
// Owns: support inboxes and channels (live chat, email, widget, portal, forms), support Conversations and
// their messages, Tickets (statuses, categories, relations, followers, attachments), SLA policies/timers,
// ticket status history, ticket↔task links, CSAT, canned responses, the customer-facing knowledge base,
// AI agent sessions/suggestions and support incidents. Every portal request (07) is a Ticket here.
// Does not own: Tasks (06), Projects/Change Requests (05), CRM companies/contacts and the Customer 360
// timeline (02, derived from audit_events + these tables), internal chat (12), outbound email/SMS (11),
// notifications (14), documents (17), time on tickets (18), the automation rules engine and scheduled
// jobs (20 — referenced by plain ids), internal knowledge (15). Tags, custom fields, saved views → 02.
// =====================================================================

/// 13 §1, §5 — channel through which a customer conversation arrives.
enum SupportChannelType {
  LIVE_CHAT
  EMAIL
  WIDGET
  PORTAL
  FORM
  API
  PHONE
}

/// 13 §1 — conversation status (Open, Pending, Snoozed, Resolved).
enum SupportConversationStatus {
  OPEN
  PENDING
  SNOOZED
  RESOLVED
}

/// 13 §1, §2 — who wrote a message: customer, agent (public reply), private internal note, the AI agent, or system.
enum SupportMessageKind {
  CUSTOMER
  AGENT
  INTERNAL_NOTE
  AI_AGENT
  SYSTEM
}

/// 13 §1, §10 — outbound delivery state of an agent reply sent through 11 (email) or the widget.
enum SupportMessageDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

/// 13 §1 — role of an internal participant on a conversation.
enum SupportParticipantRole {
  ASSIGNEE
  COLLABORATOR
  MENTIONED
}

/// 13 §2 — priority levels (Low, Normal, High, Urgent). Also used for conversation prioritization (§1).
enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// 13 §2, §13 — semantic category of a configurable ticket status.
enum TicketStatusCategory {
  NEW
  OPEN
  PENDING_CUSTOMER
  ON_HOLD
  RESOLVED
  CLOSED
}

/// 13 §3, §5 — request/issue type (portal request types + AI issue types).
enum TicketType {
  QUESTION
  BUG
  FEATURE_REQUEST
  CHANGE_REQUEST
  BILLING
  ACCOUNT
  INCIDENT
  OTHER
}

/// 13 §2 — where the ticket was created from.
enum TicketSource {
  CONVERSATION
  EMAIL
  LIVE_CHAT
  WIDGET
  PORTAL
  FORM
  AI_AGENT
  MANUAL
  API
  CHANNEL_MESSAGE
}

/// 13 §2, §3 — relationships between tickets (related, duplicate, blocks, same incident).
enum TicketRelationType {
  RELATED
  DUPLICATE_OF
  BLOCKS
  SAME_INCIDENT
}

/// 13 §4 — how a ticket is tied to a Task (06): converted (task created from the ticket) or linked to an existing task.
enum TicketTaskLinkKind {
  CONVERTED
  LINKED
}

/// 13 §2 — SLA metrics tracked per ticket.
enum SlaMetric {
  FIRST_RESPONSE
  NEXT_RESPONSE
  RESOLUTION
}

/// 13 §2, §7 — lifecycle of one SLA timer.
enum SlaTimerStatus {
  RUNNING
  PAUSED
  MET
  BREACHED
  CANCELLED
}

/// 13 §3 — detected customer sentiment.
enum SupportSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
  FRUSTRATED
}

/// 13 §6 — article lifecycle.
enum KnowledgeArticleStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

/// 13 §6 — public (help center, no login), customers (portal users only), internal (agents only).
enum KnowledgeVisibility {
  PUBLIC
  CUSTOMERS
  INTERNAL
}

/// 13 §1 — who may use a canned response.
enum SupportCannedResponseScope {
  PERSONAL
  TEAM
  ORGANIZATION
}

/// 13 §3 — AI agent session lifecycle (automated first-line support with human handover).
enum SupportAiSessionStatus {
  ACTIVE
  RESOLVED_BY_AI
  HANDED_OVER
  ABANDONED
  FAILED
}

/// 13 §3 — kinds of AI output that wait for (or bypass) human approval.
enum SupportAiSuggestionKind {
  CLASSIFICATION
  PRIORITY
  ASSIGNMENT
  REPLY
  REWRITE
  SUMMARY
  TRANSLATION
  ARTICLE_RECOMMENDATION
  FOLLOW_UP_QUESTION
  TROUBLESHOOTING
  ACTION_ITEMS
  DUPLICATE_TICKET
  TASK_CREATION
  KNOWLEDGE_GAP
  ARTICLE_DRAFT
  INCIDENT_GROUPING
  FEEDBACK_EXTRACTION
}

/// 13 §3 — approval state of an AI suggestion.
enum SupportAiSuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
  AUTO_APPLIED
  EXPIRED
}

/// 13 §3, §9 — grouped incident / recurring problem status.
enum SupportIncidentStatus {
  DETECTED
  CONFIRMED
  RESOLVED
  DISMISSED
}

/// 13 §5 — customer impact of an incident (status page style).
enum SupportIncidentSeverity {
  MINOR
  MAJOR
  CRITICAL
}

/// 13 §5 — stage of a public status update on an incident.
enum SupportIncidentUpdateStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

/// 13 §2 — how new conversations / tickets in an inbox are assigned; automation rules (20) may override.
enum SupportRoutingStrategy {
  MANUAL
  ROUND_ROBIN
  LOAD_BALANCED
  SKILL_BASED
}

/// 13 §2 — agent presence used by routing.
enum SupportAgentAvailability {
  ONLINE
  AWAY
  OFFLINE
}

/// 13 §9 — CSAT survey scale: 1–5 stars or thumbs (stored as 1 = down, 5 = up).
enum SupportCsatScale {
  STARS_5
  THUMBS
}

// --- Settings ----------------------------------------------------------------------

/// 13 §2, §3, §7 — per-organization support configuration: ticket numbering, auto-close / inactivity
/// periods, CSAT, AI thresholds and approval requirements. Rules themselves live in 20.
model SupportSettings {
  organization_id            String           @id
  /// Prefix for ticket references (e.g. "SUP"); the counter is number_sequences (03) with key "ticket".
  ticket_prefix              String           @default("SUP")
  default_sla_policy_id      String?
  default_inbox_id           String?
  /// 13 §7 — auto-close resolved tickets after N days (null = never); registered as a scheduled job (20).
  auto_close_after_days      Int?
  /// 13 §7 — flag a ticket as inactive after N hours without a reply (null = off).
  inactivity_after_hours     Int?
  /// 13 §7 — customer may reopen a resolved ticket within N days (null = always).
  reopen_window_days         Int?
  /// 13 §9 — request a CSAT rating when a ticket is resolved.
  csat_enabled               Boolean          @default(true)
  csat_delay_minutes         Int              @default(0)
  /// 13 §9 — survey definition: scale, question text, thank-you text; ratings at or below the threshold open a follow-up.
  csat_scale                 SupportCsatScale @default(STARS_5)
  csat_question              String?
  csat_thank_you             String?
  csat_follow_up_threshold   Int?
  /// 13 §3 — AI agent enabled for customer-facing channels.
  ai_agent_enabled           Boolean          @default(false)
  /// 13 §3 — AI model through the shared AI layer (Product_Specification §6); JEV by default.
  ai_model                   String           @default("jev")
  /// 13 §3 — minimum confidence (0–1) to auto-apply classification / assignment / task creation.
  ai_auto_classify_threshold Decimal?         @db.Decimal(5, 4)
  ai_auto_assign_threshold   Decimal?         @db.Decimal(5, 4)
  ai_auto_task_threshold     Decimal?         @db.Decimal(5, 4)
  /// 13 §3, §4 — require human approval before AI creates tasks / sends replies.
  ai_require_task_approval   Boolean          @default(true)
  ai_require_reply_approval  Boolean          @default(true)
  /// 13 §3 — AI agent hands over to a human after N unresolved turns or on these intents.
  ai_handover_after_turns    Int?
  ai_escalation_intents      String[]         @default([])
  /// 13 §4 — default project / task type used when converting tickets (06 TaskType id).
  default_task_type_id       String?
  /// 13 §4 — ticket priority → task priority mapping, e.g. { URGENT: "URGENT", HIGH: "HIGH" }.
  task_priority_mapping      Json?
  /// 13 §4 — task status category → ticket status slug mapping for bidirectional sync.
  task_status_sync_mapping   Json?
  /// 13 §1 — default agent signature (markdown).
  default_signature          String?
  updated_at                 DateTime         @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@map("support_settings")
}

// --- Inboxes & channels ------------------------------------------------------------

/// 13 §1 — team / shared inbox. Conversations and tickets are routed into an inbox; an inbox can
/// belong to a Team (01 §42) and to a Branch for branch-level support (01 §38).
model SupportInbox {
  id                             String                 @id @default(uuid())
  organization_id                String
  team_id                        String?
  branch_id                      String?
  name                           String
  slug                           String
  description                    String?
  color                          String?
  is_default                     Boolean                @default(false)
  /// 13 §2 — default assignee for new conversations/tickets in this inbox.
  default_assignee_membership_id String?
  default_sla_policy_id          String?
  /// 13 §2 — routing strategy; LOAD_BALANCED / SKILL_BASED use SupportAgentProfile; automation rules (20) may override.
  routing_strategy               SupportRoutingStrategy @default(MANUAL)
  /// 13 §1 — shared signature appended to agent replies (markdown).
  signature                      String?
  /// 13 §7 — automatic reply sent on first customer message (markdown); null = none.
  auto_reply_body                String?
  archived_at                    DateTime?
  created_at                     DateTime               @default(now())
  updated_at                     DateTime               @updatedAt

  organization     Organization          @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  team             Team?                 @relation(fields: [team_id], references: [id], onDelete: SetNull)
  branch           Branch?               @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  default_assignee Membership?           @relation("SupportInboxDefaultAssignee", fields: [default_assignee_membership_id], references: [id], onDelete: SetNull)
  channels         SupportChannel[]
  conversations    SupportConversation[]
  tickets          Ticket[]

  @@unique([organization_id, slug])
  @@index([organization_id])
  @@index([team_id])
  @@map("support_inboxes")
}

/// 13 §1, §5 — a connected channel feeding an inbox: inbound email address, website/in-app widget,
/// live chat, portal request form, API. Widget appearance lives in `config`; the portal-wide toggle is
/// CustomerPortalSettings.widget_settings (07).
model SupportChannel {
  id                 String             @id @default(uuid())
  organization_id    String
  inbox_id           String
  type               SupportChannelType
  name               String
  /// EMAIL: the inbound address (support@…); unique per organization.
  email_address      String?
  /// 11 SenderIdentity used for outbound replies from this channel; id only.
  sender_identity_id String?
  /// WIDGET / LIVE_CHAT: public embed key.
  widget_key         String?            @unique
  /// Allowed origins for the widget / API.
  allowed_origins    String[]           @default([])
  /// Type-specific configuration (widget colours, welcome text, office hours, form fields, forwarding).
  config             Json?
  /// 13 §3 — AI agent answers first on this channel before a human.
  ai_agent_enabled   Boolean            @default(false)
  is_active          Boolean            @default(true)
  /// 13 §9 — request CSAT for tickets / conversations coming through this channel.
  csat_enabled       Boolean            @default(true)
  verified_at        DateTime?
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt

  organization  Organization          @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  inbox         SupportInbox          @relation(fields: [inbox_id], references: [id], onDelete: Cascade)
  conversations SupportConversation[]

  @@unique([organization_id, email_address])
  @@index([inbox_id])
  @@index([organization_id, type])
  @@map("support_channels")
}

// --- Conversations -----------------------------------------------------------------

/// 13 §1, §14 — the communication thread between a customer and the team (chat, email, widget, portal).
/// Identity resolves to a CRM Contact/Company (02) and/or a Customer Portal User (01 §79); anonymous
/// widget visitors keep `visitor_key` + captured name/email until matched. Tags → taggings (02 §36).
model SupportConversation {
  id                          String                    @id @default(uuid())
  organization_id             String
  inbox_id                    String?
  channel_id                  String?
  channel_type                SupportChannelType
  status                      SupportConversationStatus @default(OPEN)
  priority                    TicketPriority            @default(NORMAL)
  subject                     String?
  // 13 §1, §8 — customer identity (shared with CRM).
  contact_id                  String?
  company_id                  String?
  /// Customer Portal User (01 §79) when started from the portal/authenticated widget.
  customer_user_id            String?
  /// Anonymous widget visitor key (cookie) before identification.
  visitor_key                 String?
  customer_name               String?
  customer_email              String?
  // 13 §1 — ownership and team.
  assignee_membership_id      String?
  team_id                     String?
  /// 13 §1 — snoozed until; status returns to OPEN when it passes (scheduled job, 20).
  snoozed_until               DateTime?
  /// 13 §1 — merging: this conversation was merged into another (status RESOLVED).
  merged_into_conversation_id String?
  /// 13 §1 — splitting: this conversation was split out of another.
  split_from_conversation_id  String?
  /// EMAIL: thread key (Message-ID / References) used to attach inbound replies.
  email_thread_key            String?
  /// 13 §3 — detected language (BCP 47) and sentiment.
  language                    String?
  sentiment                   SupportSentiment?
  sentiment_score             Decimal?                  @db.Decimal(5, 4)
  /// 13 §3 — AI-generated summary (refreshed on transfer / resolution).
  ai_summary                  String?
  ai_summary_at               DateTime?
  // 13 §1, §9 — timestamps for metrics and read receipts.
  message_count               Int                       @default(0)
  first_customer_message_at   DateTime?
  first_agent_response_at     DateTime?
  last_message_at             DateTime?
  last_customer_message_at    DateTime?
  last_agent_message_at       DateTime?
  /// 13 §1 — read receipts (customer side); agent side is per participant.
  customer_last_read_at       DateTime?
  resolved_at                 DateTime?
  resolved_by_membership_id   String?
  reopened_at                 DateTime?
  created_by_membership_id    String?
  created_at                  DateTime                  @default(now())
  updated_at                  DateTime                  @updatedAt

  organization Organization          @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  inbox        SupportInbox?         @relation(fields: [inbox_id], references: [id], onDelete: SetNull)
  channel      SupportChannel?       @relation(fields: [channel_id], references: [id], onDelete: SetNull)
  contact      CrmContact?           @relation(fields: [contact_id], references: [id], onDelete: SetNull)
  company      CrmCompany?           @relation(fields: [company_id], references: [id], onDelete: SetNull)
  customer     User?                 @relation("SupportConversationCustomer", fields: [customer_user_id], references: [id], onDelete: SetNull)
  assignee     Membership?           @relation("SupportConversationAssignee", fields: [assignee_membership_id], references: [id], onDelete: SetNull)
  team         Team?                 @relation(fields: [team_id], references: [id], onDelete: SetNull)
  merged_into  SupportConversation?  @relation("SupportConversationMerge", fields: [merged_into_conversation_id], references: [id], onDelete: SetNull)
  merged_from  SupportConversation[] @relation("SupportConversationMerge")
  split_from   SupportConversation?  @relation("SupportConversationSplit", fields: [split_from_conversation_id], references: [id], onDelete: SetNull)
  split_into   SupportConversation[] @relation("SupportConversationSplit")

  messages        SupportMessage[]
  participants    SupportConversationParticipant[]
  primary_tickets Ticket[]                         @relation("TicketPrimaryConversation")
  ticket_links    TicketConversation[]
  ai_sessions     SupportAiSession[]
  ai_suggestions  SupportAiSuggestion[]
  csat_ratings    SupportCsatRating[]

  @@index([organization_id, status, last_message_at])
  @@index([inbox_id, status])
  @@index([assignee_membership_id, status])
  @@index([contact_id])
  @@index([company_id])
  @@index([customer_user_id])
  @@index([organization_id, email_thread_key])
  @@index([organization_id, visitor_key])
  @@map("support_conversations")
}

/// 13 §1 — internal members collaborating on a conversation (assignee, collaborators, @mentioned);
/// `last_read_at` drives agent-side read receipts and unread counts.
model SupportConversationParticipant {
  conversation_id String
  membership_id   String
  role            SupportParticipantRole @default(COLLABORATOR)
  last_read_at    DateTime?
  joined_at       DateTime               @default(now())

  conversation SupportConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  membership   Membership          @relation("SupportConversationParticipant", fields: [membership_id], references: [id], onDelete: Cascade)

  @@id([conversation_id, membership_id])
  @@index([membership_id])
  @@map("support_conversation_participants")
}

/// 13 §1, §2, §3 — one message in a conversation: customer message, agent reply, private internal note,
/// AI agent answer or system event. Outbound email replies go through 11 (`comm_message_id`).
model SupportMessage {
  id                     String                        @id @default(uuid())
  conversation_id        String
  /// 13 §1 — denormalized tenant id for direct filtering (also reachable via conversation).
  organization_id        String
  kind                   SupportMessageKind
  /// Channel the message came in / went out on (a conversation may mix email and chat).
  channel_type           SupportChannelType?
  author_membership_id   String?
  /// Customer Portal User (01 §79) when written from the portal/widget.
  author_user_id         String?
  /// Captured sender identity for inbound email / anonymous widget messages.
  author_name            String?
  author_email           String?
  /// Markdown body; `body_html` keeps the sanitized original for email.
  body                   String
  body_html              String?
  /// 13 §1 — @mentions (membership ids) in internal notes.
  mentions               String[]                      @default([])
  /// 13 §1 — canned response used to compose this reply.
  canned_response_id     String?
  /// 13 §3 — AI suggestion this reply was generated from (accepted / rewritten).
  ai_suggestion_id       String?
  /// 13 §3 — detected language and stored translations { "en": "...", "el": "..." }.
  language               String?
  translations           Json?
  // 13 §1, §10 — outbound delivery (email via 11 CommMessage; id only) and inbound email identifiers.
  comm_message_id        String?
  external_message_id    String?
  in_reply_to_message_id String?
  delivery_status        SupportMessageDeliveryStatus?
  delivered_at           DateTime?
  delivery_error         String?
  /// 13 §1 — read receipt for the customer (public messages only).
  read_by_customer_at    DateTime?
  /// 13 §9 — marks the first agent/AI public reply (first response time).
  is_first_response      Boolean                       @default(false)
  edited_at              DateTime?
  deleted_at             DateTime?
  created_at             DateTime                      @default(now())
  updated_at             DateTime                      @updatedAt
  /// 13 §1 — Postgres full-text search vector over body; maintained by a database trigger (see migration). Not set by the API.
  search_vector          Unsupported("tsvector")?

  conversation    SupportConversation        @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  author          Membership?                @relation("SupportMessageAuthor", fields: [author_membership_id], references: [id], onDelete: SetNull)
  author_user     User?                      @relation("SupportMessageAuthorUser", fields: [author_user_id], references: [id], onDelete: SetNull)
  canned_response SupportCannedResponse?     @relation(fields: [canned_response_id], references: [id], onDelete: SetNull)
  ai_suggestion   SupportAiSuggestion?       @relation("SupportMessageFromSuggestion", fields: [ai_suggestion_id], references: [id], onDelete: SetNull)
  attachments     SupportMessageAttachment[]
  organization    Organization               @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([conversation_id, created_at])
  @@index([search_vector], type: Gin)
  @@index([organization_id, created_at])
  @@index([author_membership_id])
  @@index([external_message_id])
  @@map("support_messages")
}

/// 13 §1 — file and image attachments on a message are Documents (17 §2).
model SupportMessageAttachment {
  id          String   @id @default(uuid())
  message_id  String
  /// 17 Document.
  document_id String
  /// Denormalized for inbox previews.
  file_name   String?
  mime_type   String?
  size_bytes  Int?
  created_at  DateTime @default(now())

  message SupportMessage @relation(fields: [message_id], references: [id], onDelete: Cascade)

  @@unique([message_id, document_id])
  @@map("support_message_attachments")
}

// --- Ticket configuration ----------------------------------------------------------

/// 13 §2, §13 — configurable ticket statuses with workflow transitions (organization-wide).
model TicketStatus {
  id                  String               @id @default(uuid())
  organization_id     String
  name                String
  slug                String
  category            TicketStatusCategory
  color               String?
  sort_order          Int                  @default(0)
  is_default          Boolean              @default(false)
  /// Slugs this status may transition to; empty = any.
  allowed_transitions String[]             @default([])
  /// 13 §2 — SLA timers pause while a ticket is in this status (e.g. waiting on customer).
  pauses_sla          Boolean              @default(false)
  /// 13 §5 — label shown to customers in the portal (defaults to name).
  customer_label      String?
  archived_at         DateTime?
  created_at          DateTime             @default(now())

  organization Organization          @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  tickets      Ticket[]
  history_from TicketStatusHistory[] @relation("TicketStatusHistoryFrom")
  history_to   TicketStatusHistory[] @relation("TicketStatusHistoryTo")

  @@unique([organization_id, slug])
  @@index([organization_id, category])
  @@map("ticket_statuses")
}

/// 13 §2, §3 — custom ticket categories (hierarchical) with routing defaults used by AI
/// categorization and automation rules (20).
model TicketCategory {
  id                    String          @id @default(uuid())
  organization_id       String
  parent_category_id    String?
  name                  String
  slug                  String
  description           String?
  color                 String?
  icon                  String?
  /// Routing defaults applied when the category is set (manually or by AI).
  default_team_id       String?
  default_inbox_id      String?
  default_priority      TicketPriority?
  default_sla_policy_id String?
  /// 13 §4 — default project for tasks converted from tickets in this category (05 Project id).
  default_project_id    String?
  /// 13 §3 — keywords/examples that help the AI classifier.
  ai_hints              String[]        @default([])
  sort_order            Int             @default(0)
  archived_at           DateTime?
  created_at            DateTime        @default(now())
  updated_at            DateTime        @updatedAt

  organization Organization     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  parent       TicketCategory?  @relation("TicketCategoryHierarchy", fields: [parent_category_id], references: [id], onDelete: SetNull)
  children     TicketCategory[] @relation("TicketCategoryHierarchy")
  tickets      Ticket[]

  @@unique([organization_id, slug])
  @@index([parent_category_id])
  @@map("ticket_categories")
}

// --- SLA ---------------------------------------------------------------------------

/// 13 §2, §7 — SLA policy: response/resolution targets per priority, business-hours handling and
/// escalation. Timers and auto-escalation are executed by 20 scheduled jobs / rules.
model SlaPolicy {
  id                        String    @id @default(uuid())
  organization_id           String
  name                      String
  description               String?
  is_default                Boolean   @default(false)
  /// Count only business hours (Organization/Branch business_hours, 01 §14, §120) instead of calendar hours.
  use_business_hours        Boolean   @default(true)
  /// 19 Calendar id used for holidays when business hours apply; id only.
  calendar_id               String?
  /// Match conditions: { categories: [], channel_types: [], company_ids: [], ticket_types: [], tags: [] }; empty = any.
  conditions                Json?
  /// 13 §7 — percentage of target elapsed at which an "SLA at risk" event is emitted.
  at_risk_threshold_percent Decimal   @default(80) @db.Decimal(5, 2)
  /// 13 §7 — automation rules (20) run on at-risk / breach; ids only.
  escalation_rule_ids       String[]  @default([])
  sort_order                Int       @default(0)
  archived_at               DateTime?
  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt

  organization Organization      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  targets      SlaPolicyTarget[]
  tickets      Ticket[]
  timers       TicketSlaTimer[]

  @@unique([organization_id, name])
  @@index([organization_id, is_default])
  @@map("sla_policies")
}

/// 13 §2 — targets per priority within a policy (minutes; null = not tracked).
model SlaPolicyTarget {
  id                     String         @id @default(uuid())
  policy_id              String
  priority               TicketPriority
  first_response_minutes Int?
  next_response_minutes  Int?
  resolution_minutes     Int?

  policy SlaPolicy @relation(fields: [policy_id], references: [id], onDelete: Cascade)

  @@unique([policy_id, priority])
  @@map("sla_policy_targets")
}

// --- Ticket ------------------------------------------------------------------------

/// 13 §2, §5, §14 — the structured support case: priority, SLA, status, ownership, resolution.
/// Requester is a CRM Contact/Company (02) and/or a Customer Portal User (01 §79). Custom fields →
/// custom_field_values, tags → taggings, saved views → saved_views (02), history → audit_events +
/// TicketStatusHistory, time → 18 TimeEntry (entity TICKET), internal discussion → 12 (§11).
model Ticket {
  id                         String                   @id @default(uuid())
  organization_id            String
  /// 13 §2 — sequential per organization via number_sequences (03); `reference` = prefix + number (SUP-1042).
  number                     Int
  reference                  String
  branch_id                  String?
  inbox_id                   String?
  /// Primary conversation; additional ones via TicketConversation (§14).
  conversation_id            String?
  /// 12 §64, §60 — Message the ticket was created from ("Create ticket" on a channel message); id of the source message.
  source_message_id          String?
  subject                    String
  /// Markdown description (first customer message or form body).
  description                String?
  type                       TicketType               @default(QUESTION)
  source                     TicketSource             @default(MANUAL)
  channel_type               SupportChannelType?
  status_id                  String?
  priority                   TicketPriority           @default(NORMAL)
  category_id                String?
  // 13 §2, §11 — requester (shared CRM identity).
  requester_contact_id       String?
  company_id                 String?
  /// Customer Portal User who opened / may view the ticket (01 §79).
  requester_user_id          String?
  requester_email            String?
  requester_name             String?
  // 13 §2 — ownership.
  assignee_membership_id     String?
  team_id                    String?
  // 13 §2, §4, §11 — related application entities.
  project_id                 String?
  /// Project Change Request (05 §45) created from this request.
  change_request_id          String?
  /// 06 Release that shipped the fix (notified to the customer, §4); id only.
  release_id                 String?
  // 13 §2 — SLA (policy + denormalized due dates; detail in TicketSlaTimer).
  sla_policy_id              String?
  first_response_due_at      DateTime?
  next_response_due_at       DateTime?
  resolution_due_at          DateTime?
  sla_breached               Boolean                  @default(false)
  sla_at_risk                Boolean                  @default(false)
  // 13 §2, §9 — lifecycle timestamps.
  first_responded_at         DateTime?
  last_customer_reply_at     DateTime?
  last_agent_reply_at        DateTime?
  due_at                     DateTime?
  resolved_at                DateTime?
  resolved_by_membership_id  String?
  resolution                 String?
  closed_at                  DateTime?
  /// 13 §7 — scheduled auto-close (20 ScheduledJob id).
  auto_close_at              DateTime?
  auto_close_job_id          String?
  reopened_at                DateTime?
  reopen_count               Int                      @default(0)
  // 13 §2, §7 — escalation.
  escalation_level           Int                      @default(0)
  escalated_at               DateTime?
  escalated_to_membership_id String?
  // 13 §2 — merge / duplicates / incidents.
  merged_into_ticket_id      String?
  incident_id                String?
  // 13 §3 — AI classification (latest accepted/auto-applied).
  ai_classification          Json?
  ai_confidence              Decimal?                 @db.Decimal(5, 4)
  sentiment                  SupportSentiment?
  sentiment_score            Decimal?                 @db.Decimal(5, 4)
  language                   String?
  /// 13 §3 — estimated complexity: low | medium | high.
  ai_complexity              String?
  ai_summary                 String?
  /// 13 §9 — resolved by the AI agent without a human.
  resolved_by_ai             Boolean                  @default(false)
  /// 13 §5 — visible to the requester's portal users.
  customer_visible           Boolean                  @default(true)
  /// Messaging thread for internal discussion (12 §60); id only.
  channel_id                 String?
  created_by_membership_id   String?
  created_by_user_id         String?
  archived_at                DateTime?
  created_at                 DateTime                 @default(now())
  updated_at                 DateTime                 @updatedAt
  /// 13 §1, §2 — Postgres full-text search vector over subject + description; maintained by a database trigger (see migration). Not set by the API.
  search_vector              Unsupported("tsvector")?

  organization   Organization          @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  branch         Branch?               @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  inbox          SupportInbox?         @relation(fields: [inbox_id], references: [id], onDelete: SetNull)
  conversation   SupportConversation?  @relation("TicketPrimaryConversation", fields: [conversation_id], references: [id], onDelete: SetNull)
  status         TicketStatus?         @relation(fields: [status_id], references: [id], onDelete: SetNull)
  category       TicketCategory?       @relation(fields: [category_id], references: [id], onDelete: SetNull)
  requester      CrmContact?           @relation(fields: [requester_contact_id], references: [id], onDelete: SetNull)
  company        CrmCompany?           @relation(fields: [company_id], references: [id], onDelete: SetNull)
  requester_user User?                 @relation("TicketRequesterUser", fields: [requester_user_id], references: [id], onDelete: SetNull)
  assignee       Membership?           @relation("TicketAssignee", fields: [assignee_membership_id], references: [id], onDelete: SetNull)
  team           Team?                 @relation(fields: [team_id], references: [id], onDelete: SetNull)
  project        Project?              @relation(fields: [project_id], references: [id], onDelete: SetNull)
  change_request ProjectChangeRequest? @relation(fields: [change_request_id], references: [id], onDelete: SetNull)
  sla_policy     SlaPolicy?            @relation(fields: [sla_policy_id], references: [id], onDelete: SetNull)
  merged_into    Ticket?               @relation("TicketMerge", fields: [merged_into_ticket_id], references: [id], onDelete: SetNull)
  merged_from    Ticket[]              @relation("TicketMerge")
  incident       SupportIncident?      @relation(fields: [incident_id], references: [id], onDelete: SetNull)

  conversations     TicketConversation[]
  status_history    TicketStatusHistory[]
  sla_timers        TicketSlaTimer[]
  relations_from    TicketRelation[]      @relation("TicketRelationSource")
  relations_to      TicketRelation[]      @relation("TicketRelationTarget")
  task_links        TicketTaskLink[]
  followers         TicketFollower[]
  attachments       TicketAttachment[]
  csat_ratings      SupportCsatRating[]
  ai_suggestions    SupportAiSuggestion[]
  ai_sessions       SupportAiSession[]    @relation("SupportAiSessionTicket")
  knowledge_sources KnowledgeArticle[]    @relation("KnowledgeArticleSourceTicket")
  project_issues    ProjectIssue[]

  source_message Message? @relation("TicketSourceMessage", fields: [source_message_id], references: [id], onDelete: SetNull)

  @@unique([organization_id, number])
  @@unique([organization_id, reference])
  @@index([source_message_id])
  @@index([search_vector], type: Gin)
  @@index([organization_id, status_id])
  @@index([organization_id, priority])
  @@index([organization_id, category_id])
  @@index([organization_id, created_at])
  @@index([inbox_id, status_id])
  @@index([assignee_membership_id, status_id])
  @@index([team_id, status_id])
  @@index([requester_contact_id])
  @@index([company_id])
  @@index([requester_user_id])
  @@index([project_id])
  @@index([conversation_id])
  @@index([incident_id])
  @@index([resolution_due_at])
  @@index([first_response_due_at])
  @@map("tickets")
}

/// 13 §14 — additional conversations attached to a ticket (one conversation ↔ many tickets and vice versa).
model TicketConversation {
  ticket_id       String
  conversation_id String
  created_at      DateTime @default(now())

  ticket       Ticket              @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  conversation SupportConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@id([ticket_id, conversation_id])
  @@index([conversation_id])
  @@map("ticket_conversations")
}

/// 13 §2, §9 — queryable status history for resolution-time, SLA and agent metrics.
model TicketStatusHistory {
  id                       String                @id @default(uuid())
  ticket_id                String
  from_status_id           String?
  to_status_id             String?
  /// Category snapshots so metrics survive status renames.
  from_category            TicketStatusCategory?
  to_category              TicketStatusCategory?
  changed_by_membership_id String?
  changed_by_user_id       String?
  /// 13 §4, §7 — manual | automation | task_sync | ai | customer | auto_close
  changed_via              String                @default("manual")
  reason                   String?
  /// Seconds spent in the previous status.
  seconds_in_previous      Int?
  changed_at               DateTime              @default(now())

  ticket      Ticket        @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  from_status TicketStatus? @relation("TicketStatusHistoryFrom", fields: [from_status_id], references: [id], onDelete: SetNull)
  to_status   TicketStatus? @relation("TicketStatusHistoryTo", fields: [to_status_id], references: [id], onDelete: SetNull)

  @@index([ticket_id, changed_at])
  @@index([to_status_id, changed_at])
  @@map("ticket_status_history")
}

/// 13 §2, §7 — one SLA timer per metric per ticket; paused while the status pauses SLA.
/// The due reminder / breach check is a 20 ScheduledJob.
model TicketSlaTimer {
  id                   String         @id @default(uuid())
  ticket_id            String
  policy_id            String?
  metric               SlaMetric
  status               SlaTimerStatus @default(RUNNING)
  target_minutes       Int
  started_at           DateTime       @default(now())
  due_at               DateTime
  paused_at            DateTime?
  paused_seconds_total Int            @default(0)
  at_risk_at           DateTime?
  at_risk_notified_at  DateTime?
  completed_at         DateTime?
  breached_at          DateTime?
  /// Minutes elapsed when completed (business minutes when the policy uses business hours).
  elapsed_minutes      Int?
  /// 20 ScheduledJob id for the breach check; id only.
  scheduled_job_id     String?
  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt

  ticket Ticket     @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  policy SlaPolicy? @relation(fields: [policy_id], references: [id], onDelete: SetNull)

  @@index([ticket_id, metric])
  @@index([status, due_at])
  @@map("ticket_sla_timers")
}

/// 13 §2, §3 — related / duplicate / blocking / same-incident relationships between tickets.
model TicketRelation {
  id                       String             @id @default(uuid())
  source_ticket_id         String
  target_ticket_id         String
  type                     TicketRelationType @default(RELATED)
  /// 13 §3 — detected by AI (duplicate / incident grouping) vs added manually.
  detected_by_ai           Boolean            @default(false)
  confidence               Decimal?           @db.Decimal(5, 4)
  created_by_membership_id String?
  created_at               DateTime           @default(now())

  source Ticket @relation("TicketRelationSource", fields: [source_ticket_id], references: [id], onDelete: Cascade)
  target Ticket @relation("TicketRelationTarget", fields: [target_ticket_id], references: [id], onDelete: Cascade)

  @@unique([source_ticket_id, target_ticket_id, type])
  @@index([target_ticket_id])
  @@map("ticket_relations")
}

/// 13 §4, §14 — permanent link between a ticket and a Task (06): many tickets ↔ many tasks.
/// Creation is idempotent via `idempotency_key`; status sync follows SupportSettings.task_status_sync_mapping.
/// The task side also carries a TaskLink (06 §13) with entity_type TICKET.
model TicketTaskLink {
  id                       String             @id @default(uuid())
  ticket_id                String
  task_id                  String
  kind                     TicketTaskLinkKind @default(LINKED)
  /// 13 §4 — synchronize task status changes back to the ticket.
  sync_status              Boolean            @default(true)
  /// 13 §4, §13 — prevents duplicate task creation on retries (ticket id + source hash).
  idempotency_key          String?            @unique
  /// 13 §3 — AI suggestion that proposed the conversion, when applicable.
  ai_suggestion_id         String?
  created_by_membership_id String?
  /// 13 §4 — last synchronized task status category and when.
  last_synced_task_status  String?
  last_synced_at           DateTime?
  created_at               DateTime           @default(now())

  ticket        Ticket               @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  task          Task                 @relation(fields: [task_id], references: [id], onDelete: Cascade)
  ai_suggestion SupportAiSuggestion? @relation("TicketTaskLinkSuggestion", fields: [ai_suggestion_id], references: [id], onDelete: SetNull)

  @@unique([ticket_id, task_id])
  @@index([task_id])
  @@map("ticket_task_links")
}

/// 13 §2, §10 — members following a ticket for notifications (14).
model TicketFollower {
  ticket_id     String
  membership_id String
  created_at    DateTime @default(now())

  ticket     Ticket     @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  membership Membership @relation("TicketFollower", fields: [membership_id], references: [id], onDelete: Cascade)

  @@id([ticket_id, membership_id])
  @@index([membership_id])
  @@map("ticket_followers")
}

/// 13 §2, §5 — attachments on a ticket (beyond message attachments) are Documents (17); id only.
model TicketAttachment {
  id                     String   @id @default(uuid())
  ticket_id              String
  /// 17 Document.
  document_id            String
  file_name              String?
  mime_type              String?
  size_bytes             Int?
  /// 13 §5 — uploaded by a portal user (User id) or a member (Membership id).
  added_by_user_id       String?
  added_by_membership_id String?
  created_at             DateTime @default(now())

  ticket Ticket @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  @@unique([ticket_id, document_id])
  @@map("ticket_attachments")
}

/// 13 §3, §9 — a grouped incident / recurring problem spanning several tickets (detected by AI or
/// declared by an agent). Tickets point at it via Ticket.incident_id.
model SupportIncident {
  id                   String                  @id @default(uuid())
  organization_id      String
  title                String
  description          String?
  status               SupportIncidentStatus   @default(DETECTED)
  /// 13 §5 — customer impact shown on the incident, its status updates and the portal announcement.
  severity             SupportIncidentSeverity @default(MINOR)
  /// 13 §5 — affected services / product areas (free labels shown on the status page).
  affected_services    String[]                @default([])
  detected_by_ai       Boolean                 @default(false)
  /// 05 Project / 06 Task the incident is tracked in; ids only.
  project_id           String?
  task_id              String?
  /// 13 §6 — knowledge article published for the incident (workaround / status).
  knowledge_article_id String?
  owner_membership_id  String?
  ticket_count         Int                     @default(0)
  first_reported_at    DateTime?
  resolved_at          DateTime?
  created_at           DateTime                @default(now())
  updated_at           DateTime                @updatedAt

  organization  Organization            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  tickets       Ticket[]
  updates       SupportIncidentUpdate[]
  announcements Announcement[]

  @@index([organization_id, status])
  @@map("support_incidents")
}

// --- CSAT --------------------------------------------------------------------------

/// 13 §9 — customer satisfaction rating requested on resolution (ticket or conversation).
model SupportCsatRating {
  id                  String    @id @default(uuid())
  organization_id     String
  ticket_id           String?
  conversation_id     String?
  contact_id          String?
  /// Customer Portal User who rated (01 §79).
  rated_by_user_id    String?
  /// Agent credited for the rating (assignee at resolution).
  agent_membership_id String?
  /// 1–5 on a STARS_5 survey; 1 (down) or 5 (up) on a THUMBS survey (SupportSettings.csat_scale).
  rating              Int?
  comment             String?
  /// Opaque token for the rating link in emails (11).
  token               String    @unique @default(uuid())
  requested_at        DateTime  @default(now())
  submitted_at        DateTime?
  expires_at          DateTime?

  organization Organization         @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  ticket       Ticket?              @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  conversation SupportConversation? @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  contact      CrmContact?          @relation(fields: [contact_id], references: [id], onDelete: SetNull)
  rated_by     User?                @relation("SupportCsatRatedBy", fields: [rated_by_user_id], references: [id], onDelete: SetNull)
  agent        Membership?          @relation("SupportCsatAgent", fields: [agent_membership_id], references: [id], onDelete: SetNull)

  @@index([organization_id, submitted_at])
  @@index([ticket_id])
  @@index([agent_membership_id, submitted_at])
  @@map("support_csat_ratings")
}

// --- Canned responses --------------------------------------------------------------

/// 13 §1 — saved replies / response templates / macros with optional field actions.
model SupportCannedResponse {
  id                  String                     @id @default(uuid())
  organization_id     String
  scope               SupportCannedResponseScope @default(ORGANIZATION)
  team_id             String?
  owner_membership_id String?
  name                String
  /// Slash shortcut (e.g. "/refund").
  shortcut            String?
  category            String?
  /// Markdown with placeholders ({{customer.first_name}}, {{ticket.reference}}, {{agent.name}}).
  body                String
  /// Macro actions applied when used: { status_slug, priority, assignee_membership_id, team_id, add_tag_ids, category_id }.
  actions             Json?
  usage_count         Int                        @default(0)
  last_used_at        DateTime?
  archived_at         DateTime?
  created_at          DateTime                   @default(now())
  updated_at          DateTime                   @updatedAt

  organization Organization     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  team         Team?            @relation(fields: [team_id], references: [id], onDelete: Cascade)
  owner        Membership?      @relation("SupportCannedResponseOwner", fields: [owner_membership_id], references: [id], onDelete: Cascade)
  messages     SupportMessage[]

  @@unique([organization_id, shortcut])
  @@index([organization_id, scope])
  @@index([team_id])
  @@index([owner_membership_id])
  @@map("support_canned_responses")
}

// --- Knowledge base ----------------------------------------------------------------

/// 13 §6 — categories / collections of the customer-facing help center (hierarchical).
model KnowledgeCategory {
  id                 String              @id @default(uuid())
  organization_id    String
  parent_category_id String?
  name               String
  slug               String
  description        String?
  icon               String?
  /// Most restrictive visibility of the category; articles may be stricter.
  visibility         KnowledgeVisibility @default(PUBLIC)
  sort_order         Int                 @default(0)
  archived_at        DateTime?
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt

  organization Organization        @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  parent       KnowledgeCategory?  @relation("KnowledgeCategoryHierarchy", fields: [parent_category_id], references: [id], onDelete: SetNull)
  children     KnowledgeCategory[] @relation("KnowledgeCategoryHierarchy")
  articles     KnowledgeArticle[]

  @@unique([organization_id, slug])
  @@index([parent_category_id])
  @@map("knowledge_categories")
}

/// 13 §6 — help-center article (rich text, versions, feedback). Public articles are served by the
/// help center and the portal (07); INTERNAL ones only to agents. Approved content is the AI agent's
/// primary source (§3). Tags → taggings (entity KNOWLEDGE_ARTICLE). Embedded media are Documents (17).
model KnowledgeArticle {
  id                      String                   @id @default(uuid())
  organization_id         String
  category_id             String?
  title                   String
  slug                    String
  summary                 String?
  /// Markdown/HTML body of the current version (denormalized from the latest version).
  body                    String
  status                  KnowledgeArticleStatus   @default(DRAFT)
  visibility              KnowledgeVisibility      @default(PUBLIC)
  /// 13 §6 — shown in the FAQ section.
  is_faq                  Boolean                  @default(false)
  locale                  String                   @default("en")
  /// 13 §6 — groups translations of the same article (one id per article, shared by its locale rows); no table.
  translation_group_id    String?
  keywords                String[]                 @default([])
  /// Related article ids (manual + AI suggestions, §6).
  related_article_ids     String[]                 @default([])
  /// 17 Document ids for images/videos/attachments.
  attachment_document_ids String[]                 @default([])
  /// 06 Release whose notes this article publishes, when applicable; id only.
  release_id              String?
  /// 13 §6 — AI-generated draft from a resolved ticket.
  ai_generated            Boolean                  @default(false)
  source_ticket_id        String?
  author_membership_id    String?
  reviewer_membership_id  String?
  current_version         Int                      @default(1)
  published_at            DateTime?
  last_reviewed_at        DateTime?
  /// 13 §6, §9 — usage counters (detail in KnowledgeArticleFeedback).
  view_count              Int                      @default(0)
  helpful_count           Int                      @default(0)
  not_helpful_count       Int                      @default(0)
  /// SEO metadata for public articles { meta_title, meta_description, canonical_url }.
  seo                     Json?
  sort_order              Int                      @default(0)
  archived_at             DateTime?
  created_at              DateTime                 @default(now())
  updated_at              DateTime                 @updatedAt
  /// 13 §6 — Postgres full-text search vector over title + body; maintained by a database trigger (see migration). Not set by the API.
  search_vector           Unsupported("tsvector")?

  organization     Organization               @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  category         KnowledgeCategory?         @relation(fields: [category_id], references: [id], onDelete: SetNull)
  author           Membership?                @relation("KnowledgeArticleAuthor", fields: [author_membership_id], references: [id], onDelete: SetNull)
  source_ticket    Ticket?                    @relation("KnowledgeArticleSourceTicket", fields: [source_ticket_id], references: [id], onDelete: SetNull)
  versions         KnowledgeArticleVersion[]
  feedback         KnowledgeArticleFeedback[]
  ai_index_entries WikiAiIndexEntry[]

  @@unique([organization_id, slug, locale])
  @@unique([translation_group_id, locale])
  @@index([organization_id, translation_group_id])
  @@index([organization_id, status, visibility])
  @@index([search_vector], type: Gin)
  @@index([category_id, sort_order])
  @@index([source_ticket_id])
  @@map("knowledge_articles")
}

/// 13 §6 — immutable article version history.
model KnowledgeArticleVersion {
  id                   String   @id @default(uuid())
  article_id           String
  version              Int
  title                String
  summary              String?
  body                 String
  change_note          String?
  author_membership_id String?
  ai_generated         Boolean  @default(false)
  created_at           DateTime @default(now())

  article KnowledgeArticle @relation(fields: [article_id], references: [id], onDelete: Cascade)

  @@unique([article_id, version])
  @@map("knowledge_article_versions")
}

/// 13 §6 — ratings and feedback on an article from portal users, anonymous visitors or agents.
model KnowledgeArticleFeedback {
  id              String   @id @default(uuid())
  article_id      String
  is_helpful      Boolean
  comment         String?
  /// Customer Portal User (01 §79) when authenticated.
  user_id         String?
  contact_id      String?
  /// Anonymous visitor key (cookie) to deduplicate public votes.
  visitor_key     String?
  /// Conversation where the article was recommended, when the feedback came from a chat (§6).
  conversation_id String?
  created_at      DateTime @default(now())

  article KnowledgeArticle @relation(fields: [article_id], references: [id], onDelete: Cascade)
  user    User?            @relation("KnowledgeArticleFeedbackUser", fields: [user_id], references: [id], onDelete: SetNull)

  @@index([article_id, created_at])
  @@index([user_id])
  @@map("knowledge_article_feedback")
}

// --- AI ----------------------------------------------------------------------------

/// 13 §3 — an AI support-agent session on a conversation: first-line answers from the knowledge base
/// and authorized data, information collection, ticket creation and handover to a human with context.
/// All AI actions are also written to audit_events (§13).
model SupportAiSession {
  id                String                 @id @default(uuid())
  organization_id   String
  conversation_id   String
  /// Ticket created by the AI when human assistance was required.
  ticket_id         String?
  status            SupportAiSessionStatus @default(ACTIVE)
  model             String
  /// Structured data collected before escalation (issue, steps, environment, urgency …).
  collected_data    Json?
  /// Knowledge article ids used to answer.
  cited_article_ids String[]               @default([])
  /// Handover context passed to the human agent.
  handover_summary  String?
  handover_reason   String?
  /// AI turns (messages of kind AI_AGENT) in this session.
  turn_count        Int                    @default(0)
  /// Token / cost accounting { input_tokens, output_tokens, cost }.
  usage             Json?
  started_at        DateTime               @default(now())
  handed_over_at    DateTime?
  ended_at          DateTime?

  organization Organization        @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  conversation SupportConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  ticket       Ticket?             @relation("SupportAiSessionTicket", fields: [ticket_id], references: [id], onDelete: SetNull)

  @@index([organization_id, status, started_at])
  @@index([conversation_id])
  @@map("support_ai_sessions")
}

/// 13 §3 — one AI output awaiting / past human review: classification, priority, assignment, reply
/// draft, summary, translation, article recommendation, duplicate, task-creation proposal, knowledge gap.
/// `payload` holds the typed proposal; `confidence` is 0–1 and compared with SupportSettings thresholds.
model SupportAiSuggestion {
  id                        String                    @id @default(uuid())
  organization_id           String
  kind                      SupportAiSuggestionKind
  conversation_id           String?
  ticket_id                 String?
  /// Message that triggered the suggestion (SupportMessage id).
  source_message_id         String?
  model                     String
  payload                   Json
  /// Human-readable rationale from the model.
  explanation               String?
  confidence                Decimal?                  @db.Decimal(5, 4)
  status                    SupportAiSuggestionStatus @default(PENDING)
  /// Applied automatically because confidence ≥ threshold (no human review).
  auto_applied              Boolean                   @default(false)
  reviewed_by_membership_id String?
  reviewed_at               DateTime?
  review_note               String?
  applied_at                DateTime?
  expires_at                DateTime?
  /// 13 §9 — accuracy feedback: was the suggestion correct after the fact?
  was_correct               Boolean?
  created_at                DateTime                  @default(now())
  updated_at                DateTime                  @updatedAt

  organization Organization         @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  conversation SupportConversation? @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  ticket       Ticket?              @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  reviewed_by  Membership?          @relation("SupportAiSuggestionReviewer", fields: [reviewed_by_membership_id], references: [id], onDelete: SetNull)
  messages     SupportMessage[]     @relation("SupportMessageFromSuggestion")
  task_links   TicketTaskLink[]     @relation("TicketTaskLinkSuggestion")

  @@index([organization_id, kind, status])
  @@index([conversation_id, kind])
  @@index([ticket_id, kind])
  @@map("support_ai_suggestions")
}

/// 13 §5 — status-page style timeline entry of an incident. customer_visible entries are shown in the
/// customer portal (07) and mirrored by the incident's Announcement (14).
model SupportIncidentUpdate {
  id                   String                      @id @default(uuid())
  organization_id      String
  incident_id          String
  status               SupportIncidentUpdateStatus
  body                 String
  customer_visible     Boolean                     @default(false)
  author_membership_id String?
  created_at           DateTime                    @default(now())

  organization Organization    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  incident     SupportIncident @relation(fields: [incident_id], references: [id], onDelete: Cascade)
  author       Membership?     @relation("SupportIncidentUpdateAuthor", fields: [author_membership_id], references: [id], onDelete: SetNull)

  @@index([incident_id, created_at])
  @@index([organization_id])
  @@map("support_incident_updates")
}

/// 13 §2 — per-member support routing profile: presence, capacity, skills and languages used by
/// ROUND_ROBIN / LOAD_BALANCED / SKILL_BASED inboxes. Members edit their own; managers edit others.
model SupportAgentProfile {
  membership_id          String                   @id
  organization_id        String
  availability           SupportAgentAvailability @default(OFFLINE)
  /// Maximum open conversations assigned at once (null = unlimited).
  max_open_conversations Int?
  skills                 String[]                 @default([])
  languages              String[]                 @default([])
  /// Last automatic assignment, for round robin.
  last_assigned_at       DateTime?
  created_at             DateTime                 @default(now())
  updated_at             DateTime                 @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  membership   Membership   @relation(fields: [membership_id], references: [id], onDelete: Cascade)

  @@index([organization_id, availability])
  @@map("support_agent_profiles")
}

// =====================================================================
// 14 Notifications & Activity Center — docs/features/14-notifications-activity-center.md (LOG-403)
// Owns: the platform notification engine — event catalog, ingested events (idempotent), per-recipient
// notifications (inbox / Activity Center, portal inbox), per-channel deliveries, templates & localization,
// organization defaults, per-recipient settings and preferences (incl. per-record follow/mute and keyword
// subscriptions reused by 12), digests, push device tokens and delivery rules (dedup / coalesce / throttle).
// Does not own: record activity/history (written by owning modules to audit_events), email/SMS sending
// (11 CommMessage), campaigns/templates for customer messaging (11), outbound webhooks (20 OutboundWebhook),
// the event bus (20 PlatformEvent), messaging channels/messages (12). Referenced by id only.
// Audit of mandatory/security deliveries, template and default changes goes to audit_events (14 §13).
// =====================================================================

/// 14 §5 — delivery channels. IN_APP is the Activity Center for members and the portal inbox for
/// Customer Portal users (14 §7). EMAIL and SMS are delivered through 11. PUSH / DESKTOP use
/// platform-level APNs / FCM / Web Push credentials (not per organization). Slack delivery returns when a provider exists.
enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
  DESKTOP
}

/// 14 §3 — who a notification / preference / digest is addressed to.
enum NotificationRecipientType {
  MEMBERSHIP
  PORTAL_USER
}

/// 14 §4, §7 — inbox category of an event type; drives the Activity Center filters (unread, mentions,
/// assigned to me, approvals) and the 12 §18 categories (mentions, replies, DMs, reactions, invitations, reminders).
enum NotificationCategory {
  GENERAL
  MENTION
  DIRECT_MESSAGE
  REPLY
  REACTION
  ASSIGNMENT
  APPROVAL
  STATUS_CHANGE
  REMINDER
  DUE_DATE
  INVITATION
  SHARE
  SLA
  SECURITY
  BILLING
  ANNOUNCEMENT
  SYSTEM
}

/// 14 §6 — importance used by the "important only" preference level and by mandatory events.
enum NotificationPriority {
  LOW
  NORMAL
  IMPORTANT
  CRITICAL
}

/// 14 §6 — recipient level: all events / important only / mentions and direct only / none.
/// Also the 12 §17 per-channel options (all messages, mentions and DMs, only DMs → MENTIONS_AND_DIRECT, nothing).
enum NotificationLevel {
  ALL
  IMPORTANT_ONLY
  MENTIONS_AND_DIRECT
  NONE
}

/// 14 §6, §8 — immediate delivery or batched into a digest.
enum NotificationDeliveryMode {
  IMMEDIATE
  DIGEST
  OFF
}

/// 14 §8 — digest cadence; IMMEDIATE means no digest.
enum NotificationDigestFrequency {
  IMMEDIATE
  HOURLY
  DAILY
  WEEKLY
}

/// 14 §9, §14 — lifecycle of an ingested event.
enum NotificationEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  /// Duplicate idempotency key or no eligible recipients.
  IGNORED
  FAILED
}

/// 14 §9 — per-channel delivery lifecycle (retry with backoff; in-app never fails silently).
enum NotificationDeliveryStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  FAILED
  /// Not sent because of a preference, rule or channel restriction; see skip_reason.
  SKIPPED
  /// Held for a digest (14 §8); digest_id is set.
  DIGESTED
  EXPIRED
  CANCELLED
}

/// 14 §6, §9, §11 — why a delivery was skipped.
enum NotificationSkipReason {
  PREFERENCE_OFF
  LEVEL_FILTERED
  RECORD_MUTED
  QUIET_HOURS
  CHANNEL_DISABLED
  CHANNEL_NOT_AVAILABLE
  NO_ADDRESS
  NO_DEVICE
  DEDUPLICATED
  COALESCED
  THROTTLED
  PERMISSION_DENIED
  NOT_CUSTOMER_VISIBLE
  EXPIRED
}

/// 14 §8 — digest lifecycle.
enum NotificationDigestStatus {
  OPEN
  SCHEDULED
  SENDING
  SENT
  /// Period closed with no items.
  EMPTY
  FAILED
}

/// 14 §5 — push target platforms.
enum NotificationPushPlatform {
  IOS
  ANDROID
  WEB
  DESKTOP
}

/// 14 §9, §16 — delivery rule kinds (coalescing rules are Phase 2).
enum NotificationDeliveryRuleKind {
  DEDUPLICATE
  COALESCE
  THROTTLE
  SUPPRESS
}

/// 14 §9 — what a coalesce / throttle rule groups by.
enum NotificationCoalesceKey {
  RECORD
  RECORD_AND_ACTOR
  EVENT_TYPE
  RECIPIENT
}

/// 14 §4, §7 — lifecycle of a system announcement.
enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  LIVE
  EXPIRED
  WITHDRAWN
}

// --- Event catalog -----------------------------------------------------------------

/// 14 §4, §10, §14 — the event catalog. Platform entries have organization_id = null; organizations may
/// register additional event types (admin API, 14 §14). The owning module is the source of truth for meaning.
model NotificationEventType {
  id                      String                @id @default(uuid())
  /// null = platform catalog entry shared by all organizations.
  organization_id         String?
  /// Stable key, e.g. `task.assigned`, `invoice.overdue`, `contract.expiring` (14 §4).
  key                     String
  /// Owning module (14 §4 table).
  module                  ModuleKey
  name                    String
  description             String?
  category                NotificationCategory  @default(GENERAL)
  priority                NotificationPriority  @default(NORMAL)
  /// 14 §5, §11 — may be delivered to Customer Portal users; internal-only events are never customer-visible.
  customer_visible        Boolean               @default(false)
  /// 14 §5 — channels enabled by platform default when no org default / preference applies.
  default_channels        NotificationChannel[] @default([IN_APP])
  /// 14 §6 — platform-mandatory (security alerts, legal notices); organizations extend via NotificationOrgDefault.
  mandatory_by_default    Boolean               @default(false)
  /// 14 §6, §9 — channels always used for this event when mandatory (e.g. security alerts → EMAIL), ignoring recipient preferences.
  forced_channels         NotificationChannel[] @default([])
  /// 14 §9 — rapid repeated events on the same record may collapse into one notification.
  can_coalesce            Boolean               @default(false)
  coalesce_window_seconds Int?
  /// 14 §8 — may be batched into digests.
  supports_digest         Boolean               @default(true)
  /// 14 §9 — default expiry for notifications of this type (e.g. meeting reminders).
  default_expiry_minutes  Int?
  /// 14 §7 — actions the inbox can offer (approve, reply, complete, …), resolved by the owning module.
  available_actions       String[]              @default([])
  /// JSON schema of the event payload / template variables (14 §10).
  payload_schema          Json?
  is_active               Boolean               @default(true)
  deprecated_at           DateTime?
  sort_order              Int                   @default(0)
  created_at              DateTime              @default(now())
  updated_at              DateTime              @updatedAt

  organization   Organization?              @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  events         NotificationEvent[]
  notifications  Notification[]
  templates      NotificationTemplate[]
  org_defaults   NotificationOrgDefault[]
  preferences    NotificationPreference[]
  delivery_rules NotificationDeliveryRule[]

  @@unique([organization_id, key])
  @@index([module, is_active])
  @@index([category])
  @@map("notification_event_types")
}

// --- Events (ingestion) --------------------------------------------------------------

/// 14 §2, §9, §14 — an event published by a module or the Automation Engine (20). Idempotent on
/// (organization_id, idempotency_key): redelivered events never create duplicate notifications.
model NotificationEvent {
  id                       String                  @id @default(uuid())
  organization_id          String
  event_type_id            String
  /// Denormalized event type key for querying without a join.
  event_key                String
  /// Caller-supplied id (14 §9 idempotency); defaults to the publisher's own event id.
  idempotency_key          String
  /// Source record (14 §2).
  entity_type              RecordEntityType?
  entity_id                String?
  /// Display label of the source record at the time of the event.
  entity_label             String?
  /// 14 §7 — project / company the source record belongs to (05 / 02, ids only), set by the emitting module so the inbox and digests filter without joins.
  context_project_id       String?
  context_company_id       String?
  actor_membership_id      String?
  /// Platform / portal user actor when not a member (e.g. customer reply from the portal).
  actor_user_id            String?
  /// 01 ServiceAccount id when published by an integration.
  actor_service_account_id String?
  /// Event payload used for recipient resolution and template variables.
  payload                  Json
  /// 14 §3 — declared audiences before expansion: { membership_ids, user_ids, team_ids, role_ids, scope: … }.
  /// Teams, roles and scopes are expanded to Memberships at delivery time.
  targets                  Json?
  /// 14 §9 — coalescing key (defaults to event_key + entity); notifications inherit it.
  group_key                String?
  /// 14 §9 — not delivered after this moment.
  expires_at               DateTime?
  /// 20 PlatformEvent id when the event came from the event bus.
  platform_event_id        String?
  /// 20 AutomationRule id when a rule published the event (14 §16).
  automation_rule_id       String?
  status                   NotificationEventStatus @default(RECEIVED)
  /// Number of notifications produced.
  notification_count       Int                     @default(0)
  error                    String?
  occurred_at              DateTime                @default(now())
  received_at              DateTime                @default(now())
  processed_at             DateTime?

  organization  Organization          @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  event_type    NotificationEventType @relation(fields: [event_type_id], references: [id], onDelete: Restrict)
  actor         Membership?           @relation("NotificationEventActor", fields: [actor_membership_id], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@unique([organization_id, idempotency_key])
  @@index([organization_id, status, received_at])
  @@index([organization_id, event_key, occurred_at])
  @@index([entity_type, entity_id])
  @@index([group_key])
  @@index([organization_id, context_project_id, occurred_at])
  @@index([organization_id, context_company_id, occurred_at])
  @@map("notification_events")
}

// --- Notifications (inbox) -------------------------------------------------------------

/// 14 §2, §7, §9, 12 §16, §18 — a message produced from an event for one recipient (a Membership or a Customer Portal
/// User). The in-app record is always stored (14 §5); per-channel deliveries hang off it.
model Notification {
  id                      String                    @id @default(uuid())
  organization_id         String
  event_id                String?
  event_type_id           String
  /// Denormalized for inbox filters without joins.
  event_key               String
  module                  ModuleKey
  category                NotificationCategory      @default(GENERAL)
  priority                NotificationPriority      @default(NORMAL)
  recipient_type          NotificationRecipientType
  recipient_membership_id String?
  /// Customer Portal User (01 §79) — set with portal_membership_id for portal-scoped inboxes (14 §7).
  recipient_user_id       String?
  portal_membership_id    String?
  /// 14 §3 — why this recipient was selected: assignee | watcher | mention | owner | team:<id> | role:<id> | follow.
  audience_reason         String?
  title                   String
  /// Short plain-text body / preview. Hidden on push/desktop/email when previews are disabled (14 §11).
  body                    String?
  icon                    String?
  /// Deep link to the source record or message (14 §8).
  action_url              String?
  entity_type             RecordEntityType?
  entity_id               String?
  entity_label            String?
  /// 14 §7 — project / company context copied from the event (ids only) for the inbox "by project / company" filters.
  context_project_id      String?
  context_company_id      String?
  actor_membership_id     String?
  actor_user_id           String?
  /// Extra template / UI data from the event payload.
  data                    Json?
  /// 14 §6 — cannot be muted (security alerts, SLA breaches, legal notices).
  is_mandatory            Boolean                   @default(false)
  /// 14 §7 — waiting on the recipient (approvals section); cleared when the action is taken.
  requires_action         Boolean                   @default(false)
  /// 14 §7 — inline actions offered: [{ key, label, style }].
  actions                 Json?
  action_taken            String?
  action_taken_at         DateTime?
  /// 14 §9 — coalescing: later events with the same key update this row instead of creating a new one.
  group_key               String?
  coalesced_count         Int                       @default(1)
  last_event_at           DateTime                  @default(now())
  /// 14 §7 — read / seen / archive / snooze state.
  seen_at                 DateTime?
  read_at                 DateTime?
  archived_at             DateTime?
  snoozed_until           DateTime?
  /// 14 §9 — not delivered after this moment.
  expires_at              DateTime?
  created_at              DateTime                  @default(now())
  updated_at              DateTime                  @updatedAt

  organization         Organization              @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  event                NotificationEvent?        @relation(fields: [event_id], references: [id], onDelete: SetNull)
  event_type           NotificationEventType     @relation(fields: [event_type_id], references: [id], onDelete: Restrict)
  recipient_membership Membership?               @relation("NotificationRecipientMembership", fields: [recipient_membership_id], references: [id], onDelete: Cascade)
  recipient_user       User?                     @relation("NotificationRecipientUser", fields: [recipient_user_id], references: [id], onDelete: Cascade)
  portal_membership    CustomerPortalMembership? @relation(fields: [portal_membership_id], references: [id], onDelete: Cascade)
  actor                Membership?               @relation("NotificationActorMembership", fields: [actor_membership_id], references: [id], onDelete: SetNull)
  deliveries           NotificationDelivery[]

  // 14 §9 — the same event never produces two notifications for one recipient.
  @@unique([event_id, recipient_membership_id])
  @@unique([event_id, recipient_user_id])
  @@index([organization_id, recipient_membership_id, read_at, created_at])
  @@index([organization_id, recipient_user_id, read_at, created_at])
  @@index([recipient_membership_id, requires_action])
  @@index([recipient_membership_id, category])
  @@index([organization_id, group_key])
  @@index([entity_type, entity_id])
  @@index([snoozed_until])
  @@index([organization_id, recipient_membership_id, context_project_id])
  @@index([organization_id, context_company_id])
  @@index([expires_at])
  @@map("notifications")
}

/// 14 §5, §9 — one delivery attempt record per channel of a notification. Email/SMS are sent through 11
/// (comm_message_id); push through NotificationPushDevice; in-app is the Notification row itself.
model NotificationDelivery {
  id                  String                     @id @default(uuid())
  organization_id     String
  notification_id     String
  channel             NotificationChannel
  status              NotificationDeliveryStatus @default(PENDING)
  skip_reason         NotificationSkipReason?
  /// 14 §9 — retry with backoff.
  attempt_count       Int                        @default(0)
  max_attempts        Int                        @default(5)
  next_attempt_at     DateTime?
  last_attempted_at   DateTime?
  sent_at             DateTime?
  delivered_at        DateTime?
  failed_at           DateTime?
  failure_reason      String?
  /// 14 §8 — set when held for / sent inside a digest.
  digest_id           String?
  /// Template and locale used to render this delivery (14 §10).
  template_id         String?
  locale              String?
  rendered_subject    String?
  rendered_body       String?
  /// Address the delivery went to (email, phone, device label); previews may be hidden (14 §11).
  destination         String?
  preview_hidden      Boolean                    @default(false)
  /// 11 CommMessage id for EMAIL / SMS deliveries.
  comm_message_id     String?
  push_device_id      String?
  /// Provider name (resend, twilio, fcm, apns, web-push, slack) and its message id / raw response.
  provider            String?
  provider_message_id String?
  provider_response   Json?
  /// 14 §16 — notification analytics.
  opened_at           DateTime?
  clicked_at          DateTime?
  expires_at          DateTime?
  created_at          DateTime                   @default(now())
  updated_at          DateTime                   @updatedAt

  organization Organization            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  notification Notification            @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  digest       NotificationDigest?     @relation(fields: [digest_id], references: [id], onDelete: SetNull)
  template     NotificationTemplate?   @relation(fields: [template_id], references: [id], onDelete: SetNull)
  push_device  NotificationPushDevice? @relation(fields: [push_device_id], references: [id], onDelete: SetNull)

  // 14 §9, §17 — one recipient, one channel, one delivery per notification.
  @@unique([notification_id, channel])
  @@index([organization_id, status, next_attempt_at])
  @@index([organization_id, channel, created_at])
  @@index([digest_id])
  @@index([comm_message_id])
  @@index([provider_message_id])
  @@map("notification_deliveries")
}

// --- Templates & localization ----------------------------------------------------------

/// 14 §10 — notification template per event type, channel and locale. organization_id = null is the
/// platform default; organization rows override it. Branding (01 §15) is applied to email at render time.
model NotificationTemplate {
  id                       String              @id @default(uuid())
  organization_id          String?
  event_type_id            String
  channel                  NotificationChannel
  /// BCP-47 locale (en, el, …); null = fallback for every locale.
  locale                   String?
  /// Email subject / push title; supports {{variables}} from the event payload.
  subject                  String?
  title                    String
  /// Plain-text / markdown body with {{variables}}.
  body                     String
  /// HTML body for EMAIL.
  html_body                String?
  /// Template for the primary call-to-action label and link.
  cta_label                String?
  cta_url                  String?
  /// Variables the template expects: [{ key, description, example }].
  variables                Json?
  version                  Int                 @default(1)
  is_active                Boolean             @default(true)
  created_by_membership_id String?
  updated_by_membership_id String?
  created_at               DateTime            @default(now())
  updated_at               DateTime            @updatedAt

  organization Organization?                 @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  event_type   NotificationEventType         @relation(fields: [event_type_id], references: [id], onDelete: Cascade)
  deliveries   NotificationDelivery[]
  versions     NotificationTemplateVersion[]

  @@unique([organization_id, event_type_id, channel, locale])
  @@index([event_type_id, channel])
  @@map("notification_templates")
}

// --- Organization configuration -----------------------------------------------------------

/// 14 §5, §6, §8, §11 — organization-wide notification settings (one row per organization).
model NotificationOrgSettings {
  organization_id          String                      @id
  /// 14 §5 — channels available to members; others are restricted for the whole organization.
  enabled_channels         NotificationChannel[]       @default([IN_APP, EMAIL])
  /// 14 §5 — channels available to Customer Portal users (in-app, email, optionally SMS).
  portal_enabled_channels  NotificationChannel[]       @default([IN_APP, EMAIL])
  /// 11 SenderIdentity used for notification emails / SMS.
  email_sender_identity_id String?
  sms_sender_identity_id   String?
  default_level            NotificationLevel           @default(ALL)
  default_digest_frequency NotificationDigestFrequency @default(IMMEDIATE)
  /// Local hour (0–23) / weekday (0–6) when daily / weekly digests are sent.
  default_digest_hour      Int                         @default(8)
  default_digest_weekday   Int                         @default(1)
  /// 14 §11 — hide message content in push, desktop and email previews by default.
  hide_previews_by_default Boolean                     @default(false)
  /// 14 §9 — default retry policy for failed channel deliveries.
  max_delivery_attempts    Int                         @default(5)
  retry_backoff_seconds    Int                         @default(60)
  /// Days to keep read / archived notifications before purge; null = keep.
  retention_days           Int?
  /// 14 §14 — emit notification.* webhook events through 20 OutboundWebhook.
  webhook_events_enabled   Boolean                     @default(false)
  updated_by_membership_id String?
  created_at               DateTime                    @default(now())
  updated_at               DateTime                    @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@map("notification_org_settings")
}

/// 14 §6 — organization defaults per module or per event type (preference layer 4) and the list of
/// mandatory events administrators configure. Exactly one of module / event_type_id is set.
model NotificationOrgDefault {
  id                       String                      @id @default(uuid())
  organization_id          String
  module                   ModuleKey?
  event_type_id            String?
  enabled                  Boolean                     @default(true)
  /// Channels enabled by default for members.
  channels                 NotificationChannel[]       @default([IN_APP])
  /// Channels enabled by default for Customer Portal users (only for customer-visible events).
  portal_channels          NotificationChannel[]       @default([IN_APP, EMAIL])
  delivery_mode            NotificationDeliveryMode    @default(IMMEDIATE)
  digest_frequency         NotificationDigestFrequency @default(DAILY)
  /// 14 §6 — users cannot mute this event (security alerts, SLA breaches, legal notices).
  is_mandatory             Boolean                     @default(false)
  updated_by_membership_id String?
  created_at               DateTime                    @default(now())
  updated_at               DateTime                    @updatedAt

  organization Organization           @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  event_type   NotificationEventType? @relation(fields: [event_type_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, module])
  @@unique([organization_id, event_type_id])
  @@map("notification_org_defaults")
}

// --- Recipient settings & preferences ---------------------------------------------------------

/// 14 §6 — per-recipient global settings (preference layer 3): level, Do Not Disturb / quiet hours,
/// digest mode, preview privacy (12 §87) and channel master switches (12 §17). One row per Membership
/// or per Customer Portal membership.
model NotificationRecipientSettings {
  id                     String                      @id @default(uuid())
  organization_id        String
  recipient_type         NotificationRecipientType
  membership_id          String?                     @unique
  portal_membership_id   String?                     @unique
  level                  NotificationLevel           @default(ALL)
  // Channel master switches (12 §17: desktop, mobile, email notifications, sound).
  in_app_enabled         Boolean                     @default(true)
  email_enabled          Boolean                     @default(true)
  sms_enabled            Boolean                     @default(false)
  push_enabled           Boolean                     @default(true)
  desktop_enabled        Boolean                     @default(true)
  sound_enabled          Boolean                     @default(true)
  // 14 §6 — Do Not Disturb schedule and time zone.
  dnd_enabled            Boolean                     @default(false)
  /// "HH:mm" local time in `timezone`.
  dnd_start_time         String?
  dnd_end_time           String?
  /// Weekdays (0 = Sunday … 6 = Saturday) the schedule applies to; empty = every day.
  dnd_weekdays           Int[]                       @default([])
  /// Temporary DND ("pause for 1 hour / until tomorrow").
  dnd_until              DateTime?
  /// IANA time zone; null = the user's / organization's time zone (01 §127).
  timezone               String?
  /// 14 §6 — deliver mandatory / CRITICAL notifications even during DND.
  dnd_allow_critical     Boolean                     @default(true)
  // 14 §8 — digest instead of immediate delivery.
  digest_frequency       NotificationDigestFrequency @default(IMMEDIATE)
  digest_channel         NotificationChannel         @default(EMAIL)
  digest_hour            Int?
  digest_weekday         Int?
  /// 14 §6, §11 — whether push / desktop / email previews include message content (12 §87).
  show_previews          Boolean                     @default(true)
  // 12 §17 — messaging-specific toggles layered on 14.
  thread_notifications   Boolean                     @default(true)
  reaction_notifications Boolean                     @default(true)
  keyword_notifications  Boolean                     @default(true)
  /// Preferred notification language; null = user language (01 §127).
  language               String?
  created_at             DateTime                    @default(now())
  updated_at             DateTime                    @updatedAt

  organization      Organization              @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  membership        Membership?               @relation(fields: [membership_id], references: [id], onDelete: Cascade)
  portal_membership CustomerPortalMembership? @relation(fields: [portal_membership_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@map("notification_recipient_settings")
}

/// 14 §6 — per-recipient preference rows for layers 1–2, reusable by 12 §17 and §32 for channel /
/// conversation mute. Scope is exactly one of: event_type_id (per event type), module (per module), or
/// (entity_type, entity_id) (per record: follow / mute a messaging channel, project, ticket …).
/// channel = null applies to every channel. `scope_key` and `recipient_key` are derived by the service
/// (`event:<key>` | `module:<MODULE>` | `record:<ENTITY_TYPE>:<id>`, `m:<membership_id>` | `p:<portal_membership_id>`)
/// so one unique index can cover the nullable scope columns.
model NotificationPreference {
  id                   String                    @id @default(uuid())
  organization_id      String
  recipient_type       NotificationRecipientType
  membership_id        String?
  portal_membership_id String?
  recipient_key        String
  // Scope
  event_type_id        String?
  module               ModuleKey?
  entity_type          RecordEntityType?
  entity_id            String?
  /// Display label of the record at the time of the mute / follow, so the list survives deleted records.
  entity_label         String?
  scope_key            String
  /// null = all channels.
  channel              NotificationChannel?
  /// false = muted for this scope / channel (14 §6 per-record mute, 12 §17 per-channel settings).
  enabled              Boolean                   @default(true)
  /// Record / module scope: all / important only / mentions and direct only / none (12 §17).
  level                NotificationLevel?
  delivery_mode        NotificationDeliveryMode  @default(IMMEDIATE)
  /// Record scope: receive every event on the record even when not a participant ("follow this project").
  is_following         Boolean                   @default(false)
  /// Temporary mute ("mute for 8 hours"); null = indefinite while enabled = false.
  muted_until          DateTime?
  created_at           DateTime                  @default(now())
  updated_at           DateTime                  @updatedAt

  organization      Organization              @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  membership        Membership?               @relation(fields: [membership_id], references: [id], onDelete: Cascade)
  portal_membership CustomerPortalMembership? @relation(fields: [portal_membership_id], references: [id], onDelete: Cascade)
  event_type        NotificationEventType?    @relation(fields: [event_type_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, recipient_key, scope_key, channel])
  @@index([membership_id, event_type_id])
  @@index([membership_id, entity_type, entity_id])
  @@index([portal_membership_id])
  @@index([entity_type, entity_id])
  @@map("notification_preferences")
}

/// 14 §6, §16 — keyword subscriptions (12 §32): the member is notified when the term appears in an
/// authorized conversation. Phase 2.
model NotificationKeyword {
  id               String                @id @default(uuid())
  organization_id  String
  membership_id    String
  keyword          String
  match_whole_word Boolean               @default(true)
  case_sensitive   Boolean               @default(false)
  /// Channels to notify on; empty = recipient's defaults.
  channels         NotificationChannel[] @default([])
  is_enabled       Boolean               @default(true)
  /// 12 §32 — "disable temporarily".
  disabled_until   DateTime?
  created_at       DateTime              @default(now())
  updated_at       DateTime              @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  membership   Membership   @relation(fields: [membership_id], references: [id], onDelete: Cascade)

  @@unique([membership_id, keyword])
  @@index([organization_id, is_enabled])
  @@map("notification_keywords")
}

// --- Digests ----------------------------------------------------------------------------------

/// 14 §8 — a batch of notifications for one recipient and period, per module or per record
/// (12 Messaging channel digest). Deliveries held for the digest point at it; the digest itself is sent
/// through 11 (comm_message_id) or push.
model NotificationDigest {
  id                   String                      @id @default(uuid())
  organization_id      String
  recipient_type       NotificationRecipientType
  membership_id        String?
  portal_membership_id String?
  /// Portal User id for PORTAL_USER recipients.
  recipient_user_id    String?
  frequency            NotificationDigestFrequency
  channel              NotificationChannel         @default(EMAIL)
  /// Scope: null/null = all modules; module = per module; entity = per record (12 channel digest).
  module               ModuleKey?
  entity_type          RecordEntityType?
  entity_id            String?
  period_start         DateTime
  period_end           DateTime
  scheduled_for        DateTime
  status               NotificationDigestStatus    @default(OPEN)
  item_count           Int                         @default(0)
  locale               String?
  rendered_subject     String?
  rendered_body        String?
  /// 11 CommMessage id of the sent digest (EMAIL / SMS).
  comm_message_id      String?
  provider_message_id  String?
  sent_at              DateTime?
  failed_at            DateTime?
  failure_reason       String?
  attempt_count        Int                         @default(0)
  created_at           DateTime                    @default(now())
  updated_at           DateTime                    @updatedAt

  organization      Organization              @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  membership        Membership?               @relation(fields: [membership_id], references: [id], onDelete: Cascade)
  portal_membership CustomerPortalMembership? @relation(fields: [portal_membership_id], references: [id], onDelete: Cascade)
  deliveries        NotificationDelivery[]

  @@index([organization_id, status, scheduled_for])
  @@index([membership_id, status, period_start])
  @@index([portal_membership_id, status])
  @@map("notification_digests")
}

// --- Push devices ----------------------------------------------------------------------------

/// 14 §5 — registered push targets (mobile, browser, desktop) per platform User. User-level because a
/// device is not tenant-specific; the active membership at registration is kept for diagnostics.
model NotificationPushDevice {
  id            String                   @id @default(uuid())
  user_id       String
  /// Membership active when the device registered; informational only.
  membership_id String?
  platform      NotificationPushPlatform
  /// fcm | apns | web-push | electron
  provider      String
  /// Device / registration token (FCM / APNs) or Web Push endpoint.
  token         String
  /// Web Push subscription (endpoint, keys) when platform = WEB.
  subscription  Json?
  device_name   String?
  app_version   String?
  locale        String?
  last_seen_at  DateTime?
  /// Consecutive provider failures; the device is disabled after the provider reports an invalid token.
  failure_count Int                      @default(0)
  disabled_at   DateTime?
  created_at    DateTime                 @default(now())
  updated_at    DateTime                 @updatedAt

  user       User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@unique([platform, token])
  @@index([user_id, disabled_at])
  @@map("notification_push_devices")
}

// --- Delivery rules -----------------------------------------------------------------------------

/// 14 §9, §16 — organization-level dedup / coalesce / throttle / suppress rules evaluated before delivery.
/// A rule applies to the matching event type (or module, or all) and channel (or all). Rules may be
/// created by 20 Automation (automation_rule_id).
model NotificationDeliveryRule {
  id                       String                       @id @default(uuid())
  organization_id          String
  name                     String
  kind                     NotificationDeliveryRuleKind
  event_type_id            String?
  module                   ModuleKey?
  channel                  NotificationChannel?
  /// Window in which DEDUPLICATE / COALESCE / THROTTLE apply.
  window_seconds           Int?
  /// THROTTLE: max notifications per recipient per window.
  max_per_window           Int?
  coalesce_key             NotificationCoalesceKey?
  /// Extra matching conditions on the event payload (JSON logic), 14 §16.
  conditions               Json?
  /// 20 AutomationRule id when managed by the Automation Engine.
  automation_rule_id       String?
  priority                 Int                          @default(0)
  is_active                Boolean                      @default(true)
  created_by_membership_id String?
  created_at               DateTime                     @default(now())
  updated_at               DateTime                     @updatedAt

  organization Organization           @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  event_type   NotificationEventType? @relation(fields: [event_type_id], references: [id], onDelete: Cascade)

  @@index([organization_id, is_active, kind])
  @@index([event_type_id])
  @@map("notification_delivery_rules")
}

/// 14 §10 — immutable snapshot of a template before each change, for history and rollback.
model NotificationTemplateVersion {
  id                       String   @id @default(uuid())
  /// null = platform template.
  organization_id          String?
  template_id              String
  version                  Int
  subject                  String?
  title                    String
  body                     String
  html_body                String?
  cta_label                String?
  cta_url                  String?
  variables                Json?
  changed_by_membership_id String?
  created_at               DateTime @default(now())

  organization Organization?        @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  template     NotificationTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@unique([template_id, version])
  @@index([organization_id])
  @@map("notification_template_versions")
}

/// 14 §4, §7 — system announcement (maintenance, policy change, outage notice). Publishing fans out Notification
/// rows (category ANNOUNCEMENT, event `announcement.published`) to the audience; portal_visible also reaches Customer Portal
/// users (13 §5 service announcements, linked to a SupportIncident via incident_id).
model Announcement {
  id                       String               @id @default(uuid())
  organization_id          String
  title                    String
  body                     String
  severity                 NotificationPriority @default(NORMAL)
  /// 14 §3 — audience before expansion: { membership_ids, team_ids, role_ids, branch_ids }; null = every member.
  audience                 Json?
  /// Also delivered to Customer Portal users (sensitive; needs notifications.announcements.manage).
  portal_visible           Boolean              @default(false)
  /// Recipients must acknowledge (AnnouncementAcknowledgement).
  requires_ack             Boolean              @default(false)
  status                   AnnouncementStatus   @default(DRAFT)
  publish_at               DateTime?
  published_at             DateTime?
  expires_at               DateTime?
  withdrawn_at             DateTime?
  /// 13 SupportIncident this announcement reports on, when any.
  incident_id              String?
  created_by_membership_id String?
  created_at               DateTime             @default(now())
  updated_at               DateTime             @updatedAt

  organization     Organization                  @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  incident         SupportIncident?              @relation(fields: [incident_id], references: [id], onDelete: SetNull)
  created_by       Membership?                   @relation("AnnouncementCreator", fields: [created_by_membership_id], references: [id], onDelete: SetNull)
  acknowledgements AnnouncementAcknowledgement[]

  @@index([organization_id, status, publish_at])
  @@index([organization_id, portal_visible, status])
  @@index([incident_id])
  @@map("announcements")
}

/// 14 §7 — who acknowledged an announcement that requires it (a member or a Customer Portal user).
model AnnouncementAcknowledgement {
  id                   String   @id @default(uuid())
  organization_id      String
  announcement_id      String
  membership_id        String?
  portal_membership_id String?
  acknowledged_at      DateTime @default(now())

  organization      Organization              @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  announcement      Announcement              @relation(fields: [announcement_id], references: [id], onDelete: Cascade)
  membership        Membership?               @relation(fields: [membership_id], references: [id], onDelete: Cascade)
  portal_membership CustomerPortalMembership? @relation(fields: [portal_membership_id], references: [id], onDelete: Cascade)

  @@unique([announcement_id, membership_id])
  @@unique([announcement_id, portal_membership_id])
  @@index([organization_id])
  @@map("announcement_acknowledgements")
}

/// 14 §2, §7 — activity feed read model written by the owning modules next to audit_events (which stays the
/// security / compliance trail). Scopes: organization, project (project_id), customer (company_id + customer_visible:
/// the only rows the portal preview and portal users may see).
model ActivityEvent {
  id                  String            @id @default(uuid())
  organization_id     String
  /// Stable key, e.g. `task.completed`, `proposal.signed`, `ticket.resolved`.
  event_key           String
  module              ModuleKey
  /// Human-readable one-line summary, e.g. "Anna completed Design homepage".
  summary             String
  entity_type         RecordEntityType?
  entity_id           String?
  entity_label        String?
  /// Plain ids: feed rows outlive the actor and the records.
  actor_membership_id String?
  actor_user_id       String?
  project_id          String?
  company_id          String?
  branch_id           String?
  /// Shown in the customer-scope feed and in the portal.
  customer_visible    Boolean           @default(false)
  data                Json?
  /// audit_events row written for the same action, when any.
  audit_event_id      String?
  occurred_at         DateTime          @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id, occurred_at])
  @@index([organization_id, project_id, occurred_at])
  @@index([organization_id, company_id, customer_visible, occurred_at])
  @@index([entity_type, entity_id, occurred_at])
  @@index([organization_id, branch_id, occurred_at])
  @@map("activity_events")
}

// =====================================================================
// 15 Business Docs (Internal Knowledge) — docs/features/15-notion-business-docs.md (LOG-341)
// Owns: wiki spaces, hierarchical pages (block content), page templates, versions, page-level
// permissions, record links, comments, favorites, review/acknowledgement tracking, onboarding &
// offboarding checklists, custom forms, form assignments & submissions, AI knowledge index.
// Does not own: customer-facing help center (13 §6), file storage (17), project notes (05 §33–34),
// members/teams/branches/roles (01), employees/departments (10), tasks (06), notifications (14),
// automation rules (20). Those are related or referenced by id only. Activity goes to audit_events.
// =====================================================================

/// 15 §2 — what a space is organised around (department, team, branch, project or topic).
enum WikiSpaceKind {
  DEPARTMENT
  TEAM
  BRANCH
  PROJECT
  TOPIC
}

/// 15 §2 — page lifecycle: draft, published, needs review, archived.
enum WikiPageStatus {
  DRAFT
  PUBLISHED
  NEEDS_REVIEW
  ARCHIVED
}

/// 15 §2, §3, §4 — template / page kinds (policy, procedure, runbook, meeting notes, decision record,
/// handbook chapter, onboarding/offboarding guides, FAQ).
enum WikiPageType {
  GENERAL
  POLICY
  PROCEDURE
  RUNBOOK
  MEETING_NOTES
  DECISION_RECORD
  HANDBOOK_CHAPTER
  ONBOARDING_GUIDE
  OFFBOARDING_GUIDE
  FAQ
}

/// 15 §2 — who may see a page: whole organization, a branch, a team, a role or explicit members.
/// BRANCH / TEAM / ROLE / MEMBERS enumerate the principals in WikiPagePermission.
enum WikiVisibility {
  ORGANIZATION
  BRANCH
  TEAM
  ROLE
  MEMBERS
}

/// 15 §2, §8 — access level granted by a space membership or page permission.
enum WikiPermissionLevel {
  VIEW
  COMMENT
  EDIT
  MANAGE
}

/// 15 §2 — principal kinds a page permission can be granted to. DEPARTMENT ids are Department = Team of kind DEPARTMENT (01 §43)s.
enum WikiPrincipalType {
  MEMBERSHIP
  TEAM
  BRANCH
  ROLE
  DEPARTMENT
}

/// 15 §3 — onboarding vs offboarding checklist.
enum WikiChecklistKind {
  ONBOARDING
  OFFBOARDING
}

/// 15 §3 — who a checklist item's generated Task (06) is assigned to.
enum WikiChecklistAssigneeKind {
  SUBJECT
  MANAGER
  CHECKLIST_OWNER
  SPECIFIC_MEMBER
}

/// 15 §3 — lifecycle of a checklist run for one member.
enum WikiChecklistRunStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// 15 §3 — how a checklist run was started.
enum WikiChecklistTrigger {
  MEMBER_ONBOARDING
  MEMBER_OFFBOARDING
  MANUAL
  AUTOMATION
}

/// 15 §3 — status of one item inside a checklist run.
enum WikiChecklistItemStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

/// 15 §5 — form lifecycle.
enum CustomFormStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

/// 15 §5 — typical form kinds; CUSTOM for anything else.
enum CustomFormKind {
  FEEDBACK_SURVEY
  CHECK_IN
  EQUIPMENT_REQUEST
  INCIDENT_REPORT
  COMPLIANCE_ACKNOWLEDGEMENT
  EXIT_INTERVIEW
  CUSTOM
}

/// 15 §5 — allowed `type` values inside CustomForm.fields_schema. FILE_UPLOAD stores Documents (17);
/// SIGNATURE captures a drawn/typed signature image stored as a Document (17) — not a 04 signature request.
enum CustomFormFieldType {
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  EMAIL
  SINGLE_CHOICE
  MULTI_CHOICE
  CHECKBOX
  SCALE
  DATE
  FILE_UPLOAD
  SIGNATURE
  SECTION
}

/// 15 §5 — who a form is assigned to; recipients are expanded per Membership.
enum FormAssignmentTargetType {
  MEMBERSHIP
  TEAM
  DEPARTMENT
  BRANCH
  ORGANIZATION
}

/// 15 §5 — per-recipient assignment state.
enum FormAssignmentRecipientStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  OVERDUE
  CANCELLED
}

/// 15 §5 — submission lifecycle (review step is optional per form).
enum FormSubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  REVIEWED
  REJECTED
}

/// 15 §6 — kind of content an AI knowledge index entry was built from.
enum WikiAiSourceType {
  WIKI_PAGE
  CUSTOM_FORM
  FORM_SUBMISSION
  LINKED_RECORD
  /// 13 §3, §6 — customer-facing help-center article (KnowledgeArticle), indexed for semantic search and the AI support agent.
  KNOWLEDGE_ARTICLE
}

/// 15 §6 — index entry freshness.
enum WikiAiIndexStatus {
  PENDING
  INDEXED
  STALE
  FAILED
}

/// 15 §6 — AI proposals: new page drafts, updates to existing pages, stale and contradiction flags.
enum WikiAiSuggestionKind {
  DRAFT_PAGE
  UPDATE_PAGE
  STALE_PAGE
  CONTRADICTION
}

/// 15 §6 — review outcome of an AI suggestion.
enum WikiAiSuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
  DISMISSED
}

/// 15 §2 — where a page view came from.
enum WikiPageViewSource {
  UI
  SEARCH
  AI_CITATION
}

/// 15 §7 — search mode of a logged query.
enum WikiSearchMode {
  KEYWORD
  SEMANTIC
}

/// 15 §2 — import or export.
enum WikiTransferKind {
  IMPORT
  EXPORT
}

/// 15 §2 — file / source format of an import (source) or export (target).
enum WikiTransferFormat {
  MARKDOWN
  HTML
  DOCX
  PDF
  NOTION
  CONFLUENCE
  GOOGLE_DOCS
}

/// 15 §2 — what an export covers.
enum WikiTransferScope {
  PAGE
  SUBTREE
  SPACE
}

/// 15 §2 — import / export job state.
enum WikiTransferStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

/// 15 §2 — approval of a page version in a space that requires review before publishing.
enum WikiReviewRequestStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

// --- Spaces -----------------------------------------------------------------------

/// 15 §2, §4 — a space groups pages per department, team, branch, project or topic.
/// Exactly one of team_id / branch_id / department_id / project_id is normally set for the matching kind;
/// TOPIC spaces set none.
model WikiSpace {
  id                            String         @id @default(uuid())
  organization_id               String
  name                          String
  slug                          String
  description                   String?
  icon                          String?
  color                         String?
  kind                          WikiSpaceKind  @default(TOPIC)
  team_id                       String?
  branch_id                     String?
  /// Department = Team of kind DEPARTMENT (01 §43).
  department_id                 String?
  /// 15 §4 — project help center space (05 §34).
  project_id                    String?
  owner_membership_id           String?
  /// Default visibility applied to new pages in this space (15 §2).
  default_visibility            WikiVisibility @default(ORGANIZATION)
  /// Private spaces are visible only to WikiSpaceMember rows regardless of page visibility.
  is_private                    Boolean        @default(false)
  /// 15 §4 — pages of this space may be set customer_visible (WikiPage.customer_visible).
  allow_customer_visible        Boolean        @default(false)
  /// 15 §2 — members with edit access may publish; otherwise only space managers / `docs.pages.publish` holders.
  members_can_publish           Boolean        @default(true)
  /// 15 §2 — publishing goes through a WikiPageReviewRequest approval.
  require_review_before_publish Boolean        @default(false)
  sort_order                    Int            @default(0)
  archived_at                   DateTime?
  /// 15 §2 — trash: soft-deleted space, purged after the retention period (30 days). Different from archived.
  deleted_at                    DateTime?
  deleted_by_membership_id      String?
  created_by_user_id            String?
  created_at                    DateTime       @default(now())
  updated_at                    DateTime       @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [team_id], references: [id], onDelete: SetNull)
  branch       Branch?      @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  project      Project?     @relation(fields: [project_id], references: [id], onDelete: SetNull)
  owner        Membership?  @relation("WikiSpaceOwner", fields: [owner_membership_id], references: [id], onDelete: SetNull)

  members       WikiSpaceMember[]
  pages         WikiPage[]
  templates     WikiPageTemplate[]
  forms         CustomForm[]
  transfer_jobs WikiTransferJob[]

  department Team? @relation("WikiSpaceDepartment", fields: [department_id], references: [id], onDelete: SetNull)

  @@unique([organization_id, slug])
  @@index([organization_id, kind])
  @@index([team_id])
  @@index([branch_id])
  @@index([project_id])
  @@index([organization_id, deleted_at])
  @@map("wiki_spaces")
}

/// 15 §2, §8 — explicit space members with their access level (space managers hold `docs.spaces.manage`).
model WikiSpaceMember {
  space_id         String
  membership_id    String
  level            WikiPermissionLevel @default(VIEW)
  added_by_user_id String?
  created_at       DateTime            @default(now())

  space      WikiSpace  @relation(fields: [space_id], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membership_id], references: [id], onDelete: Cascade)

  @@id([space_id, membership_id])
  @@index([membership_id])
  @@map("wiki_space_members")
}

// --- Templates --------------------------------------------------------------------

/// 15 §2, §3 — page templates (policy, procedure, runbook, meeting notes, decision record, handbook chapter,
/// onboarding/offboarding guide). organization_id null = platform-provided system template.
model WikiPageTemplate {
  id                           String       @id @default(uuid())
  organization_id              String?
  /// Optional: template offered only inside this space.
  space_id                     String?
  name                         String
  slug                         String
  description                  String?
  icon                         String?
  page_type                    WikiPageType @default(GENERAL)
  /// Block-structured content (same shape as WikiPage.content).
  content                      Json?
  /// Markdown rendering of `content` for preview/search.
  content_markdown             String?
  /// Default review cadence for pages created from this template (15 §2).
  default_review_interval_days Int?
  is_system                    Boolean      @default(false)
  sort_order                   Int          @default(0)
  archived_at                  DateTime?
  created_by_user_id           String?
  created_at                   DateTime     @default(now())
  updated_at                   DateTime     @updatedAt

  organization Organization? @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  space        WikiSpace?    @relation(fields: [space_id], references: [id], onDelete: SetNull)
  pages        WikiPage[]

  @@unique([organization_id, slug])
  @@index([organization_id, page_type])
  @@map("wiki_page_templates")
}

// --- Pages ------------------------------------------------------------------------

/// 15 §2, §4 — a nested page. `content` is a block tree (Notion-style: paragraph, heading, list, checklist,
/// table, code, image/embed → Document (17), record link → RecordEntityType + id); `content_markdown` is
/// the rendered markdown used for search (15 §7) and AI indexing (15 §6).
model WikiPage {
  id                             String                   @id @default(uuid())
  organization_id                String
  space_id                       String
  parent_page_id                 String?
  template_id                    String?
  title                          String
  slug                           String
  icon                           String?
  /// Cover image Document (17); id only.
  cover_document_id              String?
  page_type                      WikiPageType             @default(GENERAL)
  status                         WikiPageStatus           @default(DRAFT)
  /// Block tree: [{ id, type, props, children: [...] }].
  content                        Json?
  content_markdown               String?
  /// Short plain-text excerpt for lists and search snippets.
  excerpt                        String?
  /// Materialized path of ancestor page ids (`/a/b/`), for subtree queries and breadcrumbs.
  path                           String                   @default("")
  depth                          Int                      @default(0)
  sort_order                     Int                      @default(0)
  // 15 §2 — visibility & exposure
  visibility                     WikiVisibility           @default(ORGANIZATION)
  /// 15 §4 — exposed through the Customer Portal (07) / help center (13 §6). Audited (15 §9).
  customer_visible               Boolean                  @default(false)
  /// 13 §6 KnowledgeArticle view published from this page (13 owns the article; the page is the source); id only.
  help_center_article_id         String?
  help_center_published_at       DateTime?
  // 15 §2 — ownership & review cadence
  owner_membership_id            String?
  review_interval_days           Int?
  last_reviewed_at               DateTime?
  last_reviewed_by_membership_id String?
  next_review_at                 DateTime?                @db.Date
  /// Set by stale detection (15 §2, §6) when next_review_at has passed or AI flagged it; cleared on review.
  stale_flagged_at               DateTime?
  /// 15 §3 — members assigned this page must acknowledge reading it (WikiPageAcknowledgement).
  requires_acknowledgement       Boolean                  @default(false)
  /// 15 §3 — default due date for the acknowledgements expanded from WikiPageAckTarget.
  ack_due_at                     DateTime?                @db.Date
  // 15 §2 — versions & publishing
  current_version_number         Int                      @default(0)
  published_at                   DateTime?
  published_by_membership_id     String?
  published_version_number       Int?
  /// Set while a member holds an edit lock (collaborative editing guard).
  locked_by_membership_id        String?
  locked_at                      DateTime?
  /// 15 §6 — page created or last rewritten by the AI assistant and accepted after review.
  ai_generated                   Boolean                  @default(false)
  last_edited_by_membership_id   String?
  last_edited_at                 DateTime?
  word_count                     Int                      @default(0)
  archived_at                    DateTime?
  /// 15 §2 — trash: soft-deleted page, purged after the retention period (30 days). Different from ARCHIVED status.
  deleted_at                     DateTime?
  deleted_by_membership_id       String?
  created_by_user_id             String?
  created_at                     DateTime                 @default(now())
  updated_at                     DateTime                 @updatedAt
  /// 15 §7 — Postgres full-text search vector over title + content_markdown; maintained by a database trigger (see migration). Not set by the API.
  search_vector                  Unsupported("tsvector")?

  organization Organization      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  space        WikiSpace         @relation(fields: [space_id], references: [id], onDelete: Cascade)
  parent       WikiPage?         @relation("WikiPageHierarchy", fields: [parent_page_id], references: [id], onDelete: SetNull)
  children     WikiPage[]        @relation("WikiPageHierarchy")
  template     WikiPageTemplate? @relation(fields: [template_id], references: [id], onDelete: SetNull)
  owner        Membership?       @relation("WikiPageOwner", fields: [owner_membership_id], references: [id], onDelete: SetNull)

  reviewers            WikiPageReviewer[]
  versions             WikiPageVersion[]
  permissions          WikiPagePermission[]
  links                WikiPageLink[]
  attachments          WikiPageAttachment[]
  comments             WikiPageComment[]
  favorites            WikiPageFavorite[]
  acknowledgements     WikiPageAcknowledgement[]
  checklist_guides     WikiChecklist[]           @relation("WikiChecklistGuidePage")
  checklist_items      WikiChecklistItem[]       @relation("WikiChecklistItemPage")
  ai_index_entries     WikiAiIndexEntry[]
  ai_suggestions       WikiAiSuggestion[]        @relation("WikiAiSuggestionPage")
  ai_related_in        WikiAiSuggestion[]        @relation("WikiAiSuggestionRelatedPage")
  // 05 §34 — projects that use this page as their runbook (Project.runbook_page_id).
  runbook_for_projects Project[]
  views                WikiPageView[]
  view_rollups         WikiPageViewDaily[]
  feedback             WikiPageFeedback[]
  ack_targets          WikiPageAckTarget[]
  watchers             WikiPageWatcher[]
  review_requests      WikiPageReviewRequest[]
  search_clicks        WikiSearchQuery[]
  transfer_jobs        WikiTransferJob[]

  @@unique([space_id, slug])
  @@index([organization_id, status])
  @@index([organization_id, customer_visible])
  @@index([search_vector], type: Gin)
  @@index([space_id, parent_page_id, sort_order])
  @@index([parent_page_id])
  @@index([owner_membership_id])
  @@index([next_review_at])
  @@index([path])
  @@index([organization_id, deleted_at])
  @@map("wiki_pages")
}

/// 15 §2 — members responsible for reviewing a page on its cadence.
model WikiPageReviewer {
  page_id       String
  membership_id String
  created_at    DateTime @default(now())

  page       WikiPage   @relation(fields: [page_id], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membership_id], references: [id], onDelete: Cascade)

  @@id([page_id, membership_id])
  @@index([membership_id])
  @@map("wiki_page_reviewers")
}

/// 15 §2 — immutable snapshot per save/publish; `WikiPage.current_version_number` points at the latest.
model WikiPageVersion {
  id                       String   @id @default(uuid())
  page_id                  String
  version_number           Int
  title                    String
  content                  Json?
  content_markdown         String?
  /// Optional author note describing the change.
  change_summary           String?
  /// True when this snapshot was the published copy at the time.
  is_published_snapshot    Boolean  @default(false)
  /// Version this one was restored from, when created by a rollback.
  restored_from_version_id String?
  /// 15 §6 — produced by accepting an AI suggestion.
  ai_suggestion_id         String?
  created_by_membership_id String?
  created_at               DateTime @default(now())

  page WikiPage @relation(fields: [page_id], references: [id], onDelete: Cascade)

  @@unique([page_id, version_number])
  @@index([page_id, created_at])
  @@map("wiki_page_versions")
}

/// 15 §2, §8 — explicit grant on a page to a member, team, branch, role or department (10).
/// Enumerates the principals for BRANCH / TEAM / ROLE / MEMBERS visibility and allows per-page overrides.
/// principal_id references memberships / teams / branches / roles or an Department = Team of kind DEPARTMENT (01 §43).
model WikiPagePermission {
  id                 String              @id @default(uuid())
  page_id            String
  principal_type     WikiPrincipalType
  principal_id       String
  level              WikiPermissionLevel @default(VIEW)
  /// Grant also applies to descendant pages.
  inherit            Boolean             @default(true)
  granted_by_user_id String?
  created_at         DateTime            @default(now())

  page WikiPage @relation(fields: [page_id], references: [id], onDelete: Cascade)

  @@unique([page_id, principal_type, principal_id])
  @@index([principal_type, principal_id])
  @@map("wiki_page_permissions")
}

/// 15 §2, §4, §6 — link from a page to a platform record (project, customer, task, document, ticket …).
/// Also fed to the AI index as context (15 §6).
model WikiPageLink {
  id                 String           @id @default(uuid())
  page_id            String
  entity_type        RecordEntityType
  entity_id          String
  /// Optional display label; block_id anchors the link to a content block.
  label              String?
  block_id           String?
  created_by_user_id String?
  created_at         DateTime         @default(now())

  page WikiPage @relation(fields: [page_id], references: [id], onDelete: Cascade)

  @@unique([page_id, entity_type, entity_id])
  @@index([entity_type, entity_id])
  @@map("wiki_page_links")
}

/// 15 §2 — files/images embedded in a page are Documents (17); id only.
model WikiPageAttachment {
  id               String   @id @default(uuid())
  page_id          String
  document_id      String
  /// Content block that embeds the document.
  block_id         String?
  added_by_user_id String?
  created_at       DateTime @default(now())

  page WikiPage @relation(fields: [page_id], references: [id], onDelete: Cascade)

  @@unique([page_id, document_id])
  @@index([document_id])
  @@map("wiki_page_attachments")
}

/// 15 §2 — threaded page comments with mentions (14 notifies), optionally anchored to a block, resolvable.
model WikiPageComment {
  id                        String    @id @default(uuid())
  page_id                   String
  parent_comment_id         String?
  author_membership_id      String?
  /// Content block the comment is anchored to; null = page-level comment.
  block_id                  String?
  body                      String
  /// Membership ids mentioned.
  mentions                  String[]  @default([])
  /// { emoji: [membership_id, …] }
  reactions                 Json?
  resolved_at               DateTime?
  resolved_by_membership_id String?
  edited_at                 DateTime?
  deleted_at                DateTime?
  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt

  page    WikiPage          @relation(fields: [page_id], references: [id], onDelete: Cascade)
  parent  WikiPageComment?  @relation("WikiPageCommentThread", fields: [parent_comment_id], references: [id], onDelete: Cascade)
  replies WikiPageComment[] @relation("WikiPageCommentThread")
  author  Membership?       @relation("WikiPageCommentAuthor", fields: [author_membership_id], references: [id], onDelete: SetNull)

  @@index([page_id, created_at])
  @@index([parent_comment_id])
  @@map("wiki_page_comments")
}

/// 15 §2 — a member's favorite (starred) pages for the sidebar.
model WikiPageFavorite {
  page_id       String
  membership_id String
  sort_order    Int      @default(0)
  created_at    DateTime @default(now())

  page       WikiPage   @relation(fields: [page_id], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membership_id], references: [id], onDelete: Cascade)

  @@id([page_id, membership_id])
  @@index([membership_id])
  @@map("wiki_page_favorites")
}

/// 15 §3 — required-reading acknowledgement tracking: one row per member per page; re-acknowledgement
/// is required when `acknowledged_version_number` falls behind the published version.
model WikiPageAcknowledgement {
  id                          String    @id @default(uuid())
  page_id                     String
  membership_id               String
  /// Checklist run item that required the reading, when applicable.
  checklist_run_item_id       String?
  required_by                 DateTime? @db.Date
  acknowledged_at             DateTime?
  acknowledged_version_number Int?
  created_at                  DateTime  @default(now())
  updated_at                  DateTime  @updatedAt

  page       WikiPage   @relation(fields: [page_id], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membership_id], references: [id], onDelete: Cascade)

  @@unique([page_id, membership_id])
  @@index([membership_id, acknowledged_at])
  @@index([required_by])
  @@map("wiki_page_acknowledgements")
}

// --- Onboarding & offboarding checklists ------------------------------------------

/// 15 §3 — onboarding/offboarding checklist definition per department and/or role (01 §130–131).
/// Items generate Tasks (06) when a run starts.
model WikiChecklist {
  id                  String            @id @default(uuid())
  organization_id     String
  kind                WikiChecklistKind
  name                String
  description         String?
  /// Department = Team of kind DEPARTMENT (01 §43).
  department_id       String?
  /// Role (01) this checklist applies to; null = all roles.
  role_id             String?
  team_id             String?
  branch_id           String?
  /// Guide page shown to the member alongside the checklist.
  guide_page_id       String?
  owner_membership_id String?
  /// Auto-start on member onboarding/offboarding (01 §130–131) when department/role match.
  auto_assign         Boolean           @default(true)
  is_active           Boolean           @default(true)
  archived_at         DateTime?
  created_by_user_id  String?
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt

  organization Organization        @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  role         Role?               @relation(fields: [role_id], references: [id], onDelete: SetNull)
  guide_page   WikiPage?           @relation("WikiChecklistGuidePage", fields: [guide_page_id], references: [id], onDelete: SetNull)
  items        WikiChecklistItem[]
  runs         WikiChecklistRun[]

  department Team? @relation("WikiChecklistDepartment", fields: [department_id], references: [id], onDelete: SetNull)

  @@index([organization_id, kind, is_active])
  @@index([department_id])
  @@index([role_id])
  @@map("wiki_checklists")
}

/// 15 §3 — a step in a checklist: a task to do, a page to read (with acknowledgement) or a form to fill (15 §5).
model WikiChecklistItem {
  id                       String                    @id @default(uuid())
  checklist_id             String
  title                    String
  description              String?
  sort_order               Int                       @default(0)
  /// Required reading page.
  page_id                  String?
  requires_acknowledgement Boolean                   @default(false)
  /// Form to complete (equipment request, compliance acknowledgement …).
  form_id                  String?
  /// Days after run start by which the generated Task is due.
  due_offset_days          Int?
  assignee_kind            WikiChecklistAssigneeKind @default(SUBJECT)
  assignee_membership_id   String?
  /// Task type (06 §3) for the generated Task; id only.
  task_type_id             String?
  is_required              Boolean                   @default(true)
  created_at               DateTime                  @default(now())
  updated_at               DateTime                  @updatedAt

  checklist WikiChecklist          @relation(fields: [checklist_id], references: [id], onDelete: Cascade)
  page      WikiPage?              @relation("WikiChecklistItemPage", fields: [page_id], references: [id], onDelete: SetNull)
  form      CustomForm?            @relation(fields: [form_id], references: [id], onDelete: SetNull)
  run_items WikiChecklistRunItem[]

  @@index([checklist_id, sort_order])
  @@map("wiki_checklist_items")
}

/// 15 §3 — a checklist executed for one member; progress is tracked per employee (10).
model WikiChecklistRun {
  id                    String                 @id @default(uuid())
  organization_id       String
  checklist_id          String
  subject_membership_id String
  /// Employees (10) Employee record of the subject; id only.
  employee_id           String?
  status                WikiChecklistRunStatus @default(NOT_STARTED)
  triggered_by          WikiChecklistTrigger   @default(MANUAL)
  /// Automation run (20) that started it; id only.
  automation_run_id     String?
  started_at            DateTime?
  due_at                DateTime?              @db.Date
  completed_at          DateTime?
  cancelled_at          DateTime?
  progress_percent      Int                    @default(0)
  created_by_user_id    String?
  created_at            DateTime               @default(now())
  updated_at            DateTime               @updatedAt

  organization Organization           @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  checklist    WikiChecklist          @relation(fields: [checklist_id], references: [id], onDelete: Cascade)
  subject      Membership             @relation("WikiChecklistRunSubject", fields: [subject_membership_id], references: [id], onDelete: Cascade)
  items        WikiChecklistRunItem[]

  @@index([organization_id, status])
  @@index([checklist_id])
  @@index([subject_membership_id, status])
  @@index([employee_id])
  @@map("wiki_checklist_runs")
}

/// 15 §3 — item state inside a run; `task_id` is the generated Task (06).
model WikiChecklistRunItem {
  id                         String                  @id @default(uuid())
  run_id                     String
  checklist_item_id          String
  task_id                    String?
  status                     WikiChecklistItemStatus @default(PENDING)
  /// Submission that satisfied a form item.
  form_submission_id         String?
  completed_by_membership_id String?
  completed_at               DateTime?
  skipped_reason             String?
  created_at                 DateTime                @default(now())
  updated_at                 DateTime                @updatedAt

  run            WikiChecklistRun  @relation(fields: [run_id], references: [id], onDelete: Cascade)
  checklist_item WikiChecklistItem @relation(fields: [checklist_item_id], references: [id], onDelete: Cascade)
  task           Task?             @relation(fields: [task_id], references: [id], onDelete: SetNull)

  @@unique([run_id, checklist_item_id])
  @@index([task_id])
  @@map("wiki_checklist_run_items")
}

// --- Custom forms -----------------------------------------------------------------

/// 15 §5 — form builder definition. `fields_schema` is the editable draft; each publish freezes a
/// CustomFormVersion that submissions reference. Shape:
/// [{ key, type: CustomFormFieldType, label, description?, required, options?: [{ value, label }],
///    scale?: { min, max, min_label?, max_label? }, accept?: [mime], max_files?, conditions?: {...} }]
model CustomForm {
  id                         String           @id @default(uuid())
  organization_id            String
  /// Optional home space (15 §2) so the form is browsable with related pages.
  space_id                   String?
  name                       String
  slug                       String
  description                String?
  kind                       CustomFormKind   @default(CUSTOM)
  status                     CustomFormStatus @default(DRAFT)
  fields_schema              Json
  /// 15 §5 — anonymous forms never store respondent ids (enforced at storage).
  is_anonymous               Boolean          @default(false)
  allow_multiple_submissions Boolean          @default(false)
  /// Submissions require review by a reviewer before they count as REVIEWED.
  requires_review            Boolean          @default(false)
  /// Membership ids allowed to review responses (`docs.forms.review`).
  reviewer_membership_ids    String[]         @default([])
  confirmation_message       String?
  /// Automatic 06 Task / 13 Ticket creation is configured in 20 rules; this is the default hint shown there.
  opens_at                   DateTime?
  closes_at                  DateTime?
  current_version_number     Int              @default(0)
  owner_membership_id        String?
  published_at               DateTime?
  archived_at                DateTime?
  created_by_user_id         String?
  created_at                 DateTime         @default(now())
  updated_at                 DateTime         @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  space        WikiSpace?   @relation(fields: [space_id], references: [id], onDelete: SetNull)
  owner        Membership?  @relation("CustomFormOwner", fields: [owner_membership_id], references: [id], onDelete: SetNull)

  versions         CustomFormVersion[]
  assignments      FormAssignment[]
  submissions      FormSubmission[]
  checklist_items  WikiChecklistItem[]
  ai_index_entries WikiAiIndexEntry[]

  @@unique([organization_id, slug])
  @@index([organization_id, status])
  @@index([space_id])
  @@map("custom_forms")
}

/// 15 §5 — frozen copy of fields_schema at publish time so old submissions stay interpretable.
model CustomFormVersion {
  id                 String   @id @default(uuid())
  form_id            String
  version_number     Int
  fields_schema      Json
  change_summary     String?
  created_by_user_id String?
  created_at         DateTime @default(now())

  form        CustomForm       @relation(fields: [form_id], references: [id], onDelete: Cascade)
  submissions FormSubmission[]

  @@unique([form_id, version_number])
  @@map("custom_form_versions")
}

/// 15 §5 — an assignment of a form to a member, team, department (10), branch or the whole organization,
/// with due date and reminders (14, 20). Recipients are expanded into FormAssignmentRecipient rows.
model FormAssignment {
  id                        String                   @id @default(uuid())
  organization_id           String
  form_id                   String
  target_type               FormAssignmentTargetType
  /// memberships / teams / branches id or Department = Team of kind DEPARTMENT (01 §43) id; null for ORGANIZATION.
  target_id                 String?
  due_at                    DateTime?
  /// Reminder schedule: { days_before: [7, 1], after_due_every_days?: 3 } delivered via 14/20.
  reminders                 Json?
  message                   String?
  /// Automation rule (20) that created the assignment; id only.
  automation_rule_id        String?
  assigned_by_membership_id String?
  recipient_count           Int                      @default(0)
  submitted_count           Int                      @default(0)
  cancelled_at              DateTime?
  created_at                DateTime                 @default(now())
  updated_at                DateTime                 @updatedAt

  organization Organization              @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  form         CustomForm                @relation(fields: [form_id], references: [id], onDelete: Cascade)
  recipients   FormAssignmentRecipient[]

  @@index([organization_id, form_id])
  @@index([target_type, target_id])
  @@index([due_at])
  @@map("form_assignments")
}

/// 15 §5 — per-member state of an assignment. For anonymous forms `submission_id` stays null and only
/// `status` moves to SUBMITTED, so completion is trackable without linking the response.
model FormAssignmentRecipient {
  id               String                        @id @default(uuid())
  assignment_id    String
  membership_id    String
  status           FormAssignmentRecipientStatus @default(PENDING)
  submission_id    String?                       @unique
  last_reminded_at DateTime?
  reminder_count   Int                           @default(0)
  submitted_at     DateTime?
  created_at       DateTime                      @default(now())
  updated_at       DateTime                      @updatedAt

  assignment FormAssignment  @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  membership Membership      @relation(fields: [membership_id], references: [id], onDelete: Cascade)
  submission FormSubmission? @relation(fields: [submission_id], references: [id], onDelete: SetNull)

  @@unique([assignment_id, membership_id])
  @@index([membership_id, status])
  @@map("form_assignment_recipients")
}

/// 15 §5 — a response. `answers` = { [field_key]: value } (files hold FormSubmissionFile ids). When the form
/// is anonymous, respondent_membership_id, submitted_by_user_id and client metadata are never written.
model FormSubmission {
  id                        String               @id @default(uuid())
  organization_id           String
  form_id                   String
  form_version_id           String
  respondent_membership_id  String?
  submitted_by_user_id      String?
  is_anonymous              Boolean              @default(false)
  status                    FormSubmissionStatus @default(SUBMITTED)
  answers                   Json
  submitted_at              DateTime?
  // 15 §5 — review
  reviewed_by_membership_id String?
  reviewed_at               DateTime?
  review_notes              String?
  /// 15 §5 — records created from this response by 20 rules; ids only (Ticket is 13).
  created_task_id           String?
  created_ticket_id         String?
  /// 15 §6 — excluded from AI indexing (always true for anonymous forms).
  exclude_from_ai_index     Boolean              @default(false)
  created_at                DateTime             @default(now())
  updated_at                DateTime             @updatedAt

  organization Organization      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  form         CustomForm        @relation(fields: [form_id], references: [id], onDelete: Cascade)
  form_version CustomFormVersion @relation(fields: [form_version_id], references: [id], onDelete: Restrict)
  respondent   Membership?       @relation("FormSubmissionRespondent", fields: [respondent_membership_id], references: [id], onDelete: SetNull)
  created_task Task?             @relation(fields: [created_task_id], references: [id], onDelete: SetNull)

  files                FormSubmissionFile[]
  assignment_recipient FormAssignmentRecipient?
  ai_index_entries     WikiAiIndexEntry[]

  @@index([organization_id, form_id, status])
  @@index([form_id, submitted_at])
  @@index([respondent_membership_id])
  @@map("form_submissions")
}

/// 15 §5 — uploaded files and signature images for FILE_UPLOAD / SIGNATURE fields; stored as Documents (17).
model FormSubmissionFile {
  id            String   @id @default(uuid())
  submission_id String
  field_key     String
  document_id   String
  created_at    DateTime @default(now())

  submission FormSubmission @relation(fields: [submission_id], references: [id], onDelete: Cascade)

  @@index([submission_id, field_key])
  @@index([document_id])
  @@map("form_submission_files")
}

// --- AI knowledge index -----------------------------------------------------------

/// 15 §6, §7 — one retrievable chunk of a page, form or submission for the shared AI layer and semantic
/// search. `embedding` is a float vector (switch to pgvector `Unsupported("vector")` in a migration when
/// ANN search is needed). Visibility columns are denormalised so retrieval can be permission-filtered
/// before ranking (15 §6, §7).
model WikiAiIndexEntry {
  id               String            @id @default(uuid())
  organization_id  String
  source_type      WikiAiSourceType
  source_id        String
  page_id          String?
  form_id          String?
  submission_id    String?
  /// Chunk position inside the source document.
  chunk_index      Int               @default(0)
  /// Heading path of the chunk (e.g. "Onboarding > Day 1").
  heading_path     String?
  content_text     String
  content_hash     String
  token_count      Int?
  embedding        Float[]           @default([])
  embedding_model  String?
  // Denormalised permission context from the source page/space
  space_id         String?
  visibility       WikiVisibility?
  customer_visible Boolean           @default(false)
  source_version   Int?
  status           WikiAiIndexStatus @default(PENDING)
  indexed_at       DateTime?
  error            String?
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt

  organization         Organization      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  page                 WikiPage?         @relation(fields: [page_id], references: [id], onDelete: Cascade)
  form                 CustomForm?       @relation(fields: [form_id], references: [id], onDelete: Cascade)
  submission           FormSubmission?   @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  /// 13 §6 — source help-center article when source_type = KNOWLEDGE_ARTICLE; only PUBLISHED articles are indexed.
  knowledge_article_id String?
  knowledge_article    KnowledgeArticle? @relation(fields: [knowledge_article_id], references: [id], onDelete: Cascade)

  @@unique([source_type, source_id, chunk_index])
  @@index([organization_id, status])
  @@index([organization_id, space_id, visibility])
  @@index([page_id])
  @@index([knowledge_article_id])
  @@map("wiki_ai_index_entries")
}

/// 15 §6 — AI-proposed page drafts/updates (from conversations, meetings, resolved tickets) and stale or
/// contradiction flags, held for human review before they touch a page.
model WikiAiSuggestion {
  id                        String                 @id @default(uuid())
  organization_id           String
  kind                      WikiAiSuggestionKind
  status                    WikiAiSuggestionStatus @default(PENDING)
  /// Target page for UPDATE_PAGE / STALE_PAGE / CONTRADICTION; null for a brand-new draft.
  page_id                   String?
  /// Second page involved in a CONTRADICTION.
  related_page_id           String?
  /// Space a DRAFT_PAGE would be created in.
  space_id                  String?
  title                     String?
  /// Proposed block content and markdown (same shapes as WikiPage).
  content                   Json?
  content_markdown          String?
  /// Why the AI proposed this (summary, contradiction details).
  rationale                 String?
  /// Source the draft was derived from (ticket 13, conversation 12, calendar event 19 …).
  source_entity_type        RecordEntityType?
  source_entity_id          String?
  /// Index entry ids cited as evidence.
  citation_entry_ids        String[]               @default([])
  confidence                Decimal?               @db.Decimal(5, 2)
  model_name                String?
  reviewed_by_membership_id String?
  reviewed_at               DateTime?
  review_notes              String?
  /// Version created when the suggestion was accepted.
  resulting_version_id      String?
  created_at                DateTime               @default(now())
  updated_at                DateTime               @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  page         WikiPage?    @relation("WikiAiSuggestionPage", fields: [page_id], references: [id], onDelete: Cascade)
  related_page WikiPage?    @relation("WikiAiSuggestionRelatedPage", fields: [related_page_id], references: [id], onDelete: SetNull)

  @@index([organization_id, status, kind])
  @@index([page_id])
  @@index([source_entity_type, source_entity_id])
  @@map("wiki_ai_suggestions")
}

/// 15 §2 — one row per page open (Recent pages, reader analytics). Retained 180 days, rolled up daily in WikiPageViewDaily.
model WikiPageView {
  id              String             @id @default(uuid())
  organization_id String
  page_id         String
  membership_id   String
  version_number  Int?
  source          WikiPageViewSource @default(UI)
  viewed_at       DateTime           @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  page         WikiPage     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  membership   Membership   @relation(fields: [membership_id], references: [id], onDelete: Cascade)

  @@index([membership_id, viewed_at(sort: Desc)])
  @@index([page_id, viewed_at])
  @@index([organization_id, viewed_at])
  @@map("wiki_page_views")
}

/// 15 §2 — daily rollup of WikiPageView kept after the raw rows expire (reader analytics, popular pages).
model WikiPageViewDaily {
  page_id         String
  day             DateTime @db.Date
  organization_id String
  view_count      Int      @default(0)
  unique_readers  Int      @default(0)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  page         WikiPage     @relation(fields: [page_id], references: [id], onDelete: Cascade)

  @@id([page_id, day])
  @@index([organization_id, day])
  @@map("wiki_page_view_daily")
}

/// 15 §7 — search log: top searches, zero-result tracking, click-through.
model WikiSearchQuery {
  id              String         @id @default(uuid())
  organization_id String
  membership_id   String?
  query           String
  mode            WikiSearchMode @default(KEYWORD)
  filters         Json?
  result_count    Int            @default(0)
  clicked_page_id String?
  created_at      DateTime       @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  membership   Membership?  @relation(fields: [membership_id], references: [id], onDelete: SetNull)
  clicked_page WikiPage?    @relation(fields: [clicked_page_id], references: [id], onDelete: SetNull)

  @@index([organization_id, created_at])
  @@index([organization_id, result_count, created_at])
  @@map("wiki_search_queries")
}

/// 15 §2 — "was this page helpful" feedback, one per member per page (updated in place).
model WikiPageFeedback {
  id              String   @id @default(uuid())
  organization_id String
  page_id         String
  membership_id   String
  helpful         Boolean
  comment         String?
  version_number  Int?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  page         WikiPage     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  membership   Membership   @relation(fields: [membership_id], references: [id], onDelete: Cascade)

  @@unique([page_id, membership_id])
  @@index([organization_id, created_at])
  @@map("wiki_page_feedback")
}

/// 15 §2, §10 — import / export job (Markdown, HTML, DOCX, PDF, Notion, Confluence, Google Docs).
model WikiTransferJob {
  id                         String             @id @default(uuid())
  organization_id            String
  kind                       WikiTransferKind
  /// Source format for IMPORT, target format for EXPORT.
  format                     WikiTransferFormat
  scope                      WikiTransferScope  @default(PAGE)
  space_id                   String?
  page_id                    String?
  /// 17 Documents uploaded as import source; ids only.
  source_document_ids        String[]           @default([])
  /// 17 Document holding the export archive; id only.
  result_document_id         String?
  status                     WikiTransferStatus @default(QUEUED)
  page_count                 Int                @default(0)
  warning_count              Int                @default(0)
  error_report               Json?
  requested_by_membership_id String?
  created_at                 DateTime           @default(now())
  finished_at                DateTime?

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  space        WikiSpace?   @relation(fields: [space_id], references: [id], onDelete: SetNull)
  page         WikiPage?    @relation(fields: [page_id], references: [id], onDelete: SetNull)

  @@index([organization_id, status, created_at])
  @@map("wiki_transfer_jobs")
}

/// 15 §3 — who must acknowledge a page (member, team, branch, role or department). Expanded into
/// WikiPageAcknowledgement rows on publish and for new members; the denominator of "17 of 24".
model WikiPageAckTarget {
  id             String            @id @default(uuid())
  page_id        String
  principal_type WikiPrincipalType
  principal_id   String
  /// Overrides WikiPage.ack_due_at for this target.
  due_at         DateTime?         @db.Date
  created_at     DateTime          @default(now())

  page WikiPage @relation(fields: [page_id], references: [id], onDelete: Cascade)

  @@unique([page_id, principal_type, principal_id])
  @@index([principal_type, principal_id])
  @@map("wiki_page_ack_targets")
}

/// 15 §2 — member follows a page and is notified (14) on publish and comments. Author, owner, reviewers and mentioned members follow implicitly.
model WikiPageWatcher {
  page_id       String
  membership_id String
  created_at    DateTime @default(now())

  page       WikiPage   @relation(fields: [page_id], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membership_id], references: [id], onDelete: Cascade)

  @@id([page_id, membership_id])
  @@index([membership_id])
  @@map("wiki_page_watchers")
}

/// 15 §2 — review request for a page version in a space with require_review_before_publish.
model WikiPageReviewRequest {
  id                         String                  @id @default(uuid())
  page_id                    String
  version_number             Int
  requested_by_membership_id String?
  reviewer_membership_id     String
  status                     WikiReviewRequestStatus @default(PENDING)
  notes                      String?
  decided_at                 DateTime?
  created_at                 DateTime                @default(now())

  page     WikiPage   @relation(fields: [page_id], references: [id], onDelete: Cascade)
  reviewer Membership @relation("WikiReviewRequestReviewer", fields: [reviewer_membership_id], references: [id], onDelete: Cascade)

  @@index([page_id, version_number])
  @@index([reviewer_membership_id, status])
  @@map("wiki_page_review_requests")
}

// =====================================================================
// 17 Documents & File Management — docs/features/17-documents-file-management.md (LOG-407)
// Owns: the Document record and its file versions, folders and folder templates, upload/intake jobs,
// previews, polymorphic attachments, shares (members, teams, portal users, external, public links),
// document-level approvals, retention policies / legal hold / deletion, storage provider connections
// and the encrypted credential vault (entries, grants, access log, per-organization keys).
// Does not own: the meaning of a document (contracts 04, deliverables 05, invoices 08 reference it),
// contract approval & signatures (04), deliverable acceptance (05 §47), notes/comments (02 crm_notes),
// tags/custom fields (02), notifications (14), OCR extraction (09), employees (10). Referenced by id only.
// Access events (download, share, reveal, retention changes) are written to audit_events (17 §15).
// =====================================================================

/// 17 §4 — lifecycle status of a Document record.
enum DocumentStatus {
  DRAFT
  ACTIVE
  APPROVED
  ARCHIVED
  DELETED
}

/// 17 §3 — scope that drives default visibility (01 §39, §85).
enum DocumentScope {
  ORGANIZATION
  BRANCH
  TEAM
  PROJECT
  CUSTOMER
  EMPLOYEE
  RECORD
}

/// 17 §5, §16 — how a document / version entered the system.
enum DocumentSource {
  UPLOAD
  URL_IMPORT
  PORTAL_UPLOAD
  EMAIL_CAPTURE
  GENERATED
  OCR_INTAKE
  EXTERNAL_LINK
  API
}

/// 17 §5–6 — availability of a file version (scanning gates availability).
enum DocumentVersionStatus {
  PENDING
  SCANNING
  AVAILABLE
  QUARANTINED
  FAILED
}

/// 17 §5 — virus / malware scan result.
enum DocumentScanStatus {
  PENDING
  SCANNING
  CLEAN
  INFECTED
  FAILED
  SKIPPED
}

/// 17 §16 — storage provider behind the storage abstraction.
enum DocumentStorageProvider {
  PLATFORM
  S3_COMPATIBLE
  GOOGLE_DRIVE
  MICROSOFT_365
}

/// 17 §16 — external storage connection health.
enum DocumentStorageConnectionStatus {
  PENDING
  CONNECTED
  ERROR
  DISCONNECTED
}

/// 17 §5 — upload / intake job states.
enum DocumentUploadJobStatus {
  PENDING
  UPLOADING
  SCANNING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

/// 17 §8 — preview renditions.
enum DocumentPreviewKind {
  THUMBNAIL
  IMAGE
  PDF
  TEXT
  VIDEO
  AUDIO
}

/// 17 §8
enum DocumentPreviewStatus {
  PENDING
  READY
  FAILED
  UNSUPPORTED
}

/// 17 §9 — who a share targets.
enum DocumentShareSubjectType {
  MEMBERSHIP
  TEAM
  PORTAL_USER
  EXTERNAL_EMAIL
  PUBLIC_LINK
}

/// 17 §9 — permission levels of a share.
enum DocumentSharePermission {
  VIEW
  COMMENT
  EDIT
  MANAGE
}

/// 17 §9
enum DocumentShareStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

/// 17 §10 — approval request state.
enum DocumentApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  CANCELLED
}

/// 17 §10 — an approver's decision.
enum DocumentApprovalDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

/// 17 §10 — internal member or Customer Portal user (07 §7).
enum DocumentApproverKind {
  MEMBERSHIP
  PORTAL_USER
}

/// 17 §7 — folder templates apply per project type (05 §36) or per customer.
enum FolderTemplateTarget {
  PROJECT_TYPE
  CUSTOMER
  EMPLOYEE
  ORGANIZATION
}

/// 17 §13 — from which moment the retention period counts.
enum DocumentRetentionAnchor {
  CREATED
  LAST_MODIFIED
  ARCHIVED
  RECORD_CLOSED
}

/// 17 §13 — what happens when the retention period ends.
enum DocumentRetentionAction {
  ARCHIVE
  SOFT_DELETE
  PERMANENT_DELETE
}

/// 17 §13 — restricted permanent deletion workflow.
enum DocumentDeletionKind {
  SOFT
  PERMANENT
  RETENTION
}

/// 17 §13
enum DocumentDeletionStatus {
  REQUESTED
  APPROVED
  EXECUTED
  REJECTED
  CANCELLED
}

/// 17 §12 — vault entry types.
enum VaultEntryType {
  PASSWORD
  API_KEY
  SSH_KEY
  NOTE
  FILE
}

/// 17 §12 — vault scope.
enum VaultScope {
  ORGANIZATION
  CUSTOMER
  PROJECT
}

/// 17 §12 — who a vault grant targets.
enum VaultGrantSubjectType {
  MEMBERSHIP
  TEAM
  PORTAL_USER
}

/// 17 §12, §15 — logged vault actions (reveal / copy are explicit).
enum VaultAccessAction {
  VIEW
  REVEAL
  COPY
  CREATE
  UPDATE
  ROTATE
  DELETE
  GRANT
  REVOKE
}

/// 17 §12 — per-organization encryption key lifecycle.
enum VaultKeyStatus {
  ACTIVE
  ROTATING
  RETIRED
}

// --- Configuration ----------------------------------------------------------------

/// 17 §5, §8, §9, §13 — organization-level document settings: file type / size limits, scanning,
/// public links, watermarking, soft-delete recovery window, folder depth, portal upload and vault sharing.
model DocumentSettings {
  organization_id              String                  @id
  /// 17 §5 — max size of a single upload in bytes.
  max_file_size_bytes          BigInt                  @default(104857600)
  /// 17 §5 — allowed MIME types / extensions; empty = all except blocked.
  allowed_mime_types           String[]                @default([])
  blocked_extensions           String[]                @default([])
  /// 17 §5 — a version becomes AVAILABLE only after a CLEAN scan.
  virus_scan_required          Boolean                 @default(true)
  /// 17 §7 — configurable folder hierarchy depth.
  folder_max_depth             Int                     @default(10)
  /// 17 §9 — public links only when enabled by organization policy, always expiring.
  public_links_enabled         Boolean                 @default(false)
  public_link_max_days         Int                     @default(30)
  /// 17 §9 — default expiry for non-public shares (null = no expiry).
  default_share_expiry_days    Int?
  /// 17 §8 — watermark customer-facing documents by default.
  watermark_customer_documents Boolean                 @default(false)
  /// 17 §8 — lifetime of signed download / preview URLs.
  signed_url_ttl_seconds       Int                     @default(900)
  /// 17 §13 — soft delete recovery window.
  soft_delete_recovery_days    Int                     @default(30)
  /// 17 §5 — Customer Portal uploads into permitted folders, projects, tickets, conversations (07 §9).
  portal_upload_enabled        Boolean                 @default(true)
  /// 17 §12 — vault sharing to Customer Portal users (Phase 2).
  vault_portal_sharing_enabled Boolean                 @default(false)
  /// 17 §12 — reveal must be re-authenticated after this many minutes (null = never).
  vault_reveal_reauth_minutes  Int?
  /// 17 §11 — full-text extraction enabled (Phase 2).
  full_text_extraction_enabled Boolean                 @default(false)
  /// 17 §16 — default storage provider for new versions when no connection is marked default.
  default_storage_provider     DocumentStorageProvider @default(PLATFORM)
  created_at                   DateTime                @default(now())
  updated_at                   DateTime                @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@map("document_settings")
}

/// 17 §4 — configurable document categories (contract, proposal, deliverable, design, specification,
/// invoice, receipt, HR document, policy, other). System categories are seeded per organization.
model DocumentCategory {
  id                          String    @id @default(uuid())
  organization_id             String
  name                        String
  slug                        String
  description                 String?
  icon                        String?
  color                       String?
  /// Seeded by the platform; cannot be deleted, only archived.
  is_system                   Boolean   @default(false)
  /// 17 §8, §15 — downloads of this category are audited; documents default to is_sensitive.
  is_sensitive                Boolean   @default(false)
  /// 17 §8 — documents of this category default to customer_visible when shared to the portal.
  customer_visible_default    Boolean   @default(false)
  /// 17 §13 — default retention policy applied to new documents of this category.
  default_retention_policy_id String?
  sort_order                  Int       @default(0)
  archived_at                 DateTime?
  created_at                  DateTime  @default(now())
  updated_at                  DateTime  @updatedAt

  organization             Organization              @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  default_retention_policy DocumentRetentionPolicy?  @relation("DocumentCategoryDefaultRetention", fields: [default_retention_policy_id], references: [id], onDelete: SetNull)
  documents                Document[]
  retention_policies       DocumentRetentionPolicy[] @relation("DocumentRetentionPolicyCategory")
  document_templates       DocumentTemplate[]

  @@unique([organization_id, slug])
  @@index([organization_id, sort_order])
  @@map("document_categories")
}

/// 17 §16 — external storage provider connection (Google Drive, Microsoft 365, S3-compatible) behind the
/// storage abstraction. The Document record stays in this module; only bytes live in the provider.
model DocumentStorageConnection {
  id                   String                          @id @default(uuid())
  organization_id      String
  provider             DocumentStorageProvider
  name                 String
  status               DocumentStorageConnectionStatus @default(PENDING)
  /// Bucket / drive / site identifier and root prefix.
  root_identifier      String?
  root_path            String?
  region               String?
  endpoint_url         String?
  /// Reference to encrypted credentials (vault key id + ciphertext); never plain text.
  credentials_ref      String?
  /// Non-secret provider options.
  config               Json?
  is_default           Boolean                         @default(false)
  last_checked_at      DateTime?
  last_error           String?
  connected_by_user_id String?
  disconnected_at      DateTime?
  created_at           DateTime                        @default(now())
  updated_at           DateTime                        @updatedAt

  organization Organization      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  versions     DocumentVersion[]

  @@index([organization_id, provider])
  @@index([organization_id, is_default])
  @@map("document_storage_connections")
}

/// 17 §13 — retention policies per category and scope (04 §84 contract retention is enforced here).
model DocumentRetentionPolicy {
  id                 String                  @id @default(uuid())
  organization_id    String
  name               String
  description        String?
  /// Null = any category.
  category_id        String?
  /// Null = any scope.
  scope              DocumentScope?
  /// Retention period in days; null = retain indefinitely (policy then only applies legal hold rules).
  retain_days        Int?
  anchor             DocumentRetentionAnchor @default(CREATED)
  action             DocumentRetentionAction @default(ARCHIVE)
  /// Module that mandates this policy (e.g. CONTRACTS for 04 §84); null for organization policies.
  enforced_by_module ModuleKey?
  is_active          Boolean                 @default(true)
  is_default         Boolean                 @default(false)
  created_by_user_id String?
  archived_at        DateTime?
  created_at         DateTime                @default(now())
  updated_at         DateTime                @updatedAt

  organization           Organization       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  category               DocumentCategory?  @relation("DocumentRetentionPolicyCategory", fields: [category_id], references: [id], onDelete: SetNull)
  default_for_categories DocumentCategory[] @relation("DocumentCategoryDefaultRetention")
  documents              Document[]

  @@index([organization_id, is_active])
  @@index([category_id])
  @@map("document_retention_policies")
}

// --- Folders ------------------------------------------------------------------------

/// 17 §7 — default folder structures per project type (05 §36), per customer, per employee or organization.
model FolderTemplate {
  id              String               @id @default(uuid())
  organization_id String
  name            String
  description     String?
  target          FolderTemplateTarget @default(PROJECT_TYPE)
  /// Project type this template applies to (05 §36); null for customer / employee / organization templates.
  project_type_id String?
  /// Folder tree: [{ name, customer_visible, category_slug, children: [...] }].
  structure       Json
  is_default      Boolean              @default(false)
  archived_at     DateTime?
  created_at      DateTime             @default(now())
  updated_at      DateTime             @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  project_type ProjectType? @relation(fields: [project_type_id], references: [id], onDelete: SetNull)
  folders      Folder[]

  @@index([organization_id, target])
  @@index([project_type_id])
  @@map("folder_templates")
}

/// 17 §2, §3, §7 — hierarchical container scoped to an organization, branch, team, project, customer
/// or employee. Moving / renaming / archiving a folder never changes Document ids.
model Folder {
  id                        String        @id @default(uuid())
  organization_id           String
  parent_folder_id          String?
  name                      String
  description               String?
  /// Materialized path of ancestor ids for hierarchy queries ("/a/b/").
  path                      String        @default("")
  depth                     Int           @default(0)
  scope                     DocumentScope @default(ORGANIZATION)
  branch_id                 String?
  team_id                   String?
  project_id                String?
  /// Customer (CRM Company, 02) for CUSTOMER scope.
  company_id                String?
  /// 10 Employee for EMPLOYEE scope (HR documents); id only.
  employee_id               String?
  /// 17 §7 — created from a folder template.
  template_id               String?
  /// Default category for documents created in this folder.
  default_category_id       String?
  /// Visible in the Customer Portal (07 §9); customers may upload here when portal_upload_allowed.
  customer_visible          Boolean       @default(false)
  portal_upload_allowed     Boolean       @default(false)
  /// System folders (e.g. "Generated PDFs", "Signed contracts") cannot be deleted.
  is_system                 Boolean       @default(false)
  color                     String?
  icon                      String?
  sort_order                Int           @default(0)
  /// 17 §13 — legal hold on the whole folder: every document in it and in its subfolders (Folder.path)
  /// is held, including documents added later. Effective hold = Document.legal_hold OR any ancestor folder hold.
  legal_hold                Boolean       @default(false)
  legal_hold_reason         String?
  legal_hold_set_by_user_id String?
  legal_hold_set_at         DateTime?
  created_by_user_id        String?
  archived_at               DateTime?
  deleted_at                DateTime?
  created_at                DateTime      @default(now())
  updated_at                DateTime      @updatedAt

  organization Organization    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  parent       Folder?         @relation("FolderHierarchy", fields: [parent_folder_id], references: [id], onDelete: Restrict)
  children     Folder[]        @relation("FolderHierarchy")
  branch       Branch?         @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  team         Team?           @relation(fields: [team_id], references: [id], onDelete: SetNull)
  project      Project?        @relation(fields: [project_id], references: [id], onDelete: Cascade)
  company      CrmCompany?     @relation(fields: [company_id], references: [id], onDelete: Cascade)
  template     FolderTemplate? @relation(fields: [template_id], references: [id], onDelete: SetNull)

  documents          Document[]
  shares             DocumentShare[]
  favorites          DocumentFavorite[]
  upload_jobs        DocumentUploadJob[]
  document_templates DocumentTemplate[]

  @@unique([organization_id, parent_folder_id, name])
  @@index([organization_id, scope])
  @@index([parent_folder_id])
  @@index([project_id])
  @@index([company_id])
  @@index([branch_id])
  @@index([team_id])
  @@index([employee_id])
  @@index([organization_id, legal_hold])
  @@map("folders")
}

// --- Documents ----------------------------------------------------------------------

/// 17 §2, §3, §4 — the Document record: a logical document with one or more immutable file versions,
/// a title, category, scope, status, owner, retention policy and access rules. Modules own the
/// relationship to a document; this module owns the document. Legacy columns (user_uuid, filename,
/// mimetype, size, url, path, type) are kept for pre-module-17 rows (logo / avatar uploads) and now
/// mirror the current version.
model Document {
  id              String       @id @default(uuid())
  /// Legacy uploader (pre-module 17); superseded by created_by_user_id. Null for new rows.
  user_uuid       String?
  /// Null only for legacy rows; services backfill from organization-less uploads (notes).
  organization_id String?
  /// Legacy file name = current version file name (denormalized).
  filename        String
  /// Legacy / current version MIME type; null for link-only documents (17 §2).
  mimetype        String?
  /// Legacy / current version size in bytes; null for link-only documents.
  size            BigInt?
  /// Legacy storage URL. 17 §8: never a public URL for new rows — signed URLs are generated per request.
  url             String?
  /// Legacy / current version storage key.
  path            String?
  /// Legacy coarse file kind; kept for existing branding uploads (01 §15).
  type            DocumentType @default(OTHER)

  // 17 §4 — document record.
  /// Null only for legacy rows; services fall back to filename.
  title         String?
  description   String?
  category_id   String?
  status        DocumentStatus @default(ACTIVE)
  source        DocumentSource @default(UPLOAD)
  /// Module that generated / captured the document (03, 04, 08 PDFs; 13 email capture; 09 OCR intake).
  source_module ModuleKey?
  /// 17 §2 — a Document can exist without a file: external link.
  external_url  String?
  /// 17 §4, §5 — DocumentTemplate this document was generated from (source GENERATED).
  template_id   String?

  // 17 §3 — scope and owning record references.
  scope       DocumentScope     @default(ORGANIZATION)
  folder_id   String?
  branch_id   String?
  team_id     String?
  project_id  String?
  /// Customer (CRM Company, 02) for CUSTOMER scope or customer-facing documents.
  company_id  String?
  /// 10 Employee for EMPLOYEE scope (HR documents); id only.
  employee_id String?
  /// 17 §2 Attachment — owning record for RECORD scope (task, ticket, message, financial record, …).
  entity_type RecordEntityType?
  entity_id   String?

  // 17 §6 — versions.
  current_version_id String? @unique
  version_count      Int     @default(0)
  /// Checksum of the current version (denormalized).
  checksum           String?

  // Ownership.
  owner_membership_id String?
  /// Uploader (member or Customer Portal user).
  created_by_user_id  String?
  /// 17 §5 — uploaded through the Customer Portal (07 §9).
  uploaded_via_portal Boolean @default(false)

  // 17 §8 — access.
  /// Visible in the Customer Portal documents section (07 §9) in addition to explicit shares.
  customer_visible  Boolean @default(false)
  /// 17 §8, §15 — downloads are audited (defaults from category.is_sensitive).
  is_sensitive      Boolean @default(false)
  /// 17 §8 — watermark customer-facing downloads / previews.
  watermark_enabled Boolean @default(false)

  // 17 §10 — denormalized state of the latest approval request.
  approval_status     DocumentApprovalStatus?
  approved_version_id String?
  approved_at         DateTime?

  // 17 §11 — search.
  /// Extracted full text of the current version (Phase 2); null when not extractable.
  search_text String?
  /// Denormalized keywords / tag names for quick filtering.
  keywords    String[] @default([])

  // 17 §13 — retention & deletion.
  retention_policy_id       String?
  /// Computed from the policy; null = retain indefinitely.
  retention_expires_at      DateTime?
  legal_hold                Boolean                  @default(false)
  legal_hold_reason         String?
  legal_hold_set_by_user_id String?
  legal_hold_set_at         DateTime?
  archived_at               DateTime?
  /// Soft delete; recoverable until purge_scheduled_at.
  deleted_at                DateTime?
  deleted_by_user_id        String?
  purge_scheduled_at        DateTime?
  /// 17 §11 — Postgres full-text search vector over title + search_text; maintained by a database trigger (see migration). Not set by the API.
  search_vector             Unsupported("tsvector")?

  last_accessed_at DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  organization     Organization?            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  category         DocumentCategory?        @relation(fields: [category_id], references: [id], onDelete: SetNull)
  folder           Folder?                  @relation(fields: [folder_id], references: [id], onDelete: SetNull)
  branch           Branch?                  @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  team             Team?                    @relation(fields: [team_id], references: [id], onDelete: SetNull)
  project          Project?                 @relation(fields: [project_id], references: [id], onDelete: SetNull)
  company          CrmCompany?              @relation(fields: [company_id], references: [id], onDelete: SetNull)
  owner            Membership?              @relation("DocumentOwner", fields: [owner_membership_id], references: [id], onDelete: SetNull)
  current_version  DocumentVersion?         @relation("DocumentCurrentVersion", fields: [current_version_id], references: [id], onDelete: SetNull)
  retention_policy DocumentRetentionPolicy? @relation(fields: [retention_policy_id], references: [id], onDelete: SetNull)
  template         DocumentTemplate?        @relation(fields: [template_id], references: [id], onDelete: SetNull)

  versions                       DocumentVersion[]         @relation("DocumentVersions")
  upload_jobs                    DocumentUploadJob[]
  attachments                    DocumentAttachment[]
  shares                         DocumentShare[]
  approvals                      DocumentApproval[]
  favorites                      DocumentFavorite[]
  recent_accesses                DocumentRecentAccess[]
  deletion_requests              DocumentDeletionRequest[]
  crm_import_jobs                CrmImportJob[]
  proposal_version_pdfs          ProposalVersion[]         @relation("ProposalVersionPdf")
  contract_version_drafts        ContractVersion[]         @relation("ContractVersionDocument")
  contract_version_signed        ContractVersion[]         @relation("ContractVersionSignedDocument")
  signature_request_signed       SignatureRequest[]        @relation("SignatureRequestSignedDocument")
  signature_request_certificates SignatureRequest[]        @relation("SignatureRequestAuditCertificate")
  contract_terminations          ContractTermination[]
  project_decisions              ProjectDecision[]
  task_attachments               TaskAttachment[]
  release_notes                  Release[]                 @relation("ReleaseNotesDocument")
  invoice_pdfs                   Invoice[]                 @relation("InvoicePdf")
  payment_receipts               Payment[]                 @relation("PaymentReceipt")
  credit_note_pdfs               CreditNote[]              @relation("CreditNotePdf")
  calendar_event_attachments     CalendarEventAttachment[] @relation("CalendarEventAttachmentDocument")
  crm_activity_recordings        CrmActivity[]             @relation("CrmActivityRecording")

  @@index([user_uuid])
  @@index([organization_id, status])
  @@index([organization_id, scope])
  @@index([search_vector], type: Gin)
  @@index([organization_id, category_id])
  @@index([organization_id, created_at])
  @@index([folder_id])
  @@index([project_id])
  @@index([company_id])
  @@index([branch_id])
  @@index([team_id])
  @@index([employee_id])
  @@index([entity_type, entity_id])
  @@index([owner_membership_id])
  @@index([retention_expires_at])
  @@index([deleted_at])
  @@index([template_id])
  @@map("documents")
}

/// 17 §2 File, §6 Versioning — an immutable file snapshot inside a Document, with author, timestamp,
/// change note, scan result and lock. Re-uploads create a new version; restore creates a new version
/// from an older one.
model DocumentVersion {
  id                       String                  @id @default(uuid())
  document_id              String
  /// 1-based, unique per document.
  version_number           Int
  status                   DocumentVersionStatus   @default(PENDING)
  filename                 String
  mimetype                 String
  size_bytes               BigInt
  /// SHA-256 of the stored bytes (integrity, dedupe, 04 §17 hashes).
  checksum_sha256          String
  /// 17 §16 — where the bytes live.
  storage_provider         DocumentStorageProvider @default(PLATFORM)
  storage_connection_id    String?
  /// Object key / path inside the storage provider; never exposed directly (17 §8).
  storage_key              String
  storage_bucket           String?
  /// Provider-side file id for external drives.
  external_file_id         String?
  // 17 §5 — virus and malware scanning.
  scan_status              DocumentScanStatus      @default(PENDING)
  scan_result              Json?
  scanned_at               DateTime?
  // 17 §6 — authorship and change note.
  change_note              String?
  author_membership_id     String?
  /// Portal user or member who uploaded this version.
  author_user_id           String?
  source                   DocumentSource          @default(UPLOAD)
  /// 17 §6 — restored from a previous version.
  restored_from_version_id String?
  // 17 §6 — module lock (e.g. 04 locks the signed contract version).
  is_locked                Boolean                 @default(false)
  locked_by_module         ModuleKey?
  locked_reason            String?
  locked_at                DateTime?
  // 17 §8, §11 — derived data.
  /// Extracted text for full-text search (17 §11, Phase 2).
  extracted_text           String?
  page_count               Int?
  width                    Int?
  height                   Int?
  duration_seconds         Int?
  /// Other technical metadata (EXIF, encoding, office properties).
  metadata                 Json?
  created_at               DateTime                @default(now())

  document           Document                   @relation("DocumentVersions", fields: [document_id], references: [id], onDelete: Cascade)
  current_of         Document?                  @relation("DocumentCurrentVersion")
  storage_connection DocumentStorageConnection? @relation(fields: [storage_connection_id], references: [id], onDelete: SetNull)
  author             Membership?                @relation("DocumentVersionAuthor", fields: [author_membership_id], references: [id], onDelete: SetNull)
  restored_from      DocumentVersion?           @relation("DocumentVersionRestoredFrom", fields: [restored_from_version_id], references: [id], onDelete: SetNull)
  restores           DocumentVersion[]          @relation("DocumentVersionRestoredFrom")

  previews                  DocumentPreview[]
  approvals                 DocumentApproval[]
  upload_jobs               DocumentUploadJob[]
  templates_using_as_source DocumentTemplate[]

  @@unique([document_id, version_number])
  @@index([document_id, created_at])
  @@index([checksum_sha256])
  @@index([scan_status])
  @@index([storage_connection_id])
  @@map("document_versions")
}

/// 17 §5 — upload / intake job: drag-and-drop and multi-file uploads, upload from URL, portal uploads,
/// email captures (13), OCR intake (09) and generated PDFs (03/04/08). Tracks the transfer, scan and
/// the resulting document / version.
model DocumentUploadJob {
  id                         String                  @id @default(uuid())
  organization_id            String
  /// Groups the files of one multi-file upload.
  batch_id                   String?
  status                     DocumentUploadJobStatus @default(PENDING)
  source                     DocumentSource          @default(UPLOAD)
  source_module              ModuleKey?
  /// 17 §5 — upload from URL.
  source_url                 String?
  filename                   String
  mimetype                   String?
  expected_size_bytes        BigInt?
  uploaded_bytes             BigInt                  @default(0)
  /// Client-provided checksum to verify after transfer.
  expected_checksum          String?
  /// Provider upload session / multipart id and pre-signed target key.
  upload_session_id          String?
  storage_key                String?
  // Target placement when the job completes.
  /// Existing document to add a version to; null = create a new document.
  document_id                String?
  folder_id                  String?
  scope                      DocumentScope           @default(ORGANIZATION)
  project_id                 String?
  company_id                 String?
  entity_type                RecordEntityType?
  entity_id                  String?
  category_id                String?
  title                      String?
  change_note                String?
  /// Resulting version once processing completed.
  version_id                 String?
  scan_status                DocumentScanStatus      @default(PENDING)
  error_code                 String?
  error_message              String?
  initiated_by_membership_id String?
  /// Member or Customer Portal user who started the upload.
  initiated_by_user_id       String?
  via_portal                 Boolean                 @default(false)
  /// Upload URL / session expiry.
  expires_at                 DateTime?
  started_at                 DateTime?
  completed_at               DateTime?
  created_at                 DateTime                @default(now())
  updated_at                 DateTime                @updatedAt

  organization Organization     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  document     Document?        @relation(fields: [document_id], references: [id], onDelete: SetNull)
  folder       Folder?          @relation(fields: [folder_id], references: [id], onDelete: SetNull)
  version      DocumentVersion? @relation(fields: [version_id], references: [id], onDelete: SetNull)
  initiated_by Membership?      @relation("DocumentUploadJobInitiator", fields: [initiated_by_membership_id], references: [id], onDelete: SetNull)

  @@index([organization_id, status])
  @@index([organization_id, batch_id])
  @@index([document_id])
  @@index([initiated_by_user_id])
  @@index([expires_at])
  @@map("document_upload_jobs")
}

/// 17 §8 — generated preview rendition of a version (thumbnail, image pages, PDF rendition, text
/// extract, transcoded media). Served through signed URLs only.
model DocumentPreview {
  id           String                @id @default(uuid())
  version_id   String
  kind         DocumentPreviewKind
  status       DocumentPreviewStatus @default(PENDING)
  /// Page / frame index for multi-page renditions; 0 for single renditions.
  page_number  Int                   @default(0)
  mimetype     String?
  storage_key  String?
  size_bytes   BigInt?
  width        Int?
  height       Int?
  /// Watermarked variant (17 §8).
  watermarked  Boolean               @default(false)
  error        String?
  generated_at DateTime?
  created_at   DateTime              @default(now())

  version DocumentVersion @relation(fields: [version_id], references: [id], onDelete: Cascade)

  @@unique([version_id, kind, page_number, watermarked])
  @@index([version_id, status])
  @@map("document_previews")
}

/// 17 §2 Attachment, §11 — polymorphic link between a Document and a business record (task, ticket,
/// message, financial record, CRM record, employee …). Modules with their own join table
/// (06 task_attachments, 09 ledger_attachments, 13 ticket_attachments) keep it; other modules and
/// generic "related record" lookups use this table.
model DocumentAttachment {
  id                String           @id @default(uuid())
  organization_id   String
  document_id       String
  entity_type       RecordEntityType
  entity_id         String
  /// Role of the document on the record (attachment, generated_pdf, signed, receipt, source_file …).
  role              String           @default("attachment")
  /// Module that created the link.
  source_module     ModuleKey?
  sort_order        Int              @default(0)
  linked_by_user_id String?
  created_at        DateTime         @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  document     Document     @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@unique([document_id, entity_type, entity_id, role])
  @@index([entity_type, entity_id])
  @@index([organization_id, entity_type])
  @@map("document_attachments")
}

/// 17 §7 — favorites per member (document or folder).
model DocumentFavorite {
  id            String   @id @default(uuid())
  membership_id String
  document_id   String?
  folder_id     String?
  created_at    DateTime @default(now())

  membership Membership @relation(fields: [membership_id], references: [id], onDelete: Cascade)
  document   Document?  @relation(fields: [document_id], references: [id], onDelete: Cascade)
  folder     Folder?    @relation(fields: [folder_id], references: [id], onDelete: Cascade)

  @@unique([membership_id, document_id])
  @@unique([membership_id, folder_id])
  @@index([document_id])
  @@index([folder_id])
  @@map("document_favorites")
}

/// 17 §7 — "recent" list per member; one row per member + document, bumped on each open.
/// Download / preview audit for sensitive categories goes to audit_events (17 §15).
model DocumentRecentAccess {
  membership_id    String
  document_id      String
  last_accessed_at DateTime @default(now())
  access_count     Int      @default(1)

  membership Membership @relation(fields: [membership_id], references: [id], onDelete: Cascade)
  document   Document   @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@id([membership_id, document_id])
  @@index([membership_id, last_accessed_at])
  @@map("document_recent_accesses")
}

// --- Sharing ------------------------------------------------------------------------

/// 17 §2, §9 — explicit grant of access to a Document or Folder for a Member, Team, Customer Portal
/// user, external collaborator (email) or public link. Public links require organization policy,
/// always expire and are audited. Share activity is written to audit_events.
model DocumentShare {
  id                      String                   @id @default(uuid())
  organization_id         String
  /// Exactly one of document_id / folder_id is set.
  document_id             String?
  folder_id               String?
  subject_type            DocumentShareSubjectType
  membership_id           String?
  team_id                 String?
  /// Customer Portal user (User with a CustomerPortalMembership).
  portal_user_id          String?
  /// External collaborator.
  external_email          String?
  external_name           String?
  /// 17 §9 — public / external link token (random, unique; the share URL carries it).
  link_token              String?                  @unique
  link_password_hash      String?
  permission              DocumentSharePermission  @default(VIEW)
  status                  DocumentShareStatus      @default(ACTIVE)
  allow_download          Boolean                  @default(true)
  /// 17 §8 — watermark downloads served through this share.
  watermark               Boolean                  @default(false)
  /// 17 §6 — pin the share to a specific version; null = always current.
  pinned_version_id       String?
  /// Optional cap for link shares.
  max_access_count        Int?
  /// 17 §9 — separate cap on downloads (views are capped by max_access_count); null = unlimited.
  max_download_count      Int?
  access_count            Int                      @default(0)
  download_count          Int                      @default(0)
  last_accessed_at        DateTime?
  message                 String?
  /// 17 §9 — expiring shares (required for public links).
  expires_at              DateTime?
  shared_by_membership_id String?
  shared_by_user_id       String?
  revoked_at              DateTime?
  revoked_by_user_id      String?
  /// 14 — notification sent to the recipient.
  notified_at             DateTime?
  created_at              DateTime                 @default(now())
  updated_at              DateTime                 @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  document     Document?    @relation(fields: [document_id], references: [id], onDelete: Cascade)
  folder       Folder?      @relation(fields: [folder_id], references: [id], onDelete: Cascade)
  membership   Membership?  @relation("DocumentShareMembership", fields: [membership_id], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [team_id], references: [id], onDelete: Cascade)
  portal_user  User?        @relation("DocumentSharePortalUser", fields: [portal_user_id], references: [id], onDelete: Cascade)
  shared_by    Membership?  @relation("DocumentShareSharer", fields: [shared_by_membership_id], references: [id], onDelete: SetNull)

  @@index([organization_id, status])
  @@index([document_id, status])
  @@index([folder_id, status])
  @@index([membership_id])
  @@index([team_id])
  @@index([portal_user_id])
  @@index([external_email])
  @@index([expires_at])
  @@map("document_shares")
}

// --- Approvals ----------------------------------------------------------------------

/// 17 §10 — document-level approval request bound to an exact version (deliverables, specifications,
/// HR documents). Shown as a pending approval in the Customer Portal (07 §4, §7) when a portal user is
/// an approver. Contract approval / signature stay in 04; deliverable acceptance in 05 §47.
model DocumentApproval {
  id                         String                 @id @default(uuid())
  organization_id            String
  document_id                String
  version_id                 String
  title                      String?
  message                    String?
  status                     DocumentApprovalStatus @default(PENDING)
  /// All approvers must approve (true) or any one approval completes the request (false).
  require_all                Boolean                @default(true)
  due_at                     DateTime?
  requested_by_membership_id String?
  requested_by_user_id       String?
  /// Outcome summary when completed (last decision comment).
  outcome_comment            String?
  completed_at               DateTime?
  cancelled_at               DateTime?
  cancelled_by_user_id       String?
  /// Reminder sent through 14.
  last_reminded_at           DateTime?
  created_at                 DateTime               @default(now())
  updated_at                 DateTime               @updatedAt

  organization Organization       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  document     Document           @relation(fields: [document_id], references: [id], onDelete: Cascade)
  version      DocumentVersion    @relation(fields: [version_id], references: [id], onDelete: Cascade)
  requested_by Membership?        @relation("DocumentApprovalRequester", fields: [requested_by_membership_id], references: [id], onDelete: SetNull)
  approvers    DocumentApprover[]

  @@index([organization_id, status])
  @@index([document_id, created_at])
  @@index([version_id])
  @@index([due_at])
  @@map("document_approvals")
}

/// 17 §10 — one approver (member or Customer Portal user) on an approval request and their decision.
model DocumentApprover {
  id             String                    @id @default(uuid())
  approval_id    String
  kind           DocumentApproverKind      @default(MEMBERSHIP)
  membership_id  String?
  /// Customer Portal user (07 §7).
  portal_user_id String?
  sort_order     Int                       @default(0)
  decision       DocumentApprovalDecision?
  comment        String?
  decided_at     DateTime?
  /// 14 — approval request notification sent.
  notified_at    DateTime?
  created_at     DateTime                  @default(now())

  approval    DocumentApproval @relation(fields: [approval_id], references: [id], onDelete: Cascade)
  membership  Membership?      @relation("DocumentApproverMembership", fields: [membership_id], references: [id], onDelete: Cascade)
  portal_user User?            @relation("DocumentApproverPortalUser", fields: [portal_user_id], references: [id], onDelete: Cascade)

  @@unique([approval_id, membership_id])
  @@unique([approval_id, portal_user_id])
  @@index([membership_id, decision])
  @@index([portal_user_id, decision])
  @@map("document_approvers")
}

// --- Retention & deletion -----------------------------------------------------------

/// 17 §13 — restricted, audited deletion workflow: soft delete with recovery window, retention-driven
/// deletion and permanent deletion that requires approval. Legal hold blocks execution.
model DocumentDeletionRequest {
  id                   String                 @id @default(uuid())
  organization_id      String
  /// Null after permanent deletion removed the row; document_title / storage_keys keep the trace.
  document_id          String?
  document_title       String
  kind                 DocumentDeletionKind   @default(SOFT)
  status               DocumentDeletionStatus @default(REQUESTED)
  reason               String?
  /// Retention policy that triggered this request (kind RETENTION).
  retention_policy_id  String?
  requested_by_user_id String?
  approved_by_user_id  String?
  approved_at          DateTime?
  rejected_reason      String?
  /// Storage keys purged on execution (all versions and previews).
  purged_storage_keys  String[]               @default([])
  executed_at          DateTime?
  executed_by_user_id  String?
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  document     Document?    @relation(fields: [document_id], references: [id], onDelete: SetNull)

  @@index([organization_id, status])
  @@index([document_id])
  @@map("document_deletion_requests")
}

/// 17 §4, §5 — reusable document template (letters, policies, NDAs, reports ...). The body is a stored
/// DocumentVersion; generating fills `variables` into a copy and creates a Document with source GENERATED
/// and Document.template_id. Proposal (03), contract (04) and invoice (08) templates keep their own tables;
/// deleting the source document is blocked while an active template points at it.
model DocumentTemplate {
  id                 String        @id @default(uuid())
  organization_id    String
  name               String
  description        String?
  /// Category given to generated documents.
  category_id        String?
  /// Default folder for generated documents.
  folder_id          String?
  /// Scope given to generated documents (the actor picks the owning record when the scope needs one).
  scope              DocumentScope @default(ORGANIZATION)
  /// Version holding the template body (DOCX / PDF / text with {{placeholders}}).
  source_version_id  String
  /// Placeholders: [{ key, label, type, required, default, source }]; source = record path such as `company.legal_name`.
  variables          Json?
  usage_count        Int           @default(0)
  last_used_at       DateTime?
  created_by_user_id String?
  archived_at        DateTime?
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt

  organization   Organization      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  category       DocumentCategory? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  folder         Folder?           @relation(fields: [folder_id], references: [id], onDelete: SetNull)
  source_version DocumentVersion   @relation(fields: [source_version_id], references: [id], onDelete: Cascade)
  documents      Document[]

  @@index([organization_id, archived_at])
  @@index([category_id])
  @@index([folder_id])
  @@index([source_version_id])
  @@map("document_templates")
}

// --- Secure Credential Vault --------------------------------------------------------

/// 17 §12 — per-organization encryption key metadata (the key material lives in the KMS / secret
/// manager; only its reference is stored). Rotations create a new version.
model VaultKey {
  id              String         @id @default(uuid())
  organization_id String
  /// KMS / secret-manager key reference.
  key_ref         String
  version         Int            @default(1)
  algorithm       String         @default("AES-256-GCM")
  status          VaultKeyStatus @default(ACTIVE)
  rotated_at      DateTime?
  retired_at      DateTime?
  created_at      DateTime       @default(now())

  organization            Organization            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  entries                 VaultEntry[]
  integration_connections IntegrationConnection[]

  @@unique([organization_id, version])
  @@index([organization_id, status])
  @@map("vault_keys")
}

/// 17 §12 — an encrypted credential (hosting login, API key, service account, domain registrar,
/// third-party credential) scoped to the organization, a customer or a project. Secrets are never
/// stored in plain text nor as ordinary Documents. Tags via taggings (VAULT_ENTRY).
model VaultEntry {
  id                  String         @id @default(uuid())
  organization_id     String
  scope               VaultScope     @default(ORGANIZATION)
  /// Customer (CRM Company, 02) for CUSTOMER scope.
  company_id          String?
  project_id          String?
  name                String
  type                VaultEntryType @default(PASSWORD)
  username            String?
  url                 String?
  /// Plain-text notes (non-secret). Secret notes go into the ciphertext (type NOTE).
  notes               String?
  /// Envelope-encrypted secret (base64 ciphertext incl. nonce/tag) under vault_key_id.
  secret_ciphertext   String?
  vault_key_id        String?
  /// Non-reversible hint shown in lists (e.g. last 4 chars), optional.
  secret_hint         String?
  // Type FILE — encrypted file stored outside ordinary documents.
  file_name           String?
  file_mimetype       String?
  file_size_bytes     BigInt?
  /// Storage key of the encrypted blob.
  file_storage_key    String?
  expires_at          DateTime?
  owner_membership_id String?
  created_by_user_id  String?
  /// 17 §12 — visible to Customer Portal users of the customer scope when the organization enables it.
  portal_visible      Boolean        @default(false)
  last_rotated_at     DateTime?
  last_revealed_at    DateTime?
  reveal_count        Int            @default(0)
  archived_at         DateTime?
  deleted_at          DateTime?
  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  company      CrmCompany?  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [project_id], references: [id], onDelete: Cascade)
  owner        Membership?  @relation("VaultEntryOwner", fields: [owner_membership_id], references: [id], onDelete: SetNull)
  vault_key    VaultKey?    @relation(fields: [vault_key_id], references: [id], onDelete: Restrict)

  grants      VaultEntryGrant[]
  access_logs VaultAccessLog[]

  @@index([organization_id, scope])
  @@index([organization_id, type])
  @@index([company_id])
  @@index([project_id])
  @@index([owner_membership_id])
  @@index([expires_at])
  @@map("vault_entries")
}

/// 17 §12 — explicit access grant on a vault entry for a member, team or Customer Portal user.
/// Vault permissions (documents.vault.read / reveal / manage) are separate from document permissions.
model VaultEntryGrant {
  id                 String                @id @default(uuid())
  entry_id           String
  subject_type       VaultGrantSubjectType
  membership_id      String?
  team_id            String?
  /// Customer Portal user of the entry's customer scope (17 §12, Phase 2).
  portal_user_id     String?
  can_reveal         Boolean               @default(false)
  can_manage         Boolean               @default(false)
  expires_at         DateTime?
  granted_by_user_id String?
  revoked_at         DateTime?
  revoked_by_user_id String?
  created_at         DateTime              @default(now())

  entry       VaultEntry  @relation(fields: [entry_id], references: [id], onDelete: Cascade)
  membership  Membership? @relation("VaultGrantMembership", fields: [membership_id], references: [id], onDelete: Cascade)
  team        Team?       @relation(fields: [team_id], references: [id], onDelete: Cascade)
  portal_user User?       @relation("VaultGrantPortalUser", fields: [portal_user_id], references: [id], onDelete: Cascade)

  @@unique([entry_id, membership_id])
  @@unique([entry_id, team_id])
  @@unique([entry_id, portal_user_id])
  @@index([membership_id])
  @@index([portal_user_id])
  @@map("vault_entry_grants")
}

/// 17 §12, §15 — queryable access log for vault entries (reveal / copy are explicit, logged actions).
/// Mirrored to audit_events; this table backs the per-entry "access history" view.
model VaultAccessLog {
  id                  String            @id @default(uuid())
  organization_id     String
  entry_id            String
  action              VaultAccessAction
  actor_user_id       String?
  actor_membership_id String?
  /// Actor acted through the Customer Portal.
  via_portal          Boolean           @default(false)
  ip_address          String?
  user_agent          String?
  /// Context (e.g. project / ticket the reveal happened from).
  context             Json?
  created_at          DateTime          @default(now())

  organization     Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  entry            VaultEntry   @relation(fields: [entry_id], references: [id], onDelete: Cascade)
  actor_user       User?        @relation("VaultAccessActorUser", fields: [actor_user_id], references: [id], onDelete: SetNull)
  actor_membership Membership?  @relation("VaultAccessActorMembership", fields: [actor_membership_id], references: [id], onDelete: SetNull)

  @@index([entry_id, created_at])
  @@index([organization_id, action, created_at])
  @@index([actor_user_id, created_at])
  @@map("vault_access_logs")
}

// =====================================================================
// 18 Time Tracking — docs/features/18-time-tracking.md (LOG-408)
// Owns: time entries, running timers, timesheets and their approval history, billing/cost rate cards
// and their snapshots on entries, activity types, capture suggestions (calendar/AI), invoicing-time
// write-off/write-up adjustments, utilization snapshots and the organization's time-tracking settings.
// Does not own: projects/workstreams/milestones (05), tasks (06), tickets (13), invoices and
// products (08), employee compensation and attendance (10), calendar events (19), notifications (14).
// Creation/edit/approval/unlock/rate-change/invoicing audit goes to audit_events (01).
// =====================================================================

/// 18 §3 — lifecycle of a time entry. LOCKED is reached after the containing period is locked (§5)
/// or the entry was invoiced (§7); INVOICED entries are implicitly locked.
enum TimeEntryStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  INVOICED
  LOCKED
}

/// 18 §3, §4 — how the entry was captured.
enum TimeEntrySource {
  MANUAL
  TIMER
  CALENDAR
  IMPORTED
  GENERATED
}

/// 18 §6 — why an entry is not billable.
enum TimeNonBillableCategory {
  INTERNAL
  PRE_SALES
  WARRANTY
  OVERHEAD
  LEAVE
  TRAINING
  ADMIN
}

/// 18 §2, §5 — timesheet lifecycle.
enum TimesheetStatus {
  OPEN
  SUBMITTED
  APPROVED
  REJECTED
  LOCKED
}

/// 18 §2, §5 — timesheet period length (weekly by default, custom allowed).
enum TimesheetPeriodType {
  WEEKLY
  BIWEEKLY
  SEMI_MONTHLY
  MONTHLY
  CUSTOM
}

/// 18 §5 — who approves a member's timesheet, per organization policy.
enum TimesheetApproverPolicy {
  PROJECT_OWNER
  TEAM_LEAD
  MANAGER
  SPECIFIC_MEMBER
}

/// 18 §5, §12 — queryable approval/lock history of a timesheet.
enum TimesheetActionType {
  SUBMITTED
  APPROVED
  REJECTED
  REOPENED
  LOCKED
  UNLOCKED
}

/// 18 §2 — a rate card is either what the customer is charged or what the employee costs.
enum TimeRateKind {
  BILLING
  COST
}

/// 18 §2, §6 — resolution scope of a rate card; most specific wins
/// (PROJECT_MEMBER > PROJECT > MEMBER > PRODUCT > ORGANIZATION).
enum BillingRateScope {
  ORGANIZATION
  PRODUCT
  PROJECT
  MEMBER
  PROJECT_MEMBER
}

/// 18 §4 — origin of a suggested entry.
enum TimeSuggestionSource {
  CALENDAR
  COMMIT
  TASK_ACTIVITY
  ATTENDANCE
  AI
}

/// 18 §4 — review state of a suggested entry (review is always required).
enum TimeSuggestionStatus {
  PENDING
  ACCEPTED
  DISMISSED
  EXPIRED
}

/// 18 §6 — invoicing-time adjustment applied to an entry without editing it.
enum TimeAdjustmentType {
  WRITE_OFF
  WRITE_UP
  WRITE_DOWN
}

/// 18 §4 — rounding applied to durations at capture / invoicing time.
enum TimeRoundingMode {
  NONE
  NEAREST
  UP
  DOWN
}

/// 18 §4 — bulk import jobs for IMPORTED entries.
enum TimeImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

/// 18 §10 — output format of a time report export / scheduled report.
enum TimeReportFormat {
  CSV
  XLSX
  PDF
}

/// 18 §10 — how often a scheduled report is e-mailed.
enum TimeReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

/// 18 §10 — lifecycle of an export file.
enum TimeExportStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

// --- Configuration ----------------------------------------------------------------

/// 18 §4, §5, §6, §9 — organization-wide time tracking settings (one row per organization).
model TimeTrackingSettings {
  organization_id                    String                  @id
  // 18 §5 — timesheet periods & approval.
  period_type                        TimesheetPeriodType     @default(WEEKLY)
  /// 1 = Monday … 7 = Sunday; falls back to Organization.week_start (01 §14).
  week_start                         Int?
  require_approval                   Boolean                 @default(true)
  approver_policy                    TimesheetApproverPolicy @default(MANAGER)
  /// Approver when approver_policy = SPECIFIC_MEMBER.
  default_approver_membership_id     String?
  /// Approved periods are locked automatically (18 §5).
  lock_on_approval                   Boolean                 @default(true)
  /// Members may still edit rejected entries of a locked period.
  allow_self_approval                Boolean                 @default(false)
  // 18 §6 — billability defaults.
  default_billable                   Boolean                 @default(true)
  require_billable_override_reason   Boolean                 @default(true)
  // 18 §4 — capture rules.
  rounding_increment_minutes         Int                     @default(1)
  rounding_mode                      TimeRoundingMode        @default(NONE)
  min_entry_minutes                  Int?
  max_hours_per_day                  Decimal?                @db.Decimal(5, 2)
  allow_overlapping_entries          Boolean                 @default(false)
  allow_future_entries               Boolean                 @default(false)
  require_project                    Boolean                 @default(false)
  require_task_or_ticket             Boolean                 @default(false)
  require_description                Boolean                 @default(false)
  require_activity_type              Boolean                 @default(false)
  /// Days back a member may still add or edit DRAFT entries; null = unlimited.
  edit_window_days                   Int?
  /// 18 §5 — month-end close: entries dated before this day are read-only for everyone; unlocking an
  /// individual entry needs time.entries.unlock, moving the date needs time.settings.manage. Null = no close.
  locked_before_date                 DateTime?               @db.Date
  locked_before_set_at               DateTime?
  locked_before_set_by_membership_id String?
  /// Timer idle detection threshold (18 §4); null disables.
  idle_timeout_minutes               Int?
  /// Stop a forgotten timer automatically after this many hours; null = never.
  timer_auto_stop_hours              Int?
  calendar_capture_enabled           Boolean                 @default(false)
  ai_suggestions_enabled             Boolean                 @default(false)
  /// Attendance (10) pre-fills the daily total (18 §9).
  attendance_prefill_enabled         Boolean                 @default(false)
  // 18 §5 — reminders for missing/unsubmitted time, delivered by 14.
  missing_time_reminder_enabled      Boolean                 @default(true)
  /// Days of the week (1–7) on which the missing-time reminder is sent.
  missing_time_reminder_days         Int[]                   @default([])
  /// Local time "HH:mm" for reminders.
  missing_time_reminder_time         String?
  submission_reminder_enabled        Boolean                 @default(true)
  /// Days after period end before the submission reminder fires.
  submission_reminder_offset_days    Int                     @default(1)
  // 18 §9, §10 — utilization.
  /// Fallback expected hours per week when 10 Employees has no working-hours record.
  default_expected_hours_per_week    Decimal                 @default(40) @db.Decimal(5, 2)
  utilization_target_percent         Decimal?                @db.Decimal(5, 2)
  /// Count only billable hours in utilization (otherwise all logged hours).
  utilization_billable_only          Boolean                 @default(false)
  /// Reporting currency for mixed-currency rate reports; falls back to Organization.default_currency.
  reporting_currency                 String?
  updated_at                         DateTime                @updatedAt

  organization     Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  default_approver Membership?  @relation("TimeTrackingDefaultApprover", fields: [default_approver_membership_id], references: [id], onDelete: SetNull)

  @@map("time_tracking_settings")
}

/// 18 §3 — configurable activity types (development, design, meeting, support, admin …).
model TimeActivityType {
  id                            String                   @id @default(uuid())
  organization_id               String
  name                          String
  slug                          String
  description                   String?
  color                         String?
  icon                          String?
  /// Default billability for entries of this type (18 §6); null = inherit project/org default.
  default_billable              Boolean?
  /// Non-billable category applied when default_billable = false.
  default_non_billable_category TimeNonBillableCategory?
  is_default                    Boolean                  @default(false)
  sort_order                    Int                      @default(0)
  archived_at                   DateTime?
  created_at                    DateTime                 @default(now())
  updated_at                    DateTime                 @updatedAt

  organization     Organization          @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  time_entries     TimeEntry[]
  timers           Timer[]
  billing_rates    BillingRate[]
  suggestions      TimeSuggestion[]
  project_settings TimeProjectSettings[]

  @@unique([organization_id, slug])
  @@index([organization_id, archived_at])
  @@map("time_activity_types")
}

/// 18 §6, §8 — per-project time tracking overrides. Billing model and T&M hourly rate stay in
/// ProjectBillingSettings (08); this row carries default billability derived from the project type
/// and contract (04 §54) plus approval and capture overrides.
model TimeProjectSettings {
  project_id                    String                   @id
  /// Default billability for entries on this project; null = organization default.
  default_billable              Boolean?
  default_non_billable_category TimeNonBillableCategory?
  default_activity_type_id      String?
  /// Contract that defines the billing context (04 §54).
  contract_id                   String?
  /// Approver override for entries on this project (18 §5); null = organization policy.
  approver_membership_id        String?
  /// Whether members can log time against this project at all.
  time_tracking_enabled         Boolean                  @default(true)
  /// Only project members (05 §16) may log time.
  members_only                  Boolean                  @default(true)
  require_task                  Boolean                  @default(false)
  /// Alert when logged hours reach this percent of Project.budget_hours (05 §51).
  hours_alert_percent           Int?
  hours_alert_sent_at           DateTime?
  updated_at                    DateTime                 @updatedAt

  project               Project           @relation(fields: [project_id], references: [id], onDelete: Cascade)
  default_activity_type TimeActivityType? @relation(fields: [default_activity_type_id], references: [id], onDelete: SetNull)
  contract              Contract?         @relation(fields: [contract_id], references: [id], onDelete: SetNull)
  approver              Membership?       @relation("TimeProjectApprover", fields: [approver_membership_id], references: [id], onDelete: SetNull)

  @@index([contract_id])
  @@map("time_project_settings")
}

// --- Rates --------------------------------------------------------------------------

/// 18 §2, §6 — rate cards with effective dates. BILLING rates (customer price per hour) resolve by
/// scope: organization default, product/service (08), project override, member, project+member.
/// COST rates (employee cost per hour) are synced from 10 Employees compensation
/// (source_compensation_id) or entered here for members without an Employee record. Cost rates are
/// a sensitive field (01 §60, 18 §11). Rate changes are audited (18 §12).
model BillingRate {
  id                       String           @id @default(uuid())
  organization_id          String
  kind                     TimeRateKind     @default(BILLING)
  scope                    BillingRateScope
  /// 08 product/service the rate belongs to (unit = hour).
  product_id               String?
  project_id               String?
  membership_id            String?
  /// Optional narrowing by activity type (e.g. meetings billed at a different rate).
  activity_type_id         String?
  name                     String?
  currency                 String
  hourly_rate              Decimal          @db.Decimal(18, 2)
  effective_from           DateTime         @db.Date
  /// Null = open-ended.
  effective_to             DateTime?        @db.Date
  /// 10 Employee compensation record this COST rate was synced from; id only.
  source_compensation_id   String?
  notes                    String?
  created_by_membership_id String?
  archived_at              DateTime?
  created_at               DateTime         @default(now())
  updated_at               DateTime         @updatedAt

  organization  Organization      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  product       Product?          @relation(fields: [product_id], references: [id], onDelete: Cascade)
  project       Project?          @relation(fields: [project_id], references: [id], onDelete: Cascade)
  membership    Membership?       @relation("BillingRateMember", fields: [membership_id], references: [id], onDelete: Cascade)
  activity_type TimeActivityType? @relation(fields: [activity_type_id], references: [id], onDelete: SetNull)
  created_by    Membership?       @relation("BillingRateCreator", fields: [created_by_membership_id], references: [id], onDelete: SetNull)

  billed_entries TimeEntry[] @relation("TimeEntryBillingRate")
  costed_entries TimeEntry[] @relation("TimeEntryCostRate")

  @@index([organization_id, kind, scope, effective_from])
  @@index([project_id, membership_id, effective_from])
  @@index([membership_id, kind, effective_from])
  @@index([product_id])
  @@map("billing_rates")
}

// --- Time entries -------------------------------------------------------------------

/// 18 §3 — a unit of recorded work. Project is optional for internal time (admin, training, leave);
/// task and ticket are optional. Rate snapshots (18 §3) are copied at approval time so later rate
/// changes never alter history. Status transitions, edits, unlocks and invoicing are audited (§12).
model TimeEntry {
  id                        String                   @id @default(uuid())
  organization_id           String
  /// The member who performed the work (Member with an Employee record, 01 §80).
  membership_id             String
  /// 10 Employee record of the member at the time of logging; id only.
  employee_id               String?
  /// Branch scope for reporting (01 §123–124): the project's primary branch or the member's primary branch.
  branch_id                 String?
  /// Working date the time belongs to (entries never span days).
  date                      DateTime                 @db.Date
  start_at                  DateTime?
  end_at                    DateTime?
  /// Always stored, derived from start/end when both are present.
  duration_minutes          Int
  /// Duration after organization rounding rules (18 §4); equals duration_minutes when rounding is NONE.
  billable_minutes          Int
  project_id                String?
  workstream_id             String?
  milestone_id              String?
  task_id                   String?
  /// Support ticket (13 §4); id only.
  ticket_id                 String?
  activity_type_id          String?
  description               String?
  // 18 §6 — billable classification.
  is_billable               Boolean                  @default(true)
  /// True when the member/approver overrode the default billability; the reason is required (18 §6).
  billable_overridden       Boolean                  @default(false)
  billable_override_reason  String?
  non_billable_category     TimeNonBillableCategory?
  // 18 §3 — rate snapshots, stored at approval time.
  billing_rate_id           String?
  billing_rate_amount       Decimal?                 @db.Decimal(18, 2)
  billing_currency          String?
  /// billable_minutes / 60 × billing_rate_amount, snapshotted with the rate.
  billable_amount           Decimal?                 @db.Decimal(18, 2)
  cost_rate_id              String?
  cost_rate_amount          Decimal?                 @db.Decimal(18, 2)
  cost_currency             String?
  /// duration_minutes / 60 × cost_rate_amount; consumed by 09 for project profitability (18 §7).
  cost_amount               Decimal?                 @db.Decimal(18, 2)
  rates_snapshotted_at      DateTime?
  // 18 §3 — status & source.
  status                    TimeEntryStatus          @default(DRAFT)
  source                    TimeEntrySource          @default(MANUAL)
  /// Timer this entry was produced from (18 §4).
  timer_id                  String?                  @unique
  /// Calendar event (19) this entry was captured from; id only.
  calendar_event_id         String?
  /// Attendance record (10) that pre-filled this entry; id only.
  attendance_record_id      String?
  import_job_id             String?
  /// Identifier of the row in the import source, for idempotent re-imports.
  external_ref              String?
  // 18 §5 — timesheet & approval.
  timesheet_id              String?
  submitted_at              DateTime?
  approved_by_membership_id String?
  approved_at               DateTime?
  rejected_by_membership_id String?
  rejected_at               DateTime?
  rejection_reason          String?
  // 18 §7 — invoicing link, set by 08 when the entry is billed.
  invoice_id                String?
  invoice_line_item_id      String?
  invoiced_at               DateTime?
  // 18 §5 — locking; unlock requires `time.entries.unlock` and is audited.
  is_locked                 Boolean                  @default(false)
  locked_at                 DateTime?
  locked_by_membership_id   String?
  unlocked_at               DateTime?
  unlocked_by_membership_id String?
  unlock_reason             String?
  created_by_user_id        String?
  /// Soft delete (deleted entries stay for audit; invoiced entries cannot be deleted).
  deleted_at                DateTime?
  created_at                DateTime                 @default(now())
  updated_at                DateTime                 @updatedAt

  organization      Organization       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  membership        Membership         @relation("TimeEntryMember", fields: [membership_id], references: [id], onDelete: Cascade)
  branch            Branch?            @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  project           Project?           @relation(fields: [project_id], references: [id], onDelete: SetNull)
  workstream        ProjectWorkstream? @relation(fields: [workstream_id], references: [id], onDelete: SetNull)
  milestone         ProjectMilestone?  @relation(fields: [milestone_id], references: [id], onDelete: SetNull)
  task              Task?              @relation(fields: [task_id], references: [id], onDelete: SetNull)
  activity_type     TimeActivityType?  @relation(fields: [activity_type_id], references: [id], onDelete: SetNull)
  billing_rate      BillingRate?       @relation("TimeEntryBillingRate", fields: [billing_rate_id], references: [id], onDelete: SetNull)
  cost_rate         BillingRate?       @relation("TimeEntryCostRate", fields: [cost_rate_id], references: [id], onDelete: SetNull)
  timer             Timer?             @relation(fields: [timer_id], references: [id], onDelete: SetNull)
  import_job        TimeImportJob?     @relation(fields: [import_job_id], references: [id], onDelete: SetNull)
  timesheet         Timesheet?         @relation(fields: [timesheet_id], references: [id], onDelete: SetNull)
  approved_by       Membership?        @relation("TimeEntryApprover", fields: [approved_by_membership_id], references: [id], onDelete: SetNull)
  rejected_by       Membership?        @relation("TimeEntryRejecter", fields: [rejected_by_membership_id], references: [id], onDelete: SetNull)
  locked_by         Membership?        @relation("TimeEntryLocker", fields: [locked_by_membership_id], references: [id], onDelete: SetNull)
  unlocked_by       Membership?        @relation("TimeEntryUnlocker", fields: [unlocked_by_membership_id], references: [id], onDelete: SetNull)
  invoice           Invoice?           @relation(fields: [invoice_id], references: [id], onDelete: SetNull)
  invoice_line_item InvoiceLineItem?   @relation(fields: [invoice_line_item_id], references: [id], onDelete: SetNull)

  adjustments TimeEntryAdjustment[]
  suggestion  TimeSuggestion?       @relation("TimeSuggestionAcceptedEntry")

  @@unique([organization_id, import_job_id, external_ref])
  @@index([organization_id, status])
  @@index([organization_id, date])
  @@index([membership_id, date])
  @@index([membership_id, status])
  @@index([project_id, date])
  @@index([project_id, is_billable, status])
  @@index([task_id])
  @@index([ticket_id])
  @@index([milestone_id])
  @@index([workstream_id])
  @@index([timesheet_id])
  @@index([invoice_id])
  @@index([invoice_line_item_id])
  @@index([branch_id, date])
  @@index([activity_type_id])
  @@map("time_entries")
}

/// 18 §2, §4 — a running timer started from a task, ticket or project. At most one running timer
/// per member (enforced by the service: stopped_at IS NULL). Stopping creates a TimeEntry with
/// source TIMER; discarding leaves no entry.
model Timer {
  id                     String    @id @default(uuid())
  organization_id        String
  membership_id          String
  project_id             String?
  workstream_id          String?
  milestone_id           String?
  task_id                String?
  /// Support ticket (13 §4); id only.
  ticket_id              String?
  activity_type_id       String?
  description            String?
  is_billable            Boolean?
  started_at             DateTime  @default(now())
  /// Pause support: accumulated paused time is excluded from the resulting duration.
  paused_at              DateTime?
  paused_minutes         Int       @default(0)
  /// Client heartbeat for idle detection (18 §4).
  last_heartbeat_at      DateTime?
  idle_detected_at       DateTime?
  /// Idle minutes the member chose to discard when prompted.
  idle_discarded_minutes Int       @default(0)
  stopped_at             DateTime?
  discarded_at           DateTime?
  /// Set when the timer was stopped automatically (timer_auto_stop_hours).
  auto_stopped           Boolean   @default(false)
  /// web | mobile | api | browser_extension
  device                 String?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  organization  Organization       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  membership    Membership         @relation("TimerMember", fields: [membership_id], references: [id], onDelete: Cascade)
  project       Project?           @relation(fields: [project_id], references: [id], onDelete: SetNull)
  workstream    ProjectWorkstream? @relation(fields: [workstream_id], references: [id], onDelete: SetNull)
  milestone     ProjectMilestone?  @relation(fields: [milestone_id], references: [id], onDelete: SetNull)
  task          Task?              @relation(fields: [task_id], references: [id], onDelete: SetNull)
  activity_type TimeActivityType?  @relation(fields: [activity_type_id], references: [id], onDelete: SetNull)
  time_entry    TimeEntry?

  @@index([organization_id, stopped_at])
  @@index([membership_id, stopped_at])
  @@index([task_id, stopped_at])
  @@index([project_id, stopped_at])
  @@index([ticket_id])
  @@map("timers")
}

/// 18 §4 — bulk/CSV/external imports producing IMPORTED entries.
model TimeImportJob {
  id                       String           @id @default(uuid())
  organization_id          String
  /// csv | external system key
  source                   String
  /// Uploaded file (17 Document); id only.
  file_document_id         String?
  status                   TimeImportStatus @default(PENDING)
  /// Column → field mapping used for the run.
  mapping                  Json?
  total_rows               Int              @default(0)
  imported_rows            Int              @default(0)
  skipped_rows             Int              @default(0)
  failed_rows              Int              @default(0)
  /// [{ row, message }]
  errors                   Json?
  started_at               DateTime?
  completed_at             DateTime?
  created_by_membership_id String?
  created_at               DateTime         @default(now())
  updated_at               DateTime         @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  created_by   Membership?  @relation("TimeImportJobCreator", fields: [created_by_membership_id], references: [id], onDelete: SetNull)
  entries      TimeEntry[]

  @@index([organization_id, status])
  @@map("time_import_jobs")
}

/// 18 §4 — suggested entries from calendar events (19), commits, task activity (06), attendance (10)
/// or AI. Review is always required: accepting creates a TimeEntry, dismissing keeps the suggestion
/// so it is not re-proposed.
model TimeSuggestion {
  id                     String               @id @default(uuid())
  organization_id        String
  membership_id          String
  source                 TimeSuggestionSource
  status                 TimeSuggestionStatus @default(PENDING)
  date                   DateTime             @db.Date
  start_at               DateTime?
  end_at                 DateTime?
  duration_minutes       Int
  project_id             String?
  task_id                String?
  /// Support ticket (13); id only.
  ticket_id              String?
  activity_type_id       String?
  description            String?
  is_billable            Boolean?
  /// Calendar event (19) the suggestion came from; id only.
  calendar_event_id      String?
  /// Commit sha, attendance record id, task audit event id, …
  external_ref           String?
  /// 0–1 confidence for AI suggestions.
  confidence             Decimal?             @db.Decimal(5, 4)
  /// Model/rule explanation shown to the reviewer.
  rationale              String?
  /// Raw source payload (event title, commit message, …).
  payload                Json?
  accepted_time_entry_id String?              @unique
  reviewed_at            DateTime?
  expires_at             DateTime?
  created_at             DateTime             @default(now())
  updated_at             DateTime             @updatedAt

  organization   Organization      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  membership     Membership        @relation("TimeSuggestionMember", fields: [membership_id], references: [id], onDelete: Cascade)
  project        Project?          @relation(fields: [project_id], references: [id], onDelete: SetNull)
  task           Task?             @relation(fields: [task_id], references: [id], onDelete: SetNull)
  activity_type  TimeActivityType? @relation(fields: [activity_type_id], references: [id], onDelete: SetNull)
  accepted_entry TimeEntry?        @relation("TimeSuggestionAcceptedEntry", fields: [accepted_time_entry_id], references: [id], onDelete: SetNull)

  @@unique([membership_id, source, external_ref])
  @@index([membership_id, status, date])
  @@index([organization_id, status])
  @@map("time_suggestions")
}

/// 18 §6 — write-off / write-up / write-down applied at invoicing time. The entry itself is never
/// edited: the adjustment records the delta between the snapshotted billable amount and what was
/// actually billed on the invoice line (08 "Invoicing").
model TimeEntryAdjustment {
  id                        String             @id @default(uuid())
  organization_id           String
  time_entry_id             String
  type                      TimeAdjustmentType
  /// Minutes actually billed after the adjustment (null = unchanged).
  adjusted_billable_minutes Int?
  /// Amount actually billed after the adjustment.
  adjusted_amount           Decimal            @db.Decimal(18, 2)
  /// adjusted_amount − TimeEntry.billable_amount (negative for write-offs).
  delta_amount              Decimal            @db.Decimal(18, 2)
  currency                  String
  reason                    String
  invoice_line_item_id      String?
  created_by_membership_id  String?
  created_at                DateTime           @default(now())

  organization      Organization     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  time_entry        TimeEntry        @relation(fields: [time_entry_id], references: [id], onDelete: Cascade)
  invoice_line_item InvoiceLineItem? @relation(fields: [invoice_line_item_id], references: [id], onDelete: SetNull)
  created_by        Membership?      @relation("TimeEntryAdjustmentCreator", fields: [created_by_membership_id], references: [id], onDelete: SetNull)

  @@index([time_entry_id])
  @@index([invoice_line_item_id])
  @@index([organization_id, type, created_at])
  @@map("time_entry_adjustments")
}

// --- Timesheets ---------------------------------------------------------------------

/// 18 §2, §5 — a periodic collection of one member's entries submitted for approval. Created lazily
/// when the first entry of a period is logged or on submission. Totals are denormalized on
/// submission/approval for timesheet-compliance reporting (18 §10).
model Timesheet {
  id                        String              @id @default(uuid())
  organization_id           String
  membership_id             String
  period_type               TimesheetPeriodType @default(WEEKLY)
  period_start              DateTime            @db.Date
  period_end                DateTime            @db.Date
  status                    TimesheetStatus     @default(OPEN)
  // Denormalized totals (minutes).
  total_minutes             Int                 @default(0)
  billable_minutes          Int                 @default(0)
  non_billable_minutes      Int                 @default(0)
  /// Expected capacity for the period from working hours, leave and holidays (10, 01 §121–122).
  expected_minutes          Int?
  /// Snapshot of billable amount across entries, in reporting currency.
  billable_amount           Decimal?            @db.Decimal(18, 2)
  currency                  String?
  // 18 §5 — submit / approve / reject.
  submitted_at              DateTime?
  /// Resolved approver for this timesheet (project owner, team lead or manager per policy).
  approver_membership_id    String?
  approved_at               DateTime?
  approved_by_membership_id String?
  rejected_at               DateTime?
  rejected_by_membership_id String?
  rejection_comment         String?
  /// Member comment attached on submission.
  submission_comment        String?
  // 18 §5 — locking.
  locked_at                 DateTime?
  locked_by_membership_id   String?
  unlocked_at               DateTime?
  unlocked_by_membership_id String?
  unlock_reason             String?
  last_reminder_sent_at     DateTime?
  reminder_count            Int                 @default(0)
  created_at                DateTime            @default(now())
  updated_at                DateTime            @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  membership   Membership   @relation("TimesheetMember", fields: [membership_id], references: [id], onDelete: Cascade)
  approver     Membership?  @relation("TimesheetApprover", fields: [approver_membership_id], references: [id], onDelete: SetNull)
  approved_by  Membership?  @relation("TimesheetApprovedBy", fields: [approved_by_membership_id], references: [id], onDelete: SetNull)
  rejected_by  Membership?  @relation("TimesheetRejectedBy", fields: [rejected_by_membership_id], references: [id], onDelete: SetNull)
  locked_by    Membership?  @relation("TimesheetLockedBy", fields: [locked_by_membership_id], references: [id], onDelete: SetNull)
  unlocked_by  Membership?  @relation("TimesheetUnlockedBy", fields: [unlocked_by_membership_id], references: [id], onDelete: SetNull)

  entries TimeEntry[]
  actions TimesheetAction[]

  @@unique([membership_id, period_start, period_end])
  @@index([organization_id, status])
  @@index([organization_id, period_start])
  @@index([approver_membership_id, status])
  @@map("timesheets")
}

/// 18 §5, §12 — submit/approve/reject/reopen/lock/unlock history with comments. Mirrors audit_events
/// but is kept queryable for compliance reporting (18 §10).
model TimesheetAction {
  id                  String              @id @default(uuid())
  timesheet_id        String
  action              TimesheetActionType
  actor_membership_id String?
  comment             String?
  /// Status before → after.
  from_status         TimesheetStatus?
  to_status           TimesheetStatus?
  created_at          DateTime            @default(now())

  timesheet Timesheet   @relation(fields: [timesheet_id], references: [id], onDelete: Cascade)
  actor     Membership? @relation("TimesheetActionActor", fields: [actor_membership_id], references: [id], onDelete: SetNull)

  @@index([timesheet_id, created_at])
  @@map("timesheet_actions")
}

// --- Reporting ----------------------------------------------------------------------

/// 18 §9, §10 — per-member, per-period utilization snapshot. Utilization = logged / expected hours;
/// computed here (expected capacity from 10 and 01 §121–122), displayed in 10 and 05. Recomputed
/// whenever entries, leave or holidays in the period change.
model TimeUtilizationPeriod {
  id                  String   @id @default(uuid())
  organization_id     String
  membership_id       String
  branch_id           String?
  period_start        DateTime @db.Date
  period_end          DateTime @db.Date
  expected_minutes    Int      @default(0)
  logged_minutes      Int      @default(0)
  billable_minutes    Int      @default(0)
  /// Minutes of approved leave and holidays removed from capacity (10, 01 §122).
  leave_minutes       Int      @default(0)
  utilization_percent Decimal? @db.Decimal(5, 2)
  billable_ratio      Decimal? @db.Decimal(5, 2)
  computed_at         DateTime @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  membership   Membership   @relation("TimeUtilizationMember", fields: [membership_id], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branch_id], references: [id], onDelete: SetNull)

  @@unique([membership_id, period_start, period_end])
  @@index([organization_id, period_start])
  @@index([branch_id, period_start])
  @@map("time_utilization_periods")
}

/// 18 §10 — a saved report delivered on a schedule (the "Schedule" button). Hosted by the 20 engine job
/// `time.report_schedules.tick`, which writes a TimeExport per run and e-mails the file through 14. Only the
/// organization's own members and listed e-mail addresses receive it; creating one needs time.entries.export.
model TimeReportSchedule {
  id                       String              @id @default(uuid())
  organization_id          String
  name                     String
  /// hours_by_project | hours_by_customer | hours_by_employee | utilization | billable_ratio | estimate_vs_actual | unbilled | compliance
  report_key               String
  /// SavedView (02 §29, entity_type TIME_ENTRY) the filters came from; id only.
  saved_view_id            String?
  /// Filters and grouping: { date_range, branch_ids, team_ids, project_ids, company_ids, membership_ids, billable, group_by }.
  filters                  Json
  format                   TimeReportFormat    @default(CSV)
  frequency                TimeReportFrequency @default(WEEKLY)
  /// 1 = Monday … 7 = Sunday for WEEKLY.
  day_of_week              Int?
  /// 1–28 for MONTHLY.
  day_of_month             Int?
  /// Local time "HH:mm".
  time_of_day              String              @default("08:00")
  timezone                 String
  recipient_membership_ids String[]            @default([])
  recipient_emails         String[]            @default([])
  is_active                Boolean             @default(true)
  next_run_at              DateTime?
  last_run_at              DateTime?
  last_error               String?
  created_by_membership_id String?
  created_at               DateTime            @default(now())
  updated_at               DateTime            @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  created_by   Membership?  @relation("TimeReportScheduleCreator", fields: [created_by_membership_id], references: [id], onDelete: SetNull)
  exports      TimeExport[]

  @@index([organization_id, is_active])
  @@index([is_active, next_run_at])
  @@index([created_by_membership_id])
  @@map("time_report_schedules")
}

/// 18 §10, §13 — export log: who exported which report with which filters, row count and the file
/// (a 17 Document). Manual exports and scheduled runs both write one row.
model TimeExport {
  id                       String           @id @default(uuid())
  organization_id          String
  report_key               String
  /// Set for runs of a TimeReportSchedule.
  schedule_id              String?
  format                   TimeReportFormat @default(CSV)
  status                   TimeExportStatus @default(PENDING)
  filters                  Json
  row_count                Int?
  /// 17 Document holding the file; id only.
  file_document_id         String?
  /// Download link expiry.
  expires_at               DateTime?
  error                    String?
  started_at               DateTime?
  completed_at             DateTime?
  created_by_membership_id String?
  created_at               DateTime         @default(now())

  organization Organization        @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  schedule     TimeReportSchedule? @relation(fields: [schedule_id], references: [id], onDelete: SetNull)
  created_by   Membership?         @relation("TimeExportCreator", fields: [created_by_membership_id], references: [id], onDelete: SetNull)

  @@index([organization_id, created_at])
  @@index([organization_id, status])
  @@index([schedule_id])
  @@index([created_by_membership_id])
  @@map("time_exports")
}

// =====================================================================
// 19 Calendar — docs/features/19-calendar.md (LOG-409)
// Owns: calendars (personal/team/project/customer/branch/resource/organization/external), calendar
// sharing, the only CalendarEvent record (recurrence, attendees, RSVP, reminders, resources, links,
// attachments), bookable resources, availability schedules used for scheduling and booking,
// booking links and bookings, external calendar connections (Google / Microsoft 365) with per-event
// sync mappings, conferencing provider accounts and per-member calendar preferences.
// Does not own: projected dates (milestones 05, contract dates 04, task due dates 06, leave 10 —
// rendered read-only from the source record, never stored here), employee working hours / capacity
// (10), branch business hours and holidays (01 §120–122), CRM meeting outcomes (02 §15 — CrmActivity
// points at the event), notifications (14), documents (17). Audit log goes to audit_events (§11).
// =====================================================================

/// 19 §2 — kinds of calendar. EXTERNAL calendars are created by a CalendarConnection (§7).
enum CalendarKind {
  PERSONAL
  TEAM
  PROJECT
  CUSTOMER
  BRANCH
  ORGANIZATION
  RESOURCE
  EXTERNAL
}

/// 19 §6 — bookable resource kinds (rooms, equipment).
enum CalendarResourceKind {
  ROOM
  EQUIPMENT
  VEHICLE
  OTHER
}

/// 19 §7, §10 — what a calendar share grants. FREE_BUSY exposes only busy blocks (§7).
enum CalendarShareRole {
  FREE_BUSY
  READ
  WRITE
  MANAGE
}

/// 19 §3 — event lifecycle. CANCELLED rows are kept for history, sync and notifications (§9).
enum CalendarEventStatus {
  TENTATIVE
  CONFIRMED
  CANCELLED
}

/// 19 §3, §8 — visibility. CUSTOMER_VISIBLE events surface in the Customer Portal (07 §11).
enum CalendarEventVisibility {
  PRIVATE
  TEAM
  ORGANIZATION
  CUSTOMER_VISIBLE
}

/// 19 §3 — where the event came from.
enum CalendarEventSource {
  INTERNAL
  SYNCED
  BOOKING
  API
}

/// 19 §3 — who an attendee is: Member, Customer Portal user, CRM contact or an external email.
enum CalendarAttendeeKind {
  MEMBER
  PORTAL_USER
  CONTACT
  EXTERNAL
}

/// 19 §3 — attendee participation role.
enum CalendarAttendeeRole {
  REQUIRED
  OPTIONAL
  INFORMATIONAL
}

/// 19 §3 — RSVP state (iCalendar PARTSTAT).
enum CalendarAttendeeResponse {
  NEEDS_ACTION
  ACCEPTED
  TENTATIVE
  DECLINED
}

/// 19 §6 — resource booking approval state.
enum CalendarResourceBookingStatus {
  REQUESTED
  APPROVED
  DECLINED
  CANCELLED
}

/// 19 §9 — reminder delivery channel; delivery itself happens in 14.
enum CalendarReminderMethod {
  NOTIFICATION
  EMAIL
  SMS
  PUSH
}

/// 19 §6 — availability override kind: block time off or open extra hours.
enum CalendarAvailabilityOverrideKind {
  UNAVAILABLE
  AVAILABLE
}

/// 19 §6 — booking link lifecycle.
enum BookingLinkStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

/// 19 §6 — how hosts are picked for a booking link with several hosts.
enum BookingHostAssignment {
  SINGLE
  ROUND_ROBIN
  COLLECTIVE
}

/// 19 §6 — who may use a booking link.
enum BookingLinkAudience {
  PUBLIC
  PORTAL
  INTERNAL
}

/// 19 §6 — booking lifecycle.
enum CalendarBookingStatus {
  PENDING
  CONFIRMED
  RESCHEDULED
  CANCELLED
  NO_SHOW
  COMPLETED
}

/// 19 §6 — how a booking was made.
enum CalendarBookingSource {
  PUBLIC_LINK
  PORTAL
  INTERNAL
  API
}

/// 19 §7 — external calendar providers.
enum CalendarProvider {
  GOOGLE
  MICROSOFT
}

/// 19 §7 — connection lifecycle.
enum CalendarConnectionStatus {
  PENDING_AUTH
  ACTIVE
  PAUSED
  ERROR
  DISCONNECTED
}

/// 19 §7 — sync direction per connected calendar.
enum CalendarSyncDirection {
  TWO_WAY
  PULL_ONLY
  PUSH_ONLY
}

/// 19 §7 — per-event sync state.
enum CalendarSyncMappingStatus {
  SYNCED
  PENDING_PUSH
  PENDING_PULL
  CONFLICT
  FAILED
  DELETED_REMOTELY
}

/// 19 §7 — sync run outcome.
enum CalendarSyncRunStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

/// 19 §3 — external video / conferencing providers for meeting links.
enum ConferencingProvider {
  GOOGLE_MEET
  MICROSOFT_TEAMS
  ZOOM
  CUSTOM
}

/// 19 §3 — conferencing account state.
enum ConferencingAccountStatus {
  ACTIVE
  ERROR
  DISCONNECTED
}

// --- Configuration ----------------------------------------------------------------

/// 19 §4 — configurable event types (meeting, customer meeting, kickoff, review, interview, deadline,
/// out of office, focus time, booking …). System types are seeded per organization and cannot be deleted.
model CalendarEventType {
  id                       String                  @id @default(uuid())
  organization_id          String
  name                     String
  slug                     String
  description              String?
  color                    String?
  icon                     String?
  /// Seeded type (customer_meeting, booking, out_of_office …) referenced by other modules; not deletable.
  is_system                Boolean                 @default(false)
  is_default               Boolean                 @default(false)
  default_duration_minutes Int?
  default_visibility       CalendarEventVisibility @default(TEAM)
  /// Whether events of this type block free/busy (§6). False for focus time / informational types.
  shows_as_busy            Boolean                 @default(true)
  /// Default reminders applied to new events: [{ method, minutes_before }] (§9).
  default_reminders        Json?
  /// Customer meeting type used by CRM meetings (02 §15).
  is_customer_facing       Boolean                 @default(false)
  sort_order               Int                     @default(0)
  archived_at              DateTime?
  created_at               DateTime                @default(now())
  updated_at               DateTime                @updatedAt

  organization  Organization    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  events        CalendarEvent[]
  booking_links BookingLink[]

  @@unique([organization_id, slug])
  @@index([organization_id, archived_at])
  @@map("calendar_event_types")
}

/// 19 §5, §9 — per-member calendar preferences (default calendar, reminder defaults, view settings).
/// Reminder timing is a user preference (§9).
model CalendarPreference {
  id                       String   @id @default(uuid())
  membership_id            String   @unique
  default_calendar_id      String?
  /// IANA zone override; falls back to User.timezone, then Branch/Organization (01 §120).
  timezone                 String?
  /// day | week | month | agenda (§5).
  default_view             String   @default("week")
  week_start               Int?
  show_weekends            Boolean  @default(true)
  show_declined_events     Boolean  @default(false)
  default_event_duration   Int      @default(30)
  /// Default reminders for events the member creates or is invited to: [{ method, minutes_before }].
  default_reminders        Json?
  /// Modules whose projected dates are shown (§5 filter): ["projects","tasks","contracts","employees"].
  projected_modules        String[] @default([])
  /// Calendar ids overlaid by default (§5).
  overlay_calendar_ids     String[] @default([])
  /// Working-hours schedule used for free/busy and suggestions when set (§6).
  availability_schedule_id String?
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  membership            Membership                    @relation(fields: [membership_id], references: [id], onDelete: Cascade)
  default_calendar      Calendar?                     @relation("CalendarPreferenceDefault", fields: [default_calendar_id], references: [id], onDelete: SetNull)
  availability_schedule CalendarAvailabilitySchedule? @relation(fields: [availability_schedule_id], references: [id], onDelete: SetNull)

  @@map("calendar_preferences")
}

// --- Calendars ---------------------------------------------------------------------

/// 19 §2, §5 — a named collection of events. Exactly one scope column is set according to kind:
/// PERSONAL → owner_membership_id, TEAM → team_id, PROJECT → project_id, CUSTOMER → company_id,
/// BRANCH → branch_id, RESOURCE → resource_id, EXTERNAL → connection_calendar (see
/// CalendarConnectionCalendar.calendar_id), ORGANIZATION → none.
model Calendar {
  id                    String                  @id @default(uuid())
  organization_id       String
  kind                  CalendarKind
  name                  String
  description           String?
  color                 String?
  /// IANA zone used to render all-day events and recurrence expansion; null = owner / organization default.
  timezone              String?
  owner_membership_id   String?
  team_id               String?
  project_id            String?
  /// Customer calendar (CRM company, 02 §2) — holds customer-visible events shown in the portal (§8).
  company_id            String?
  branch_id             String?
  resource_id           String?                 @unique
  /// Member's default personal calendar (one per member).
  is_default            Boolean                 @default(false)
  /// Default visibility for events created in this calendar.
  default_visibility    CalendarEventVisibility @default(TEAM)
  /// §7 — when true, other Members only ever see free/busy for this calendar unless shared explicitly.
  free_busy_only        Boolean                 @default(false)
  /// Portal users may see customer-visible events of this calendar (§8).
  portal_visible        Boolean                 @default(false)
  /// 19 §7 — secret token of the read-only iCalendar subscription feed (`/calendar/feed/{token}.ics`); null = feed
  /// disabled. Rotating replaces it (calendar.calendars.manage). The feed honours Calendar.free_busy_only.
  feed_token            String?                 @unique
  feed_token_rotated_at DateTime?
  sort_order            Int                     @default(0)
  created_by_user_id    String?
  archived_at           DateTime?
  created_at            DateTime                @default(now())
  updated_at            DateTime                @updatedAt

  organization Organization      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  owner        Membership?       @relation("CalendarOwner", fields: [owner_membership_id], references: [id], onDelete: Cascade)
  team         Team?             @relation(fields: [team_id], references: [id], onDelete: Cascade)
  project      Project?          @relation(fields: [project_id], references: [id], onDelete: Cascade)
  company      CrmCompany?       @relation(fields: [company_id], references: [id], onDelete: Cascade)
  branch       Branch?           @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  resource     CalendarResource? @relation(fields: [resource_id], references: [id], onDelete: Cascade)

  events                  CalendarEvent[]
  shares                  CalendarShare[]
  booking_links           BookingLink[]
  connection_calendars    CalendarConnectionCalendar[]
  default_for_preferences CalendarPreference[]         @relation("CalendarPreferenceDefault")

  @@index([organization_id, kind])
  @@index([owner_membership_id])
  @@index([team_id])
  @@index([project_id])
  @@index([company_id])
  @@index([branch_id])
  @@map("calendars")
}

/// 19 §7, §10, §11 — explicit sharing of a calendar with a Member or a Team. Sharing is audited.
model CalendarShare {
  id                String            @id @default(uuid())
  calendar_id       String
  membership_id     String?
  team_id           String?
  role              CalendarShareRole @default(READ)
  shared_by_user_id String?
  expires_at        DateTime?
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt

  calendar   Calendar    @relation(fields: [calendar_id], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [membership_id], references: [id], onDelete: Cascade)
  team       Team?       @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@unique([calendar_id, membership_id])
  @@unique([calendar_id, team_id])
  @@index([membership_id])
  @@index([team_id])
  @@map("calendar_shares")
}

/// 19 §6 — bookable resources (meeting rooms, equipment). Each resource has a RESOURCE calendar
/// (Calendar.resource_id) that holds its bookings for conflict detection.
model CalendarResource {
  id                     String               @id @default(uuid())
  organization_id        String
  branch_id              String?
  kind                   CalendarResourceKind @default(ROOM)
  name                   String
  code                   String?
  description            String?
  /// Seats (rooms) or units (equipment).
  capacity               Int?
  location               String?
  color                  String?
  /// Bookings need approval from a resource manager (CalendarEventResource.status).
  requires_approval      Boolean              @default(false)
  /// Membership ids that approve bookings when requires_approval is set.
  manager_membership_ids String[]             @default([])
  /// Hours the resource can be booked: { mon: [{start,end}], … }; null = branch business hours (01 §121).
  availability           Json?
  /// Equipment, features, floor … free-form.
  attributes             Json?
  archived_at            DateTime?
  created_at             DateTime             @default(now())
  updated_at             DateTime             @updatedAt

  organization   Organization            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  branch         Branch?                 @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  calendar       Calendar?
  event_bookings CalendarEventResource[]

  @@unique([organization_id, code])
  @@index([organization_id, kind])
  @@index([branch_id])
  @@map("calendar_resources")
}

// --- Events ------------------------------------------------------------------------

/// 19 §3–4 — the event record. Recurring series: the master row carries recurrence_rule; modified or
/// cancelled occurrences are stored as child rows with recurring_event_id + original_start_at
/// (status CANCELLED = exception). Unmodified occurrences are expanded at read time.
/// CRM meetings (02 §15) are events of a customer-facing type; CrmActivity.calendar_event_id points here.
model CalendarEvent {
  id                       String                  @id @default(uuid())
  organization_id          String
  calendar_id              String
  event_type_id            String?
  title                    String
  /// Markdown body.
  description              String?
  status                   CalendarEventStatus     @default(CONFIRMED)
  starts_at                DateTime
  ends_at                  DateTime
  all_day                  Boolean                 @default(false)
  /// IANA zone the event was scheduled in; drives all-day boundaries and recurrence expansion.
  timezone                 String
  /// RFC 5545 RRULE (e.g. "FREQ=WEEKLY;BYDAY=MO,WE;UNTIL=20270101T000000Z"); master rows only.
  recurrence_rule          String?
  /// Explicit excluded occurrence starts (EXDATE) for the series.
  recurrence_exdates       DateTime[]              @default([])
  /// Last occurrence of the series, materialised from the rule for range queries.
  recurrence_ends_at       DateTime?
  recurring_event_id       String?
  /// Start of the occurrence this exception row replaces.
  original_start_at        DateTime?
  organizer_membership_id  String?
  /// Organizer when the event was pulled from an external calendar and is not a Member (§7).
  organizer_email          String?
  visibility               CalendarEventVisibility @default(TEAM)
  /// Blocks free/busy (§6); false for focus time, out-of-office markers that should stay available, etc.
  shows_as_busy            Boolean                 @default(true)
  location                 String?
  /// Structured location (address, room name, geo) when available.
  location_details         Json?
  conferencing_provider    ConferencingProvider?
  meeting_url              String?
  /// Provider meeting id (Zoom meeting id, Teams join id …).
  meeting_external_id      String?
  /// Dial-in numbers, passcodes, host key …; secrets are encrypted by the API.
  meeting_details          Json?
  /// 19 §4 — out-of-office events: message sent as the decline comment of auto-declined invitations.
  auto_reply_message       String?
  /// 19 §4 — out-of-office events: new invitations for the organizer during the event are declined
  /// automatically (CalendarEventAttendee.response DECLINED + auto_reply_message).
  auto_decline_invitations Boolean                 @default(false)
  /// 19 §3, §9 — attendees may see who else is invited; false hides the guest list from non-organizers.
  guests_can_see_guests    Boolean                 @default(true)
  /// Customer context: CRM company (02 §2). Required for CUSTOMER_VISIBLE events (§8).
  company_id               String?
  project_id               String?
  /// Branch whose business hours / holidays apply (01 §120–122); null = organization.
  branch_id                String?
  source                   CalendarEventSource     @default(INTERNAL)
  /// Event colour override; null = calendar / type colour.
  color                    String?
  /// iCalendar UID for invitations and interop; stable across edits.
  ical_uid                 String                  @default(uuid())
  /// iCalendar SEQUENCE; incremented on every change that re-sends invitations (§9).
  sequence                 Int                     @default(0)
  cancelled_at             DateTime?
  cancelled_by_user_id     String?
  cancellation_reason      String?
  /// 20 AutomationRule when created by a rule.
  automation_rule_id       String?
  created_by_user_id       String?
  created_at               DateTime                @default(now())
  updated_at               DateTime                @updatedAt

  organization    Organization       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  calendar        Calendar           @relation(fields: [calendar_id], references: [id], onDelete: Cascade)
  event_type      CalendarEventType? @relation(fields: [event_type_id], references: [id], onDelete: SetNull)
  recurring_event CalendarEvent?     @relation("CalendarEventRecurrence", fields: [recurring_event_id], references: [id], onDelete: Cascade)
  occurrences     CalendarEvent[]    @relation("CalendarEventRecurrence")
  organizer       Membership?        @relation("CalendarEventOrganizer", fields: [organizer_membership_id], references: [id], onDelete: SetNull)
  company         CrmCompany?        @relation(fields: [company_id], references: [id], onDelete: SetNull)
  project         Project?           @relation(fields: [project_id], references: [id], onDelete: SetNull)
  branch          Branch?            @relation(fields: [branch_id], references: [id], onDelete: SetNull)

  attendees     CalendarEventAttendee[]
  resources     CalendarEventResource[]
  reminders     CalendarEventReminder[]
  links         CalendarEventLink[]
  attachments   CalendarEventAttachment[]
  sync_mappings CalendarEventSyncMapping[]
  booking       CalendarBooking?

  // Back-links from other modules' records that reference this event
  crm_activities CrmActivity[]

  @@unique([organization_id, ical_uid])
  @@unique([recurring_event_id, original_start_at])
  @@index([organization_id, starts_at, ends_at])
  @@index([calendar_id, starts_at])
  @@index([organization_id, status])
  @@index([organizer_membership_id, starts_at])
  @@index([company_id])
  @@index([project_id])
  @@index([event_type_id])
  @@index([recurrence_ends_at])
  @@map("calendar_events")
}

/// 19 §3, §9 — attendees: Members (membership_id), Customer Portal users (user_id, 01 §79),
/// CRM contacts (contact_id, 02) or plain external emails. Exactly one identity column per kind;
/// email is always filled so invitations (14) and iCalendar exports work.
model CalendarEventAttendee {
  id                   String                   @id @default(uuid())
  event_id             String
  kind                 CalendarAttendeeKind
  membership_id        String?
  /// Customer Portal user (User with a CustomerPortalMembership).
  user_id              String?
  contact_id           String?
  email                String
  name                 String?
  role                 CalendarAttendeeRole     @default(REQUIRED)
  response             CalendarAttendeeResponse @default(NEEDS_ACTION)
  response_comment     String?
  /// 19 §9 — "propose new time": a pending proposal is proposed_starts_at / proposed_ends_at set. The organizer
  /// accepts (event is rescheduled, sequence + 1, proposals cleared) or dismisses it.
  proposed_starts_at   DateTime?
  proposed_ends_at     DateTime?
  proposal_comment     String?
  proposed_at          DateTime?
  responded_at         DateTime?
  /// Organizer is also listed as an attendee for RSVP tracking and sync.
  is_organizer         Boolean                  @default(false)
  /// Per-attendee invitation emission (§9): null = not sent yet.
  invited_at           DateTime?
  /// Token for one-click RSVP links sent to external / portal attendees.
  response_token       String?                  @unique
  /// Attendee's own copy lives in another synced calendar; id only.
  external_attendee_id String?
  created_at           DateTime                 @default(now())
  updated_at           DateTime                 @updatedAt

  event      CalendarEvent @relation(fields: [event_id], references: [id], onDelete: Cascade)
  membership Membership?   @relation(fields: [membership_id], references: [id], onDelete: Cascade)
  user       User?         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  contact    CrmContact?   @relation(fields: [contact_id], references: [id], onDelete: SetNull)

  @@unique([event_id, email])
  @@unique([event_id, membership_id])
  @@index([membership_id, response])
  @@index([user_id])
  @@index([contact_id])
  @@map("calendar_event_attendees")
}

/// 19 §6 — resource booking (room / equipment) attached to an event, with optional approval.
/// Conflicts are detected against other APPROVED rows for the same resource and overlapping time.
model CalendarEventResource {
  id                 String                        @id @default(uuid())
  event_id           String
  resource_id        String
  status             CalendarResourceBookingStatus @default(APPROVED)
  /// Units booked for equipment with capacity > 1.
  quantity           Int                           @default(1)
  decided_by_user_id String?
  decided_at         DateTime?
  decision_note      String?
  created_at         DateTime                      @default(now())
  updated_at         DateTime                      @updatedAt

  event    CalendarEvent    @relation(fields: [event_id], references: [id], onDelete: Cascade)
  resource CalendarResource @relation(fields: [resource_id], references: [id], onDelete: Cascade)

  @@unique([event_id, resource_id])
  @@index([resource_id, status])
  @@map("calendar_event_resources")
}

/// 19 §3, §9 — reminders. membership_id null = event default for every attendee; set = a Member's
/// personal override. Emitted to 14 at scheduled_at (next_occurrence for series); sent_at records
/// the last emission.
model CalendarEventReminder {
  id             String                 @id @default(uuid())
  event_id       String
  membership_id  String?
  method         CalendarReminderMethod @default(NOTIFICATION)
  minutes_before Int
  /// Next emission time, recomputed when the event moves or a recurrence occurrence passes.
  scheduled_at   DateTime?
  sent_at        DateTime?
  created_at     DateTime               @default(now())

  event      CalendarEvent @relation(fields: [event_id], references: [id], onDelete: Cascade)
  membership Membership?   @relation(fields: [membership_id], references: [id], onDelete: Cascade)

  @@unique([event_id, membership_id, method, minutes_before])
  @@index([scheduled_at, sent_at])
  @@index([membership_id])
  @@map("calendar_event_reminders")
}

/// 19 §3 — related records: project, customer, deal, contract, ticket (13), task, lead, proposal,
/// invoice … Polymorphic via RecordEntityType; company_id / project_id on the event are the primary
/// context, this table carries the rest.
model CalendarEventLink {
  id                 String           @id @default(uuid())
  event_id           String
  entity_type        RecordEntityType
  entity_id          String
  /// origin | related — origin marks the record the event was created from (CRM meeting, ticket callback).
  relation           String           @default("related")
  created_by_user_id String?
  created_at         DateTime         @default(now())

  event CalendarEvent @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@unique([event_id, entity_type, entity_id])
  @@index([entity_type, entity_id])
  @@map("calendar_event_links")
}

/// 19 §3 — attachments are Documents (17); id only.
model CalendarEventAttachment {
  id               String   @id @default(uuid())
  event_id         String
  /// 19 §3 — the attachment is a 17 Document.
  document_id      String
  /// Attachment pulled from an external calendar (Drive / OneDrive link) before it is imported into 17.
  external_url     String?
  title            String?
  added_by_user_id String?
  created_at       DateTime @default(now())

  event    CalendarEvent @relation(fields: [event_id], references: [id], onDelete: Cascade)
  document Document      @relation("CalendarEventAttachmentDocument", fields: [document_id], references: [id], onDelete: Cascade)

  @@unique([event_id, document_id])
  @@index([document_id])
  @@map("calendar_event_attachments")
}

// --- Availability ------------------------------------------------------------------

/// 19 §6 — a scheduling availability schedule (weekly hours + date overrides) for free/busy, slot
/// suggestions and booking links. Employee working hours, leave and capacity are owned by 10
/// ("Attendance & Working Hours"); this is the Member's scheduling-layer override and the schedule a
/// booking link offers. membership_id null = organization-level schedule (e.g. "Support hours").
model CalendarAvailabilitySchedule {
  id              String    @id @default(uuid())
  organization_id String
  membership_id   String?
  name            String
  /// IANA zone the rules are expressed in.
  timezone        String
  is_default      Boolean   @default(false)
  /// Respect branch holidays (01 §122) and approved leave (10) on top of the rules.
  honor_holidays  Boolean   @default(true)
  honor_leave     Boolean   @default(true)
  archived_at     DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  organization  Organization                   @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  membership    Membership?                    @relation(fields: [membership_id], references: [id], onDelete: Cascade)
  rules         CalendarAvailabilityRule[]
  overrides     CalendarAvailabilityOverride[]
  booking_links BookingLink[]
  preferences   CalendarPreference[]

  @@index([organization_id])
  @@index([membership_id, is_default])
  @@map("calendar_availability_schedules")
}

/// 19 §6 — weekly recurring availability window. Several rows per weekday allow split shifts.
model CalendarAvailabilityRule {
  id          String @id @default(uuid())
  schedule_id String
  /// 0 = Sunday … 6 = Saturday.
  weekday     Int
  /// "HH:MM" in the schedule's timezone.
  start_time  String
  end_time    String

  schedule CalendarAvailabilitySchedule @relation(fields: [schedule_id], references: [id], onDelete: Cascade)

  @@index([schedule_id, weekday])
  @@map("calendar_availability_rules")
}

/// 19 §6 — date-specific override: block a day / hours (UNAVAILABLE) or open extra hours (AVAILABLE).
/// Null start/end times mean the whole day.
model CalendarAvailabilityOverride {
  id          String                           @id @default(uuid())
  schedule_id String
  date        DateTime                         @db.Date
  kind        CalendarAvailabilityOverrideKind @default(UNAVAILABLE)
  start_time  String?
  end_time    String?
  reason      String?
  created_at  DateTime                         @default(now())

  schedule CalendarAvailabilitySchedule @relation(fields: [schedule_id], references: [id], onDelete: Cascade)

  @@index([schedule_id, date])
  @@map("calendar_availability_overrides")
}

// --- Booking links -----------------------------------------------------------------

/// 19 §6, §8 — self-scheduling page for customers and prospects (used by 02 and 13; portal users see
/// them in 07 §11). Slots are computed from the hosts' availability schedules, their busy events,
/// branch holidays (01 §122) and leave (10); confirmed bookings create a CalendarEvent of event_type.
model BookingLink {
  id                          String                @id @default(uuid())
  organization_id             String
  /// Public URL segment: /book/{org-slug}/{slug}.
  slug                        String
  name                        String
  /// Markdown shown on the booking page.
  description                 String?
  status                      BookingLinkStatus     @default(DRAFT)
  audience                    BookingLinkAudience   @default(PUBLIC)
  owner_membership_id         String?
  /// Restrict the link to one customer (CRM company, 02); portal users of that customer see it in 07.
  company_id                  String?
  /// Event type given to booked events (default: the system "booking" type).
  event_type_id               String?
  /// Calendar that receives the booked events; null = the assigned host's default personal calendar.
  calendar_id                 String?
  availability_schedule_id    String?
  host_assignment             BookingHostAssignment @default(SINGLE)
  duration_minutes            Int                   @default(30)
  /// Alternative durations the invitee may pick; empty = fixed duration.
  duration_options            Int[]                 @default([])
  slot_interval_minutes       Int                   @default(30)
  buffer_before_minutes       Int                   @default(0)
  buffer_after_minutes        Int                   @default(0)
  min_notice_minutes          Int                   @default(60)
  max_days_ahead              Int                   @default(60)
  /// Optional fixed booking window.
  available_from              DateTime?             @db.Date
  available_until             DateTime?             @db.Date
  max_bookings_per_day        Int?
  /// Collective / group links: invitees per slot (1 = one-to-one).
  seats_per_slot              Int                   @default(1)
  /// Bookings start PENDING until a host confirms.
  requires_confirmation       Boolean               @default(false)
  /// Fallback timezone shown on the page; invitees pick their own.
  timezone                    String?
  location                    String?
  conferencing_provider       ConferencingProvider?
  conferencing_account_id     String?
  /// Questions asked at booking: [{ key, label, type, required, options }].
  questions                   Json?
  /// Reminders for the booked event: [{ method, minutes_before }] (§9).
  reminders                   Json?
  /// Invitee may cancel / reschedule until N minutes before start; null = always.
  cancellation_notice_minutes Int?
  allow_rescheduling          Boolean               @default(true)
  /// Markdown shown after booking; redirect_url wins when set.
  confirmation_message        String?
  redirect_url                String?
  /// Page branding overrides (01 §15 branding is the default).
  branding                    Json?
  /// Template for the created event title, e.g. "{invitee_name} × {host_name}".
  event_title_template        String?
  created_by_user_id          String?
  archived_at                 DateTime?
  created_at                  DateTime              @default(now())
  updated_at                  DateTime              @updatedAt

  organization          Organization                  @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  owner                 Membership?                   @relation("BookingLinkOwner", fields: [owner_membership_id], references: [id], onDelete: SetNull)
  company               CrmCompany?                   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  event_type            CalendarEventType?            @relation(fields: [event_type_id], references: [id], onDelete: SetNull)
  calendar              Calendar?                     @relation(fields: [calendar_id], references: [id], onDelete: SetNull)
  availability_schedule CalendarAvailabilitySchedule? @relation(fields: [availability_schedule_id], references: [id], onDelete: SetNull)
  conferencing_account  CalendarConferencingAccount?  @relation(fields: [conferencing_account_id], references: [id], onDelete: SetNull)
  hosts                 BookingLinkHost[]
  bookings              CalendarBooking[]
  daily_stats           BookingLinkStatsDaily[]

  @@unique([organization_id, slug])
  @@index([organization_id, status])
  @@index([owner_membership_id])
  @@index([company_id])
  @@map("booking_links")
}

/// 19 §6 — Members who can be booked through a link. For ROUND_ROBIN the next host is chosen by
/// priority then least-recently-booked; COLLECTIVE requires every host to be free.
model BookingLinkHost {
  id                       String   @id @default(uuid())
  booking_link_id          String
  membership_id            String
  priority                 Int      @default(0)
  /// Optional per-host schedule override; null = host's default schedule.
  availability_schedule_id String?
  created_at               DateTime @default(now())

  booking_link BookingLink @relation(fields: [booking_link_id], references: [id], onDelete: Cascade)
  membership   Membership  @relation(fields: [membership_id], references: [id], onDelete: Cascade)

  @@unique([booking_link_id, membership_id])
  @@index([membership_id])
  @@map("booking_link_hosts")
}

/// 19 §6, §8, §12 — a booked slot. Confirmed bookings own one CalendarEvent (source BOOKING) and emit
/// `calendar.booking_created`. The invitee is a portal user (user_id), a CRM contact (contact_id) or
/// just a name + email.
model CalendarBooking {
  id                          String                @id @default(uuid())
  organization_id             String
  booking_link_id             String
  event_id                    String?               @unique
  host_membership_id          String?
  status                      CalendarBookingStatus @default(CONFIRMED)
  source                      CalendarBookingSource @default(PUBLIC_LINK)
  starts_at                   DateTime
  ends_at                     DateTime
  /// Invitee's timezone at booking time.
  timezone                    String
  invitee_name                String
  invitee_email               String
  invitee_phone               String?
  /// Customer Portal user who booked (01 §79).
  invitee_user_id             String?
  contact_id                  String?
  company_id                  String?
  /// Answers to BookingLink.questions: { key: value }.
  answers                     Json?
  /// Invitee note shown to the host.
  notes                       String?
  /// Record that triggered the booking (ticket 13, deal/lead 02) — polymorphic.
  origin_entity_type          RecordEntityType?
  origin_entity_id            String?
  /// Token for the invitee's manage page (cancel / reschedule) without login.
  manage_token                String                @unique @default(uuid())
  confirmed_at                DateTime?
  confirmed_by_user_id        String?
  cancelled_at                DateTime?
  /// invitee | host | system
  cancelled_by                String?
  cancellation_reason         String?
  rescheduled_from_booking_id String?
  no_show_marked_at           DateTime?
  completed_at                DateTime?
  /// Marketing attribution captured from the booking page (utm_*, referrer).
  attribution                 Json?
  created_at                  DateTime              @default(now())
  updated_at                  DateTime              @updatedAt

  organization     Organization      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  booking_link     BookingLink       @relation(fields: [booking_link_id], references: [id], onDelete: Cascade)
  event            CalendarEvent?    @relation(fields: [event_id], references: [id], onDelete: SetNull)
  host             Membership?       @relation("CalendarBookingHost", fields: [host_membership_id], references: [id], onDelete: SetNull)
  invitee_user     User?             @relation(fields: [invitee_user_id], references: [id], onDelete: SetNull)
  contact          CrmContact?       @relation(fields: [contact_id], references: [id], onDelete: SetNull)
  company          CrmCompany?       @relation(fields: [company_id], references: [id], onDelete: SetNull)
  rescheduled_from CalendarBooking?  @relation("CalendarBookingReschedule", fields: [rescheduled_from_booking_id], references: [id], onDelete: SetNull)
  rescheduled_to   CalendarBooking[] @relation("CalendarBookingReschedule")

  @@index([organization_id, status, starts_at])
  @@index([booking_link_id, starts_at])
  @@index([host_membership_id, starts_at])
  @@index([invitee_email])
  @@index([invitee_user_id])
  @@index([contact_id])
  @@index([company_id])
  @@index([origin_entity_type, origin_entity_id])
  @@map("calendar_bookings")
}

/// 19 §6, §12 — daily funnel counters of a booking link: page views, slot picks and bookings, with a source
/// breakdown. Incremented by the public booking page / API (no per-visitor rows, no personal data stored;
/// unique visitors are counted from a hashed session in the cache). Conversion = bookings_created / page_views.
model BookingLinkStatsDaily {
  id                 String   @id @default(uuid())
  organization_id    String
  booking_link_id    String
  date               DateTime @db.Date
  page_views         Int      @default(0)
  unique_visitors    Int      @default(0)
  /// A visitor picked a slot and opened the booking form.
  slot_selections    Int      @default(0)
  bookings_created   Int      @default(0)
  bookings_cancelled Int      @default(0)
  /// Views per source: { referrer: { host: n }, utm_source: { name: n }, utm_campaign: { name: n } }.
  sources            Json?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  booking_link BookingLink  @relation(fields: [booking_link_id], references: [id], onDelete: Cascade)

  @@unique([booking_link_id, date])
  @@index([organization_id, date])
  @@map("booking_link_stats_daily")
}

// --- External sync -----------------------------------------------------------------

/// 19 §7, §10 — an OAuth connection to Google Calendar or Microsoft 365. membership_id set = a Member's
/// personal connection (calendar.sync.manage_own); null = organization-level connection for shared
/// calendars. Tokens are stored encrypted by the API.
model CalendarConnection {
  id                   String                   @id @default(uuid())
  organization_id      String
  membership_id        String?
  provider             CalendarProvider
  status               CalendarConnectionStatus @default(PENDING_AUTH)
  /// Provider account identity (Google sub / Microsoft oid) and the mailbox address.
  external_account_id  String?
  account_email        String?
  /// Encrypted OAuth credentials: { access_token, refresh_token, expires_at, token_type }.
  credentials          Json?
  scopes               String[]                 @default([])
  default_direction    CalendarSyncDirection    @default(TWO_WAY)
  /// Provider push channel (Google watch / Microsoft subscription) for incremental sync.
  watch_channel_id     String?
  watch_resource_id    String?
  watch_expires_at     DateTime?
  last_synced_at       DateTime?
  last_error           String?
  last_error_at        DateTime?
  connected_by_user_id String?
  disconnected_at      DateTime?
  created_at           DateTime                 @default(now())
  updated_at           DateTime                 @updatedAt

  organization Organization                 @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  membership   Membership?                  @relation(fields: [membership_id], references: [id], onDelete: Cascade)
  calendars    CalendarConnectionCalendar[]
  sync_runs    CalendarSyncRun[]

  @@unique([organization_id, membership_id, provider, external_account_id])
  @@index([organization_id, status])
  @@index([membership_id])
  @@index([watch_expires_at])
  @@map("calendar_connections")
}

/// 19 §7 — a remote calendar discovered on a connection and its mapping to a local Calendar. Local
/// events of calendar_id are pushed and remote events are pulled according to direction.
/// free_busy_only enforces §7: pulled events expose only busy blocks to other Members.
model CalendarConnectionCalendar {
  id             String                @id @default(uuid())
  connection_id  String
  /// Provider calendar id.
  external_id    String
  name           String
  color          String?
  is_primary     Boolean               @default(false)
  /// Remote access level (owner | writer | reader) as reported by the provider.
  access_role    String?
  sync_enabled   Boolean               @default(false)
  direction      CalendarSyncDirection @default(TWO_WAY)
  /// Local calendar receiving pulled events / providing pushed events; null until sync is enabled.
  calendar_id    String?
  free_busy_only Boolean               @default(true)
  /// Incremental sync cursor (Google syncToken / Microsoft deltaLink).
  sync_cursor    String?
  last_synced_at DateTime?
  last_error     String?
  created_at     DateTime              @default(now())
  updated_at     DateTime              @updatedAt

  connection    CalendarConnection         @relation(fields: [connection_id], references: [id], onDelete: Cascade)
  calendar      Calendar?                  @relation(fields: [calendar_id], references: [id], onDelete: SetNull)
  sync_mappings CalendarEventSyncMapping[]

  @@unique([connection_id, external_id])
  @@index([calendar_id])
  @@map("calendar_connection_calendars")
}

/// 19 §7 — one row per (event, connected calendar): the remote id, the provider's last-modified
/// timestamp used to resolve conflicts, and the sync state. Overwritten local changes are also
/// written to audit_events (`calendar.sync_overwritten`).
model CalendarEventSyncMapping {
  id                     String                    @id @default(uuid())
  event_id               String
  connection_calendar_id String
  /// Provider event id; for recurring series the master id, with the instance id on exception rows.
  external_id            String
  external_ical_uid      String?
  external_etag          String?
  /// Provider-side updated timestamp; conflicts are resolved by the newer timestamp (§7).
  external_updated_at    DateTime?
  /// Local updated_at that was last pushed, to detect local-vs-remote divergence.
  local_synced_version   DateTime?
  status                 CalendarSyncMappingStatus @default(SYNCED)
  last_pulled_at         DateTime?
  last_pushed_at         DateTime?
  /// Snapshot of the losing side when a conflict was auto-resolved (also audited).
  conflict_snapshot      Json?
  last_error             String?
  created_at             DateTime                  @default(now())
  updated_at             DateTime                  @updatedAt

  event               CalendarEvent              @relation(fields: [event_id], references: [id], onDelete: Cascade)
  connection_calendar CalendarConnectionCalendar @relation(fields: [connection_calendar_id], references: [id], onDelete: Cascade)

  @@unique([connection_calendar_id, external_id])
  @@unique([event_id, connection_calendar_id])
  @@index([status])
  @@map("calendar_event_sync_mappings")
}

/// 19 §7 — queryable history of sync runs per connection (full or incremental), for diagnostics.
model CalendarSyncRun {
  id             String                @id @default(uuid())
  connection_id  String
  status         CalendarSyncRunStatus @default(RUNNING)
  /// full | incremental | webhook
  trigger        String                @default("incremental")
  started_at     DateTime              @default(now())
  finished_at    DateTime?
  events_pulled  Int                   @default(0)
  events_pushed  Int                   @default(0)
  events_deleted Int                   @default(0)
  conflicts      Int                   @default(0)
  error          String?
  /// Per-calendar counters and provider diagnostics.
  details        Json?

  connection CalendarConnection @relation(fields: [connection_id], references: [id], onDelete: Cascade)

  @@index([connection_id, started_at])
  @@map("calendar_sync_runs")
}

// --- Conferencing ------------------------------------------------------------------

/// 19 §3 — connected video-conferencing accounts used to auto-create meeting links for events and
/// bookings. GOOGLE_MEET / MICROSOFT_TEAMS may reuse the CalendarConnection credentials
/// (calendar_connection_id); ZOOM has its own OAuth. membership_id null = organization-level account.
model CalendarConferencingAccount {
  id                     String                    @id @default(uuid())
  organization_id        String
  membership_id          String?
  provider               ConferencingProvider
  status                 ConferencingAccountStatus @default(ACTIVE)
  external_account_id    String?
  account_email          String?
  /// Encrypted OAuth credentials or API key for providers with their own auth.
  credentials            Json?
  /// Reuses a calendar connection's token when the provider is Google Meet / Teams; id only (same module).
  calendar_connection_id String?
  /// Default meeting settings (waiting room, passcode, recording …).
  settings               Json?
  is_default             Boolean                   @default(false)
  last_error             String?
  disconnected_at        DateTime?
  created_at             DateTime                  @default(now())
  updated_at             DateTime                  @updatedAt

  organization  Organization  @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  membership    Membership?   @relation(fields: [membership_id], references: [id], onDelete: Cascade)
  booking_links BookingLink[]

  @@unique([organization_id, membership_id, provider, external_account_id])
  @@index([organization_id, provider])
  @@index([membership_id])
  @@map("calendar_conferencing_accounts")
}

// =====================================================================
// 20 Automation Engine — docs/features/20-automation-engine.md (LOG-410)
// Owns: the trigger/action catalog modules register, automation rules and their versions, rule
// templates, runs with per-action steps, approvals and AI steps, the platform event bus
// (PlatformEvent), module-owned scheduled jobs and their runs, outbound webhooks and deliveries,
// inbound webhook endpoints, run locks and per-organization engine settings.
// Does not own: the records actions touch (tasks 06, tickets 13, projects 05, …), notification
// delivery (14), outbound email/SMS (11), chat messages (12), service accounts (01 §76),
// provider webhooks such as payment providers (08 provider_webhook_events), the audit log (01). Rule
// create/edit/enable and destructive runs are also written to audit_events (20 §11).
// =====================================================================

/// 20 §2, §3 — what starts a rule.
enum AutomationTriggerKind {
  EVENT
  SCHEDULE
  DATE_RELATIVE
  MANUAL
  INBOUND_WEBHOOK
}

/// 20 §4 — category of an action exposed by a module or built into the engine.
enum AutomationActionKind {
  UPDATE_FIELD
  ADD_TAG
  SET_CUSTOM_FIELD
  CHANGE_STATUS
  ASSIGN
  CREATE_RECORD
  NOTIFY
  SEND_COMMUNICATION
  POST_MESSAGE
  MANAGE_CHANNEL
  CALL_WEBHOOK
  AI_STEP
  WAIT
  APPROVAL
  BRANCH
  CUSTOM
}

/// 20 §4 — assignment strategy for ASSIGN actions.
enum AutomationAssignStrategy {
  MEMBER
  TEAM
  ROUND_ROBIN
  LEAST_LOADED
}

/// 20 §5 — where a rule applies.
enum AutomationRuleScopeType {
  ORGANIZATION
  BRANCH
  TEAM
  PROJECT_TYPE
  PROJECT
}

/// 20 §5 — rule lifecycle. `enabled` is the user switch; status tracks draft/archive.
enum AutomationRuleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// 20 §5 — live, test (sample event) or dry run (nothing is executed).
enum AutomationRunMode {
  LIVE
  TEST
  DRY_RUN
}

/// 20 §6, §8 — run lifecycle including retry and dead-letter states.
enum AutomationRunStatus {
  PENDING
  RUNNING
  WAITING
  AWAITING_APPROVAL
  RETRY_SCHEDULED
  SUCCEEDED
  FAILED
  DEAD_LETTERED
  SKIPPED
  CANCELLED
}

/// 20 §6, §8 — per-action result inside a run.
enum AutomationStepStatus {
  PENDING
  RUNNING
  WAITING
  AWAITING_APPROVAL
  SUCCEEDED
  FAILED
  SKIPPED
  CANCELLED
}

/// 20 §4, §6 — human approval gate decision.
enum AutomationApprovalDecision {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

/// 20 §4, §9 — AI step operation through the shared AI layer.
enum AutomationAiStepKind {
  CLASSIFY
  SUMMARIZE
  EXTRACT
  DRAFT
}

/// 20 §2 — who published an event to the bus.
enum PlatformEventSource {
  MODULE
  API
  INBOUND_WEBHOOK
  SCHEDULED_JOB
  AUTOMATION
  SYSTEM
}

/// 20 §7 — schedule type of a module-owned job.
enum ScheduledJobKind {
  CRON
  INTERVAL
  ONCE
}

/// 20 §7
enum ScheduledJobStatus {
  ACTIVE
  PAUSED
  DISABLED
  COMPLETED
}

/// 20 §7 — outcome of one job execution.
enum ScheduledJobRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  CANCELLED
  TIMED_OUT
}

/// 20 §12 — outbound webhook endpoint lifecycle; DISABLED after repeated failures.
enum OutboundWebhookStatus {
  ACTIVE
  PAUSED
  DISABLED
}

/// 20 §6, §12 — delivery attempt lifecycle.
enum WebhookDeliveryStatus {
  PENDING
  RETRY_SCHEDULED
  SUCCEEDED
  FAILED
  DEAD_LETTERED
}

/// 20 §12, §14 — inbound webhook endpoint lifecycle.
enum InboundWebhookStatus {
  ACTIVE
  PAUSED
  REVOKED
}

/// 20 §12, §14 — how an inbound webhook payload is authenticated.
enum InboundWebhookAuthScheme {
  HMAC_SHA256
  BEARER_TOKEN
  BASIC
  NONE
}

// --- Organization settings -------------------------------------------------------

/// 20 §6, §8, §10 — per-organization engine guardrails: rate limits, loop depth, retention,
/// destructive-action enablement and the default service account rules may run under.
model AutomationSettings {
  organization_id                              String    @id
  /// 20 §6 — rate limit per organization (runs started per hour).
  org_rate_limit_per_hour                      Int       @default(10000)
  /// 20 §6 — default per-rule rate limit; a rule may lower it.
  default_rule_rate_limit_per_hour             Int       @default(1000)
  /// 20 §6 — loop protection: max depth of rule → event → rule chains.
  max_trigger_depth                            Int       @default(3)
  /// 20 §6 — default retry policy applied to runs and deliveries.
  default_max_retries                          Int       @default(5)
  default_retry_backoff_seconds                Int       @default(60)
  /// 20 §6, §10 — destructive actions must be explicitly enabled (automation.actions.destructive.enable).
  destructive_actions_enabled                  Boolean   @default(false)
  destructive_actions_enabled_at               DateTime?
  destructive_actions_enabled_by_membership_id String?
  /// 20 §6 — destructive / customer-facing actions require human approval by default.
  destructive_requires_approval                Boolean   @default(true)
  /// 20 §8 — run history retention; null = keep forever.
  run_retention_days                           Int?      @default(365)
  /// 20 §2 — event bus log retention.
  event_retention_days                         Int?      @default(90)
  /// 20 §7 — scheduled job run log retention.
  job_run_retention_days                       Int?      @default(90)
  /// 20 §6 — dead-letter alerting through 14 Notifications.
  dead_letter_alerts_enabled                   Boolean   @default(true)
  /// 20 §6 — who is alerted about dead letters besides the rule owner (Members; ids validated by the service).
  dead_letter_alert_membership_ids             String[]  @default([])
  dead_letter_alert_notify_rule_owner          Boolean   @default(true)
  /// 12 Messaging channel that also receives the alert; id only.
  dead_letter_alert_channel_id                 String?
  /// 20 §4, §14 — service account used when a rule has none of its own (01 §76).
  default_service_account_id                   String?
  /// 20 §9 — default confidence gate (0–100) for AI steps.
  ai_default_confidence_threshold              Decimal   @default(80) @db.Decimal(5, 2)
  updated_at                                   DateTime  @updatedAt

  organization            Organization    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  default_service_account ServiceAccount? @relation("AutomationSettingsDefaultServiceAccount", fields: [default_service_account_id], references: [id], onDelete: SetNull)

  @@map("automation_settings")
}

// --- Trigger & action catalog ------------------------------------------------------

/// 20 §3, §12 — a trigger a module registers (platform-wide, not tenant-scoped). `key` is the
/// stable event key modules publish, e.g. `crm.deal.stage_changed`, `contracts.expiring`,
/// `schedule.cron`, `record.date_relative`.
model AutomationTriggerDefinition {
  id                   String                @id @default(uuid())
  module               ModuleKey
  key                  String                @unique
  name                 String
  description          String?
  kind                 AutomationTriggerKind @default(EVENT)
  /// Primary record type the event is about (polymorphic entity on the rule run).
  entity_type          RecordEntityType?
  /// JSON Schema of the event payload; the rule builder uses it for condition fields (20 §5).
  payload_schema       Json?
  /// Sample event for test mode (20 §5).
  sample_payload       Json?
  /// DATE_RELATIVE triggers: date fields of the record that may be used, [{ key, label }] (20 §3).
  date_fields          Json?
  /// Trigger-specific config schema (e.g. { days: 30, direction: "before" } or cron) (20 §3).
  config_schema        Json?
  /// Permission needed to build a rule on this trigger (20 §10).
  required_permission  String?
  /// Also mirrored to 14 Notifications and outbound webhooks (20 §2).
  notifiable           Boolean               @default(true)
  webhook_subscribable Boolean               @default(true)
  version              Int                   @default(1)
  is_active            Boolean               @default(true)
  sort_order           Int                   @default(0)
  created_at           DateTime              @default(now())
  updated_at           DateTime              @updatedAt

  rules AutomationRule[]

  @@index([module, is_active])
  @@index([kind])
  @@map("automation_trigger_definitions")
}

/// 20 §4, §12 — an action a module exposes with its input schema and required permission.
/// `key` e.g. `tasks.create`, `crm.deal.change_status`, `notifications.notify`, `engine.wait`.
model AutomationActionDefinition {
  id                  String               @id @default(uuid())
  module              ModuleKey
  key                 String               @unique
  name                String
  description         String?
  kind                AutomationActionKind
  /// Record type the action operates on, when it targets one.
  entity_type         RecordEntityType?
  /// JSON Schema of the action inputs (20 §4).
  input_schema        Json?
  /// JSON Schema of what the action returns; later steps can reference it (20 §4, §9).
  output_schema       Json?
  /// Permission the executing principal must hold (20 §4, §10).
  required_permission String?
  /// 20 §6 — delete, payment, external send to customers: needs explicit enablement.
  is_destructive      Boolean              @default(false)
  /// 20 §6 — sends to customers / external parties.
  is_customer_facing  Boolean              @default(false)
  /// 20 §6 — the action can be safely re-executed with the same idempotency key.
  is_idempotent       Boolean              @default(true)
  /// 20 §6 — default retry policy for transient failures.
  retryable           Boolean              @default(true)
  /// 20 §4 — AI steps and approval/wait steps are executed by the engine itself.
  is_engine_builtin   Boolean              @default(false)
  version             Int                  @default(1)
  is_active           Boolean              @default(true)
  sort_order          Int                  @default(0)
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt

  run_steps AutomationRunStep[]

  @@index([module, is_active])
  @@index([kind])
  @@map("automation_action_definitions")
}

// --- Rules -------------------------------------------------------------------------

/// 20 §5, §14 — rule templates / recipes library ("Deal won → create project from template").
/// organization_id null = system template shipped by the platform; otherwise an organization's own.
model AutomationRuleTemplate {
  id                       String    @id @default(uuid())
  organization_id          String?
  module                   ModuleKey
  key                      String
  name                     String
  description              String?
  category                 String?
  /// Trigger kind/key + config, conditions and actions in the same shape as AutomationRule.
  definition               Json
  /// Variables the user fills when instantiating: [{ key, label, type, required, default }].
  variables                Json?
  is_system                Boolean   @default(false)
  is_published             Boolean   @default(true)
  usage_count              Int       @default(0)
  created_by_membership_id String?
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  organization Organization?    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  created_by   Membership?      @relation("AutomationRuleTemplateAuthor", fields: [created_by_membership_id], references: [id], onDelete: SetNull)
  rules        AutomationRule[]

  @@unique([organization_id, key])
  @@index([module, is_published])
  @@map("automation_rule_templates")
}

/// 20 §2, §5, §6 — a rule: trigger + conditions + ordered actions, owned by an organization,
/// versioned, enabled/disabled, scoped. The live definition is on the rule; each published edit
/// is snapshotted in AutomationRuleVersion.
model AutomationRule {
  id              String               @id @default(uuid())
  organization_id String
  name            String
  description     String?
  /// Primary module the rule belongs to (for module filters and templates per module, 20 §5).
  module          ModuleKey?
  status          AutomationRuleStatus @default(DRAFT)
  /// 20 §5 — user switch; only PUBLISHED + enabled rules run.
  enabled         Boolean              @default(false)
  /// 20 §5 — current published version number; incremented on every edit of a live rule.
  current_version Int                  @default(1)

  // 20 §2, §3 — trigger
  trigger_kind          AutomationTriggerKind
  /// Event key from the trigger catalog (e.g. `crm.deal.stage_changed`), `schedule.*`, `record.date_relative`, `manual`, `inbound_webhook`.
  trigger_key           String
  trigger_definition_id String?
  /// Trigger configuration: event filters, { cron, timezone } / { interval_seconds }, { entity_type, date_field, offset_days, direction } for DATE_RELATIVE (20 §3).
  trigger_config        Json?
  /// Record type the rule primarily operates on (20 §2).
  entity_type           RecordEntityType?

  // 20 §2 — conditions and actions
  /// Condition tree: { all: [...], any: [...], not: [...] } with predicates on payload, related records, custom fields, scope and time (20 §2).
  conditions Json?
  /// Ordered steps: [{ key, action_key, inputs, on_error: "stop"|"continue", branch?: {...}, wait?: {...}, approval?: {...}, ai?: {...} }] (20 §2, §4).
  actions    Json

  // 20 §5 — scope
  scope_type      AutomationRuleScopeType @default(ORGANIZATION)
  branch_id       String?
  team_id         String?
  project_type_id String?
  project_id      String?

  // 20 §4, §10 — execution principal
  owner_membership_id       String?
  /// 20 §4, §14 — run under a service account instead of the owner (01 §76).
  run_as_service_account_id String?

  // 20 §6 — execution semantics
  /// Template for the per-run idempotency key, e.g. "{{event.id}}" or "{{record.id}}:{{date}}".
  idempotency_key_template         String?
  /// 20 §6 — runs for the same record are serialized when true.
  serialize_per_record             Boolean @default(false)
  max_retries                      Int?
  retry_backoff_seconds            Int?
  /// 20 §6 — per-rule rate limit; null = organization default.
  rate_limit_per_hour              Int?
  /// 20 §6 — loop protection; null = organization default.
  max_trigger_depth                Int?
  /// 20 §6 — rule contains destructive actions and they were explicitly allowed.
  allow_destructive_actions        Boolean @default(false)
  /// 20 §6 — destructive / customer-facing steps pause for human approval.
  require_approval_for_destructive Boolean @default(true)
  /// 20 §6 — maximum run time before the run is failed.
  timeout_seconds                  Int?

  // 20 §5 — provenance
  template_id             String?
  duplicated_from_rule_id String?
  /// Import source metadata when the rule came from an export file (20 §5).
  imported_from           Json?

  // 20 §5 — unpublished edits of a live rule: the live columns keep running until Publish copies the draft
  // over them, bumps current_version, writes AutomationRuleVersion and clears the draft. Discard clears it.
  /// { name, description, trigger_kind, trigger_key, trigger_config, conditions, actions, scope, settings }.
  draft_definition               Json?
  draft_updated_at               DateTime?
  draft_updated_by_membership_id String?

  // 20 §8 — rollups
  last_run_at     DateTime?
  last_run_status AutomationRunStatus?
  run_count       Int                  @default(0)
  failure_count   Int                  @default(0)
  /// 20 §3 — next evaluation for SCHEDULE and DATE_RELATIVE triggers (mirrors the hosting ScheduledJob).
  next_run_at     DateTime?

  enabled_at         DateTime?
  disabled_at        DateTime?
  published_at       DateTime?
  archived_at        DateTime?
  created_by_user_id String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  organization       Organization                 @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  trigger_definition AutomationTriggerDefinition? @relation(fields: [trigger_definition_id], references: [id], onDelete: SetNull)
  owner              Membership?                  @relation("AutomationRuleOwner", fields: [owner_membership_id], references: [id], onDelete: SetNull)
  run_as             ServiceAccount?              @relation("AutomationRuleRunAs", fields: [run_as_service_account_id], references: [id], onDelete: SetNull)
  branch             Branch?                      @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  team               Team?                        @relation(fields: [team_id], references: [id], onDelete: Cascade)
  project_type       ProjectType?                 @relation(fields: [project_type_id], references: [id], onDelete: Cascade)
  project            Project?                     @relation(fields: [project_id], references: [id], onDelete: Cascade)
  template           AutomationRuleTemplate?      @relation(fields: [template_id], references: [id], onDelete: SetNull)
  duplicated_from    AutomationRule?              @relation("AutomationRuleDuplicate", fields: [duplicated_from_rule_id], references: [id], onDelete: SetNull)
  duplicates         AutomationRule[]             @relation("AutomationRuleDuplicate")

  versions         AutomationRuleVersion[]
  runs             AutomationRun[]
  scheduled_jobs   ScheduledJob[]             @relation("ScheduledJobRule")
  inbound_webhooks AutomationInboundWebhook[]
  run_locks        AutomationRunLock[]
  /// 06 — recurring task instances created by this rule.
  tasks            Task[]                     @relation("TaskAutomationRule")
  /// 02 §31 — activities created by this rule.
  crm_activities   CrmActivity[]              @relation("CrmActivityAutomationRule")

  @@index([organization_id, status, enabled])
  @@index([organization_id, trigger_kind, trigger_key])
  @@index([organization_id, module])
  @@index([trigger_definition_id])
  @@index([owner_membership_id])
  @@index([run_as_service_account_id])
  @@index([branch_id])
  @@index([team_id])
  @@index([project_type_id])
  @@index([project_id])
  @@index([template_id])
  @@index([next_run_at])
  @@map("automation_rules")
}

/// 20 §5 — immutable snapshot of a rule at each publish; editing a live rule creates a new version.
/// Runs reference the version they executed (20 §8).
model AutomationRuleVersion {
  id                   String                  @id @default(uuid())
  rule_id              String
  version              Int
  name                 String
  description          String?
  trigger_kind         AutomationTriggerKind
  trigger_key          String
  trigger_config       Json?
  conditions           Json?
  actions              Json
  scope_type           AutomationRuleScopeType
  /// { branch_id, team_id, project_type_id, project_id } at publish time.
  scope                Json?
  /// Execution settings at publish time (idempotency, retries, rate limit, destructive flags).
  settings             Json?
  change_summary       String?
  author_membership_id String?
  published_at         DateTime                @default(now())
  /// Set when a newer version replaced this one.
  superseded_at        DateTime?
  created_at           DateTime                @default(now())

  rule   AutomationRule  @relation(fields: [rule_id], references: [id], onDelete: Cascade)
  author Membership?     @relation("AutomationRuleVersionAuthor", fields: [author_membership_id], references: [id], onDelete: SetNull)
  runs   AutomationRun[]

  @@unique([rule_id, version])
  @@index([author_membership_id])
  @@map("automation_rule_versions")
}

// --- Event bus -----------------------------------------------------------------------

/// 20 §2, §6, §12 — the event bus log: a domain fact published by a module, the API, an inbound
/// webhook or a scheduled job. Consumed by rules (20), 14 Notifications and outbound webhooks.
/// `dedupe_key` gives at-least-once delivery with idempotent consumers.
model PlatformEvent {
  id               String              @id @default(uuid())
  organization_id  String?
  /// Stable key from the trigger catalog, e.g. `crm.deal.stage_changed`.
  event_key        String
  module           ModuleKey
  source           PlatformEventSource @default(MODULE)
  /// Primary record the event is about.
  entity_type      RecordEntityType?
  entity_id        String?
  /// Free-form record kind when RecordEntityType has no value yet (e.g. "leave_request").
  entity_kind      String?
  /// Additional record references: [{ entity_type|entity_kind, entity_id, role }].
  related_entities Json?
  payload          Json
  /// Before/after diff for *.updated / *.status_changed events, when the module provides it.
  changes          Json?

  // 20 §2 — actor
  actor_type               AuditActorType @default(USER)
  actor_user_id            String?
  actor_membership_id      String?
  actor_service_account_id String?

  // 20 §6 — delivery & loop protection
  /// Publisher-supplied idempotency key (module + record + version); duplicates are dropped.
  dedupe_key           String?
  /// Groups events of one business transaction.
  correlation_id       String?
  /// Run that caused this event, when published by an automation action (loop protection).
  causation_run_id     String?
  /// Depth of rule → event → rule chaining; rules stop at the configured max (20 §6).
  trigger_depth        Int      @default(0)
  inbound_webhook_id   String?
  scheduled_job_run_id String?
  occurred_at          DateTime @default(now())
  received_at          DateTime @default(now())

  // 20 §6 — consumer processing flags
  rules_processed_at         DateTime?
  rules_matched_count        Int       @default(0)
  /// 14 Notifications fan-out done.
  notifications_processed_at DateTime?
  /// Outbound webhook fan-out done (20 §12).
  webhooks_processed_at      DateTime?
  /// All consumers done.
  processed_at               DateTime?
  processing_attempts        Int       @default(0)
  processing_error           String?
  next_processing_at         DateTime?
  dead_lettered_at           DateTime?

  organization          Organization?             @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  actor_user            User?                     @relation("PlatformEventActor", fields: [actor_user_id], references: [id], onDelete: SetNull)
  actor_membership      Membership?               @relation("PlatformEventActorMembership", fields: [actor_membership_id], references: [id], onDelete: SetNull)
  actor_service_account ServiceAccount?           @relation("PlatformEventActorServiceAccount", fields: [actor_service_account_id], references: [id], onDelete: SetNull)
  causation_run         AutomationRun?            @relation("PlatformEventCausationRun", fields: [causation_run_id], references: [id], onDelete: SetNull)
  inbound_webhook       AutomationInboundWebhook? @relation(fields: [inbound_webhook_id], references: [id], onDelete: SetNull)
  scheduled_job_run     ScheduledJobRun?          @relation(fields: [scheduled_job_run_id], references: [id], onDelete: SetNull)

  triggered_runs     AutomationRun[]   @relation("AutomationRunTriggerEvent")
  webhook_deliveries WebhookDelivery[]

  @@unique([organization_id, dedupe_key])
  @@index([organization_id, event_key, occurred_at])
  @@index([organization_id, entity_type, entity_id])
  @@index([organization_id, processed_at])
  @@index([event_key, occurred_at])
  @@index([next_processing_at])
  @@index([correlation_id])
  @@index([causation_run_id])
  @@index([actor_user_id])
  @@index([actor_membership_id])
  @@index([actor_service_account_id])
  @@index([inbound_webhook_id])
  @@index([scheduled_job_run_id])
  @@index([occurred_at])
  @@map("platform_events")
}

// --- Runs ------------------------------------------------------------------------------

/// 20 §2, §6, §8 — one execution of a rule: trigger, inputs, conditions evaluated, status,
/// duration, errors and retries. Steps hold each action result.
model AutomationRun {
  id                   String                @id @default(uuid())
  organization_id      String
  rule_id              String
  rule_version_id      String?
  /// Version number executed, kept even if the version row is pruned.
  rule_version         Int
  mode                 AutomationRunMode     @default(LIVE)
  status               AutomationRunStatus   @default(PENDING)
  trigger_kind         AutomationTriggerKind
  trigger_key          String
  event_id             String?
  scheduled_job_run_id String?
  /// 20 §6 — idempotency key; the same key never starts a second run for the rule.
  idempotency_key      String
  /// Primary record the run operates on (20 §8 — searchable by record).
  entity_type          RecordEntityType?
  entity_id            String?
  entity_kind          String?
  /// Trigger payload / sample event as received (20 §8).
  input                Json?
  /// Evaluated conditions: [{ path, operator, expected, actual, passed }] (20 §8).
  conditions_result    Json?
  /// False = conditions did not match; the run is SKIPPED.
  conditions_passed    Boolean?
  /// Final outputs keyed by step key (20 §4 — results are inputs to later actions).
  output               Json?

  // 20 §4, §8 — actor / principal
  actor_type                AuditActorType @default(SYSTEM)
  /// Member who ran the rule manually (20 §12).
  actor_membership_id       String?
  /// Principal the actions executed as (20 §4, §14).
  run_as_service_account_id String?

  // 20 §6 — chaining, retries, waiting
  /// Run whose actions published the triggering event (loop protection).
  parent_run_id                String?
  trigger_depth                Int       @default(0)
  attempt                      Int       @default(1)
  max_attempts                 Int       @default(1)
  next_retry_at                DateTime?
  /// Index of the step currently executing / waiting.
  current_step_index           Int?
  /// WAIT step: resume at this time.
  wait_until                   DateTime?
  /// 20 §6, §11 — run executed a destructive or customer-facing action (audited).
  performed_destructive_action Boolean   @default(false)

  // 20 §8 — timing and errors
  queued_at                  DateTime  @default(now())
  started_at                 DateTime?
  finished_at                DateTime?
  duration_ms                Int?
  error_code                 String?
  error_message              String?
  /// Structured error (stack, failing step, upstream response).
  error                      Json?
  dead_lettered_at           DateTime?
  dead_letter_reason         String?
  cancelled_at               DateTime?
  cancelled_by_membership_id String?
  created_at                 DateTime  @default(now())
  updated_at                 DateTime  @updatedAt

  organization      Organization           @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  rule              AutomationRule         @relation(fields: [rule_id], references: [id], onDelete: Cascade)
  rule_version_ref  AutomationRuleVersion? @relation(fields: [rule_version_id], references: [id], onDelete: SetNull)
  event             PlatformEvent?         @relation("AutomationRunTriggerEvent", fields: [event_id], references: [id], onDelete: SetNull)
  scheduled_job_run ScheduledJobRun?       @relation(fields: [scheduled_job_run_id], references: [id], onDelete: SetNull)
  actor_membership  Membership?            @relation("AutomationRunActor", fields: [actor_membership_id], references: [id], onDelete: SetNull)
  run_as            ServiceAccount?        @relation("AutomationRunRunAs", fields: [run_as_service_account_id], references: [id], onDelete: SetNull)
  parent_run        AutomationRun?         @relation("AutomationRunChain", fields: [parent_run_id], references: [id], onDelete: SetNull)
  child_runs        AutomationRun[]        @relation("AutomationRunChain")

  steps         AutomationRunStep[]
  approvals     AutomationApproval[]
  ai_steps      AutomationAiStep[]
  caused_events PlatformEvent[]      @relation("PlatformEventCausationRun")
  locks         AutomationRunLock[]

  @@unique([rule_id, idempotency_key])
  @@index([organization_id, status, created_at])
  @@index([organization_id, rule_id, created_at])
  @@index([organization_id, entity_type, entity_id])
  @@index([rule_version_id])
  @@index([event_id])
  @@index([scheduled_job_run_id])
  @@index([actor_membership_id])
  @@index([run_as_service_account_id])
  @@index([parent_run_id])
  @@index([status, next_retry_at])
  @@index([status, wait_until])
  @@index([created_at])
  @@map("automation_runs")
}

/// 20 §4, §6, §8 — one action (step) inside a run with its inputs, result, retries and timing.
model AutomationRunStep {
  id                   String               @id @default(uuid())
  run_id               String
  /// 0-based position in the rule's actions list.
  step_index           Int
  /// Step key from the rule definition (referenced by later steps).
  step_key             String
  action_key           String
  action_definition_id String?
  kind                 AutomationActionKind
  status               AutomationStepStatus @default(PENDING)
  /// Resolved inputs after template interpolation.
  input                Json?
  output               Json?
  /// 20 §6 — per-step idempotency key handed to the module action.
  idempotency_key      String?
  attempt              Int                  @default(1)
  max_attempts         Int                  @default(1)
  next_retry_at        DateTime?
  /// WAIT step: resume time.
  wait_until           DateTime?
  /// BRANCH step: which branch key was taken.
  branch_taken         String?
  skipped_reason       String?
  /// 20 §6 — this step was destructive / customer-facing.
  is_destructive       Boolean              @default(false)
  started_at           DateTime?
  finished_at          DateTime?
  duration_ms          Int?
  error_code           String?
  error_message        String?
  error                Json?
  created_at           DateTime             @default(now())
  updated_at           DateTime             @updatedAt

  run                AutomationRun               @relation(fields: [run_id], references: [id], onDelete: Cascade)
  action_definition  AutomationActionDefinition? @relation(fields: [action_definition_id], references: [id], onDelete: SetNull)
  approval           AutomationApproval?
  ai_step            AutomationAiStep?
  webhook_deliveries WebhookDelivery[]

  @@unique([run_id, step_index])
  @@index([action_definition_id])
  @@index([status, next_retry_at])
  @@index([status, wait_until])
  @@map("automation_run_steps")
}

/// 20 §4, §6, §9, §14 — human approval gate: a run pauses until a member approves or rejects.
model AutomationApproval {
  id                           String                     @id @default(uuid())
  organization_id              String
  run_id                       String
  step_id                      String                     @unique
  decision                     AutomationApprovalDecision @default(PENDING)
  /// What is about to happen (action summary, record, AI output) shown to the approver.
  context                      Json?
  /// Member (or members, via Json) asked to approve; the first decision wins.
  requested_from_membership_id String?
  /// Additional approvers / team ids when more than one may decide.
  requested_from               Json?
  approver_membership_id       String?
  comment                      String?
  requested_at                 DateTime                   @default(now())
  expires_at                   DateTime?
  decided_at                   DateTime?
  /// 14 Notification id sent for this request; id only.
  notification_id              String?
  /// 20 §4 — reusable approver policy the step used; null = ad-hoc requested_from.
  policy_id                    String?
  /// Escalation: set when the request was re-sent to the policy's escalation approver.
  escalated_at                 DateTime?
  escalated_to_membership_id   String?

  organization          Organization              @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  run                   AutomationRun             @relation(fields: [run_id], references: [id], onDelete: Cascade)
  step                  AutomationRunStep         @relation(fields: [step_id], references: [id], onDelete: Cascade)
  requested_from_member Membership?               @relation("AutomationApprovalRequestedFrom", fields: [requested_from_membership_id], references: [id], onDelete: SetNull)
  approver              Membership?               @relation("AutomationApprovalApprover", fields: [approver_membership_id], references: [id], onDelete: SetNull)
  policy                AutomationApprovalPolicy? @relation(fields: [policy_id], references: [id], onDelete: SetNull)

  @@index([organization_id, decision])
  @@index([run_id])
  @@index([requested_from_membership_id, decision])
  @@index([approver_membership_id])
  @@index([policy_id])
  @@index([expires_at])
  @@map("automation_approvals")
}

/// 20 §4, §6 — reusable approver policy referenced by `approval.policy_id` in a rule step (e.g. "any of the
/// finance leads, escalate to the CFO after 24 h, hand over while an approver is out of office"). First decision
/// wins (same as AutomationApproval); quorum / all-must-approve is Phase 2. Approver ids are validated by the
/// service (arrays cannot carry foreign keys).
model AutomationApprovalPolicy {
  id                          String    @id @default(uuid())
  organization_id             String
  name                        String
  description                 String?
  approver_membership_ids     String[]  @default([])
  approver_team_ids           String[]  @default([])
  approver_role_ids           String[]  @default([])
  /// The rule owner may approve their own rule's requests (default off).
  allow_rule_owner            Boolean   @default(false)
  /// Request expires (decision EXPIRED, step follows on_error) after N hours; null = never.
  expires_after_hours         Int?
  /// Re-send to escalate_to_membership_id after N hours without a decision; null = no escalation.
  escalate_after_hours        Int?
  escalate_to_membership_id   String?
  /// Route to the next approver of the policy while one is on leave (10) or has an out-of-office event (19).
  delegate_when_out_of_office Boolean   @default(true)
  created_by_membership_id    String?
  archived_at                 DateTime?
  created_at                  DateTime  @default(now())
  updated_at                  DateTime  @updatedAt

  organization Organization         @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  approvals    AutomationApproval[]

  @@unique([organization_id, name])
  @@index([organization_id, archived_at])
  @@map("automation_approval_policies")
}

/// 20 §4, §9, §14 — AI step record: structured output with confidence, threshold gate and the
/// approval it may require. Never executes irreversible actions by itself.
model AutomationAiStep {
  id                   String               @id @default(uuid())
  organization_id      String
  run_id               String
  step_id              String               @unique
  kind                 AutomationAiStepKind
  /// Shared AI layer provider/model identifiers (Product_Specification §6).
  provider             String?
  model                String?
  /// Prompt template key or inline instructions used.
  prompt_template      String?
  /// Resolved prompt / inputs sent to the model.
  input                Json?
  /// JSON Schema the output must match (classify labels, extract fields, …).
  output_schema        Json?
  /// Structured result.
  output               Json?
  /// 0–100.
  confidence           Decimal?             @db.Decimal(5, 2)
  /// Gate: below this the next step waits for approval or the run stops (20 §9).
  confidence_threshold Decimal?             @db.Decimal(5, 2)
  passed_threshold     Boolean?
  requires_approval    Boolean              @default(false)
  input_tokens         Int?
  output_tokens        Int?
  /// Provider cost in the organization currency; 6 decimals because unit prices are fractions of a cent.
  cost_amount          Decimal?             @db.Decimal(18, 6)
  latency_ms           Int?
  error                String?
  created_at           DateTime             @default(now())

  organization Organization      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  run          AutomationRun     @relation(fields: [run_id], references: [id], onDelete: Cascade)
  step         AutomationRunStep @relation(fields: [step_id], references: [id], onDelete: Cascade)

  @@index([organization_id, kind, created_at])
  @@index([run_id])
  @@map("automation_ai_steps")
}

/// 20 §6 — serialization lock: runs for the same record are executed one at a time when the
/// rule requires it. Rows are short-lived; expired locks are reclaimed by the worker.
model AutomationRunLock {
  id              String            @id @default(uuid())
  organization_id String
  rule_id         String?
  run_id          String
  entity_type     RecordEntityType?
  entity_kind     String?
  entity_id       String
  /// Lock key as hashed: rule (or "*") + entity.
  lock_key        String
  acquired_at     DateTime          @default(now())
  expires_at      DateTime

  organization Organization    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  rule         AutomationRule? @relation(fields: [rule_id], references: [id], onDelete: Cascade)
  run          AutomationRun   @relation(fields: [run_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, lock_key])
  @@index([run_id])
  @@index([rule_id])
  @@index([expires_at])
  @@map("automation_run_locks")
}

// --- Scheduled jobs --------------------------------------------------------------------

/// 20 §7 — module-owned recurring job hosted by the engine (04 expiration monitoring,
/// 08 billing/dunning, 09 recurring expenses, 12 channel archival, 13 SLA timers,
/// 14 digests, 17 retention). Also hosts the schedule of SCHEDULE/DATE_RELATIVE rules
/// (rule_id set). organization_id null = platform-wide job.
model ScheduledJob {
  id                    String                 @id @default(uuid())
  organization_id       String?
  /// 20 §7 — optional branch scope for branch-level module jobs (01 §34 branch reporting).
  branch_id             String?
  module                ModuleKey
  /// Stable per-module job key, e.g. `finance.dunning.tick`, `contracts.expiration_monitor`.
  key                   String
  name                  String
  description           String?
  kind                  ScheduledJobKind       @default(CRON)
  /// 5/6-field cron expression (CRON).
  cron_expression       String?
  interval_seconds      Int?
  /// Single execution time (ONCE).
  run_at                DateTime?
  timezone              String                 @default("UTC")
  /// Handler the module registered for this job (service method key).
  handler               String
  /// Arguments passed to the handler on every run (e.g. { policy_id }).
  payload               Json?
  status                ScheduledJobStatus     @default(ACTIVE)
  /// User rule whose schedule this job drives (20 §3).
  rule_id               String?
  next_run_at           DateTime?
  last_run_at           DateTime?
  last_run_status       ScheduledJobRunStatus?
  last_error            String?
  last_duration_ms      Int?
  run_count             Int                    @default(0)
  failure_count         Int                    @default(0)
  consecutive_failures  Int                    @default(0)
  /// 20 §6, §7 — retries with backoff.
  max_retries           Int                    @default(3)
  retry_backoff_seconds Int                    @default(60)
  timeout_seconds       Int?
  /// Skip the tick if the previous run is still running.
  allow_overlap         Boolean                @default(false)
  /// Run missed ticks after downtime, otherwise skip to the next one.
  catch_up_missed       Boolean                @default(false)
  /// Worker lease for exactly-one-runner scheduling.
  locked_by             String?
  locked_at             DateTime?
  lock_expires_at       DateTime?
  paused_at             DateTime?
  created_at            DateTime               @default(now())
  updated_at            DateTime               @updatedAt

  organization        Organization?      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  rule                AutomationRule?    @relation("ScheduledJobRule", fields: [rule_id], references: [id], onDelete: Cascade)
  runs                ScheduledJobRun[]
  branch              Branch?            @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  crm_report_schedule CrmReportSchedule? @relation("CrmReportScheduleJob")

  @@unique([organization_id, module, key])
  @@index([status, next_run_at])
  @@index([organization_id, module])
  @@index([rule_id])
  @@index([branch_id])
  @@index([lock_expires_at])
  @@map("scheduled_jobs")
}

/// 20 §7, §8 — one execution of a scheduled job.
model ScheduledJobRun {
  id                         String                @id @default(uuid())
  job_id                     String
  organization_id            String?
  status                     ScheduledJobRunStatus @default(PENDING)
  /// Tick this run was scheduled for.
  scheduled_for              DateTime
  started_at                 DateTime?
  finished_at                DateTime?
  duration_ms                Int?
  attempt                    Int                   @default(1)
  max_attempts               Int                   @default(1)
  next_retry_at              DateTime?
  /// Payload as passed to the handler for this run.
  input                      Json?
  /// Handler result / counters (e.g. { invoices_processed: 12 }).
  output                     Json?
  error_code                 String?
  error_message              String?
  error                      Json?
  worker_id                  String?
  /// Set when a member ran the job on demand.
  triggered_by_membership_id String?
  created_at                 DateTime              @default(now())
  updated_at                 DateTime              @updatedAt

  job          ScheduledJob  @relation(fields: [job_id], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  triggered_by Membership?   @relation("ScheduledJobRunTriggeredBy", fields: [triggered_by_membership_id], references: [id], onDelete: SetNull)

  automation_runs  AutomationRun[]
  published_events PlatformEvent[]

  @@index([job_id, scheduled_for])
  @@index([organization_id, status, created_at])
  @@index([status, next_retry_at])
  @@index([triggered_by_membership_id])
  @@map("scheduled_job_runs")
}

// --- Webhooks --------------------------------------------------------------------------

/// 20 §12 — outbound webhook endpoint subscribed to platform events (and the target of the
/// CALL_WEBHOOK action). `secret` is stored encrypted and used for HMAC signatures.
/// Also the single webhook mechanism for every module's "API & Webhooks" section (02 §38, 03, 04, 05 §116,
/// 06 §16, 09, 11, 13 §11, 14 §14, 15 §10, 17 §17, 18 §13, 19 §12) — modules publish events with their
/// `<module>.<entity>.<action>` keys. Messaging webhooks (12 §39–40, §52) are rows here with
/// `messaging.*` event keys and the optional channel filter below.
model OutboundWebhook {
  id                       String                @id @default(uuid())
  organization_id          String
  name                     String
  description              String?
  url                      String
  /// Encrypted signing secret; shown once on creation.
  secret                   String
  /// Signature header algorithm, e.g. `hmac-sha256`.
  signing_algorithm        String                @default("hmac-sha256")
  /// Event keys this endpoint receives, e.g. `automation.rule_run_failed`, `crm.deal.won`; `*` = all (20 §12).
  subscribed_events        String[]              @default([])
  /// Static headers added to every delivery.
  headers                  Json?
  /// 12 §40 — only messaging events from this channel; null = all channels the endpoint may see.
  channel_id               String?
  /// 12 §40, §53 — direct-message events are excluded unless explicitly enabled.
  include_direct_messages  Boolean               @default(false)
  content_type             String                @default("application/json")
  /// Payload shape version sent to the endpoint.
  api_version              String?
  status                   OutboundWebhookStatus @default(ACTIVE)
  max_attempts             Int                   @default(5)
  retry_backoff_seconds    Int                   @default(60)
  timeout_seconds          Int                   @default(10)
  /// Disabled automatically after this many consecutive failures; null = never.
  disable_after_failures   Int?                  @default(50)
  consecutive_failures     Int                   @default(0)
  last_delivery_at         DateTime?
  last_success_at          DateTime?
  last_failure_at          DateTime?
  disabled_at              DateTime?
  disabled_reason          String?
  created_by_membership_id String?
  created_at               DateTime              @default(now())
  updated_at               DateTime              @updatedAt

  organization               Organization      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  created_by                 Membership?       @relation("OutboundWebhookCreator", fields: [created_by_membership_id], references: [id], onDelete: SetNull)
  channel                    Channel?          @relation("WebhookChannelFilter", fields: [channel_id], references: [id], onDelete: Cascade)
  deliveries                 WebhookDelivery[]
  /// 01 §138 — secret rotation grace: deliveries are also verifiable with the previous (encrypted) secret until previous_secret_expires_at.
  previous_secret            String?
  secret_rotated_at          DateTime?
  previous_secret_expires_at DateTime?

  @@index([organization_id, status])
  @@index([created_by_membership_id])
  @@index([channel_id])
  @@map("outbound_webhooks")
}

/// 20 §6, §12 — one delivery of an event (or a CALL_WEBHOOK step) to an endpoint, with attempts,
/// response code and retry state.
model WebhookDelivery {
  id                   String                @id @default(uuid())
  organization_id      String
  webhook_id           String
  event_id             String?
  /// Set when the delivery was produced by a CALL_WEBHOOK action rather than a subscription.
  run_step_id          String?
  event_key            String
  status               WebhookDeliveryStatus @default(PENDING)
  /// Body sent (after api_version shaping).
  payload              Json
  request_headers      Json?
  attempt              Int                   @default(0)
  max_attempts         Int                   @default(5)
  next_retry_at        DateTime?
  response_status_code Int?
  /// Truncated response body for debugging.
  response_body        String?
  response_headers     Json?
  error_message        String?
  duration_ms          Int?
  /// Per-delivery idempotency id sent in the signature header.
  delivery_key         String                @unique @default(uuid())
  last_attempt_at      DateTime?
  delivered_at         DateTime?
  dead_lettered_at     DateTime?
  created_at           DateTime              @default(now())
  updated_at           DateTime              @updatedAt

  organization Organization       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  webhook      OutboundWebhook    @relation(fields: [webhook_id], references: [id], onDelete: Cascade)
  event        PlatformEvent?     @relation(fields: [event_id], references: [id], onDelete: SetNull)
  run_step     AutomationRunStep? @relation(fields: [run_step_id], references: [id], onDelete: SetNull)

  @@index([webhook_id, created_at])
  @@index([organization_id, status, created_at])
  @@index([event_id])
  @@index([run_step_id])
  @@index([status, next_retry_at])
  @@map("webhook_deliveries")
}

/// 20 §12, §14 — inbound webhook endpoint: external systems trigger rules with a signed payload.
/// The request is logged as a PlatformEvent (source INBOUND_WEBHOOK, event_key `inbound_webhook.<slug>`).
model AutomationInboundWebhook {
  id                       String                   @id @default(uuid())
  organization_id          String
  /// Rule started by this endpoint; null = publishes the event for any rule with trigger_key `inbound_webhook.<slug>`.
  rule_id                  String?
  name                     String
  description              String?
  /// Public path token: /webhooks/in/{slug}.
  slug                     String                   @unique
  auth_scheme              InboundWebhookAuthScheme @default(HMAC_SHA256)
  /// Encrypted secret / token used to verify the signature.
  secret                   String
  /// Header carrying the signature or token.
  signature_header         String?
  /// JSON Schema the payload must match; invalid payloads are rejected and logged.
  payload_schema           Json?
  /// Optional mapping from raw payload to the event payload (JSONPath / template).
  payload_mapping          Json?
  allowed_ip_ranges        String[]                 @default([])
  status                   InboundWebhookStatus     @default(ACTIVE)
  /// Requests per minute; null = organization default.
  rate_limit_per_minute    Int?
  received_count           Int                      @default(0)
  rejected_count           Int                      @default(0)
  last_received_at         DateTime?
  last_rejected_at         DateTime?
  last_rejection_reason    String?
  secret_rotated_at        DateTime?
  revoked_at               DateTime?
  created_by_membership_id String?
  created_at               DateTime                 @default(now())
  updated_at               DateTime                 @updatedAt

  organization Organization    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  rule         AutomationRule? @relation(fields: [rule_id], references: [id], onDelete: SetNull)
  created_by   Membership?     @relation("InboundWebhookCreator", fields: [created_by_membership_id], references: [id], onDelete: SetNull)
  events       PlatformEvent[]

  @@index([organization_id, status])
  @@index([rule_id])
  @@index([created_by_membership_id])
  @@map("automation_inbound_webhooks")
}
