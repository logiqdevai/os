/// 01 §157 — third-party services an organization connects with its own credentials. LAUNCH SET ONLY: to support another provider add a value
/// here, an entry in api/src/shared/constants/integration-providers.ts and an adapter in the owning module. The domain enums PaymentProvider (08) and
/// CommProviderKind (11) already reserve more providers; they stay reserved until their adapter and value are added here.
enum IntegrationProvider {
  OPENAI
  RESEND
  TWILIO
  STRIPE
  VIVA_WALLET
}

/// 01 §157 — what a connection is used for. Modules resolve a connection by category (+ default, branch).
enum IntegrationCategory {
  AI
  EMAIL
  SMS
  PAYMENTS
}

/// 01 §157 — PENDING = saved but not verified yet; ACTIVE = verified and usable; ERROR = last verification or call failed
/// (see last_error); DISABLED = switched off by an admin (secret kept); DISCONNECTED = secret destroyed.
enum IntegrationStatus {
  PENDING
  ACTIVE
  ERROR
  DISABLED
  DISCONNECTED
}

/// 01 §157 — provider environment of the credentials (Stripe test/live, sandbox accounts).
enum IntegrationMode {
  LIVE
