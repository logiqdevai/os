// Prisma schema — Logiqdev OS API
//
// Module coverage:
//   01 Users, Members, Organizations, Branches & Permissions  → docs/features/01-users-organizations-permissions.md (LOG-406)
//   02 CRM & Sales Management (incl. platform custom fields, tags, saved views) → docs/features/02-crm-sales-management.md (LOG-404)
//   03 Proposals & Quotations (incl. platform number sequences) → docs/features/03-proposal-quotation-generator.md (LOG-303)
//   04 Contracts (incl. the in-house e-signature service) → docs/features/04-contracts.md (LOG-349)
//   05 Project Management → docs/features/05-project-management.md (LOG-405)
//   06 Task Management → docs/features/06-task-management.md (LOG-102)
//   07 Customer Portal (portal settings only) → docs/features/07-customer-portal.md (LOG-103)
//   08 Financial Management & Payment Providers (incl. platform products catalog) → docs/features/08-financial-management-stripe-integration.md (LOG-104)
//   09 Income & Expense Management (ledger, VAT, periods, payroll cost) → docs/features/09-income-expense-management.md (LOG-105)
//   10 Employee Management (HR, leave, attendance, capacity) → docs/features/10-employee-management-system.md (LOG-107)
//   11 Communication Center (outbound email/SMS, templates, campaigns) → docs/features/11-communication-center.md (LOG-106)
//   12 Messaging & Team Communication (channels, messages) → docs/features/12-messaging-team-communication.md (LOG-313)
//   13 Customer Support (conversations, tickets, SLA, knowledge base) → docs/features/13-customer-support-communication-hub.md (LOG-342)
//   14 Notifications & Activity Center → docs/features/14-notifications-activity-center.md (LOG-403)
//   15 Business Docs (wiki, forms, AI knowledge) → docs/features/15-notion-business-docs.md (LOG-341)
//   17 Documents & File Management (incl. the Document model, vault) → docs/features/17-documents-file-management.md (LOG-407)
//   18 Time Tracking → docs/features/18-time-tracking.md (LOG-408)
//   19 Calendar → docs/features/19-calendar.md (LOG-409)
//   20 Automation Engine (rules, jobs, event bus, webhooks) → docs/features/20-automation-engine.md (LOG-410)
//   16 is a parking lot (no tables). Section banners below are parsed by docs/scripts/sync-feature-schema-refs.mjs.
//
// Conventions:
//   - Table names snake_case plural via @@map; columns snake_case.
//   - Primary keys are uuid strings; foreign keys end in _id.
//   - Records that belong to a tenant carry organization_id (01 §9).
//   - Every module's tables live in its own banner section. Cross-module references are Prisma relations;
//     a few remain plain string ids (documented in a comment naming the owning module) where a relation
//     would be circular or the target is an array/JSON of ids.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

