// Platform shared concepts defined by 02 CRM — custom fields (§24–26),
// tags (§36), saved views (§29). Consumed by every module.
// =====================================================================

/// Entities that can carry custom fields, tags and saved views. Modules append their own values.
enum RecordEntityType {
  MEMBERSHIP
  AUDIT_EVENT
  CRM_COMPANY
  CRM_CONTACT
  CRM_LEAD
  CRM_DEAL
  CRM_ACTIVITY
  PROJECT
  TASK
  CONTRACT
  CONTRACT_OBLIGATION
  PROPOSAL
  TICKET
  DOCUMENT
  FINANCIAL_RECORD
  LEDGER_INVOICE_IMPORT
  EXPENSE_CLAIM
  LEDGER_BUDGET
  VAT_RETURN
  PAYMENT_LINK
  EMPLOYEE
  INVOICE
  RECURRING_EXPENSE
  PAYROLL_ENTRY
  LEAVE_REQUEST
  PERFORMANCE_REVIEW
  PERFORMANCE_GOAL
  COMM_MESSAGE
  CAMPAIGN
  COMM_TEMPLATE
  CHANNEL
  MESSAGE
  PROJECT_MILESTONE
  PROJECT_CHANGE_REQUEST
  PAYMENT
  SUPPORT_CONVERSATION
  KNOWLEDGE_ARTICLE
  NOTIFICATION
  WIKI_SPACE
  WIKI_PAGE
  CUSTOM_FORM
  FORM_SUBMISSION
  FOLDER
  VAULT_ENTRY
  TIME_ENTRY
  TIMESHEET
  CALENDAR_EVENT
  CALENDAR_BOOKING
  AUTOMATION_RULE
  AUTOMATION_RUN
  SCHEDULED_JOB
  SUBSCRIPTION
}

/// 02 §24 — supported field types.
enum CustomFieldType {
  TEXT
  LONG_TEXT
  NUMBER
  DECIMAL
  CURRENCY
  PERCENTAGE
  BOOLEAN
  DATE
  DATETIME
  EMAIL
  PHONE
  URL
  DROPDOWN
  MULTI_SELECT
  RADIO
  USER
  TEAM
  COMPANY
  CONTACT
  DEAL
  RECORD_REFERENCE
}

enum SavedViewVisibility {
  PERSONAL
  TEAM
  ORGANIZATION
}

/// 02 §25 — logical sections for shared fields.
model CustomFieldGroup {
  id              String   @id @default(uuid())
  organization_id String
  name            String
  description     String?
  sort_order      Int      @default(0)
  created_at      DateTime @default(now())

  organization Organization            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  fields       CustomFieldDefinition[]

  @@unique([organization_id, name])
  @@map("custom_field_groups")
}

/// 02 §24–26 — one definition; shared fields list several entity types (02 §25).
/// `key` is the stable API identifier (02 §26); `label` may change.
model CustomFieldDefinition {
  id              String             @id @default(uuid())
  organization_id String
  group_id        String?
  key             String
  label           String
  description     String?
  type            CustomFieldType
  /// Entity types this field applies to. Length > 1 means a shared field (02 §25).
  entity_types    RecordEntityType[]
  is_shared       Boolean            @default(false)
  is_required     Boolean            @default(false)
  /// Options for DROPDOWN / MULTI_SELECT / RADIO: [{ value, label, color?, sort_order? }]
  options         Json?
  default_value   Json?
  /// Validation rules (min, max, regex, length …).
  validation      Json?
  /// Role-based visibility and visibility rules (02 §24).
  visibility      Json?
  is_searchable   Boolean            @default(true)
  is_filterable   Boolean            @default(true)
  is_sortable     Boolean            @default(false)
  sort_order      Int                @default(0)
  archived_at     DateTime?
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt

  organization Organization       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  group        CustomFieldGroup?  @relation(fields: [group_id], references: [id], onDelete: SetNull)
  values       CustomFieldValue[]

  @@unique([organization_id, key])
  @@index([organization_id])
  @@map("custom_field_definitions")
}

/// Value of a custom field on a record. entity_id points at the table named by entity_type.
model CustomFieldValue {
  id            String           @id @default(uuid())
  definition_id String
  entity_type   RecordEntityType
  entity_id     String
  /// Typed value stored as JSON (string, number, boolean, ISO date, option value, option values[], referenced id).
  value         Json?
  /// Denormalized text for search/filter.
  value_text    String?
  updated_at    DateTime         @updatedAt

  definition CustomFieldDefinition @relation(fields: [definition_id], references: [id], onDelete: Cascade)

  @@unique([definition_id, entity_id])
  @@index([entity_type, entity_id])
  @@index([definition_id, value_text])
  @@map("custom_field_values")
}

/// Organization-scoped tags, applied to any record through Tagging.
model Tag {
  id              String             @id @default(uuid())
  organization_id String
  name            String
  slug            String
  color           String?
  /// Restrict a tag to certain entity types; empty = any.
  entity_types    RecordEntityType[] @default([])
  created_at      DateTime           @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  taggings     Tagging[]

  @@unique([organization_id, slug])
  @@map("tags")
}

model Tagging {
  tag_id      String
  entity_type RecordEntityType
  entity_id   String
  created_at  DateTime         @default(now())

  tag Tag @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([tag_id, entity_type, entity_id])
  @@index([entity_type, entity_id])
  @@map("taggings")
}

/// 02 §29, 06 §5 — saved views with filters, sorting, grouping, columns; personal, team or organization-wide. Used by every list/board view.
model SavedView {
  id                  String              @id @default(uuid())
  organization_id     String
  entity_type         RecordEntityType
  name                String
  /// table | kanban | pipeline | list | timeline | calendar | activity | forecast
  layout              String              @default("table")
  visibility          SavedViewVisibility @default(PERSONAL)
  owner_membership_id String?
  team_id             String?
  filters             Json?
  sorting             Json?
  grouping            Json?
  columns             Json?
  search              String?
  is_default          Boolean             @default(false)
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  owner        Membership?  @relation(fields: [owner_membership_id], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [team_id], references: [id], onDelete: Cascade)
  segments     Segment[]

  @@index([organization_id, entity_type])
  @@index([owner_membership_id])
  @@map("saved_views")
}

