  @@map("crm_lifecycle_history")
}

/// 02 §8 — multiple pipelines per organization.
model CrmPipeline {
  id              String    @id @default(uuid())
  organization_id String
  name            String
  slug            String
  description     String?
  /// Optional owning team (02 §21).
  team_id         String?
  is_default      Boolean   @default(false)
  currency        String?
  archived_at     DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  organization Organization       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  team         Team?              @relation(fields: [team_id], references: [id], onDelete: SetNull)
  stages       CrmPipelineStage[]
  deals        CrmDeal[]

  sales_targets      CrmSalesTarget[]
  forecast_snapshots CrmForecastSnapshot[]

  @@unique([organization_id, slug])
  @@map("crm_pipelines")
}

/// 02 §8 — pipeline-specific stages with default probability.
model CrmPipelineStage {
  id                String              @id @default(uuid())
  pipeline_id       String
  name              String
  slug              String
  sort_order        Int                 @default(0)
  /// Default win probability (0–100) applied to deals entering this stage.
  probability       Int                 @default(0)
  forecast_category CrmForecastCategory @default(PIPELINE)
  is_won            Boolean             @default(false)
  is_lost           Boolean             @default(false)
  /// Days after which a deal in this stage is considered stale (02 §31 inactive-deal rule).
  stale_after_days  Int?
  color             String?
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt

  pipeline     CrmPipeline           @relation(fields: [pipeline_id], references: [id], onDelete: Cascade)
  deals        CrmDeal[]
  history_from CrmDealStageHistory[] @relation("StageHistoryFrom")
  history_to   CrmDealStageHistory[] @relation("StageHistoryTo")

  @@unique([pipeline_id, slug])
  @@index([pipeline_id, sort_order])
  @@map("crm_pipeline_stages")
}

// --- Core records -----------------------------------------------------------

/// 02 §2 — any external legal entity: prospect, customer, partner or vendor. One record model.
/// Never a platform Organization (01 §8) and never a Branch (01 §16).
model CrmCompany {
  id                            String         @id @default(uuid())
  organization_id               String
  parent_company_id             String?
  name                          String
  legal_name                    String?
  type                          CrmCompanyType @default(PROSPECT)
  lifecycle_stage_id            String?
  industry                      String?
  company_size                  String?
  number_of_employees           Int?
  annual_revenue                Decimal?       @db.Decimal(18, 2)
  currency                      String?
  website                       String?
  email                         String?
  phone                         String?
  country                       String?
  address                       Json?
  tax_id                        String?
  vat_number                    String?
  registration_number           String?
  description                   String?
  lead_source_id                String?
  customer_since                DateTime?
  /// 02 §2a — default commission agreed with a partner company (share of the first-year revenue of referred deals). The payout itself is an expense in 09.
  partner_commission_percent    Decimal?       @db.Decimal(5, 2)
  /// 02 §20 — ownership and responsibility.
  owner_membership_id           String?
  account_manager_membership_id String?
  success_owner_membership_id   String?
  /// 02 §20 — secondary owner and the project manager responsible for the customer's delivery work.
  secondary_owner_membership_id String?
  project_manager_membership_id String?
  team_id                       String?
  /// External system identifiers (02 §27). The billing profile itself is owned by 08.
  external_ids                  Json?
  last_activity_at              DateTime?
  next_activity_at              DateTime?
  archived_at                   DateTime?
  /// 02 §22 — duplicate merge: the survivor this record was merged into. Old links and external ids resolve through it; the record is archived.
  merged_into_id                String?
  merged_at                     DateTime?
  created_by_user_id            String?
  created_at                    DateTime       @default(now())
  updated_at                    DateTime       @updatedAt

  organization    Organization       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  parent          CrmCompany?        @relation("CrmCompanyHierarchy", fields: [parent_company_id], references: [id], onDelete: SetNull)
  merged_into     CrmCompany?        @relation("CrmCompanyMerge", fields: [merged_into_id], references: [id], onDelete: SetNull)
  children        CrmCompany[]       @relation("CrmCompanyHierarchy")
  lifecycle_stage CrmLifecycleStage? @relation(fields: [lifecycle_stage_id], references: [id], onDelete: SetNull)
  lead_source     CrmLeadSource?     @relation(fields: [lead_source_id], references: [id], onDelete: SetNull)
  owner           Membership?        @relation("CrmCompanyOwner", fields: [owner_membership_id], references: [id], onDelete: SetNull)
  account_manager Membership?        @relation("CrmCompanyAccountManager", fields: [account_manager_membership_id], references: [id], onDelete: SetNull)
  success_owner   Membership?        @relation("CrmCompanySuccessOwner", fields: [success_owner_membership_id], references: [id], onDelete: SetNull)
  secondary_owner Membership?        @relation("CrmCompanySecondaryOwner", fields: [secondary_owner_membership_id], references: [id], onDelete: SetNull)
  project_manager Membership?        @relation("CrmCompanyProjectManager", fields: [project_manager_membership_id], references: [id], onDelete: SetNull)
  team            Team?              @relation(fields: [team_id], references: [id], onDelete: SetNull)

  contacts                       CrmContact[]
  leads                          CrmLead[]
  deals                          CrmDeal[]
  activities                     CrmActivity[]
  branches                       CrmCompanyBranch[]
  lifecycle_history              CrmLifecycleHistory[]
  converted_from_leads           CrmLead[]                            @relation("LeadConvertedCompany")
  proposals                      Proposal[]
  primary_contracts              Contract[]                           @relation("ContractPrimaryCompany")
  contract_parties               ContractParty[]
  projects                       Project[]
  billing_profiles               BillingProfile[]
  invoices                       Invoice[]
  subscriptions                  Subscription[]
  portal_profile_change_requests CustomerPortalProfileChangeRequest[]
  ledger_supplier_profile        LedgerSupplierProfile?
  ledger_records                 LedgerRecord[]
  ledger_invoice_imports         LedgerInvoiceImport[]
  recurring_expenses             RecurringExpense[]
  financial_period_summaries     FinancialPeriodSummary[]
  ledger_profitability_snapshots LedgerProfitabilitySnapshot[]
  comm_threads                   CommThread[]
  comm_messages                  CommMessage[]
  messaging_channels             Channel[]
  support_conversations          SupportConversation[]
  support_tickets                Ticket[]
  folders                        Folder[]
  documents                      Document[]
  vault_entries                  VaultEntry[]
  calendars                      Calendar[]
  calendar_events                CalendarEvent[]
  booking_links                  BookingLink[]
  calendar_bookings              CalendarBooking[]
  portal_invitations             Invitation[]
  portal_settings                CustomerPortalClientSettings[]
  merged_from                    CrmCompany[]                         @relation("CrmCompanyMerge")
  referred_leads                 CrmLead[]                            @relation("CrmLeadReferringPartner")
  referred_deals                 CrmDeal[]                            @relation("CrmDealReferringPartner")

  @@index([organization_id, name])
  @@index([organization_id, type])
  @@index([organization_id, lifecycle_stage_id])
  @@index([owner_membership_id])
  @@index([parent_company_id])
  @@index([merged_into_id])
  @@map("crm_companies")
}

/// 01 §31, §37 — branch relationships on one company record instead of duplicate companies.
model CrmCompanyBranch {
  id            String                @id @default(uuid())
  company_id    String
  branch_id     String
  relation_type CrmBranchRelationType @default(SALES)
  is_primary    Boolean               @default(false)
  created_at    DateTime              @default(now())

  company CrmCompany @relation(fields: [company_id], references: [id], onDelete: Cascade)
  branch  Branch     @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  @@unique([company_id, branch_id, relation_type])
  @@index([branch_id])
  @@map("crm_company_branches")
}

/// 02 §3 — a person at a Company. Not a platform User (01 §4).
model CrmContact {
  id                            String           @id @default(uuid())
  organization_id               String
  company_id                    String?
  first_name                    String
  last_name                     String?
  job_title                     String?
  department                    String?
  /// Primary email; additional addresses in `emails`.
  email                         String?
  emails                        Json?
  phone                         String?
  mobile                        String?
  phones                        Json?
  /// 02 §3 — postal address { line1, line2, city, region, postal_code, country }.
  address                       Json?
  website                       String?
  linkedin_url                  String?
  social_profiles               Json?
  roles                         CrmContactRole[] @default([])
  contact_type                  String?
  lifecycle_stage_id            String?
  lead_source_id                String?
  owner_membership_id           String?
  /// 02 §20 — secondary owner.
  secondary_owner_membership_id String?
  timezone                      String?
  language                      String?
  /// Marketing consent per channel (consumed by 11 Communication Center).
  consent                       Json?
  description                   String?
  last_activity_at              DateTime?
  archived_at                   DateTime?
  /// 02 §22 — duplicate merge: the survivor this record was merged into (record is archived and kept as a redirect).
  merged_into_id                String?
  merged_at                     DateTime?
  created_by_user_id            String?
  created_at                    DateTime         @default(now())
  updated_at                    DateTime         @updatedAt

  organization    Organization       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  company         CrmCompany?        @relation(fields: [company_id], references: [id], onDelete: SetNull)
  merged_into     CrmContact?        @relation("CrmContactMerge", fields: [merged_into_id], references: [id], onDelete: SetNull)
  lifecycle_stage CrmLifecycleStage? @relation(fields: [lifecycle_stage_id], references: [id], onDelete: SetNull)
  lead_source     CrmLeadSource?     @relation(fields: [lead_source_id], references: [id], onDelete: SetNull)
  owner           Membership?        @relation("CrmContactOwner", fields: [owner_membership_id], references: [id], onDelete: SetNull)
  secondary_owner Membership?        @relation("CrmContactSecondaryOwner", fields: [secondary_owner_membership_id], references: [id], onDelete: SetNull)

  leads                           CrmLead[]
  primary_deals                   CrmDeal[]                            @relation("CrmDealPrimaryContact")
  deal_links                      CrmDealContact[]
  activities                      CrmActivityParticipant[]
  lifecycle_history               CrmLifecycleHistory[]
  converted_from_leads            CrmLead[]                            @relation("LeadConvertedContact")
  proposals                       Proposal[]
  proposal_deliveries             ProposalDelivery[]
  proposal_acceptances            ProposalAcceptance[]
  contract_signatories            ContractSignatory[]
  project_stakeholders            ProjectStakeholder[]
  portal_profile_change_requests  CustomerPortalProfileChangeRequest[]
  comm_threads                    CommThread[]
  comm_messages                   CommMessage[]                        @relation("CommMessageRecipientContact")
  comm_message_recipients         CommMessageRecipient[]               @relation("CommMessageRecipientsContact")
  comm_recipient_list_memberships CommRecipientListMember[]            @relation("CommRecipientListMemberContact")
  comm_consents                   CommConsent[]                        @relation("CommConsentContact")
  comm_suppressions               CommSuppression[]                    @relation("CommSuppressionContact")
  campaign_recipients             CampaignRecipient[]                  @relation("CampaignRecipientContact")
  support_conversations           SupportConversation[]
  support_tickets                 Ticket[]
  support_csat_ratings            SupportCsatRating[]
  calendar_event_attendances      CalendarEventAttendee[]
  calendar_bookings               CalendarBooking[]
  merged_from                     CrmContact[]                         @relation("CrmContactMerge")
  contract_reviews                ContractReview[]                     @relation("ContractReviewerContact")

  comm_topic_subscriptions CommTopicSubscription[] @relation("CommTopicSubscriptionContact")

  @@index([organization_id, email])
  @@index([organization_id, last_name, first_name])
  @@index([company_id])
  @@index([owner_membership_id])
  @@index([merged_into_id])
  @@map("crm_contacts")
}

/// 02 §4–7 — prospect before qualification. Conversion links to the created records (02 §7).
model CrmLead {
  id                            String    @id @default(uuid())
  organization_id               String
  branch_id                     String?
  name                          String
  company_id                    String?
  contact_id                    String?
  /// Free-text company/contact details captured before records exist.
  company_name                  String?
  contact_name                  String?
  email                         String?
  phone                         String?
  website                       String?
  industry                      String?
  estimated_company_size        String?
  estimated_value               Decimal?  @db.Decimal(18, 2)
  currency                      String?
  status_id                     String?
  lead_source_id                String?
  owner_membership_id           String?
  /// 02 §20 — secondary owner.
  secondary_owner_membership_id String?
  /// 02 §6 — qualification criteria and answers.
  qualification                 Json?
  qualification_notes           String?
  lead_score                    Int?
  manual_score                  Int?
  description                   String?
  last_activity_at              DateTime?
  next_follow_up_at             DateTime?
  converted_at                  DateTime?
  converted_company_id          String?
  converted_contact_id          String?
  converted_deal_id             String?
  lost_reason                   String?
  /// 02 §4 — catalogue reason (CrmLossReason) for reporting; `lost_reason` stays the free-text detail.
  lost_reason_id                String?
  /// 02 §2a — partner company that referred this lead.
  referring_partner_company_id  String?
  /// 02 §22 — duplicate merge: the survivor this lead was merged into.
  merged_into_id                String?
  merged_at                     DateTime?
  archived_at                   DateTime?
  created_by_user_id            String?
  created_at                    DateTime  @default(now())
  updated_at                    DateTime  @updatedAt

  organization      Organization   @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  branch            Branch?        @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  company           CrmCompany?    @relation(fields: [company_id], references: [id], onDelete: SetNull)
  contact           CrmContact?    @relation(fields: [contact_id], references: [id], onDelete: SetNull)
  status            CrmLeadStatus? @relation(fields: [status_id], references: [id], onDelete: SetNull)
  lead_source       CrmLeadSource? @relation(fields: [lead_source_id], references: [id], onDelete: SetNull)
  owner             Membership?    @relation("CrmLeadOwner", fields: [owner_membership_id], references: [id], onDelete: SetNull)
  secondary_owner   Membership?    @relation("CrmLeadSecondaryOwner", fields: [secondary_owner_membership_id], references: [id], onDelete: SetNull)
  converted_company CrmCompany?    @relation("LeadConvertedCompany", fields: [converted_company_id], references: [id], onDelete: SetNull)
  converted_contact CrmContact?    @relation("LeadConvertedContact", fields: [converted_contact_id], references: [id], onDelete: SetNull)
  converted_deal    CrmDeal?       @relation("LeadConvertedDeal", fields: [converted_deal_id], references: [id], onDelete: SetNull)
  loss_reason       CrmLossReason? @relation("CrmLeadLossReason", fields: [lost_reason_id], references: [id], onDelete: SetNull)
  referring_partner CrmCompany?    @relation("CrmLeadReferringPartner", fields: [referring_partner_company_id], references: [id], onDelete: SetNull)
  merged_into       CrmLead?       @relation("CrmLeadMerge", fields: [merged_into_id], references: [id], onDelete: SetNull)
  activities        CrmActivity[]
  merged_from       CrmLead[]      @relation("CrmLeadMerge")

  @@index([organization_id, status_id])
  @@index([organization_id, owner_membership_id])
  @@index([organization_id, email])
  @@index([merged_into_id])
  @@index([referring_partner_company_id])
  @@map("crm_leads")
}

/// 02 §9 — deal / opportunity. Totals derive from line items when any exist (02 §10).
model CrmDeal {
  id                                 String              @id @default(uuid())
  organization_id                    String
  branch_id                          String?
  pipeline_id                        String
  stage_id                           String
  name                               String
  company_id                         String?
  primary_contact_id                 String?
  owner_membership_id                String?
  /// 02 §20 — secondary owner (covers for the owner, shares credit) and the project manager who will deliver the deal.
  secondary_owner_membership_id      String?
  project_manager_membership_id      String?
  team_id                            String?
  status                             CrmDealStatus       @default(OPEN)
  value                              Decimal             @default(0) @db.Decimal(18, 2)
  recurring_value                    Decimal             @default(0) @db.Decimal(18, 2)
  one_time_value                     Decimal             @default(0) @db.Decimal(18, 2)
  discount_amount                    Decimal             @default(0) @db.Decimal(18, 2)
  /// 02 §10 — order-level discount applied on top of the line items; above the member's CrmDiscountPolicy.max_percent it needs `crm.deals.approve_discount`.
  discount_percent                   Decimal             @default(0) @db.Decimal(5, 2)
  discount_approved_by_membership_id String?
  discount_approved_at               DateTime?
  tax_amount                         Decimal             @default(0) @db.Decimal(18, 2)
  currency                           String
  probability                        Int?
  forecast_category                  CrmForecastCategory @default(PIPELINE)
  expected_close_date                DateTime?           @db.Date
  actual_close_date                  DateTime?           @db.Date
  deal_type                          String?
  lead_source_id                     String?
  competitor                         String?
  lost_reason                        String?
  /// 02 §9 — catalogue reason (CrmLossReason) for reporting; `lost_reason` stays the free-text detail.
  lost_reason_id                     String?
  /// 02 §9 — why the deal was won (free text, shown in the won summary).
  won_note                           String?
  /// 02 §2a — partner company that referred this deal.
  referring_partner_company_id       String?
  /// 02 §22 — duplicate merge: the survivor this deal was merged into.
  merged_into_id                     String?
  merged_at                          DateTime?
  next_step                          String?
  description                        String?
  /// References to records owned by other modules (ids only): 03, 04, 05.
  proposal_id                        String?
  contract_id                        String?
  project_id                         String?
  stage_entered_at                   DateTime            @default(now())
  last_activity_at                   DateTime?
  archived_at                        DateTime?
  created_by_user_id                 String?
  created_at                         DateTime            @default(now())
  updated_at                         DateTime            @updatedAt

  organization         Organization     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  branch               Branch?          @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  pipeline             CrmPipeline      @relation(fields: [pipeline_id], references: [id], onDelete: Restrict)
  stage                CrmPipelineStage @relation(fields: [stage_id], references: [id], onDelete: Restrict)
  company              CrmCompany?      @relation(fields: [company_id], references: [id], onDelete: SetNull)
  primary_contact      CrmContact?      @relation("CrmDealPrimaryContact", fields: [primary_contact_id], references: [id], onDelete: SetNull)
  owner                Membership?      @relation("CrmDealOwner", fields: [owner_membership_id], references: [id], onDelete: SetNull)
  secondary_owner      Membership?      @relation("CrmDealSecondaryOwner", fields: [secondary_owner_membership_id], references: [id], onDelete: SetNull)
  project_manager      Membership?      @relation("CrmDealProjectManager", fields: [project_manager_membership_id], references: [id], onDelete: SetNull)
  team                 Team?            @relation(fields: [team_id], references: [id], onDelete: SetNull)
  lead_source          CrmLeadSource?   @relation(fields: [lead_source_id], references: [id], onDelete: SetNull)
  project              Project?         @relation("CrmDealProject", fields: [project_id], references: [id], onDelete: SetNull)
  loss_reason          CrmLossReason?   @relation("CrmDealLossReason", fields: [lost_reason_id], references: [id], onDelete: SetNull)
  referring_partner    CrmCompany?      @relation("CrmDealReferringPartner", fields: [referring_partner_company_id], references: [id], onDelete: SetNull)
  discount_approved_by Membership?      @relation("CrmDealDiscountApprover", fields: [discount_approved_by_membership_id], references: [id], onDelete: SetNull)
  merged_into          CrmDeal?         @relation("CrmDealMerge", fields: [merged_into_id], references: [id], onDelete: SetNull)

  contacts             CrmDealContact[]
  line_items           CrmDealLineItem[]
  stage_history        CrmDealStageHistory[]
  activities           CrmActivity[]
  converted_from_leads CrmLead[]             @relation("LeadConvertedDeal")
  proposals            Proposal[]
  merged_from          CrmDeal[]             @relation("CrmDealMerge")

  @@index([organization_id, pipeline_id, stage_id])
  @@index([organization_id, status])
  @@index([company_id])
  @@index([owner_membership_id])
  @@index([expected_close_date])
  @@index([merged_into_id])
  @@index([referring_partner_company_id])
  @@map("crm_deals")
}

/// 02 §9 — additional contacts on a deal.
model CrmDealContact {
  deal_id    String
  contact_id String
  role       String?
  created_at DateTime @default(now())

  deal    CrmDeal    @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  contact CrmContact @relation(fields: [contact_id], references: [id], onDelete: Cascade)

  @@id([deal_id, contact_id])
  @@index([contact_id])
  @@map("crm_deal_contacts")
}

/// 02 §10 — deal line items. product_id references the Finance catalog (08); no FK until 08 exists.
model CrmDealLineItem {
  id                String   @id @default(uuid())
  deal_id           String
  product_id        String?
  name              String
  description       String?
  quantity          Decimal  @default(1) @db.Decimal(12, 3)
  unit_price        Decimal  @default(0) @db.Decimal(18, 2)
  discount_percent  Decimal? @db.Decimal(5, 2)
  discount_amount   Decimal  @default(0) @db.Decimal(18, 2)
  tax_percent       Decimal? @db.Decimal(5, 2)
  net_amount        Decimal  @default(0) @db.Decimal(18, 2)
  tax_amount        Decimal  @default(0) @db.Decimal(18, 2)
  gross_amount      Decimal  @default(0) @db.Decimal(18, 2)
  is_recurring      Boolean  @default(false)
  /// monthly | quarterly | annual | custom
  billing_frequency String?
  sort_order        Int      @default(0)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  deal    CrmDeal  @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [product_id], references: [id], onDelete: SetNull)

  @@index([deal_id])
  @@map("crm_deal_line_items")
}

/// 02 §8, §34 — stage transitions for duration, velocity and history.
model CrmDealStageHistory {
  id                 String   @id @default(uuid())
  deal_id            String
  from_stage_id      String?
  to_stage_id        String
  changed_by_user_id String?
  changed_at         DateTime @default(now())
  /// Seconds spent in from_stage.
  duration_seconds   Int?

  deal       CrmDeal           @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  from_stage CrmPipelineStage? @relation("StageHistoryFrom", fields: [from_stage_id], references: [id], onDelete: SetNull)
  to_stage   CrmPipelineStage  @relation("StageHistoryTo", fields: [to_stage_id], references: [id], onDelete: Cascade)

  @@index([deal_id, changed_at])
  @@map("crm_deal_stage_history")
}

// --- Activities & notes -----------------------------------------------------

/// 02 §12–15 — unified CRM activity. Tasks are NOT activities: they live in 06 and link back to CRM
/// records from Task Management. MEETING rows reference a Calendar event (19).
model CrmActivity {
  id                    String                @id @default(uuid())
  organization_id       String
  type                  CrmActivityType
  status                CrmActivityStatus     @default(PLANNED)
  priority              CrmPriority           @default(NORMAL)
  /// 02 §13 — CALL / EMAIL: inbound or outbound.
  direction             CrmActivityDirection?
  title                 String
  description           String?
  company_id            String?
  contact_id            String?
  lead_id               String?
  deal_id               String?
  /// Project reference (05); id only.
  project_id            String?
  owner_membership_id   String?
  starts_at             DateTime?
  ends_at               DateTime?
  duration_minutes      Int?
  location              String?
  meeting_url           String?
  /// Calendar event id (19); id only.
  calendar_event_id     String?
  outcome               String?
  /// 02 §13 — logged EMAIL: the real message in Communication Center (11); id only.
  comm_message_id       String?
  /// 02 §13 — CALL: recording stored in Documents (17), sensitive; id only.
  recording_document_id String?
  /// Automation rule id (20) when created by a rule.
  automation_rule_id    String?
  completed_at          DateTime?
  created_by_user_id    String?
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt

  organization       Organization             @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  company            CrmCompany?              @relation(fields: [company_id], references: [id], onDelete: Cascade)
  lead               CrmLead?                 @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  deal               CrmDeal?                 @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  owner              Membership?              @relation("CrmActivityOwner", fields: [owner_membership_id], references: [id], onDelete: SetNull)
  participants       CrmActivityParticipant[]
  calendar_event     CalendarEvent?           @relation(fields: [calendar_event_id], references: [id], onDelete: SetNull)
  comm_message       CommMessage?             @relation(fields: [comm_message_id], references: [id], onDelete: SetNull)
  recording_document Document?                @relation("CrmActivityRecording", fields: [recording_document_id], references: [id], onDelete: SetNull)
  automation_rule    AutomationRule?          @relation("CrmActivityAutomationRule", fields: [automation_rule_id], references: [id], onDelete: SetNull)

  @@index([organization_id, starts_at])
  @@index([company_id])
  @@index([contact_id])
  @@index([deal_id])
  @@index([lead_id])
  @@index([owner_membership_id, status])
  @@index([comm_message_id])
  @@map("crm_activities")
}

/// Participants of an activity: internal Members (by membership id) and CRM Contacts.
model CrmActivityParticipant {
  id            String  @id @default(uuid())
  activity_id   String
  membership_id String?
  contact_id    String?
  response      String?

  activity CrmActivity @relation(fields: [activity_id], references: [id], onDelete: Cascade)
  contact  CrmContact? @relation(fields: [contact_id], references: [id], onDelete: Cascade)

  @@unique([activity_id, membership_id, contact_id])
  @@index([contact_id])
  @@map("crm_activity_participants")
}

/// 02 §16 — notes attachable to companies, contacts, leads, deals and other modules' records.
model CrmNote {
  id                   String           @id @default(uuid())
  organization_id      String
  entity_type          RecordEntityType
  entity_id            String
  author_membership_id String?
  /// Markdown / rich text body.
  body                 String
  is_private           Boolean          @default(false)
  /// Mentioned membership ids.
  mentions             String[]         @default([])
  pinned               Boolean          @default(false)
  edited_at            DateTime?
  /// Previous bodies for edit history (02 §16).
  edit_history         Json?
  created_at           DateTime         @default(now())
  updated_at           DateTime         @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  author       Membership?  @relation("CrmNoteAuthor", fields: [author_membership_id], references: [id], onDelete: SetNull)

  @@index([entity_type, entity_id, created_at])
  @@index([organization_id])
  @@map("crm_notes")
}

// --- Operations ---------------------------------------------------------------

/// 02 §20 — automatic assignment rules (evaluated by the Automation Engine, 20).
model CrmAssignmentRule {
  id              String           @id @default(uuid())
  organization_id String
  name            String
  entity_type     RecordEntityType
  /// Conditions on record fields and custom fields.
  conditions      Json
  /// { membership_id } | { team_id, strategy: "round_robin" | "least_loaded" }
  assign_to       Json
  priority        Int              @default(0)
  enabled         Boolean          @default(true)
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id, entity_type, enabled])
  @@map("crm_assignment_rules")
}

/// 02 §11, §33 — sales target for pipeline coverage and attainment. Scope: the whole organization (owner and team null), a team, or one
/// person; optionally one pipeline. Coverage = open pipeline / target; attainment = actual / target.
model CrmSalesTarget {
  id                  String          @id @default(uuid())
  organization_id     String
  pipeline_id         String?
  /// Individual target; null with team_id null = organization-wide.
  owner_membership_id String?
  team_id             String?
  period              CrmTargetPeriod
  period_start        DateTime        @db.Date
  period_end          DateTime        @db.Date
  metric              CrmTargetMetric @default(REVENUE_WON)
  amount              Decimal         @db.Decimal(14, 2)
  currency            String
  created_by_user_id  String?
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  pipeline     CrmPipeline? @relation(fields: [pipeline_id], references: [id], onDelete: SetNull)
  owner        Membership?  @relation("CrmSalesTargetOwner", fields: [owner_membership_id], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@index([organization_id, period_start])
  @@index([owner_membership_id])
  @@index([team_id])
  @@map("crm_sales_targets")
}

/// 02 §33 — periodic forecast snapshot (written by a daily job) so forecast accuracy can compare what was forecast with what closed.
/// One row per pipeline and scope (organization, team or owner) and forecast period.
model CrmForecastSnapshot {
  id                  String   @id @default(uuid())
  organization_id     String
  pipeline_id         String
  owner_membership_id String?
  team_id             String?
  snapshot_date       DateTime @db.Date
  period_start        DateTime @db.Date
  period_end          DateTime @db.Date
  pipeline_amount     Decimal  @default(0) @db.Decimal(14, 2)
  best_case_amount    Decimal  @default(0) @db.Decimal(14, 2)
  commit_amount       Decimal  @default(0) @db.Decimal(14, 2)
  closed_won_amount   Decimal  @default(0) @db.Decimal(14, 2)
  weighted_amount     Decimal  @default(0) @db.Decimal(14, 2)
  deal_count          Int      @default(0)
  currency            String
  created_at          DateTime @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  pipeline     CrmPipeline  @relation(fields: [pipeline_id], references: [id], onDelete: Cascade)
  owner        Membership?  @relation("CrmForecastSnapshotOwner", fields: [owner_membership_id], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@index([organization_id, pipeline_id, snapshot_date])
  @@index([organization_id, period_start])
  @@map("crm_forecast_snapshots")
}

/// 02 §32 — dashboard layout by role or team: which widgets and in which order. role_id and team_id both null = organization default.
/// A person's own arrangement stays in UserPreference.dashboard_layout and wins over these.
model CrmDashboardLayout {
  id                 String   @id @default(uuid())
  organization_id    String
  name               String
  role_id            String?
  team_id            String?
  /// Ordered widgets: [{ key, size, filters }].
  widgets            Json
  is_default         Boolean  @default(false)
  created_by_user_id String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  role         Role?        @relation(fields: [role_id], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@index([organization_id, role_id])
  @@index([organization_id, team_id])
  @@map("crm_dashboard_layouts")
}

/// 02 §6 — configurable lead-scoring rule: when the conditions match, the points are added to CrmLead.lead_score (manual_score stays separate).
model CrmLeadScoringRule {
  id              String   @id @default(uuid())
  organization_id String
  name            String
  description     String?
  /// Conditions over lead fields, source, activity and engagement, e.g. [{ field, operator, value }].
  conditions      Json
  /// Points added (negative to subtract).
  points          Int
  enabled         Boolean  @default(true)
  sort_order      Int      @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id, enabled])
  @@map("crm_lead_scoring_rules")
}

/// 02 §22 — CSV import jobs with mapping, preview, validation, history and rollback.
model CrmImportJob {
  id                       String           @id @default(uuid())
  organization_id          String
  entity_type              RecordEntityType
  status                   CrmImportStatus  @default(PENDING)
  /// Uploaded file (17 Documents); id only.
  document_id              String?
  file_name                String?
  field_mapping            Json?
  /// Duplicate detection strategy: match fields and merge behaviour.
  duplicate_strategy       Json?
  total_rows               Int              @default(0)
  imported_rows            Int              @default(0)
  updated_rows             Int              @default(0)
  skipped_rows             Int              @default(0)
  error_rows               Int              @default(0)
  errors                   Json?
  /// Ids created by this job, kept for rollback.
  created_record_ids       String[]         @default([])
  started_by_membership_id String?
  started_at               DateTime?
  completed_at             DateTime?
  rolled_back_at           DateTime?
  created_at               DateTime         @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  started_by   Membership?  @relation(fields: [started_by_membership_id], references: [id], onDelete: SetNull)
  document     Document?    @relation(fields: [document_id], references: [id], onDelete: SetNull)

  @@index([organization_id, status])
  @@map("crm_import_jobs")
}

/// 02 §22 — one duplicate merge (companies, contacts, leads, deals): survivor, merged ids, per-field choices and
/// what was re-pointed. The merged records keep `merged_into_id` so old links and external ids still resolve.
model CrmMergeLog {
  id                      String           @id @default(uuid())
  organization_id         String
  /// CRM_COMPANY | CRM_CONTACT | CRM_LEAD | CRM_DEAL.
  entity_type             RecordEntityType
  survivor_id             String
  merged_ids              String[]         @default([])
  /// { field: { chosen_from: record_id, value } } for every field where the records differed.
  field_choices           Json?
  /// Re-pointed related records, e.g. { contacts: 3, deals: 2, activities: 14, notes: 6 }.
  moved_counts            Json?
  merged_by_membership_id String?
  created_at              DateTime         @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  merged_by    Membership?  @relation("CrmMergeLogMergedBy", fields: [merged_by_membership_id], references: [id], onDelete: SetNull)

  @@index([organization_id, entity_type, survivor_id])
  @@map("crm_merge_logs")
}

/// 02 §22 — duplicate detection settings per entity type: match keys, minimum score and whether the check runs on create.
model CrmDuplicateRule {
  id              String           @id @default(uuid())
  organization_id String
  entity_type     RecordEntityType
  /// email | phone | domain | vat | name | tax_id | registration_number
  match_keys      String[]         @default([])
  min_score       Int              @default(50)
  auto_check      Boolean          @default(true)
  enabled         Boolean          @default(true)
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, entity_type])
  @@map("crm_duplicate_rules")
}

/// 02 §22 — a pair of records a member marked "not a duplicate", so it is not proposed again.
/// The pair is stored in one direction only: record_a_id < record_b_id.
model CrmDuplicateDismissal {
  id                         String           @id @default(uuid())
  organization_id            String
  entity_type                RecordEntityType
  record_a_id                String
  record_b_id                String
  dismissed_by_membership_id String?
  created_at                 DateTime         @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  dismissed_by Membership?  @relation("CrmDuplicateDismissalBy", fields: [dismissed_by_membership_id], references: [id], onDelete: SetNull)

  @@unique([organization_id, entity_type, record_a_id, record_b_id])
  @@map("crm_duplicate_dismissals")
}

/// 02 §4, §9 — configurable catalogue of lost reasons for deals and leads (reliable "why we lose" reporting).
/// Archived reasons stay on old records. Managed with `crm.settings.manage`.
model CrmLossReason {
  id              String             @id @default(uuid())
  organization_id String
  name            String
  slug            String
  applies_to      CrmLossReasonScope @default(BOTH)
  sort_order      Int                @default(0)
  archived_at     DateTime?
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  deals        CrmDeal[]    @relation("CrmDealLossReason")
  leads        CrmLead[]    @relation("CrmLeadLossReason")

  @@unique([organization_id, slug])
  @@index([organization_id, archived_at])
  @@map("crm_loss_reasons")
}

/// 02 §22 — saved import mapping template (column mapping and duplicate strategy) for repeated imports.
model CrmImportMapping {
  id                       String           @id @default(uuid())
  organization_id          String
  name                     String
  entity_type              RecordEntityType
  field_mapping            Json
  duplicate_strategy       Json?
  created_by_membership_id String?
  created_at               DateTime         @default(now())
  updated_at               DateTime         @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  created_by   Membership?  @relation("CrmImportMappingCreator", fields: [created_by_membership_id], references: [id], onDelete: SetNull)

  @@unique([organization_id, entity_type, name])
  @@map("crm_import_mappings")
}

/// 02 §10 — who may give how much order-level discount on a deal without approval (highest max_percent across a member's roles).
/// Above it, `crm.deals.approve_discount` is required (CrmDeal.discount_approved_by_membership_id).
model CrmDiscountPolicy {
  id              String   @id @default(uuid())
  organization_id String
  role_id         String
  max_percent     Decimal  @db.Decimal(5, 2)
  enabled         Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, role_id])
  @@map("crm_discount_policies")
}

/// 02 §33 — a saved report emailed on a schedule. The timing (cron, timezone, retries) lives in the linked
/// ScheduledJob (20 §7, handler `crm.reports.send`, payload { report_schedule_id }); this row holds what is sent and to whom.
/// The report is rendered with the owner's permissions; managed with `crm.reports.schedule`.
model CrmReportSchedule {
  id                       String          @id @default(uuid())
  organization_id          String
  name                     String
  /// pipeline | win_loss | forecast | activity | sources | leaderboard | lost_reasons | ...
  report_key               String
  filters                  Json?
  format                   CrmReportFormat @default(PDF)
  recipient_membership_ids String[]        @default([])
  recipient_emails         String[]        @default([])
  owner_membership_id      String?
  scheduled_job_id         String?         @unique
  enabled                  Boolean         @default(true)
  last_sent_at             DateTime?
  created_at               DateTime        @default(now())
  updated_at               DateTime        @updatedAt

  organization  Organization  @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  owner         Membership?   @relation("CrmReportScheduleOwner", fields: [owner_membership_id], references: [id], onDelete: SetNull)
  scheduled_job ScheduledJob? @relation("CrmReportScheduleJob", fields: [scheduled_job_id], references: [id], onDelete: SetNull)

  @@index([organization_id, enabled])
  @@map("crm_report_schedules")
}

// =====================================================================
// Platform shared concept — document numbering (used by 03 Proposals, 04 Contracts, 08 Finance).
// =====================================================================

/// Per-organization numbering sequences, e.g. PRO-2026-0001 / CTR-2026-0001 / INV-2026-0001.
/// Services increment `next_number` inside a transaction; numbers are never reused.
model NumberSequence {
  id              String            @id @default(uuid())
  organization_id String
  /// proposal | contract | invoice | credit_note | ticket …
  entity_type     String
  prefix          String
  /// Null for sequences that do not reset yearly.
  year            Int?
  next_number     Int               @default(1)
  padding         Int               @default(4)
  /// Pattern, e.g. {PREFIX}-{YYYY}-{####}; null = prefix + year + zero-padded number.
  format          String?
  reset_policy    NumberResetPolicy @default(YEARLY)
  updated_at      DateTime          @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, entity_type, prefix, year])
  @@map("number_sequences")
}

// =====================================================================
// 03 AI-Powered Proposal & Quotation Generator — docs/features/03-proposal-quotation-generator.md (LOG-303)
// Owns: Proposal, versions, sections, line items, payment schedules, templates, internal review,
// delivery, tracking, customer acceptance, conversion links.
// Does not own: products catalog and tax rates (08), PDF files (17), signature requests (04),
// contracts (04), projects (05), invoices/subscriptions (08), emails (11). Referenced by id only.
// =====================================================================

/// 03 "Proposal Status" — lifecycle of the proposal record (the latest/sent version drives it).
enum ProposalStatus {
  DRAFT
  IN_REVIEW
  PENDING_APPROVAL
  APPROVED
  SENT
  VIEWED
  CHANGES_REQUESTED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

/// 03 "Proposal Analytics" — why a proposal was REJECTED or EXPIRED (free-text detail stays in ProposalAcceptance.feedback).
enum ProposalLostReason {
  PRICE
  SCOPE
  TIMING
  COMPETITOR
  NO_DECISION
  OTHER
}

/// 03 "Customer Delivery" — who may open the public proposal link.
enum ProposalLinkAccessMode {
  ANYONE_WITH_LINK
  EMAIL_VERIFIED
}

/// 03 "AI Assistance" — what an AI proposal review flagged.
enum ProposalAiFindingKind {
  MISSING_SECTION
  PRICING_INCONSISTENCY
  DATE_CONFLICT
  UNCLEAR_SCOPE
  TERMS_RISK
  TONE_OR_CLARITY
  OTHER
}

enum ProposalAiFindingSeverity {
  LOW
  MEDIUM
  HIGH
}

/// 03 "AI Assistance" — a human's handling of an AI finding: OPEN until someone accepts (applies) or dismisses it.
enum ProposalAiFindingStatus {
  OPEN
  ACCEPTED
  DISMISSED
}

/// 03 "Proposal Versions" — a version is immutable once sent.
enum ProposalVersionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SENT
  SUPERSEDED
}

/// 03 "Proposal Review" — internal approval decision.
enum ProposalApprovalDecision {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

/// 03 "Customer Approval".
enum ProposalCustomerDecision {
  ACCEPTED
  REJECTED
  CHANGES_REQUESTED
}

/// 03 "Customer Delivery".
enum ProposalDeliveryChannel {
  EMAIL
  CUSTOMER_PORTAL
  PDF
  LINK
}

enum ProposalDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

/// 03 "Proposal Tracking" — customer and system events on a proposal.
enum ProposalEventType {
  CREATED
  VERSION_CREATED
  SUBMITTED_FOR_REVIEW
  APPROVED
  SENT
  VIEWED
  DOWNLOADED
  OPTIONAL_ITEM_TOGGLED
  COMMENTED
  CHANGES_REQUESTED
  ACCEPTED
  REJECTED
  SIGNED
  EXPIRED
  CANCELLED
  CONVERTED
}

/// 03 "Reusable Templates" / "Dynamic Proposal Content" — section types.
enum ProposalSectionType {
  COVER
  EXECUTIVE_SUMMARY
  OVERVIEW
  REQUIREMENTS
  SOLUTION
  SCOPE
  FEATURES
  DELIVERABLES
  PHASES
  MILESTONES
  TIMELINE
  PRICING
  PAYMENT_SCHEDULE
  SUPPORT_OPTIONS
  ASSUMPTIONS
  EXCLUSIONS
  WARRANTY
  TERMS
  NEXT_STEPS
  SIGNATURE
  CUSTOM
}

/// 03 "Pricing & Quotation Builder" — when a payment schedule item is due.
enum ProposalPaymentTrigger {
  ON_ACCEPTANCE
  ON_SIGNATURE
  ON_DATE
  ON_MILESTONE
  ON_DELIVERY
  RECURRING
}

// --- Templates -------------------------------------------------------------------

/// 03 "Reusable Templates" — branded, versioned template per work type. Organization-owned.
model ProposalTemplate {
  id                    String    @id @default(uuid())
  organization_id       String
  name                  String
  slug                  String
  description           String?
  /// Work type the template targets (website, web app, mobile, custom software, SaaS, maintenance, support, consulting, …).
  work_type             String?
  language              String    @default("en")
  /// Branding overrides; organization branding (01 §15) is the fallback.
  branding              Json?
  /// Page layout: cover page, headers/footers, typography, table styles.
  layout                Json?
  /// Ordered section blueprint: [{ type, title, body_template, is_required, sort_order }].
  sections              Json
  /// Default terms, warranty, assumptions, exclusions, payment terms text.
  defaults              Json?
  /// Dynamic variables the template expects (03 "Dynamic Proposal Content").
  variables             Json?
  default_validity_days Int       @default(30)
  is_default            Boolean   @default(false)
  version               Int       @default(1)
  archived_at           DateTime?
  created_by_user_id    String?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  organization Organization              @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  proposals    Proposal[]
  versions     ProposalTemplateVersion[]

  @@unique([organization_id, slug])
  @@index([organization_id, work_type])
  @@map("proposal_templates")
}

/// 03 "Reusable Templates" — immutable snapshot of a template, written on every save that changes content.
/// ProposalTemplate holds the working copy; `ProposalTemplate.version` is the number of its latest snapshot,
/// and ProposalVersion.template_version points at the snapshot used at generation time.
model ProposalTemplateVersion {
  id                    String   @id @default(uuid())
  template_id           String
  version_number        Int
  branding              Json?
  layout                Json?
  sections              Json
  defaults              Json?
  variables             Json?
  default_validity_days Int      @default(30)
  change_summary        String?
  created_by_user_id    String?
  created_at            DateTime @default(now())

  template ProposalTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@unique([template_id, version_number])
  @@map("proposal_template_versions")
}

// --- Proposal --------------------------------------------------------------------

/// 03 "Proposal Creation" — the proposal record. Content lives in versions; this row carries
/// identity, relationships, status and snapshots of the current version's totals.
model Proposal {
  id                   String                 @id @default(uuid())
  organization_id      String
  branch_id            String?
  /// Organization numbering, e.g. PRO-2026-0001 (NumberSequence).
  number               String
  title                String
  status               ProposalStatus         @default(DRAFT)
  /// 03 "Proposal Analytics" — set when the status becomes REJECTED or EXPIRED.
  lost_reason          ProposalLostReason?
  template_id          String?
  language             String                 @default("en")
  currency             String
  /// CRM references (02). company_id is the Customer the proposal is addressed to.
  company_id           String?
  contact_id           String?
  deal_id              String?
  owner_membership_id  String?
  /// Project context the proposal was generated from or for (05); id only.
  project_id           String?
  /// Validity of the currently sent version.
  valid_until          DateTime?              @db.Date
  /// Version pointers.
  current_version_id   String?                @unique
  sent_version_id      String?                @unique
  accepted_version_id  String?                @unique
  /// Snapshot of current version totals for list views and dashboards.
  net_total            Decimal                @default(0) @db.Decimal(18, 2)
  discount_total       Decimal                @default(0) @db.Decimal(18, 2)
  tax_total            Decimal                @default(0) @db.Decimal(18, 2)
  gross_total          Decimal                @default(0) @db.Decimal(18, 2)
  recurring_monthly    Decimal                @default(0) @db.Decimal(18, 2)
  recurring_annual     Decimal                @default(0) @db.Decimal(18, 2)
  /// Whether acceptance must produce a Contract before project/billing creation (03 "Conversion to Project").
  requires_contract    Boolean                @default(false)
  /// Public web view (03 "Customer Delivery"): hashed token; expires with valid_until.
  public_token_hash    String?                @unique
  /// 03 "Customer Delivery" — who may open the public link; EMAIL_VERIFIED asks for a one-time code (VerificationCode, purpose PROPOSAL_ACCESS).
  link_access_mode     ProposalLinkAccessMode @default(ANYONE_WITH_LINK)
  /// 03 "Proposal Tracking" — days before valid_until at which the customer gets a reminder, e.g. [7, 2].
  reminder_days        Int[]                  @default([])
  /// Conversion links to records owned by other modules (ids only): 04, 05, 08.
  contract_id          String?
  converted_project_id String?
  invoice_id           String?
  subscription_id      String?
  converted_at         DateTime?
  sent_at              DateTime?
  first_viewed_at      DateTime?
  last_viewed_at       DateTime?
  view_count           Int                    @default(0)
  accepted_at          DateTime?
  rejected_at          DateTime?
  expired_at           DateTime?
  cancelled_at         DateTime?
  archived_at          DateTime?
  created_by_user_id   String?
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt

  organization      Organization      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  branch            Branch?           @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  template          ProposalTemplate? @relation(fields: [template_id], references: [id], onDelete: SetNull)
  company           CrmCompany?       @relation(fields: [company_id], references: [id], onDelete: SetNull)
  contact           CrmContact?       @relation(fields: [contact_id], references: [id], onDelete: SetNull)
  deal              CrmDeal?          @relation(fields: [deal_id], references: [id], onDelete: SetNull)
  converted_project Project?          @relation("ProposalConvertedProject", fields: [converted_project_id], references: [id], onDelete: SetNull)
  invoice           Invoice?          @relation("ProposalInvoice", fields: [invoice_id], references: [id], onDelete: SetNull)
  subscription      Subscription?     @relation("ProposalSubscription", fields: [subscription_id], references: [id], onDelete: SetNull)
  owner             Membership?       @relation("ProposalOwner", fields: [owner_membership_id], references: [id], onDelete: SetNull)
  current_version   ProposalVersion?  @relation("ProposalCurrentVersion", fields: [current_version_id], references: [id], onDelete: SetNull)
  sent_version      ProposalVersion?  @relation("ProposalSentVersion", fields: [sent_version_id], references: [id], onDelete: SetNull)
  accepted_version  ProposalVersion?  @relation("ProposalAcceptedVersion", fields: [accepted_version_id], references: [id], onDelete: SetNull)

  versions           ProposalVersion[]
  deliveries         ProposalDelivery[]
  events             ProposalEvent[]
  comments           ProposalComment[]
  acceptances        ProposalAcceptance[]
  contracts          Contract[]
  projects           Project[]            @relation("ProjectSourceProposal")
  verification_codes VerificationCode[]

  @@unique([organization_id, number])
  @@index([organization_id, status])
  @@index([company_id])
  @@index([deal_id])
  @@index([owner_membership_id])
  @@index([valid_until])
  @@map("proposals")
}

/// 03 "Proposal Versions" — every revision. A version that was sent is immutable; acceptance
/// is always bound to the exact version sent.
model ProposalVersion {
  id                 String                @id @default(uuid())
  proposal_id        String
  version_number     Int
  status             ProposalVersionStatus @default(DRAFT)
  parent_version_id  String?
  change_summary     String?
  /// Template version used at generation time.
  template_version   Int?
  /// Resolved dynamic variables at generation (03 "Dynamic Proposal Content").
  variables          Json?
  /// Structured commercial content not covered by sections: payment terms, validity, support options.
  payment_terms      String?
  validity_days      Int?
  /// Milestones and timeline proposed (operational copies are created in 05 on conversion).
  milestones         Json?
  timeline           Json?
  net_total          Decimal               @default(0) @db.Decimal(18, 2)
  discount_total     Decimal               @default(0) @db.Decimal(18, 2)
  tax_total          Decimal               @default(0) @db.Decimal(18, 2)
  gross_total        Decimal               @default(0) @db.Decimal(18, 2)
  recurring_monthly  Decimal               @default(0) @db.Decimal(18, 2)
  recurring_annual   Decimal               @default(0) @db.Decimal(18, 2)
  /// Generated PDF stored in 17 Documents; id only.
  pdf_document_id    String?
  /// Integrity hash of the rendered artifact.
  content_hash       String?
  is_ai_generated    Boolean               @default(false)
  /// Model, prompt reference and sources used (03 "AI Assistance"). Review findings are ProposalAiFinding rows.
  ai_metadata        Json?
  locked_at          DateTime?
  sent_at            DateTime?
  created_by_user_id String?
  created_at         DateTime              @default(now())
  updated_at         DateTime              @updatedAt

  proposal       Proposal          @relation(fields: [proposal_id], references: [id], onDelete: Cascade)
  parent_version ProposalVersion?  @relation("ProposalVersionLineage", fields: [parent_version_id], references: [id], onDelete: SetNull)
  child_versions ProposalVersion[] @relation("ProposalVersionLineage")

  current_of         Proposal?          @relation("ProposalCurrentVersion")
  sent_of            Proposal?          @relation("ProposalSentVersion")
  accepted_of        Proposal?          @relation("ProposalAcceptedVersion")
  /// Contracts generated from this exact proposal version (04 §7, §55).
  contracts          Contract[]
  signature_requests SignatureRequest[]
  projects           Project[]          @relation("ProjectSourceProposalVersion")

  sections         ProposalSection[]
  line_items       ProposalLineItem[]
  payment_schedule ProposalPaymentScheduleItem[]
  approvals        ProposalApproval[]
  deliveries       ProposalDelivery[]
  events           ProposalEvent[]
  comments         ProposalComment[]
  acceptances      ProposalAcceptance[]
  pdf_document     Document?                     @relation("ProposalVersionPdf", fields: [pdf_document_id], references: [id], onDelete: SetNull)
  ai_findings      ProposalAiFinding[]

  @@unique([proposal_id, version_number])
  @@index([proposal_id, status])
  @@map("proposal_versions")
}

/// Addressable content blocks of a version (03 "AI Proposal Generation" output structure).
model ProposalSection {
  id              String              @id @default(uuid())
  version_id      String
  type            ProposalSectionType
  title           String
  /// Markdown / rich text. Pricing and payment sections render from line items and schedule.
  body            String?
  sort_order      Int                 @default(0)
  is_ai_generated Boolean             @default(false)
  /// Hidden from the customer-facing render (internal notes inside a section).
  is_internal     Boolean             @default(false)
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt

  version     ProposalVersion     @relation(fields: [version_id], references: [id], onDelete: Cascade)
  comments    ProposalComment[]
  ai_findings ProposalAiFinding[]

  @@index([version_id, sort_order])
  @@map("proposal_sections")
}

/// 03 "Pricing & Quotation Builder" — line items of a version. product_id references the
/// Finance catalog (08); no FK until 08 exists.
model ProposalLineItem {
  id                   String   @id @default(uuid())
  version_id           String
  product_id           String?
  /// Optional grouping label (package / phase).
  group_name           String?
  name                 String
  description          String?
  quantity             Decimal  @default(1) @db.Decimal(12, 3)
  unit                 String?
  unit_price           Decimal  @default(0) @db.Decimal(18, 2)
  discount_percent     Decimal? @db.Decimal(5, 2)
  discount_amount      Decimal  @default(0) @db.Decimal(18, 2)
  tax_percent          Decimal? @db.Decimal(5, 2)
  net_amount           Decimal  @default(0) @db.Decimal(18, 2)
  tax_amount           Decimal  @default(0) @db.Decimal(18, 2)
  gross_amount         Decimal  @default(0) @db.Decimal(18, 2)
  is_recurring         Boolean  @default(false)
  /// monthly | quarterly | annual | custom
  billing_frequency    String?
  /// Customer may choose this item (03 "Approve specific optional items").
  is_optional          Boolean  @default(false)
  /// Whether the customer selected the optional item on acceptance.
  selected_by_customer Boolean?
  sort_order           Int      @default(0)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  version ProposalVersion @relation(fields: [version_id], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [product_id], references: [id], onDelete: SetNull)

  @@index([version_id, sort_order])
  @@map("proposal_line_items")
}

/// 03 "Pricing & Quotation Builder" — deposits, milestone payments, custom schedules.
model ProposalPaymentScheduleItem {
  id             String                 @id @default(uuid())
  version_id     String
  name           String
  trigger        ProposalPaymentTrigger @default(ON_ACCEPTANCE)
  /// Either a percentage of the gross total or a fixed amount.
  percentage     Decimal?               @db.Decimal(5, 2)
  amount         Decimal?               @db.Decimal(18, 2)
  due_date       DateTime?              @db.Date
  /// Milestone label this payment is tied to (ON_MILESTONE).
  milestone_name String?
  /// For RECURRING: monthly | quarterly | annual.
  frequency      String?
  sort_order     Int                    @default(0)

  version  ProposalVersion @relation(fields: [version_id], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([version_id, sort_order])
  @@map("proposal_payment_schedule_items")
}

// --- Review, delivery, tracking, acceptance --------------------------------------

/// 03 "Proposal Review" — internal approval bound to an exact version (approval rights: 01 §95).
model ProposalApproval {
  id                     String                   @id @default(uuid())
  version_id             String
  approver_membership_id String
  step                   Int                      @default(1)
  decision               ProposalApprovalDecision @default(PENDING)
  /// 03 "Proposal Review" — the ProposalApprovalRule that requested this step; null = requested manually.
  rule_id                String?
  comment                String?
  requested_at           DateTime                 @default(now())
  /// 03 "Proposal Review" — deadline for this approval step.
  due_at                 DateTime?
  decided_at             DateTime?

  version  ProposalVersion @relation(fields: [version_id], references: [id], onDelete: Cascade)
  approver Membership      @relation("ProposalApprover", fields: [approver_membership_id], references: [id], onDelete: Cascade)

  @@unique([version_id, approver_membership_id, step])
  @@index([approver_membership_id, decision])
  @@map("proposal_approvals")
}

/// 03 "Proposal Review" — approval rule: when the conditions match a proposal version (value, discount, margin, customer, type ...), the
/// steps are requested in order. Mirrors ContractApprovalRule (04 §28). Evaluated when a version is submitted for review.
model ProposalApprovalRule {
  id              String   @id @default(uuid())
  organization_id String
  name            String
  /// Conditions, e.g. [{ field: "discount_percent", operator: ">", value: 10 }, { field: "gross_total", operator: ">=", value: 100000 }].
  conditions      Json
  /// Ordered approval steps: [{ step, name, approver: { membership_id | role_id | team_id } }].
  steps           Json
  priority        Int      @default(100)
  enabled         Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id, enabled, priority])
  @@map("proposal_approval_rules")
}

/// Internal and customer comments on a proposal or a section. Customer authors are Customer Portal
/// Users (01 §79) or the addressed contact; internal comments are never shown to customers.
model ProposalComment {
  id                   String    @id @default(uuid())
  proposal_id          String
  version_id           String?
  section_id           String?
  /// Reply thread: the comment this one answers (same proposal, same visibility).
  parent_comment_id    String?
  author_membership_id String?
  author_user_id       String?
  author_contact_id    String?
  /// Name typed by a customer on the public proposal link when it differs from the CRM contact (03).
  author_name          String?
  is_internal          Boolean   @default(true)
  body                 String
  resolved_at          DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  proposal Proposal          @relation(fields: [proposal_id], references: [id], onDelete: Cascade)
  version  ProposalVersion?  @relation(fields: [version_id], references: [id], onDelete: Cascade)
  section  ProposalSection?  @relation(fields: [section_id], references: [id], onDelete: Cascade)
  author   Membership?       @relation("ProposalCommentAuthor", fields: [author_membership_id], references: [id], onDelete: SetNull)
  parent   ProposalComment?  @relation("ProposalCommentReplies", fields: [parent_comment_id], references: [id], onDelete: Cascade)
  replies  ProposalComment[] @relation("ProposalCommentReplies")

  @@index([proposal_id, created_at])
  @@index([section_id])
  @@index([parent_comment_id])
  @@map("proposal_comments")
}

/// 03 "Customer Delivery" — each send of a version through a channel. Emails go through 11.
model ProposalDelivery {
  id                   String                  @id @default(uuid())
  proposal_id          String
  version_id           String
  channel              ProposalDeliveryChannel
  status               ProposalDeliveryStatus  @default(QUEUED)
  recipient_contact_id String?
  recipient_email      String?
  /// Communication record id (11); id only.
  communication_id     String?
  sent_by_user_id      String?
  message              String?
  sent_at              DateTime?
  delivered_at         DateTime?
  failed_reason        String?
  created_at           DateTime                @default(now())

  proposal      Proposal        @relation(fields: [proposal_id], references: [id], onDelete: Cascade)
  version       ProposalVersion @relation(fields: [version_id], references: [id], onDelete: Cascade)
  recipient     CrmContact?     @relation(fields: [recipient_contact_id], references: [id], onDelete: SetNull)
  communication CommMessage?    @relation(fields: [communication_id], references: [id], onDelete: SetNull)

  @@index([proposal_id, sent_at])
  @@map("proposal_deliveries")
}

/// 03 "Proposal Tracking" — append-only event log of customer activity and lifecycle changes.
model ProposalEvent {
  id               String            @id @default(uuid())
  proposal_id      String
  version_id       String?
  type             ProposalEventType
  /// Internal actor (user id) or customer actor (portal user id / contact id).
  actor_user_id    String?
  actor_contact_id String?
  ip_address       String?
  user_agent       String?
  metadata         Json?
  created_at       DateTime          @default(now())

  proposal Proposal         @relation(fields: [proposal_id], references: [id], onDelete: Cascade)
  version  ProposalVersion? @relation(fields: [version_id], references: [id], onDelete: Cascade)

  @@index([proposal_id, created_at])
  @@index([type, created_at])
  @@map("proposal_events")
}

/// 03 "Customer Approval" — the customer's decision on an exact version, with the evidence
/// collected (name, contact, terms confirmation, selected optional items, signature reference).
model ProposalAcceptance {
  id                         String                   @id @default(uuid())
  proposal_id                String
  version_id                 String
  decision                   ProposalCustomerDecision
  /// Customer Portal User (01 §79) when accepted through the portal; id only.
  customer_user_id           String?
  contact_id                 String?
  signer_name                String
  signer_email               String
  signer_title               String?
  terms_accepted             Boolean                  @default(false)
  /// Ids of optional line items the customer selected.
  selected_optional_item_ids String[]                 @default([])
  feedback                   String?
  /// Signature request id from the in-house e-signature service (04 §33–38); id only.
  signature_request_id       String?
  signature_metadata         Json?
  ip_address                 String?
  user_agent                 String?
  created_at                 DateTime                 @default(now())

  proposal Proposal        @relation(fields: [proposal_id], references: [id], onDelete: Cascade)
  version  ProposalVersion @relation(fields: [version_id], references: [id], onDelete: Cascade)
  contact  CrmContact?     @relation(fields: [contact_id], references: [id], onDelete: SetNull)

  @@index([proposal_id, created_at])
  @@index([version_id])
  @@map("proposal_acceptances")
}

/// 03 "AI Assistance" — one finding of an AI proposal review, pointing at a section. A recommendation only: it never edits the proposal.
/// Mirrors ContractAiFinding (04 §73).
model ProposalAiFinding {
  id                        String                    @id @default(uuid())
  version_id                String
  section_id                String?
  kind                      ProposalAiFindingKind
  severity                  ProposalAiFindingSeverity
  message                   String
  recommendation            String?
  status                    ProposalAiFindingStatus   @default(OPEN)
  /// Model that produced the finding and the review run it belongs to (traceability).
  model                     String?
  review_run_id             String?
  reviewed_by_membership_id String?
  reviewed_at               DateTime?
  resolution_note           String?
  created_at                DateTime                  @default(now())

  version     ProposalVersion  @relation(fields: [version_id], references: [id], onDelete: Cascade)
  section     ProposalSection? @relation(fields: [section_id], references: [id], onDelete: SetNull)
  reviewed_by Membership?      @relation("ProposalAiFindingReviewer", fields: [reviewed_by_membership_id], references: [id], onDelete: SetNull)

  @@index([version_id, status])
  @@map("proposal_ai_findings")
}

// =====================================================================
// 04 Contracts — docs/features/04-contracts.md (LOG-349)
// Owns: contract types, templates and clause library, contract records, parties and signatories,
// versions and sections, review, change requests, approval, in-house e-signature service
// (also used by 03 Proposals), amendments/renewals lineage, obligations, termination.
// Does not own: projects (05), documents storage (17), invoices (08), calendar events (19),
// notifications (14), automation (20). Referenced by id only.
// =====================================================================

/// 04 §5 — contract lifecycle states.
enum ContractStatus {
  DRAFT
  INTERNAL_REVIEW
  CUSTOMER_REVIEW
  APPROVAL_REQUIRED
  READY_FOR_SIGNATURE
  PARTIALLY_SIGNED
  FULLY_SIGNED
  ACTIVE
  EXPIRING
  RENEWED
  SUPERSEDED
  TERMINATED
  EXPIRED
  CANCELLED
  ARCHIVED
}

/// 04 §19–20, §80 — version/document state, separate from contract lifecycle.
enum ContractVersionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  LOCKED_FOR_SIGNATURE
  SIGNED
  SUPERSEDED
}

/// 04 §43, §46–48 — how a contract relates to its parent contract.
enum ContractRelationKind {
  STANDALONE
  AMENDMENT
  RENEWAL
  SOW
  CHANGE_ORDER
  TERMINATION_AGREEMENT
}

/// 04 §3 — renewal behaviour.
enum ContractRenewalType {
  NONE
  MANUAL
  AUTOMATIC
  EVERGREEN
}

/// 04 §4 — party type.
enum ContractPartyType {
  AGENCY
  CUSTOMER
  VENDOR
  PARTNER
  CONTRACTOR
  EMPLOYEE
  OTHER
}

/// 04 §8, §77 — template governance.
enum ContractTemplateStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
}

/// 04 §11–12 — clause status.
enum ContractClauseStatus {
  DRAFT
  ACTIVE
  DEPRECATED
}

/// 04 §23 — review decision.
enum ContractReviewDecision {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

/// 04 §27–29 — approval decision.
enum ContractApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

/// 04 §26 — contract change request status.
enum ContractChangeRequestStatus {
  REQUESTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  IMPLEMENTED
  WITHDRAWN
}

/// 04 §49–50 — obligation types.
enum ContractObligationType {
  DELIVERABLE
  PAYMENT
  REPORTING
  RENEWAL_NOTICE
  SLA
  SECURITY_REVIEW
  CUSTOMER_APPROVAL
  OTHER
}

enum ContractObligationStatus {
  OPEN
  IN_PROGRESS
  FULFILLED
  OVERDUE
  WAIVED
  CANCELLED
}

/// 04 §75 — AI-extracted obligations need review before acting.
enum ExtractionReviewState {
  PENDING_REVIEW
  CONFIRMED
  REJECTED
}

/// 04 §53 — termination type.
enum ContractTerminationType {
  FOR_CONVENIENCE
  FOR_CAUSE
  MUTUAL
  EXPIRY
  OTHER
}

/// 04 §74 — explainable risk level; not legal advice.
enum ContractRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// 04 §73 — what an AI contract review flagged.
enum ContractAiFindingKind {
  MISSING_CLAUSE
  CONFLICTING_DATES
  UNUSUAL_PAYMENT_TERMS
  LIABILITY_DIFFERENCE
  TERMINATION_DIFFERENCE
  SCOPE_INCONSISTENCY
  RENEWAL_PROVISION
  NON_STANDARD_CLAUSE
}

/// 04 §73 — a human's handling of an AI finding. Findings are recommendations: OPEN until someone accepts or dismisses them.
enum ContractAiFindingStatus {
  OPEN
  ACCEPTED
  DISMISSED
}

/// What a signature request is bound to. The version relationship is immutable (04 §34).
enum SignatureSubjectType {
  CONTRACT_VERSION
  PROPOSAL_VERSION
}

/// 04 §32 — signing order.
enum SigningOrder {
  SEQUENTIAL
  PARALLEL
}

/// 04 §36 — how the signer provided the signature in the platform's own signing flow.
enum SignatureType {
  DRAWN
  TYPED
  UPLOADED
}

/// 04 §35 — signature request states.
enum SignatureRequestStatus {
  NOT_SENT
  SENT
  DELIVERED
  VIEWED
  PARTIALLY_SIGNED
  FULLY_SIGNED
  DECLINED
  EXPIRED
  CANCELLED
  FAILED
}

enum SignerStatus {
  PENDING
  SENT
  DELIVERED
  VIEWED
  SIGNED
  DECLINED
  BOUNCED
}

/// 04 §38 — provider events retained for the audit trail.
enum SignatureEventType {
  REQUEST_CREATED
  SENT
  DELIVERED
  VIEWED
  SIGNED
  DECLINED
  REMINDER_SENT
  CANCELLED
  EXPIRED
  COMPLETED
  FAILED
}

/// 04 §36 — what a one-time code proves.
enum VerificationPurpose {
  SIGNER_IDENTITY
  PROPOSAL_ACCESS
}

/// 04 §36 — how the one-time code is delivered (SMS goes through the organization's TWILIO IntegrationConnection, BYOK).
enum VerificationChannel {
  EMAIL
  SMS
}

/// 04 §46 — decision taken before a renewal contract exists.
enum ContractRenewalDecisionType {
  RENEW
  DO_NOT_RENEW
}

// --- Configuration: types, templates, clauses, approval rules ---------------------

/// 04 §2 — configurable contract types with defaults.
model ContractType {
  id                     String              @id @default(uuid())
  organization_id        String
  name                   String
  slug                   String
  description            String?
  default_template_id    String?
  /// Required metadata keys for this type (04 §16 validation).
  required_metadata      Json?
  /// Default approval workflow steps when no ContractApprovalRule matches (04 §27).
  approval_workflow      Json?
  /// Signature requirements: required parties, signing order, internal/external first.
  signature_requirements Json?
  default_renewal_type   ContractRenewalType @default(NONE)
  default_notice_days    Int?
  /// Expiration reminder windows in days (04 §52), e.g. [180,120,90,60,30,14,7].
  reminder_windows_days  Int[]               @default([90, 60, 30, 14, 7])
  /// Retention in days after closeout (04 §84); null = organization default.
  retention_days         Int?
  sort_order             Int                 @default(0)
  archived_at            DateTime?
  created_at             DateTime            @default(now())
  updated_at             DateTime            @updatedAt

  organization     Organization       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  default_template ContractTemplate?  @relation("ContractTypeDefaultTemplate", fields: [default_template_id], references: [id], onDelete: SetNull)
  templates        ContractTemplate[] @relation("ContractTemplateType")
  contracts        Contract[]

  @@unique([organization_id, slug])
  @@map("contract_types")
}

/// 04 §8, §77 — reusable contractual structure. Content is versioned in ContractTemplateVersion;
/// changing a template never modifies existing contracts.
model ContractTemplate {
  id                  String                 @id @default(uuid())
  organization_id     String
  type_id             String?
  name                String
  slug                String
  description         String?
  language            String                 @default("en")
  status              ContractTemplateStatus @default(DRAFT)
  current_version_id  String?                @unique
  owner_membership_id String?
  effective_date      DateTime?              @db.Date
  deprecated_at       DateTime?
  created_at          DateTime               @default(now())
  updated_at          DateTime               @updatedAt

  organization      Organization              @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  type              ContractType?             @relation("ContractTemplateType", fields: [type_id], references: [id], onDelete: SetNull)
  current_version   ContractTemplateVersion?  @relation("ContractTemplateCurrentVersion", fields: [current_version_id], references: [id], onDelete: SetNull)
  versions          ContractTemplateVersion[]
  default_for_types ContractType[]            @relation("ContractTypeDefaultTemplate")
  contracts         Contract[]

  @@unique([organization_id, slug])
  @@index([organization_id, status])
  @@map("contract_templates")
}

/// 04 §8–10, §14 — one immutable template version: sections, variables, conditional clause rules,
/// signature blocks, required fields, appendices.
model ContractTemplateVersion {
  id                 String    @id @default(uuid())
  template_id        String
  version_number     Int
  change_summary     String?
  /// Ordered sections: [{ key, title, body, clause_key?, conditions?, is_optional, sort_order }].
  sections           Json
  /// Variables with source mapping (04 §9): [{ key, label, source, required }].
  variables          Json?
  /// Deterministic conditional clause rules (04 §10).
  conditional_rules  Json?
  /// Signature blocks per party (04 §31).
  signature_blocks   Json?
  required_fields    String[]  @default([])
  published_at       DateTime?
  created_by_user_id String?
  created_at         DateTime  @default(now())

  template   ContractTemplate  @relation(fields: [template_id], references: [id], onDelete: Cascade)
  current_of ContractTemplate? @relation("ContractTemplateCurrentVersion")
  versions   ContractVersion[]

  @@unique([template_id, version_number])
  @@map("contract_template_versions")
}

/// 04 §11 — clause library entry. Text lives in ContractClauseVersion (04 §12).
model ContractClause {
  id                  String               @id @default(uuid())
  organization_id     String
  key                 String
  name                String
  /// payment | ip | confidentiality | privacy | liability | warranty | termination | renewal | sla | security | governing_law | other
  category            String
  description         String?
  status              ContractClauseStatus @default(DRAFT)
  /// Usage restrictions (04 §11): allowed contract types, jurisdictions, requires approval.
  usage_restrictions  Json?
  owner_membership_id String?
  current_version_id  String?              @unique
  effective_date      DateTime?            @db.Date
  deprecated_at       DateTime?
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt

  organization    Organization            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  current_version ContractClauseVersion?  @relation("ContractClauseCurrentVersion", fields: [current_version_id], references: [id], onDelete: SetNull)
  versions        ContractClauseVersion[]

  @@unique([organization_id, key])
  @@index([organization_id, category])
  @@map("contract_clauses")
}

/// 04 §12 — a generated contract keeps the exact clause version used.
model ContractClauseVersion {
  id                 String    @id @default(uuid())
  clause_id          String
  version_number     Int
  text               String
  change_summary     String?
  effective_date     DateTime? @db.Date
  deprecated_at      DateTime?
  created_by_user_id String?
  created_at         DateTime  @default(now())

  clause     ContractClause    @relation(fields: [clause_id], references: [id], onDelete: Cascade)
  current_of ContractClause?   @relation("ContractClauseCurrentVersion")
  sections   ContractSection[]

  @@unique([clause_id, version_number])
  @@map("contract_clause_versions")
}

/// 04 §28 — approval requirements by value, type, liability, discount, payment terms, duration,
/// customer category, risk, custom fields.
model ContractApprovalRule {
  id              String   @id @default(uuid())
  organization_id String
  name            String
  /// Predicate on contract metadata.
  conditions      Json
  /// Ordered steps: [{ step, approver: { membership_id | role_slug | team_id }, required }].
  steps           Json
  priority        Int      @default(0)
  enabled         Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id, enabled])
  @@map("contract_approval_rules")
}

// --- Contract record ------------------------------------------------------------

/// 04 §3 — the structured business record. Document content lives in versions.
model Contract {
  id                                 String                   @id @default(uuid())
  organization_id                    String
  branch_id                          String?
  /// Organization numbering, e.g. CTR-2026-0001 (NumberSequence).
  number                             String
  title                              String
  type_id                            String?
  template_id                        String?
  status                             ContractStatus           @default(DRAFT)
  relation_kind                      ContractRelationKind     @default(STANDALONE)
  /// Original / parent agreement for amendments, renewals, SOWs and change orders (04 §43–48).
  parent_contract_id                 String?
  /// Sequence inside the parent (Amendment 1, Amendment 2 …).
  relation_sequence                  Int?
  /// 04 §47 — the contract that replaced this one.
  superseded_by_contract_id          String?                  @unique
  owner_membership_id                String?
  /// 04 §4 — primary customer (CRM Company, 02). Full party list in ContractParty.
  primary_company_id                 String?
  /// 04 §7, §55 — source proposal and exact version (03).
  proposal_id                        String?
  proposal_version_id                String?
  /// 04 §43 — originating project change request (05); id only.
  project_change_request_id          String?
  currency                           String?
  /// 04 §3 — language of the contract text (copied from the template, editable).
  language                           String                   @default("en")
  // 04 §51 — independently addressable dates.
  draft_date                         DateTime?                @db.Date
  approval_date                      DateTime?                @db.Date
  signature_date                     DateTime?                @db.Date
  effective_date                     DateTime?                @db.Date
  start_date                         DateTime?                @db.Date
  end_date                           DateTime?                @db.Date
  renewal_date                       DateTime?                @db.Date
  notice_deadline                    DateTime?                @db.Date
  expiration_date                    DateTime?                @db.Date
  termination_date                   DateTime?                @db.Date
  renewal_type                       ContractRenewalType      @default(NONE)
  renewal_term_months                Int?
  notice_days                        Int?
  // 04 §54 — contractual value context; Finance (08) is authoritative for actual billing.
  total_value                        Decimal?                 @db.Decimal(18, 2)
  one_time_value                     Decimal?                 @db.Decimal(18, 2)
  recurring_value                    Decimal?                 @db.Decimal(18, 2)
  /// monthly | quarterly | annual | milestone | custom
  billing_frequency                  String?
  payment_terms                      String?
  /// 04 §54, 18 §6 — billing model agreed in the contract (08 BillingModel); seeds ProjectBillingSettings on project creation.
  billing_model                      BillingModel?
  /// 18 §6 — contract-level default billability for time logged under this contract; null = project type / organization default.
  default_time_billable              Boolean?
  default_time_non_billable_category TimeNonBillableCategory?
  // 04 §74 — risk scoring.
  risk_score                         Int?
  risk_level                         ContractRiskLevel?
  risk_factors                       Json?
  /// 04 §61 — portal exposure.
  customer_visible                   Boolean                  @default(false)
  current_version_id                 String?                  @unique
  signed_version_id                  String?                  @unique
  /// Flags the contract as containing personal-data processing (drives DPA clause, 04 §10).
  processes_personal_data            Boolean                  @default(false)
  activated_at                       DateTime?
  closed_at                          DateTime?
  archived_at                        DateTime?
  created_by_user_id                 String?
  created_at                         DateTime                 @default(now())
  updated_at                         DateTime                 @updatedAt

  organization     Organization      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  branch           Branch?           @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  type             ContractType?     @relation(fields: [type_id], references: [id], onDelete: SetNull)
  template         ContractTemplate? @relation(fields: [template_id], references: [id], onDelete: SetNull)
  parent           Contract?         @relation("ContractLineage", fields: [parent_contract_id], references: [id], onDelete: SetNull)
  children         Contract[]        @relation("ContractLineage")
  superseded_by    Contract?         @relation("ContractSupersession", fields: [superseded_by_contract_id], references: [id], onDelete: SetNull)
  supersedes       Contract?         @relation("ContractSupersession")
  owner            Membership?       @relation("ContractOwner", fields: [owner_membership_id], references: [id], onDelete: SetNull)
  primary_company  CrmCompany?       @relation("ContractPrimaryCompany", fields: [primary_company_id], references: [id], onDelete: SetNull)
  proposal         Proposal?         @relation(fields: [proposal_id], references: [id], onDelete: SetNull)
  proposal_version ProposalVersion?  @relation(fields: [proposal_version_id], references: [id], onDelete: SetNull)
  current_version  ContractVersion?  @relation("ContractCurrentVersion", fields: [current_version_id], references: [id], onDelete: SetNull)
  signed_version   ContractVersion?  @relation("ContractSignedVersion", fields: [signed_version_id], references: [id], onDelete: SetNull)

  parties                  ContractParty[]
  versions                 ContractVersion[]
  projects                 ContractProject[]
  change_requests          ContractChangeRequest[]
  obligations              ContractObligation[]
  termination              ContractTermination?
  signature_requests       SignatureRequest[]
  invoices                 Invoice[]
  subscriptions            Subscription[]
  ledger_records           LedgerRecord[]
  employee_documents       EmployeeDocument[]        @relation("EmployeeDocumentContract")
  time_project_settings    TimeProjectSettings[]
  renewal_decisions        ContractRenewalDecision[] @relation("ContractRenewalDecisions")
  renewal_decision_results ContractRenewalDecision[] @relation("ContractRenewalResult")

  @@unique([organization_id, number])
  @@index([organization_id, status])
  @@index([primary_company_id])
  @@index([parent_contract_id])
  @@index([expiration_date])
  @@index([renewal_date])
  @@index([notice_deadline])
  @@map("contracts")
}

/// 04 §4 — a party to the contract. References a CRM Company (02) without duplicating it;
/// the agency itself is a party of type AGENCY.
model ContractParty {
  id                  String            @id @default(uuid())
  contract_id         String
  party_type          ContractPartyType
  company_id          String?
  legal_name          String
  address             Json?
  registration_number String?
  vat_number          String?
  sort_order          Int               @default(0)
  created_at          DateTime          @default(now())

  contract    Contract            @relation(fields: [contract_id], references: [id], onDelete: Cascade)
  company     CrmCompany?         @relation(fields: [company_id], references: [id], onDelete: SetNull)
  signatories ContractSignatory[]

  @@index([contract_id])
  @@index([company_id])
  @@map("contract_parties")
}

/// 04 §4, §31 — a signatory for a party; a party may have several. Internal signatories are Members,
/// external ones are CRM Contacts or free-text.
model ContractSignatory {
  id            String   @id @default(uuid())
  party_id      String
  membership_id String?
  contact_id    String?
  name          String
  title         String?
  email         String
  /// 04 §36 — mobile number in E.164 for SMS one-time codes.
  phone         String?
  is_required   Boolean  @default(true)
  sort_order    Int      @default(0)
  created_at    DateTime @default(now())

  party      ContractParty @relation(fields: [party_id], references: [id], onDelete: Cascade)
  membership Membership?   @relation(fields: [membership_id], references: [id], onDelete: SetNull)
  contact    CrmContact?   @relation(fields: [contact_id], references: [id], onDelete: SetNull)
  signers    Signer[]

  @@index([party_id])
  @@map("contract_signatories")
}

/// 04 §56 — a contract can reference many projects (05).
model ContractProject {
  contract_id String
  project_id  String
  /// primary | sow | related
  role        String   @default("primary")
  created_at  DateTime @default(now())

  contract Contract @relation(fields: [contract_id], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@id([contract_id, project_id])
  @@index([project_id])
  @@map("contract_projects")
}

// --- Versions ----------------------------------------------------------------------

/// 04 §19–20 — every material draft change creates a version. Signed versions are immutable (04 §39).
model ContractVersion {
  id                  String                @id @default(uuid())
  contract_id         String
  version_number      Int
  /// Display label, e.g. "v0.3", "v1.0", "Amendment 1" (04 §19).
  label               String
  parent_version_id   String?
  status              ContractVersionStatus @default(DRAFT)
  change_summary      String?
  template_version_id String?
  /// Resolved variables at generation (04 §9, §17).
  variables           Json?
  /// Rendered document in 17 Documents (draft artifact); id only.
  document_id         String?
  /// Final signed artifact in 17 Documents (04 §41); id only.
  signed_document_id  String?
  /// Integrity hash of the rendered / signed artifact (04 §17, §40).
  content_hash        String?
  signed_hash         String?
  /// Whether the customer may see this version in the portal (04 §24, §61).
  customer_visible    Boolean               @default(false)
  locked_at           DateTime?
  approved_at         DateTime?
  signed_at           DateTime?
  created_by_user_id  String?
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt

  contract         Contract                 @relation(fields: [contract_id], references: [id], onDelete: Cascade)
  parent_version   ContractVersion?         @relation("ContractVersionLineage", fields: [parent_version_id], references: [id], onDelete: SetNull)
  child_versions   ContractVersion[]        @relation("ContractVersionLineage")
  template_version ContractTemplateVersion? @relation(fields: [template_version_id], references: [id], onDelete: SetNull)

  current_of Contract? @relation("ContractCurrentVersion")
  signed_of  Contract? @relation("ContractSignedVersion")

  sections             ContractSection[]
  reviews              ContractReview[]
  comments             ContractComment[]
  approvals            ContractApproval[]
  signature_requests   SignatureRequest[]
  change_requests_from ContractChangeRequest[] @relation("ChangeRequestRelatedVersion")
  change_requests_to   ContractChangeRequest[] @relation("ChangeRequestResultingVersion")
  document             Document?               @relation("ContractVersionDocument", fields: [document_id], references: [id], onDelete: SetNull)
  signed_document      Document?               @relation("ContractVersionSignedDocument", fields: [signed_document_id], references: [id], onDelete: SetNull)

  ai_findings ContractAiFinding[]

  @@unique([contract_id, version_number])
  @@index([contract_id, status])
  @@map("contract_versions")
}

/// 04 §14 — addressable section of a version; may embed an exact clause version (04 §12).
model ContractSection {
  id                String   @id @default(uuid())
  version_id        String
  /// Stable key within the contract (parties, definitions, scope, fees, ip, …).
  key               String
  title             String
  body              String?
  clause_version_id String?
  /// Appendix / schedule marker.
  is_appendix       Boolean  @default(false)
  sort_order        Int      @default(0)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  version         ContractVersion         @relation(fields: [version_id], references: [id], onDelete: Cascade)
  clause_version  ContractClauseVersion?  @relation(fields: [clause_version_id], references: [id], onDelete: SetNull)
  comments        ContractComment[]
  change_requests ContractChangeRequest[]
  obligations     ContractObligation[]

  ai_findings ContractAiFinding[]

  @@unique([version_id, key])
  @@index([version_id, sort_order])
  @@map("contract_sections")
}

// --- Review, comments, change requests, approval ----------------------------------

/// 04 §23–24 — a review request references one exact version. Internal reviewers are Members;
/// customer reviewers are Customer Portal Users (id only) or contacts.
model ContractReview {
  id                     String                 @id @default(uuid())
  version_id             String
  reviewer_membership_id String?
  reviewer_user_id       String?
  /// 04 §24 — external review: the customer-side reviewer (CRM Contact, 02).
  reviewer_contact_id    String?
  is_internal            Boolean                @default(true)
  decision               ContractReviewDecision @default(PENDING)
  comment                String?
  requested_by_user_id   String?
  requested_at           DateTime               @default(now())
  due_at                 DateTime?
  decided_at             DateTime?

  version          ContractVersion @relation(fields: [version_id], references: [id], onDelete: Cascade)
  reviewer         Membership?     @relation("ContractReviewer", fields: [reviewer_membership_id], references: [id], onDelete: Cascade)
  reviewer_contact CrmContact?     @relation("ContractReviewerContact", fields: [reviewer_contact_id], references: [id], onDelete: SetNull)

  @@index([version_id, decision])
  @@index([reviewer_membership_id, decision])
  @@index([reviewer_contact_id])
  @@map("contract_reviews")
}

/// 04 §13, §23–24 — comments on a version or section; internal comments never reach the portal.
model ContractComment {
  id                   String    @id @default(uuid())
  version_id           String
  section_id           String?
  /// Reply thread: the comment this one answers (same version, same visibility).
  parent_comment_id    String?
  author_membership_id String?
  author_user_id       String?
  is_internal          Boolean   @default(true)
  /// Blocks signature until resolved (04 §30).
  is_blocking          Boolean   @default(false)
  body                 String
  resolved_at          DateTime?
  resolved_by_user_id  String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  version ContractVersion   @relation(fields: [version_id], references: [id], onDelete: Cascade)
  section ContractSection?  @relation(fields: [section_id], references: [id], onDelete: Cascade)
  author  Membership?       @relation("ContractCommentAuthor", fields: [author_membership_id], references: [id], onDelete: SetNull)
  parent  ContractComment?  @relation("ContractCommentReplies", fields: [parent_comment_id], references: [id], onDelete: Cascade)
  replies ContractComment[] @relation("ContractCommentReplies")

  @@index([version_id, created_at])
  @@index([section_id])
  @@index([parent_comment_id])
  @@map("contract_comments")
}

/// 04 §73 — one finding of an AI contract review. Always an AI-generated recommendation pointing at a section; it never edits the contract text.
model ContractAiFinding {
  id                        String                  @id @default(uuid())
  version_id                String
  section_id                String?
  kind                      ContractAiFindingKind
  severity                  ContractRiskLevel
  message                   String
  recommendation            String?
  status                    ContractAiFindingStatus @default(OPEN)
  /// Model that produced the finding and the review run it belongs to (traceability).
  model                     String?
  review_run_id             String?
  confidence                Decimal?                @db.Decimal(5, 4)
  reviewed_by_membership_id String?
  reviewed_at               DateTime?
  resolution_note           String?
  created_at                DateTime                @default(now())

  version     ContractVersion  @relation(fields: [version_id], references: [id], onDelete: Cascade)
  section     ContractSection? @relation(fields: [section_id], references: [id], onDelete: SetNull)
  reviewed_by Membership?      @relation("ContractAiFindingReviewer", fields: [reviewed_by_membership_id], references: [id], onDelete: SetNull)

  @@index([version_id, status])
  @@map("contract_ai_findings")
}

/// 04 §26 — Contract Change Request: a request to change contract language. Never mutates the
/// current version; an accepted request produces a new version or an amendment.
model ContractChangeRequest {
  id                        String                      @id @default(uuid())
  contract_id               String
  related_version_id        String?
  resulting_version_id      String?
  section_id                String?
  requester_membership_id   String?
  requester_user_id         String?
  requester_contact_id      String?
  requested_change          String
  reason                    String?
  impact                    String?
  status                    ContractChangeRequestStatus @default(REQUESTED)
  /// Linked Project Change Request (05 §45); id only.
  project_change_request_id String?
  decided_by_user_id        String?
  decided_at                DateTime?
  /// 04 §26 — why the request was accepted or rejected.
  decision_note             String?
  created_at                DateTime                    @default(now())
  updated_at                DateTime                    @updatedAt

  contract          Contract         @relation(fields: [contract_id], references: [id], onDelete: Cascade)
  related_version   ContractVersion? @relation("ChangeRequestRelatedVersion", fields: [related_version_id], references: [id], onDelete: SetNull)
  resulting_version ContractVersion? @relation("ChangeRequestResultingVersion", fields: [resulting_version_id], references: [id], onDelete: SetNull)
  section           ContractSection? @relation(fields: [section_id], references: [id], onDelete: SetNull)

  @@index([contract_id, status])
  @@map("contract_change_requests")
}

/// 04 §27–29 — business approval bound to an exact version. Approval of v1.0 does not approve v1.1.
model ContractApproval {
  id                     String                   @id @default(uuid())
  version_id             String
  step                   Int                      @default(1)
  /// Role label for the step (account owner, finance, legal, executive, technical).
  step_name              String?
  approver_membership_id String
  decision               ContractApprovalDecision @default(PENDING)
  comment                String?
  rule_id                String?
  requested_at           DateTime                 @default(now())
  decided_at             DateTime?

  version  ContractVersion @relation(fields: [version_id], references: [id], onDelete: Cascade)
  approver Membership      @relation("ContractApprover", fields: [approver_membership_id], references: [id], onDelete: Cascade)

  @@unique([version_id, approver_membership_id, step])
  @@index([approver_membership_id, decision])
  @@map("contract_approvals")
}

// --- E-signature (in-house signing service) (04 §30–42, §71, §78–79) -------------------

/// 04 §34 — a signature request bound immutably to one subject version (contract or proposal).
/// Provider-specific data stays in provider_* fields and metadata, never in core contract fields.
model SignatureRequest {
  id                            String                 @id @default(uuid())
  organization_id               String
  subject_type                  SignatureSubjectType
  contract_id                   String?
  contract_version_id           String?
  proposal_version_id           String?
  status                        SignatureRequestStatus @default(NOT_SENT)
  signing_order                 SigningOrder           @default(SEQUENTIAL)
  /// 04 §78 — package of document ids (17) in locked order: [{ document_id, title, sort_order }].
  package_documents             Json?
  /// 04 §37 — reminder settings: { frequency_days, max_reminders }.
  reminder_settings             Json?
  reminders_sent                Int                    @default(0)
  /// Signed artifact (17) and the audit certificate (17) generated by the platform; ids only.
  signed_document_id            String?
  audit_certificate_document_id String?
  signed_hash                   String?
  message                       String?
  created_by_user_id            String?
  sent_at                       DateTime?
  expires_at                    DateTime?
  completed_at                  DateTime?
  cancelled_at                  DateTime?
  cancel_reason                 String?
  metadata                      Json?
  created_at                    DateTime               @default(now())
  updated_at                    DateTime               @updatedAt

  organization               Organization       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  contract                   Contract?          @relation(fields: [contract_id], references: [id], onDelete: Cascade)
  contract_version           ContractVersion?   @relation(fields: [contract_version_id], references: [id], onDelete: Cascade)
  proposal_version           ProposalVersion?   @relation(fields: [proposal_version_id], references: [id], onDelete: Cascade)
  signers                    Signer[]
  events                     SignatureEvent[]
  employee_documents         EmployeeDocument[] @relation("EmployeeDocumentSignatureRequest")
  signed_document            Document?          @relation("SignatureRequestSignedDocument", fields: [signed_document_id], references: [id], onDelete: SetNull)
  audit_certificate_document Document?          @relation("SignatureRequestAuditCertificate", fields: [audit_certificate_document_id], references: [id], onDelete: SetNull)

  @@index([organization_id, status])
  @@index([contract_id])
  @@index([contract_version_id])
  @@index([proposal_version_id])
  @@index([expires_at])
  @@map("signature_requests")
}

/// 04 §31–32, §36 — a signer on a request with mapped fields and signing position.
model Signer {
  id                    String         @id @default(uuid())
  request_id            String
  signatory_id          String?
  name                  String
  email                 String
  /// 04 §36 — mobile number in E.164 for SMS one-time codes.
  phone                 String?
  title                 String?
  /// Position in sequential signing; equal values sign in parallel.
  order                 Int            @default(1)
  status                SignerStatus   @default(PENDING)
  /// Mapped fields (04 §31): [{ type: signature|date|initial|text, page, x, y, w, h, required }].
  fields                Json?
  /// Hash of the single-use signing link token (the raw token is only in the link sent to the signer).
  access_token_hash     String?        @unique
  auth_method           String?
  /// Custom e-signature (04 §36): how the signature was given, the stored signature image (17, id only), the consent text (SignatureConsentText) the signer accepted,
  /// and when the signer's identity was verified (one-time code by email or SMS, auth_method).
  signature_type        SignatureType?
  signature_document_id String?
  consent_text_id       String?
  consent_accepted_at   DateTime?
  identity_verified_at  DateTime?
  ip_address            String?
  user_agent            String?
  sent_at               DateTime?
  viewed_at             DateTime?
  signed_at             DateTime?
  declined_at           DateTime?
  decline_reason        String?

  request            SignatureRequest      @relation(fields: [request_id], references: [id], onDelete: Cascade)
  signatory          ContractSignatory?    @relation(fields: [signatory_id], references: [id], onDelete: SetNull)
  consent_text       SignatureConsentText? @relation(fields: [consent_text_id], references: [id], onDelete: NoAction)
  events             SignatureEvent[]
  verification_codes VerificationCode[]

  @@index([request_id, order])
  @@index([email])
  @@map("signers")
}

/// 04 §38, §71 — provider and internal events; (provider, provider_event_id) is unique so duplicate
/// callbacks are ignored.
model SignatureEvent {
  id          String             @id @default(uuid())
  request_id  String
  signer_id   String?
  type        SignatureEventType
  occurred_at DateTime           @default(now())
  ip_address  String?
  payload     Json?
  created_at  DateTime           @default(now())

  request SignatureRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)
  signer  Signer?          @relation(fields: [signer_id], references: [id], onDelete: SetNull)

  @@index([request_id, occurred_at])
  @@map("signature_events")
}

/// 04 §36 — versioned e-signature consent text per organization and locale. A signer records the exact text row it accepted;
/// texts are retired (retired_at), never edited or deleted once used.
model SignatureConsentText {
  id                 String    @id @default(uuid())
  organization_id    String
  /// Human version label, e.g. "2026-1".
  version            String
  locale             String    @default("en")
  body               String
  effective_date     DateTime  @db.Date
  retired_at         DateTime?
  created_by_user_id String?
  created_at         DateTime  @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  signers      Signer[]

  @@unique([organization_id, version, locale])
  @@index([organization_id, locale, effective_date])
  @@map("signature_consent_texts")
}

/// 04 §36 — one-time code the platform sends to prove identity: a signer before signing (SIGNER_IDENTITY) or a proposal
/// recipient before opening an EMAIL_VERIFIED public link (PROPOSAL_ACCESS, 03). Only the hash of the code is stored.
/// Exactly one of signer_id / proposal_id is set, matching `purpose` (enforced by the service).
model VerificationCode {
  id              String              @id @default(uuid())
  organization_id String
  purpose         VerificationPurpose
  channel         VerificationChannel
  signer_id       String?
  proposal_id     String?
  /// Address the code was sent to (email or E.164 phone), kept for the audit trail.
  recipient       String
  code_hash       String
  expires_at      DateTime
  attempts        Int                 @default(0)
  max_attempts    Int                 @default(5)
  /// Set after too many wrong attempts; no new code is accepted before this time.
  locked_until    DateTime?
  verified_at     DateTime?
  ip_address      String?
  created_at      DateTime            @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  signer       Signer?      @relation(fields: [signer_id], references: [id], onDelete: Cascade)
  proposal     Proposal?    @relation(fields: [proposal_id], references: [id], onDelete: Cascade)

  @@index([signer_id, created_at])
  @@index([proposal_id, created_at])
  @@index([expires_at])
  @@map("verification_codes")
}

// --- Obligations & termination ----------------------------------------------------

/// 04 §49–50, §75 — operational obligations linked to a contract section; execution may create a
/// Task (06) rather than duplicating task functionality.
model ContractObligation {
  id                        String                   @id @default(uuid())
  contract_id               String
  section_id                String?
  type                      ContractObligationType   @default(OTHER)
  title                     String
  description               String?
  /// Responsible side: a party of the contract and/or an internal Member.
  responsible_party_id      String?
  responsible_membership_id String?
  due_date                  DateTime?                @db.Date
  /// none | weekly | monthly | quarterly | annual
  frequency                 String?
  status                    ContractObligationStatus @default(OPEN)
  reminder_days_before      Int?
  /// Related Project (05) and Task (06); ids only.
  project_id                String?
  task_id                   String?
  /// AI extraction provenance (04 §75).
  is_ai_extracted           Boolean                  @default(false)
  extraction_confidence     Decimal?                 @db.Decimal(5, 4)
  review_state              ExtractionReviewState?
  fulfilled_at              DateTime?
  created_at                DateTime                 @default(now())
  updated_at                DateTime                 @updatedAt

  contract Contract         @relation(fields: [contract_id], references: [id], onDelete: Cascade)
  section  ContractSection? @relation(fields: [section_id], references: [id], onDelete: SetNull)
  task     Task?            @relation(fields: [task_id], references: [id], onDelete: SetNull)

  @@index([contract_id, status])
  @@index([due_date])
  @@map("contract_obligations")
}

/// 04 §53 — termination record. Never alters the signed document.
model ContractTermination {
  contract_id         String                  @id
  type                ContractTerminationType @default(FOR_CONVENIENCE)
  reason              String?
  requesting_party_id String?
  notice_date         DateTime?               @db.Date
  effective_date      DateTime                @db.Date
  approved_by_user_id String?
  approved_at         DateTime?
  /// Supporting document (17); id only.
  document_id         String?
  notes               String?
  /// 04 §53 — chosen impact handling: { obligations: close | transfer | keep, child_contract_ids: [...], child_handling, final_invoice, ... }.
  impact              Json?
  created_by_user_id  String?
  created_at          DateTime                @default(now())

  contract Contract  @relation(fields: [contract_id], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [document_id], references: [id], onDelete: SetNull)

  @@map("contract_terminations")
}

/// 04 §46 — the renew / do-not-renew decision taken before a renewal contract exists. History is kept (a decision can be revised);
/// the latest row is the effective one. `resulting_contract_id` links the renewal contract once it is created.
model ContractRenewalDecision {
  id                    String                      @id @default(uuid())
  contract_id           String
  decision              ContractRenewalDecisionType
  reason                String?
  decided_by_user_id    String?
  decided_at            DateTime                    @default(now())
  resulting_contract_id String?

  contract           Contract  @relation("ContractRenewalDecisions", fields: [contract_id], references: [id], onDelete: Cascade)
  resulting_contract Contract? @relation("ContractRenewalResult", fields: [resulting_contract_id], references: [id], onDelete: SetNull)

  @@index([contract_id, decided_at])
  @@map("contract_renewal_decisions")
}

// =====================================================================
// 05 Project Management — docs/features/05-project-management.md (LOG-405)
// Owns: project types/statuses/templates, Project, membership and roles, branches, stakeholders,
// objectives, workstreams, milestones, deliverables, acceptance criteria, dependencies, risks,
// issues/blockers, decisions, status updates, project change requests, gates, reviews, allocation,
// checklists, escalations, handovers, closeout, relationships, external references.
// Does not own: Tasks (06), time entries (18), documents (17), messages (12), tickets (13),
// invoices/expenses (08/09), calendar events (19), employees (10). Referenced by id only.
// Project notes use the polymorphic notes table (crm_notes, entity_type PROJECT).
// Project activity and change history (05 §42–43) are written to audit_events.
// =====================================================================

/// 05 §4 — semantic category of a configurable status.
enum ProjectStatusCategory {
  DRAFT
  PLANNED
  NOT_STARTED
  IN_PROGRESS
  ON_HOLD
  BLOCKED
  READY_FOR_COMPLETION
  COMPLETED
  CANCELLED
  ARCHIVED
}

/// 05 §13
enum ProjectHealth {
  HEALTHY
  AT_RISK
  BLOCKED
  CRITICAL
  UNKNOWN
}

/// 05 §13–14 — how health / progress are determined.
enum CalculationMode {
  MANUAL
  AUTOMATIC
  HYBRID
}

/// 05 §80
enum ProjectPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

/// 05 §60, §111 — customer exposure of the project.
enum ProjectVisibility {
  INTERNAL
  CUSTOMER_VISIBLE
}

/// 05 §19–20
enum ProjectItemStatus {
  PLANNED
  IN_PROGRESS
  AT_RISK
  COMPLETED
  CANCELLED
}

/// 05 §18 — deliverable lifecycle including customer acceptance (05 §47, 07 §7).
enum DeliverableStatus {
  PLANNED
  IN_PROGRESS
  READY_FOR_REVIEW
  SUBMITTED
  CHANGES_REQUESTED
  ACCEPTED
  REJECTED
  CANCELLED
}

/// 05 §47
enum AcceptanceStatus {
  PENDING
  PASSED
  FAILED
  WAIVED
}

/// 05 §21, §27–28 — what a dependency endpoint is.
enum DependencyItemType {
  PROJECT
  WORKSTREAM
  MILESTONE
  DELIVERABLE
  TASK
  EXTERNAL
}

/// 05 §27
enum DependencyType {
  FINISH_TO_START
  START_TO_START
  FINISH_TO_FINISH
  START_TO_FINISH
  BLOCKS
  RELATED
}

enum DependencyStatus {
  OPEN
  RESOLVED
  CANCELLED
}

/// 05 §29
enum RiskStatus {
  OPEN
  MONITORING
  MITIGATED
  ACCEPTED
  RESOLVED
  CLOSED
}

/// 05 §30–31 — a Project Issue is a delivery problem; a Blocker is an issue preventing progress.
enum ProjectIssueKind {
  ISSUE
  BLOCKER
}

enum ProjectIssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// 05 §45 — Project Change Request status (not a Contract Change Request, 04 §26).
enum ProjectChangeRequestStatus {
  REQUESTED
  UNDER_REVIEW
  ESTIMATING
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  SCHEDULED
  IMPLEMENTED
  CANCELLED
}

/// 05 §46, §93 — approval and quality gates share one model.
enum ProjectGateKind {
  APPROVAL
  QUALITY
}

enum ProjectGateStatus {
  PENDING
  PASSED
  FAILED
  WAIVED
}

/// 05 §48–49
enum ProjectReviewType {
  KICKOFF
  MILESTONE
  DELIVERY
  QUALITY
  CUSTOMER
  POST_PROJECT
  RETROSPECTIVE
}

/// 05 §105
enum ProjectRelationType {
  RELATED
  DEPENDENCY
  REPLACEMENT
  FOLLOW_UP
  MAINTENANCE_FOR
  CONTINUATION_OF
}

/// 05 §101
enum EscalationStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  CLOSED
}

/// 05 §72, §102
enum HandoverStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// --- Configuration ----------------------------------------------------------------

/// 05 §2 — organization-defined project types with defaults.
model ProjectType {
  id                                 String                   @id @default(uuid())
  organization_id                    String
  name                               String
  slug                               String
  description                        String?
  default_template_id                String?
  /// Workspace sections enabled by default (05 §11).
  enabled_sections                   String[]                 @default([])
  required_fields                    String[]                 @default([])
  /// Health rules for AUTOMATIC/HYBRID mode (05 §13).
  health_rules                       Json?
  /// Completion checklist requirements (05 §71).
  completion_requirements            Json?
  is_default                         Boolean                  @default(false)
  sort_order                         Int                      @default(0)
  /// 18 §6 — default billability for time entries on projects of this type; null = organization default (TimeTrackingSettings). Copied into TimeProjectSettings when a project is created.
  default_time_billable              Boolean?
  /// 18 §6 — non-billable category applied when default_time_billable = false.
  default_time_non_billable_category TimeNonBillableCategory?
  archived_at                        DateTime?
  created_at                         DateTime                 @default(now())
  updated_at                         DateTime                 @updatedAt

  organization     Organization      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  default_template ProjectTemplate?  @relation("ProjectTypeDefaultTemplate", fields: [default_template_id], references: [id], onDelete: SetNull)
  templates        ProjectTemplate[] @relation("ProjectTemplateType")
  projects         Project[]
  folder_templates FolderTemplate[]
  automation_rules AutomationRule[]
  task_statuses    TaskStatus[]

  @@unique([organization_id, slug])
  @@map("project_types")
}

/// 05 §4 — configurable lifecycle statuses with allowed transitions.
model ProjectStatus {
  id                  String                @id @default(uuid())
  organization_id     String
  name                String
  slug                String
  category            ProjectStatusCategory
  color               String?
  sort_order          Int                   @default(0)
  is_default          Boolean               @default(false)
  /// Slugs of statuses this one may transition to; null = any.
  allowed_transitions String[]              @default([])
  archived_at         DateTime?
  created_at          DateTime              @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  projects     Project[]

  @@unique([organization_id, slug])
  @@map("project_statuses")
}

/// 05 §36–37 — templates with versions; updating a template never modifies existing projects.
model ProjectTemplate {
  id                 String    @id @default(uuid())
  organization_id    String
  type_id            String?
  name               String
  slug               String
  description        String?
  current_version_id String?   @unique
  is_active          Boolean   @default(true)
  deprecated_at      DateTime?
  created_by_user_id String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  organization      Organization             @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  type              ProjectType?             @relation("ProjectTemplateType", fields: [type_id], references: [id], onDelete: SetNull)
  current_version   ProjectTemplateVersion?  @relation("ProjectTemplateCurrentVersion", fields: [current_version_id], references: [id], onDelete: SetNull)
  versions          ProjectTemplateVersion[]
  default_for_types ProjectType[]            @relation("ProjectTypeDefaultTemplate")
  projects          Project[]

  @@unique([organization_id, slug])
  @@map("project_templates")
}

/// 05 §37 — immutable template content: statuses, milestones, workstreams, task structures,
/// dependencies, roles, required fields, standard documents, checklists, health rules, views.
model ProjectTemplateVersion {
  id                 String   @id @default(uuid())
  template_id        String
  version_number     Int
  change_summary     String?
  structure          Json
  created_by_user_id String?
  created_at         DateTime @default(now())

  template   ProjectTemplate  @relation(fields: [template_id], references: [id], onDelete: Cascade)
  current_of ProjectTemplate? @relation("ProjectTemplateCurrentVersion")
  projects   Project[]

  @@unique([template_id, version_number])
  @@map("project_template_versions")
}

// --- Project ------------------------------------------------------------------------

/// 05 §3, §5–7, §12–15, §80, §106–107, §117 — the project record.
model Project {
  id                  String            @id @default(uuid())
  organization_id     String
  /// Primary branch (01 §32). Participating branches in ProjectBranch.
  branch_id           String?
  parent_project_id   String?
  name                String
  /// Optional human project code (05 §6, §114); stable id is `id`.
  code                String?
  slug                String
  description         String?
  type_id             String?
  status_id           String?
  health              ProjectHealth     @default(UNKNOWN)
  health_mode         CalculationMode   @default(HYBRID)
  health_reason       String?
  progress_percent    Int               @default(0)
  progress_mode       CalculationMode   @default(AUTOMATIC)
  priority            ProjectPriority   @default(MEDIUM)
  visibility          ProjectVisibility @default(INTERNAL)
  /// Customer (CRM Company, 02). Optional: internal projects have none (05 §3, §56).
  company_id          String?
  owner_membership_id String?
  team_id             String?
  template_id         String?
  template_version_id String?
  /// Source proposal and exact version (03), set when created from an accepted proposal (05 §57).
  proposal_id         String?
  proposal_version_id String?
  // 05 §15 — dates.
  planned_start       DateTime?         @db.Date
  actual_start        DateTime?         @db.Date
  target_completion   DateTime?         @db.Date
  actual_completion   DateTime?         @db.Date
  review_date         DateTime?         @db.Date
  internal_deadline   DateTime?         @db.Date
  customer_deadline   DateTime?         @db.Date
  /// 05 §51 — planned budget context; actual financials live in 08/09.
  budget_hours        Decimal?          @db.Decimal(12, 2)
  budget_amount       Decimal?          @db.Decimal(18, 2)
  currency            String?
  icon                String?
  color               String?
  /// Messaging project channel (12 §26); id only.
  channel_id          String?
  /// Business Docs runbook page (15 §4); id only.
  runbook_page_id     String?
  completed_at        DateTime?
  cancelled_at        DateTime?
  archived_at         DateTime?
  reopened_at         DateTime?
  created_by_user_id  String?
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt

  organization     Organization            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  branch           Branch?                 @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  parent           Project?                @relation("ProjectHierarchy", fields: [parent_project_id], references: [id], onDelete: SetNull)
  children         Project[]               @relation("ProjectHierarchy")
  type             ProjectType?            @relation(fields: [type_id], references: [id], onDelete: SetNull)
  status           ProjectStatus?          @relation(fields: [status_id], references: [id], onDelete: SetNull)
  company          CrmCompany?             @relation(fields: [company_id], references: [id], onDelete: SetNull)
  owner            Membership?             @relation("ProjectOwner", fields: [owner_membership_id], references: [id], onDelete: SetNull)
  team             Team?                   @relation(fields: [team_id], references: [id], onDelete: SetNull)
  template         ProjectTemplate?        @relation(fields: [template_id], references: [id], onDelete: SetNull)
  template_version ProjectTemplateVersion? @relation(fields: [template_version_id], references: [id], onDelete: SetNull)
  proposal         Proposal?               @relation("ProjectSourceProposal", fields: [proposal_id], references: [id], onDelete: SetNull)
  proposal_version ProposalVersion?        @relation("ProjectSourceProposalVersion", fields: [proposal_version_id], references: [id], onDelete: SetNull)

  branches                       ProjectBranch[]
  members                        ProjectMember[]
  favorites                      ProjectFavorite[]
  stakeholders                   ProjectStakeholder[]
  objectives                     ProjectObjective[]
  workstreams                    ProjectWorkstream[]
  milestones                     ProjectMilestone[]
  deliverables                   ProjectDeliverable[]
  dependencies                   ProjectDependency[]
  risks                          ProjectRisk[]
  issues                         ProjectIssue[]
  decisions                      ProjectDecision[]
  status_updates                 ProjectStatusUpdate[]
  change_requests                ProjectChangeRequest[]
  gates                          ProjectGate[]
  reviews                        ProjectReview[]
  allocations                    ProjectAllocation[]
  checklists                     ProjectChecklist[]
  escalations                    ProjectEscalation[]
  handovers                      ProjectHandover[]
  closeout                       ProjectCloseout?
  relations_from                 ProjectRelation[]                 @relation("ProjectRelationSource")
  relations_to                   ProjectRelation[]                 @relation("ProjectRelationTarget")
  external_refs                  ProjectExternalReference[]
  contracts                      ContractProject[]
  deals                          CrmDeal[]                         @relation("CrmDealProject")
  converted_from_proposals       Proposal[]                        @relation("ProposalConvertedProject")
  tasks                          Task[]
  cycles                         Cycle[]
  releases                       Release[]
  invoices                       Invoice[]
  subscriptions                  Subscription[]
  billing_settings               ProjectBillingSettings?
  ledger_records                 LedgerRecord[]
  recurring_expenses             RecurringExpense[]
  financial_period_summaries     FinancialPeriodSummary[]
  ledger_profitability_snapshots LedgerProfitabilitySnapshot[]
  performance_goals              PerformanceGoal[]
  performance_feedback           PerformanceFeedback[]
  comm_threads                   CommThread[]
  comm_messages                  CommMessage[]
  messaging_channels             Channel[]
  channel                        Channel?                          @relation("ProjectPrimaryChannel", fields: [channel_id], references: [id], onDelete: SetNull)
  support_tickets                Ticket[]
  wiki_spaces                    WikiSpace[]
  runbook_page                   WikiPage?                         @relation(fields: [runbook_page_id], references: [id], onDelete: SetNull)
  folders                        Folder[]
  documents                      Document[]
  vault_entries                  VaultEntry[]
  time_settings                  TimeProjectSettings?
  billing_rates                  BillingRate[]
  time_entries                   TimeEntry[]
  timers                         Timer[]
  time_suggestions               TimeSuggestion[]
  calendars                      Calendar[]
  calendar_events                CalendarEvent[]
  automation_rules               AutomationRule[]
  portal_access                  CustomerPortalMembershipProject[]
  ledger_budget_lines            LedgerBudgetLine[]
  expense_claim_lines            ExpenseClaimLine[]

  @@unique([organization_id, slug])
  @@unique([organization_id, code])
  @@index([organization_id, status_id])
  @@index([organization_id, health])
  @@index([company_id])
  @@index([owner_membership_id])
  @@index([parent_project_id])
  @@index([target_completion])
  @@map("projects")
}

/// 01 §32–33 — participating branches of a multi-branch project (primary is projects.branch_id).
model ProjectBranch {
  project_id String
  branch_id  String
  created_at DateTime @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  @@id([project_id, branch_id])
  @@index([branch_id])
  @@map("project_branches")
}

/// 05 §8–9 — internal participants. role_id is a Role of type PROJECT (01 §45).
model ProjectMember {
  id                 String    @id @default(uuid())
  project_id         String
  membership_id      String
  role_id            String?
  /// Free-text role label when no Role is used (Developer, Designer, QA, …).
  role_label         String?
  allocation_percent Int?
  is_active          Boolean   @default(true)
  joined_at          DateTime  @default(now())
  left_at            DateTime?
  created_at         DateTime  @default(now())

  project    Project    @relation(fields: [project_id], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membership_id], references: [id], onDelete: Cascade)
  role       Role?      @relation(fields: [role_id], references: [id], onDelete: SetNull)

  @@unique([project_id, membership_id])
  @@index([membership_id, is_active])
  @@map("project_members")
}

/// 05 §53 — external stakeholders: customer contacts (02), vendors, partners, consultants.
model ProjectStakeholder {
  id                 String   @id @default(uuid())
  project_id         String
  contact_id         String?
  name               String
  organization_name  String?
  email              String?
  role               String?
  responsibility     String?
  /// Whether the stakeholder sees the project in the Customer Portal (via 01 §79 identity).
  portal_visible     Boolean  @default(false)
  decision_authority Boolean  @default(false)
  created_at         DateTime @default(now())

  project Project     @relation(fields: [project_id], references: [id], onDelete: Cascade)
  contact CrmContact? @relation(fields: [contact_id], references: [id], onDelete: SetNull)

  @@index([project_id])
  @@map("project_stakeholders")
}

// --- Planning ----------------------------------------------------------------------

/// 05 §76 — a member's favorite (starred) projects, shown in the Projects sidebar.
model ProjectFavorite {
  id            String   @id @default(uuid())
  project_id    String
  membership_id String
  created_at    DateTime @default(now())

  project    Project    @relation(fields: [project_id], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membership_id], references: [id], onDelete: Cascade)

  @@unique([project_id, membership_id])
  @@index([membership_id])
  @@map("project_favorites")
}

/// 05 §17
model ProjectObjective {
  id                  String            @id @default(uuid())
  project_id          String
  name                String
  description         String?
  owner_membership_id String?
  target_date         DateTime?         @db.Date
  success_criteria    String?
  status              ProjectItemStatus @default(PLANNED)
  progress_percent    Int               @default(0)
  sort_order          Int               @default(0)
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt

  project    Project            @relation(fields: [project_id], references: [id], onDelete: Cascade)
  milestones ProjectMilestone[]

  @@index([project_id])
  @@map("project_objectives")
}

/// 05 §19
model ProjectWorkstream {
  id                  String            @id @default(uuid())
  project_id          String
  name                String
  description         String?
  owner_membership_id String?
  status              ProjectItemStatus @default(PLANNED)
  progress_percent    Int               @default(0)
  planned_start       DateTime?         @db.Date
  planned_end         DateTime?         @db.Date
  actual_start        DateTime?         @db.Date
  actual_end          DateTime?         @db.Date
  color               String?
  sort_order          Int               @default(0)
  archived_at         DateTime?
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt

  project      Project              @relation(fields: [project_id], references: [id], onDelete: Cascade)
  milestones   ProjectMilestone[]
  deliverables ProjectDeliverable[]
  allocations  ProjectAllocation[]
  tasks        Task[]
  time_entries TimeEntry[]
  timers       Timer[]

  @@index([project_id])
  @@map("project_workstreams")
}

/// 05 §20 — major checkpoints. Task links come from Task Management (06).
model ProjectMilestone {
  id                     String            @id @default(uuid())
  project_id             String
  workstream_id          String?
  objective_id           String?
  name                   String
  description            String?
  owner_membership_id    String?
  status                 ProjectItemStatus @default(PLANNED)
  planned_date           DateTime?         @db.Date
  actual_date            DateTime?         @db.Date
  progress_percent       Int               @default(0)
  /// Shown in the Customer Portal (05 §60) and projected onto the Calendar (19).
  customer_visible       Boolean           @default(false)
  /// Triggers milestone billing in 08 when completed.
  is_billing_milestone   Boolean           @default(false)
  /// Proposal milestone this was created from (03), stored as the proposal's milestone key.
  proposal_milestone_key String?
  notes                  String?
  sort_order             Int               @default(0)
  completed_at           DateTime?
  created_at             DateTime          @default(now())
  updated_at             DateTime          @updatedAt

  project             Project                      @relation(fields: [project_id], references: [id], onDelete: Cascade)
  workstream          ProjectWorkstream?           @relation(fields: [workstream_id], references: [id], onDelete: SetNull)
  objective           ProjectObjective?            @relation(fields: [objective_id], references: [id], onDelete: SetNull)
  deliverables        ProjectDeliverable[]
  acceptance_criteria ProjectAcceptanceCriterion[]
  gates               ProjectGate[]
  allocations         ProjectAllocation[]
  tasks               Task[]
  invoice_line_items  InvoiceLineItem[]
  ledger_records      LedgerRecord[]
  time_entries        TimeEntry[]
  timers              Timer[]

  @@index([project_id, planned_date])
  @@index([workstream_id])
  @@map("project_milestones")
}

/// 05 §18, 07 §7 — how many of the required customer approvers must approve a deliverable.
enum DeliverableApprovalMode {
  ANY_ONE
  ALL
}

/// 05 §18 — tangible outputs. Files are Documents (17); commercial scope stays in 03/04.
model ProjectDeliverable {
  id                  String            @id @default(uuid())
  project_id          String
  milestone_id        String?
  workstream_id       String?
  name                String
  description         String?
  owner_membership_id String?
  status              DeliverableStatus @default(PLANNED)
  due_date            DateTime?         @db.Date
  customer_visible    Boolean           @default(false)
  /// Document ids (17) delivered.
  document_ids        String[]          @default([])
  /// Proposal line item / section reference (03) for commercial scope traceability.
  proposal_reference  String?
  submitted_at        DateTime?
  accepted_at         DateTime?
  /// Customer acceptance evidence: portal user id, contact id, comment (07 §7).
  acceptance_record   Json?
  sort_order          Int               @default(0)
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt

  project             Project                      @relation(fields: [project_id], references: [id], onDelete: Cascade)
  milestone           ProjectMilestone?            @relation(fields: [milestone_id], references: [id], onDelete: SetNull)
  workstream          ProjectWorkstream?           @relation(fields: [workstream_id], references: [id], onDelete: SetNull)
  acceptance_criteria ProjectAcceptanceCriterion[]
  reviews             ProjectDeliverableReview[]
  /// 07 §7 — ANY_ONE: one required approver is enough; ALL: every required ProjectDeliverableApprover must approve. No approvers = any portal user with portal.deliverables.approve.
  approval_mode       DeliverableApprovalMode      @default(ANY_ONE)
  approvers           ProjectDeliverableApprover[]

  @@index([project_id, status])
  @@index([milestone_id])
  @@map("project_deliverables")
}

/// 05 §47 — acceptance criteria on a deliverable or milestone. Contractual acceptance terms are 04.
model ProjectAcceptanceCriterion {
  id                     String           @id @default(uuid())
  deliverable_id         String?
  milestone_id           String?
  requirement            String
  expected_outcome       String?
  verification_method    String?
  status                 AcceptanceStatus @default(PENDING)
  reviewer_membership_id String?
  reviewed_at            DateTime?
  sort_order             Int              @default(0)

  deliverable ProjectDeliverable? @relation(fields: [deliverable_id], references: [id], onDelete: Cascade)
  milestone   ProjectMilestone?   @relation(fields: [milestone_id], references: [id], onDelete: Cascade)

  @@index([deliverable_id])
  @@index([milestone_id])
  @@map("project_acceptance_criteria")
}

/// 05 §21, §27–28 — dependencies between tasks, milestones, workstreams, deliverables and projects.
/// Endpoints are typed ids so Task (06) endpoints work without a FK.
model ProjectDependency {
  id                  String             @id @default(uuid())
  project_id          String
  source_type         DependencyItemType
  source_id           String
  target_type         DependencyItemType
  target_id           String
  type                DependencyType     @default(FINISH_TO_START)
  status              DependencyStatus   @default(OPEN)
  owner_membership_id String?
  expected_resolution DateTime?          @db.Date
  lag_days            Int?
  notes               String?
  resolved_at         DateTime?
  created_at          DateTime           @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id, status])
  @@index([source_type, source_id])
  @@index([target_type, target_id])
  @@map("project_dependencies")
}

// --- Delivery visibility -------------------------------------------------------------

/// 05 §29
model ProjectRisk {
  id                  String     @id @default(uuid())
  project_id          String
  title               String
  description         String?
  category            String?
  /// 1–5 scales; severity derived or set.
  probability         Int?
  impact              Int?
  severity            Severity   @default(MEDIUM)
  status              RiskStatus @default(OPEN)
  owner_membership_id String?
  mitigation          String?
  contingency         String?
  due_date            DateTime?  @db.Date
  milestone_id        String?
  task_id             String?
  resolved_at         DateTime?
  created_at          DateTime   @default(now())
  updated_at          DateTime   @updatedAt

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id, status])
  @@map("project_risks")
}

/// 05 §30–31 — Project Issues and Blockers (kind). Distinct from Support tickets (13) and Tasks (06).
model ProjectIssue {
  id                  String              @id @default(uuid())
  project_id          String
  kind                ProjectIssueKind    @default(ISSUE)
  title               String
  description         String?
  severity            Severity            @default(MEDIUM)
  priority            ProjectPriority     @default(MEDIUM)
  status              ProjectIssueStatus  @default(OPEN)
  owner_membership_id String?
  /// For blockers: what is blocked (typed id).
  blocked_item_type   DependencyItemType?
  blocked_item_id     String?
  milestone_id        String?
  task_id             String?
  dependency_id       String?
  /// Linked support ticket (13) when the issue originated from support; id only.
  ticket_id           String?
  identified_at       DateTime            @default(now())
  target_resolution   DateTime?           @db.Date
  resolution          String?
  resolved_at         DateTime?
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [task_id], references: [id], onDelete: SetNull)
  ticket  Ticket? @relation(fields: [ticket_id], references: [id], onDelete: SetNull)

  @@index([project_id, kind, status])
  @@map("project_issues")
}

/// 05 §32 — decision records.
model ProjectDecision {
  id                           String   @id @default(uuid())
  project_id                   String
  title                        String
  description                  String?
  decided_at                   DateTime @default(now())
  decision_maker_membership_id String?
  /// Membership ids.
  participants                 String[] @default([])
  alternatives_considered      String?
  selected_option              String?
  reason                       String?
  consequences                 String?
  milestone_id                 String?
  task_id                      String?
  document_id                  String?
  /// Source message permalink (12 §63) when converted from a conversation.
  source_message_id            String?
  created_at                   DateTime @default(now())

  project        Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  source_message Message?  @relation("ProjectDecisionSourceMessage", fields: [source_message_id], references: [id], onDelete: SetNull)
  document       Document? @relation(fields: [document_id], references: [id], onDelete: SetNull)

  @@index([project_id, decided_at])
  @@map("project_decisions")
}

/// 05 §39 — structured status updates; customer-visible ones appear in the portal (07 §4).
model ProjectStatusUpdate {
  id                   String         @id @default(uuid())
  project_id           String
  period_start         DateTime?      @db.Date
  period_end           DateTime?      @db.Date
  summary              String
  completed_work       String?
  current_work         String?
  upcoming_work        String?
  progress_percent     Int?
  health               ProjectHealth?
  risks_summary        String?
  blockers_summary     String?
  decisions_summary    String?
  required_actions     String?
  author_membership_id String?
  customer_visible     Boolean        @default(false)
  published_at         DateTime?
  is_ai_generated      Boolean        @default(false)
  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt

  project  Project                      @relation(fields: [project_id], references: [id], onDelete: Cascade)
  comments ProjectStatusUpdateComment[]

  @@index([project_id, published_at])
  @@map("project_status_updates")
}

/// 05 §45 — Project Change Request: changes affecting delivery. Commercial approval stays with
/// 03/04 (proposal_id, contract_id); a Contract Change Request (04 §26) may be linked.
model ProjectChangeRequest {
  id                           String                     @id @default(uuid())
  project_id                   String
  number                       Int
  title                        String
  description                  String?
  requester_membership_id      String?
  requester_contact_id         String?
  requested_at                 DateTime                   @default(now())
  priority                     ProjectPriority            @default(MEDIUM)
  status                       ProjectChangeRequestStatus @default(REQUESTED)
  scope_impact                 String?
  timeline_impact_days         Int?
  resource_impact              String?
  cost_impact_amount           Decimal?                   @db.Decimal(18, 2)
  currency                     String?
  customer_visible             Boolean                    @default(false)
  approved_by_membership_id    String?
  approved_by_customer_user_id String?
  approved_at                  DateTime?
  rejected_reason              String?
  deliverable_id               String?
  task_id                      String?
  /// Commercial links (03, 04) and the contract change request this originated (04 §26, §43).
  proposal_id                  String?
  contract_id                  String?
  contract_change_request_id   String?
  implemented_at               DateTime?
  created_at                   DateTime                   @default(now())
  updated_at                   DateTime                   @updatedAt

  project         Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  task            Task?    @relation(fields: [task_id], references: [id], onDelete: SetNull)
  support_tickets Ticket[]

  @@unique([project_id, number])
  @@index([project_id, status])
  @@map("project_change_requests")
}

/// 05 §46, §93 — approval gates (requirements, design, development, QA, security, customer
/// acceptance, launch, handover) and quality gates (code review, QA, security review, documentation).
model ProjectGate {
  id                        String            @id @default(uuid())
  project_id                String
  kind                      ProjectGateKind   @default(APPROVAL)
  name                      String
  description               String?
  milestone_id              String?
  approver_membership_id    String?
  /// Customer approval gates are decided by a Customer Portal User (01 §79); id only.
  customer_approver_user_id String?
  status                    ProjectGateStatus @default(PENDING)
  blocks_completion         Boolean           @default(false)
  decision_comment          String?
  decided_at                DateTime?
  sort_order                Int               @default(0)
  created_at                DateTime          @default(now())
  updated_at                DateTime          @updatedAt

  project   Project           @relation(fields: [project_id], references: [id], onDelete: Cascade)
  milestone ProjectMilestone? @relation(fields: [milestone_id], references: [id], onDelete: SetNull)
  approver  Membership?       @relation("ProjectGateApprover", fields: [approver_membership_id], references: [id], onDelete: SetNull)

  @@index([project_id, status])
  @@map("project_gates")
}

/// 05 §48–49 — structured reviews and retrospectives. Actions may create Tasks (06).
model ProjectReview {
  id                        String            @id @default(uuid())
  project_id                String
  type                      ProjectReviewType
  title                     String
  held_at                   DateTime?
  facilitator_membership_id String?
  /// Membership ids.
  participants              String[]          @default([])
  findings                  String?
  decisions                 String?
  /// Retrospective fields (05 §49).
  went_well                 String?
  went_wrong                String?
  root_causes               String?
  lessons                   String?
  /// Actions: [{ title, owner_membership_id, due_date, task_id? }].
  actions                   Json?
  milestone_id              String?
  created_at                DateTime          @default(now())
  updated_at                DateTime          @updatedAt

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id, type])
  @@map("project_reviews")
}

// --- Resources ------------------------------------------------------------------------

/// 05 §51 — planned allocation (the plan). Availability is 10; actuals are 18.
model ProjectAllocation {
  id                 String    @id @default(uuid())
  project_id         String
  membership_id      String?
  team_id            String?
  role_label         String?
  workstream_id      String?
  milestone_id       String?
  planned_hours      Decimal?  @db.Decimal(10, 2)
  allocation_percent Int?
  start_date         DateTime? @db.Date
  end_date           DateTime? @db.Date
  notes              String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  project    Project            @relation(fields: [project_id], references: [id], onDelete: Cascade)
  membership Membership?        @relation(fields: [membership_id], references: [id], onDelete: Cascade)
  team       Team?              @relation(fields: [team_id], references: [id], onDelete: Cascade)
  workstream ProjectWorkstream? @relation(fields: [workstream_id], references: [id], onDelete: SetNull)
  milestone  ProjectMilestone?  @relation(fields: [milestone_id], references: [id], onDelete: SetNull)

  required_skills ProjectAllocationSkill[]

  @@index([project_id])
  @@index([membership_id, start_date, end_date])
  @@map("project_allocations")
}

/// 05 §92 — reusable checklists (kickoff, discovery, development, QA, launch, handover, closeout).
model ProjectChecklist {
  id         String   @id @default(uuid())
  project_id String
  name       String
  /// kickoff | discovery | development | qa | launch | handover | closeout | custom
  phase      String?
  sort_order Int      @default(0)
  created_at DateTime @default(now())

  project Project                @relation(fields: [project_id], references: [id], onDelete: Cascade)
  items   ProjectChecklistItem[]

  @@index([project_id])
  @@map("project_checklists")
}

model ProjectChecklistItem {
  id                         String    @id @default(uuid())
  checklist_id               String
  title                      String
  is_required                Boolean   @default(false)
  is_completed               Boolean   @default(false)
  completed_by_membership_id String?
  completed_at               DateTime?
  /// Task created from this item (06).
  task_id                    String?
  sort_order                 Int       @default(0)

  checklist ProjectChecklist @relation(fields: [checklist_id], references: [id], onDelete: Cascade)
  task      Task?            @relation(fields: [task_id], references: [id], onDelete: SetNull)

  @@index([checklist_id])
  @@map("project_checklist_items")
}

// --- Governance & closeout -------------------------------------------------------------

/// 05 §101
model ProjectEscalation {
  id                         String           @id @default(uuid())
  project_id                 String
  issue_summary              String
  /// blocker | delay | budget | scope | customer | resources | contract
  category                   String?
  severity                   Severity         @default(HIGH)
  status                     EscalationStatus @default(OPEN)
  owner_membership_id        String?
  escalated_to_membership_id String?
  escalated_at               DateTime         @default(now())
  action_taken               String?
  resolution                 String?
  resolved_at                DateTime?
  issue_id                   String?
  created_at                 DateTime         @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id, status])
  @@map("project_escalations")
}

/// 05 §72, §102 — handovers between teams or to maintenance / support / customer success.
model ProjectHandover {
  id                        String         @id @default(uuid())
  project_id                String
  /// sales_to_delivery | delivery_to_support | development_to_qa | qa_to_customer | project_to_maintenance | custom
  type                      String
  from_team_id              String?
  to_team_id                String?
  new_owner_membership_id   String?
  status                    HandoverStatus @default(PLANNED)
  scheduled_at              DateTime?
  completed_at              DateTime?
  /// Checklist, documentation ids (17), open items, support references, contacts, notes.
  details                   Json?
  accepted_by_membership_id String?
  accepted_at               DateTime?
  created_at                DateTime       @default(now())
  updated_at                DateTime       @updatedAt

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id, status])
  @@map("project_handovers")
}

/// 05 §71, §103 — completion checklist state and closeout record.
model ProjectCloseout {
  project_id                      String    @id
  /// Completion requirement results (05 §71): [{ key, label, required, satisfied, note }].
  completion_checklist            Json?
  final_status_summary            String?
  outstanding_items               String?
  lessons_learned                 String?
  customer_outcome                String?
  /// Financial review reference (08/09); id only.
  financial_review_ref            String?
  documentation_document_ids      String[]  @default([])
  customer_acceptance_recorded_at DateTime?
  closed_by_membership_id         String?
  closed_at                       DateTime?
  updated_at                      DateTime  @updatedAt

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@map("project_closeouts")
}

/// 05 §105 — non-hierarchical relationships between projects (parent/child uses parent_project_id).
model ProjectRelation {
  id                String              @id @default(uuid())
  source_project_id String
  target_project_id String
  type              ProjectRelationType @default(RELATED)
  notes             String?
  created_at        DateTime            @default(now())

  source Project @relation("ProjectRelationSource", fields: [source_project_id], references: [id], onDelete: Cascade)
  target Project @relation("ProjectRelationTarget", fields: [target_project_id], references: [id], onDelete: Cascade)

  @@unique([source_project_id, target_project_id, type])
  @@index([target_project_id])
  @@map("project_relations")
}

/// 05 §86 — references to external systems (GitHub, GitLab, Jira, Linear, deployment, cloud, docs).
model ProjectExternalReference {
  id          String   @id @default(uuid())
  project_id  String
  /// github | gitlab | jira | linear | notion | google_drive | microsoft_365 | deployment | cloud | other
  system      String
  label       String?
  external_id String?
  url         String?
  metadata    Json?
  created_at  DateTime @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id, system])
  @@map("project_external_references")
}

/// 05 §18, §47, 07 §7 — one customer (or internal) decision on a submitted deliverable: the queryable approval
/// history behind "approve / request revisions / reject with comments". ProjectDeliverable.acceptance_record keeps
/// only the final acceptance evidence.
model ProjectDeliverableReview {
  id                     String            @id @default(uuid())
  organization_id        String
  deliverable_id         String
  /// Decision taken; the deliverable's status is set to this value.
  decision               DeliverableStatus
  comment                String?
  /// Customer Portal User (01 §79) when decided through the portal.
  reviewer_user_id       String?
  reviewer_membership_id String?
  /// Document version ids (17) that were reviewed, for traceability of which submission was decided.
  document_version_ids   String[]          @default([])
  decided_at             DateTime          @default(now())

  organization Organization       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  deliverable  ProjectDeliverable @relation(fields: [deliverable_id], references: [id], onDelete: Cascade)
  reviewer     Membership?        @relation("ProjectDeliverableReviewer", fields: [reviewer_membership_id], references: [id], onDelete: SetNull)

  @@index([deliverable_id, decided_at])
  @@index([organization_id])
  @@map("project_deliverable_reviews")
}

/// 07 §7 — customer user who must (required) or may approve a deliverable; ProjectDeliverable.approval_mode says how many.
/// Decisions stay in ProjectDeliverableReview.
model ProjectDeliverableApprover {
  id                   String    @id @default(uuid())
  organization_id      String
  deliverable_id       String
  portal_membership_id String
  required             Boolean   @default(true)
  notified_at          DateTime?
  reminded_at          DateTime?
  created_at           DateTime  @default(now())

  organization      Organization             @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  deliverable       ProjectDeliverable       @relation(fields: [deliverable_id], references: [id], onDelete: Cascade)
  portal_membership CustomerPortalMembership @relation(fields: [portal_membership_id], references: [id], onDelete: Cascade)

  @@unique([deliverable_id, portal_membership_id])
  @@index([portal_membership_id])
  @@index([organization_id])
  @@map("project_deliverable_approvers")
}

/// 05 §39, 07 §4 — comments on a published status update by customers (Customer Portal Users, 01 §79) or members.
model ProjectStatusUpdateComment {
  id                   String    @id @default(uuid())
  organization_id      String
  status_update_id     String
  author_membership_id String?
  /// Customer Portal User (01 §79) when written from the portal.
  author_user_id       String?
  body                 String
  edited_at            DateTime?
  deleted_at           DateTime?
  created_at           DateTime  @default(now())

  organization  Organization        @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  status_update ProjectStatusUpdate @relation(fields: [status_update_id], references: [id], onDelete: Cascade)
  author        Membership?         @relation("ProjectStatusUpdateCommentAuthor", fields: [author_membership_id], references: [id], onDelete: SetNull)

  @@index([status_update_id, created_at])
  @@index([organization_id])
  @@map("project_status_update_comments")
}

// =====================================================================
// 06 Task Management — docs/features/06-task-management.md (LOG-102)
// Owns: the only Task entity, task statuses/workflows, task types, labels, cycles, dependencies,
// assignees, watchers, checklists, comments, attachments, polymorphic links to other records,
// Releases and deployments. "Issue" in the UI means Task.
// Does not own: Projects/Milestones/Workstreams (05), time entries (18), documents (17),
// conversations (12), tickets (13), recurrence schedules (20). Referenced by id only.
// Task activity, version history and audit log are written to audit_events.
// =====================================================================

/// 06 §3 — semantic category of a configurable task status.
enum TaskStatusCategory {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  DONE
  CANCELLED
}

/// 06 §3
enum TaskPriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// 06 §3 — task-to-task dependency kinds.
enum TaskDependencyType {
  BLOCKS
  RELATED
  DUPLICATE_OF
}

/// 06 §4 — cycles / sprints.
enum CycleStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

/// 06 §9
enum ReleaseStatus {
  PLANNED
  IN_PROGRESS
  RELEASED
  CANCELLED
}

enum DeploymentStatus {
  PENDING
  IN_PROGRESS
  SUCCEEDED
  FAILED
  ROLLED_BACK
}

/// 06 §7 — comment visibility.
enum TaskCommentVisibility {
  INTERNAL
  CUSTOMER_VISIBLE
}

// --- Configuration ----------------------------------------------------------------

/// 06 §3 — configurable statuses with workflow transitions. Scoped to a Team when team_id is set,
/// otherwise organization-wide.
model TaskStatus {
  id                  String             @id @default(uuid())
  organization_id     String
  team_id             String?
  /// 06 §3 — scope the workflow to a Project Type (05 §11) instead of / in addition to a Team; null = not type-specific.
  project_type_id     String?
  name                String
  slug                String
  category            TaskStatusCategory
  color               String?
  sort_order          Int                @default(0)
  is_default          Boolean            @default(false)
  /// Slugs this status may transition to; empty = any.
  allowed_transitions String[]           @default([])
  archived_at         DateTime?
  created_at          DateTime           @default(now())

  organization Organization        @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  team         Team?               @relation(fields: [team_id], references: [id], onDelete: Cascade)
  tasks        Task[]
  history_from TaskStatusHistory[] @relation("TaskStatusHistoryFrom")
  history_to   TaskStatusHistory[] @relation("TaskStatusHistoryTo")
  project_type ProjectType?        @relation(fields: [project_type_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, team_id, project_type_id, slug])
  @@index([project_type_id])
  @@index([organization_id, category])
  @@map("task_statuses")
}

/// 06 §3 — task types (task, bug, feature, improvement, chore, follow-up …).
model TaskType {
  id              String    @id @default(uuid())
  organization_id String
  name            String
  slug            String
  icon            String?
  color           String?
  is_default      Boolean   @default(false)
  /// Default field values and checklist for tasks of this type (06 §3 templates).
  template        Json?
  sort_order      Int       @default(0)
  archived_at     DateTime?
  created_at      DateTime  @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  tasks        Task[]

  @@unique([organization_id, slug])
  @@map("task_types")
}

/// 06 §3 — Linear-style labels. Platform tags (02 §36) also apply to tasks.
model TaskLabel {
  id              String    @id @default(uuid())
  organization_id String
  name            String
  slug            String
  color           String?
  /// Optional parent for label groups.
  parent_label_id String?
  archived_at     DateTime?
  created_at      DateTime  @default(now())

  organization Organization          @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  parent       TaskLabel?            @relation("TaskLabelGroup", fields: [parent_label_id], references: [id], onDelete: SetNull)
  children     TaskLabel[]           @relation("TaskLabelGroup")
  assignments  TaskLabelAssignment[]

  @@unique([organization_id, slug])
  @@map("task_labels")
}

/// 06 §4 — cycles / sprints, per team or project.
model Cycle {
  id              String      @id @default(uuid())
  organization_id String
  team_id         String?
  project_id      String?
  number          Int
  name            String?
  goal            String?
  status          CycleStatus @default(PLANNED)
  starts_at       DateTime    @db.Date
  ends_at         DateTime    @db.Date
  completed_at    DateTime?
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [team_id], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [project_id], references: [id], onDelete: Cascade)
  tasks        Task[]

  @@unique([organization_id, team_id, number])
  @@index([organization_id, status])
  @@map("cycles")
}

// --- Task ---------------------------------------------------------------------------

/// 06 §1, §3, §6, §12 — the Task record (full-text search over title/description, inline editing). Work hierarchy: Organization → Team → Project → Workstream/Milestone →
/// Task → Subtask. Project is optional for personal and CRM work.
model Task {
  id                         String                   @id @default(uuid())
  organization_id            String
  /// Sequential per team (tasks without a team share one counter); shown with Team.task_key (e.g. WEB-142).
  number                     Int
  team_id                    String?
  /// 06 §2 — project context consumed from 05 (project, workstream, milestone); all optional.
  project_id                 String?
  workstream_id              String?
  milestone_id               String?
  parent_task_id             String?
  cycle_id                   String?
  release_id                 String?
  type_id                    String?
  status_id                  String?
  title                      String
  /// Markdown body.
  description                String?
  priority                   TaskPriority             @default(NONE)
  assignee_membership_id     String?
  reporter_membership_id     String?
  estimate_points            Decimal?                 @db.Decimal(6, 2)
  estimate_hours             Decimal?                 @db.Decimal(8, 2)
  start_date                 DateTime?                @db.Date
  due_date                   DateTime?                @db.Date
  completed_at               DateTime?
  cancelled_at               DateTime?
  /// Acceptance criteria as a checklist-like list: [{ text, done }].
  acceptance_criteria        Json?
  /// Visible in the Customer Portal (05 §60, 07 §4).
  customer_visible           Boolean                  @default(false)
  /// Recurring task instance: schedule rule lives in the Automation Engine (20); the template task is linked.
  automation_rule_id         String?
  recurring_template_task_id String?
  is_template                Boolean                  @default(false)
  /// Lexicographic rank for manual ordering in boards/backlog.
  rank                       String?
  /// Duplicate detection target (06 §3).
  duplicate_of_task_id       String?
  blocked                    Boolean                  @default(false)
  /// 06 §3, §10 — why the task is blocked (shown in workload bottleneck detection).
  blocked_reason             String?
  /// 06 §3, §11 — cached actual effort rolled up from approved time entries (18 §8); 18 is the source of truth.
  actual_hours               Decimal?                 @db.Decimal(8, 2)
  /// 06 §3 — task created by cloning this task (clone lineage).
  cloned_from_task_id        String?
  archived_at                DateTime?
  created_by_user_id         String?
  created_at                 DateTime                 @default(now())
  updated_at                 DateTime                 @updatedAt
  /// 06 §6 — Postgres full-text search vector over title + description; maintained by a database trigger (see migration). Not set by the API.
  search_vector              Unsupported("tsvector")?

  organization        Organization       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  team                Team?              @relation(fields: [team_id], references: [id], onDelete: SetNull)
  project             Project?           @relation(fields: [project_id], references: [id], onDelete: SetNull)
  workstream          ProjectWorkstream? @relation(fields: [workstream_id], references: [id], onDelete: SetNull)
  milestone           ProjectMilestone?  @relation(fields: [milestone_id], references: [id], onDelete: SetNull)
  parent              Task?              @relation("TaskHierarchy", fields: [parent_task_id], references: [id], onDelete: SetNull)
  subtasks            Task[]             @relation("TaskHierarchy")
  cycle               Cycle?             @relation(fields: [cycle_id], references: [id], onDelete: SetNull)
  release             Release?           @relation(fields: [release_id], references: [id], onDelete: SetNull)
  type                TaskType?          @relation(fields: [type_id], references: [id], onDelete: SetNull)
  status              TaskStatus?        @relation(fields: [status_id], references: [id], onDelete: SetNull)
  assignee            Membership?        @relation("TaskAssignee", fields: [assignee_membership_id], references: [id], onDelete: SetNull)
  reporter            Membership?        @relation("TaskReporter", fields: [reporter_membership_id], references: [id], onDelete: SetNull)
  recurring_template  Task?              @relation("TaskRecurringTemplate", fields: [recurring_template_task_id], references: [id], onDelete: SetNull)
  recurring_instances Task[]             @relation("TaskRecurringTemplate")
  duplicate_of        Task?              @relation("TaskDuplicate", fields: [duplicate_of_task_id], references: [id], onDelete: SetNull)
  duplicates          Task[]             @relation("TaskDuplicate")

  assignees         TaskAssignee[]
  labels            TaskLabelAssignment[]
  dependencies_from TaskDependency[]      @relation("TaskDependencySource")
  dependencies_to   TaskDependency[]      @relation("TaskDependencyTarget")
  checklist_items   TaskChecklistItem[]
  comments          TaskComment[]
  attachments       TaskAttachment[]
  links             TaskLink[]
  watchers          TaskWatcher[]
  status_history    TaskStatusHistory[]

  // Back-links from other modules' records that reference this task
  project_issues           ProjectIssue[]
  project_change_requests  ProjectChangeRequest[]
  project_checklist_items  ProjectChecklistItem[]
  contract_obligations     ContractObligation[]
  ticket_links             TicketTaskLink[]
  wiki_checklist_run_items WikiChecklistRunItem[]
  form_submissions         FormSubmission[]
  time_entries             TimeEntry[]
  timers                   Timer[]
  time_suggestions         TimeSuggestion[]
  automation_rule          AutomationRule?        @relation("TaskAutomationRule", fields: [automation_rule_id], references: [id], onDelete: SetNull)

  @@unique([organization_id, team_id, number])
  @@index([organization_id, status_id])
  @@index([project_id, status_id])
  @@index([search_vector], type: Gin)
  @@index([assignee_membership_id, status_id])
  @@index([team_id, cycle_id])
  @@index([parent_task_id])
  @@index([milestone_id])
  @@index([due_date])
  @@map("tasks")
}

/// 06 §3 — additional assignees beyond the primary assignee.
model TaskAssignee {
  task_id       String
  membership_id String
  assigned_at   DateTime @default(now())

  task       Task       @relation(fields: [task_id], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membership_id], references: [id], onDelete: Cascade)

  @@id([task_id, membership_id])
  @@index([membership_id])
  @@map("task_assignees")
}

model TaskLabelAssignment {
  task_id  String
  label_id String

  task  Task      @relation(fields: [task_id], references: [id], onDelete: Cascade)
  label TaskLabel @relation(fields: [label_id], references: [id], onDelete: Cascade)

  @@id([task_id, label_id])
  @@index([label_id])
  @@map("task_label_assignments")
}

/// 06 §3 — blocks / related / duplicates between tasks, including cross-project links.
model TaskDependency {
  id                 String             @id @default(uuid())
  source_task_id     String
  target_task_id     String
  type               TaskDependencyType @default(BLOCKS)
  created_by_user_id String?
  created_at         DateTime           @default(now())

  source Task @relation("TaskDependencySource", fields: [source_task_id], references: [id], onDelete: Cascade)
  target Task @relation("TaskDependencyTarget", fields: [target_task_id], references: [id], onDelete: Cascade)

  @@unique([source_task_id, target_task_id, type])
  @@index([target_task_id])
  @@map("task_dependencies")
}

/// 06 §3 — checklists inside a task.
model TaskChecklistItem {
  id                         String    @id @default(uuid())
  task_id                    String
  title                      String
  is_completed               Boolean   @default(false)
  completed_by_membership_id String?
  completed_at               DateTime?
  sort_order                 Int       @default(0)

  task Task @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@index([task_id])
  @@map("task_checklist_items")
}

/// 06 §7 — comments with threads, mentions and reactions. Customer-visible comments surface in 07.
model TaskComment {
  id                   String                @id @default(uuid())
  task_id              String
  parent_comment_id    String?
  author_membership_id String?
  /// Customer Portal User (01 §79) when written from the portal; id only.
  author_user_id       String?
  visibility           TaskCommentVisibility @default(INTERNAL)
  body                 String
  /// Membership ids mentioned.
  mentions             String[]              @default([])
  /// { emoji: [membership_id, …] }
  reactions            Json?
  edited_at            DateTime?
  deleted_at           DateTime?
  created_at           DateTime              @default(now())
  updated_at           DateTime              @updatedAt

  task    Task          @relation(fields: [task_id], references: [id], onDelete: Cascade)
  parent  TaskComment?  @relation("TaskCommentThread", fields: [parent_comment_id], references: [id], onDelete: Cascade)
  replies TaskComment[] @relation("TaskCommentThread")
  author  Membership?   @relation("TaskCommentAuthor", fields: [author_membership_id], references: [id], onDelete: SetNull)

  @@index([task_id, created_at])
  @@index([parent_comment_id])
  @@map("task_comments")
}

/// 06 §8 — attachments are Documents (17 §2).
model TaskAttachment {
  id               String   @id @default(uuid())
  task_id          String
  document_id      String
  added_by_user_id String?
  created_at       DateTime @default(now())

  task     Task     @relation(fields: [task_id], references: [id], onDelete: Cascade)
  document Document @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@unique([task_id, document_id])
  @@map("task_attachments")
}

/// 06 §13 — polymorphic link from a task to the record it originated from or serves:
/// CRM records (02 §14), tickets (13 §4), project change requests (05), customer requests (07),
/// contract obligations (04 §49), employee onboarding (10).
model TaskLink {
  id                 String           @id @default(uuid())
  task_id            String
  entity_type        RecordEntityType
  entity_id          String
  /// origin | related | blocks | fixes
  relation           String           @default("related")
  created_by_user_id String?
  created_at         DateTime         @default(now())

  task Task @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@unique([task_id, entity_type, entity_id])
  @@index([entity_type, entity_id])
  @@map("task_links")
}

/// 06 §4, §11 — status transition log per task; source for lead time, cycle time, throughput and
/// time-in-status metrics. Full field-level history stays in audit_events.
model TaskStatusHistory {
  id                       String              @id @default(uuid())
  task_id                  String
  from_status_id           String?
  to_status_id             String?
  /// Category snapshot of the target status (statuses can be renamed/deleted later).
  to_category              TaskStatusCategory?
  changed_by_membership_id String?
  /// Seconds spent in the previous status.
  seconds_in_previous      Int?
  changed_at               DateTime            @default(now())

  task        Task        @relation(fields: [task_id], references: [id], onDelete: Cascade)
  from_status TaskStatus? @relation("TaskStatusHistoryFrom", fields: [from_status_id], references: [id], onDelete: SetNull)
  to_status   TaskStatus? @relation("TaskStatusHistoryTo", fields: [to_status_id], references: [id], onDelete: SetNull)

  @@index([task_id, changed_at])
  @@index([to_status_id, changed_at])
  @@map("task_status_history")
}

/// Members following a task for notifications (14).
model TaskWatcher {
  task_id       String
  membership_id String
  created_at    DateTime @default(now())

  task       Task       @relation(fields: [task_id], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membership_id], references: [id], onDelete: Cascade)

  @@id([task_id, membership_id])
  @@index([membership_id])
  @@map("task_watchers")
}

// --- Releases -----------------------------------------------------------------------

/// 06 §9 — a shippable set of tasks. A Release may map to a Project Milestone (05).
model Release {
  id                   String        @id @default(uuid())
  organization_id      String
  team_id              String?
  project_id           String?
  milestone_id         String?
  name                 String
  version              String?
  status               ReleaseStatus @default(PLANNED)
  target_date          DateTime?     @db.Date
  released_at          DateTime?
  /// Release notes (markdown), publishable to the portal (07) and knowledge base (13 §6).
  notes                String?
  notes_document_id    String?
  customer_visible     Boolean       @default(false)
  /// Customers affected, derived from linked tickets (13 §4); CRM company ids.
  affected_company_ids String[]      @default([])
  created_by_user_id   String?
  created_at           DateTime      @default(now())
  updated_at           DateTime      @updatedAt

  organization   Organization        @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  team           Team?               @relation(fields: [team_id], references: [id], onDelete: SetNull)
  project        Project?            @relation(fields: [project_id], references: [id], onDelete: SetNull)
  tasks          Task[]
  deployments    ReleaseDeployment[]
  notes_document Document?           @relation("ReleaseNotesDocument", fields: [notes_document_id], references: [id], onDelete: SetNull)

  @@index([organization_id, status])
  @@index([project_id])
  @@map("releases")
}

/// 06 §9 — deployment status per environment.
model ReleaseDeployment {
  id                  String           @id @default(uuid())
  release_id          String
  /// development | staging | production | custom
  environment         String
  status              DeploymentStatus @default(PENDING)
  url                 String?
  deployed_by_user_id String?
  deployed_at         DateTime?
  /// External reference (CI run, GitHub deployment id, …).
  external_ref        String?
  notes               String?
  created_at          DateTime         @default(now())

  release Release @relation(fields: [release_id], references: [id], onDelete: Cascade)

  @@index([release_id, environment])
  @@map("release_deployments")
}

// =====================================================================
// 07 Customer Portal — docs/features/07-customer-portal.md (LOG-103)
// The portal is a surface; identity is 01 §79, requests are 13, billing is 08, documents are 17.
// Its only schema footprint is per-organization portal configuration.
// =====================================================================

/// 07 §14, §18 — portal branding, white-label and feature toggles per organization.
model CustomerPortalSettings {
  organization_id                  String   @id
  enabled                          Boolean  @default(true)
  /// Custom domain for the portal (white-label); verified through OrganizationDomain.
  custom_domain                    String?  @unique
  /// Branding overrides on top of organization branding (01 §15).
  branding                         Json?
  /// Feature toggles: { projects, requests, conversations, documents, proposals, contracts, billing, calendar, vault, ai }.
  features                         Json?
  /// Default customer role slug assigned to invited portal users (01 §79).
  default_role_slug                String   @default("customer-viewer")
  /// 07 §2 — agency approval policy for customer profile edits; false = changes apply immediately (PortalProfileChangeStatus.AUTO_APPLIED).
  profile_changes_require_approval Boolean  @default(true)
  /// Embedded widget configuration (support chat, request form) for customer sites (13 §5).
  widget_settings                  Json?
  welcome_message                  String?
  support_email                    String?
  updated_at                       DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@map("customer_portal_settings")
}

/// 07 §2, §14 — per-client (CRM Company) portal switch and overrides on top of CustomerPortalSettings.
/// No row = the organization defaults apply. null columns inherit the organization value.
model CustomerPortalClientSettings {
  id                String    @id @default(uuid())
  organization_id   String
  company_id        String
  enabled           Boolean   @default(true)
  /// Same keys as CustomerPortalSettings.features; null = inherit.
  features          Json?
  default_role_slug String?
  welcome_message   String?
  branding          Json?
  disabled_at       DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  company      CrmCompany   @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, company_id])
  @@index([company_id])
  @@map("customer_portal_client_settings")
}

/// 07 §2 — review state of a customer-submitted profile change.
enum PortalProfileChangeStatus {
  PENDING
  APPROVED
  REJECTED
  AUTO_APPLIED
}

/// 07 §2 — a customer portal user edits company information or contact details; the write goes to the
/// CRM Company/Contact (02) subject to the agency approval policy. Holds the proposed diff until reviewed.
model CustomerPortalProfileChangeRequest {
  id                        String                    @id @default(uuid())
  organization_id           String
  company_id                String
  /// CRM contact being edited, when the change targets a contact rather than the company.
  contact_id                String?
  requested_by_user_id      String
  /// { field: { from, to } } for the Company or Contact record.
  changes                   Json
  status                    PortalProfileChangeStatus @default(PENDING)
  reviewed_by_membership_id String?
  reviewed_at               DateTime?
  review_note               String?
  created_at                DateTime                  @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  company      CrmCompany   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  contact      CrmContact?  @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  requested_by User         @relation("PortalProfileChangeRequester", fields: [requested_by_user_id], references: [id], onDelete: Cascade)

  @@index([organization_id, status])
  @@index([company_id])
  @@map("customer_portal_profile_change_requests")
}

// =====================================================================
// 08 Financial Management & Payment Providers — docs/features/08-financial-management-stripe-integration.md (LOG-104)
// Owns: billing profiles and payment methods, the platform products & services catalog, prices,
// tax rates, coupons, invoices and line items, payments, allocations, refunds, credit notes,
// subscriptions, dunning, project billing settings, provider webhook idempotency.
// Boundary: 08 bills and collects; 09 owns the ledger. Every invoice/payment here produces an income
// record in 09. Quotes are Proposals (03). PDFs are Documents (17). Emails go through 11.
// =====================================================================

/// 08 "Products & Services"
enum ProductType {
  SERVICE
  PACKAGE
  DEVELOPMENT_HOURS
  MAINTENANCE_PLAN
  SUPPORT_PLAN
  SUBSCRIPTION
  LICENSE
  OTHER
}

/// 08 — one-time vs recurring price.
enum PriceType {
  ONE_TIME
  RECURRING
}

/// 08 "Subscription Management" / "Recurring Billing"
enum BillingInterval {
  DAY
  WEEK
  MONTH
  QUARTER
  YEAR
}

/// 08 "Taxes & Discounts"
enum TaxBehavior {
  INCLUSIVE
  EXCLUSIVE
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum CouponDuration {
  ONCE
  REPEATING
  FOREVER
}

/// 08 "Invoicing" — invoice statuses.
enum InvoiceStatus {
  DRAFT
  SCHEDULED
  OPEN
  PENDING
  PAID
  PARTIALLY_PAID
  OVERDUE
  REFUNDED
  CANCELLED
  VOID
}

/// 08 "Project Billing"
enum BillingModel {
  FIXED_PRICE
  MILESTONE
  TIME_AND_MATERIALS
  RETAINER
  RECURRING
  MAINTENANCE
}

/// 08 "Payment Providers" — online providers have an adapter and a PaymentProviderConnection; MANUAL and BANK are
/// recorded by hand and never have a connection. Adding a provider = a new value here + an adapter (08 spec).
enum PaymentProvider {
  STRIPE
  VIVA_WALLET
  MANUAL
  BANK
}

/// 08 "Payment Providers"
enum PaymentProviderConnectionStatus {
  PENDING
  ACTIVE
  ERROR
  DISCONNECTED
}

/// 08 "Payment Providers" — platform record types mirrored at a provider (PaymentProviderObject.object_type).
enum ProviderObjectType {
  CUSTOMER
  PRODUCT
  PRICE
  TAX_RATE
  COUPON
}

enum PaymentMethodType {
  CARD
  BANK_TRANSFER
  SEPA_DEBIT
  CASH
  CHECK
  WALLET
  OTHER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum CreditNoteStatus {
  DRAFT
  ISSUED
  APPLIED
  VOID
}

/// 08 "Subscription Management"
enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED
}

enum CollectionMethod {
  CHARGE_AUTOMATICALLY
  SEND_INVOICE
}

/// 08 "Recurring Billing" — dunning step actions.
enum DunningAction {
  REMINDER
  RETRY_PAYMENT
  NOTIFY_OWNER
  PAUSE_SUBSCRIPTION
  CANCEL_SUBSCRIPTION
  MARK_UNCOLLECTIBLE
}

// --- Customer billing --------------------------------------------------------------

/// 08 "Customer Billing" — billing profile of a Customer (CRM Company, 02). The customer record at each connected
/// provider is a PaymentProviderObject (object_type CUSTOMER, local_id = this id).
model BillingProfile {
  id                               String              @id @default(uuid())
  organization_id                  String
  company_id                       String
  legal_name                       String
  billing_email                    String?
  /// CRM contact ids with the BILLING role (02 §3).
  billing_contact_ids              String[]            @default([])
  billing_address                  Json?
  shipping_address                 Json?
  tax_id                           String?
  vat_number                       String?
  tax_exempt                       Boolean             @default(false)
  /// 08 "Taxes & Discounts" — outcome of the last VIES check of vat_number.
  vat_validation_status            VatValidationStatus @default(UNKNOWN)
  vat_validated_at                 DateTime?
  /// EU B2B reverse charge applies to this customer (valid VAT id in another country): invoices use the reverse-charge tax rate.
  reverse_charge                   Boolean             @default(false)
  currency                         String
  /// Net payment terms in days (e.g. 14, 30).
  payment_terms_days               Int                 @default(14)
  /// 08 "Recurring Billing" — dunning policy applied to this customer's invoices; null = organization default policy.
  dunning_policy_id                String?
  default_payment_method_id        String?             @unique
  /// 08 "Payment Providers" — connection used for this customer's invoices and subscriptions; null = organization routing.
  preferred_provider_connection_id String?
  /// Customer-specific pricing: { product_id: unit_amount } or coupon reference (08 "Taxes & Discounts").
  custom_pricing                   Json?
  notes                            String?
  created_at                       DateTime            @default(now())
  updated_at                       DateTime            @updatedAt

  organization                  Organization               @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  company                       CrmCompany                 @relation(fields: [company_id], references: [id], onDelete: Cascade)
  default_payment_method        PaymentMethod?             @relation("BillingProfileDefaultMethod", fields: [default_payment_method_id], references: [id], onDelete: SetNull)
  payment_methods               PaymentMethod[]
  invoices                      Invoice[]
  payments                      Payment[]
  subscriptions                 Subscription[]
  credit_notes                  CreditNote[]
  payment_links                 PaymentLink[]
  dunning_policy                DunningPolicy?             @relation(fields: [dunning_policy_id], references: [id], onDelete: SetNull)
  preferred_provider_connection PaymentProviderConnection? @relation("BillingProfilePreferredProvider", fields: [preferred_provider_connection_id], references: [id], onDelete: SetNull)

  @@unique([organization_id, company_id])
  @@map("billing_profiles")
}

/// 08 "Customer Billing" — stored payment methods; card data never stored, only provider tokens.
/// A saved method belongs to one provider connection and can only be charged through it.
model PaymentMethod {
  id                     String            @id @default(uuid())
  billing_profile_id     String
  type                   PaymentMethodType
  provider               PaymentProvider
  /// 08 "Payment Providers" — connection that holds the token; null for MANUAL / BANK methods.
  provider_connection_id String?
  /// Provider token: Stripe payment method, Viva Wallet card token …
  provider_method_id     String?
  brand                  String?
  last4                  String?
  exp_month              Int?
  exp_year               Int?
  /// Bank details for transfers (IBAN masked, bank name) when provider is BANK.
  /// Encrypted at the application layer (envelope encryption with the organization VaultKey, 17 §12); never returned in list endpoints.
  bank_details           Json?
  is_default             Boolean           @default(false)
  disabled_at            DateTime?
  created_at             DateTime          @default(now())

  billing_profile     BillingProfile             @relation(fields: [billing_profile_id], references: [id], onDelete: Cascade)
  provider_connection PaymentProviderConnection? @relation(fields: [provider_connection_id], references: [id], onDelete: SetNull)
  default_for         BillingProfile?            @relation("BillingProfileDefaultMethod")
  payments            Payment[]

  @@unique([provider_connection_id, provider_method_id])
  @@index([billing_profile_id])
  @@map("payment_methods")
}

// --- Catalog --------------------------------------------------------------------------

/// 08 "Products & Services" — the platform catalog used by 02 deal line items, 03 proposals and 18 rates.
model Product {
  id                  String      @id @default(uuid())
  organization_id     String
  name                String
  slug                String
  type                ProductType @default(SERVICE)
  description         String?
  /// Unit label (hour, month, project, seat).
  unit                String?
  default_tax_rate_id String?
  is_active           Boolean     @default(true)
  archived_at         DateTime?
  created_at          DateTime    @default(now())
  updated_at          DateTime    @updatedAt

  organization        Organization       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  default_tax_rate    TaxRate?           @relation(fields: [default_tax_rate_id], references: [id], onDelete: SetNull)
  prices              Price[]
  invoice_line_items  InvoiceLineItem[]
  subscription_items  SubscriptionItem[]
  deal_line_items     CrmDealLineItem[]
  proposal_line_items ProposalLineItem[]
  billing_rates       BillingRate[]

  @@unique([organization_id, slug])
  @@index([organization_id, is_active])
  @@map("products")
}

/// 08 — a price of a product: one-time or recurring, per currency.
model Price {
  id             String           @id @default(uuid())
  product_id     String
  name           String?
  currency       String
  unit_amount    Decimal          @db.Decimal(18, 2)
  type           PriceType        @default(ONE_TIME)
  interval       BillingInterval?
  interval_count Int?
  trial_days     Int?
  /// Setup fee charged on first subscription invoice.
  setup_fee      Decimal?         @db.Decimal(18, 2)
  is_active      Boolean          @default(true)
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt

  product            Product            @relation(fields: [product_id], references: [id], onDelete: Cascade)
  invoice_line_items InvoiceLineItem[]
  subscription_items SubscriptionItem[]
  payment_links      PaymentLink[]

  @@index([product_id, is_active])
  @@map("prices")
}

/// 08 "Taxes & Discounts" — tax rates incl. VAT and regional rules.
model TaxRate {
  id                String      @id @default(uuid())
  organization_id   String
  name              String
  percentage        Decimal     @db.Decimal(5, 2)
  country           String?
  region            String?
  behavior          TaxBehavior @default(EXCLUSIVE)
  is_default        Boolean     @default(false)
  is_active         Boolean     @default(true)
  /// 08 "Taxes & Discounts" — 0% rate used for reverse charge (EU B2B with a valid VAT id).
  is_reverse_charge Boolean     @default(false)
  /// standard | reduced | zero | exempt | reverse_charge …; free text for reports.
  tax_category      String?
  /// Legal text printed on invoices using this rate ("Reverse charge", "VAT exempt under article …").
  invoice_note      String?
  created_at        DateTime    @default(now())

  organization                    Organization            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  products                        Product[]
  line_items                      InvoiceLineItem[]
  ledger_settings_income_default  LedgerSettings[]        @relation("LedgerSettingsDefaultIncomeTaxRate")
  ledger_settings_expense_default LedgerSettings[]        @relation("LedgerSettingsDefaultExpenseTaxRate")
  ledger_categories               LedgerCategory[]
  ledger_supplier_profiles        LedgerSupplierProfile[]
  ledger_records                  LedgerRecord[]
  recurring_expenses              RecurringExpense[]

  @@index([organization_id, is_active])
  @@map("tax_rates")
}

/// 08 "Taxes & Discounts" — percentage or fixed discounts, reusable as coupons.
model Coupon {
  id              String         @id @default(uuid())
  organization_id String
  name            String
  code            String?
  type            DiscountType
  value           Decimal        @db.Decimal(18, 2)
  currency        String?
  duration        CouponDuration @default(ONCE)
  duration_months Int?
  max_redemptions Int?
  redemptions     Int            @default(0)
  valid_from      DateTime?
  valid_until     DateTime?
  is_active       Boolean        @default(true)
  created_at      DateTime       @default(now())

  organization  Organization   @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  invoices      Invoice[]
  subscriptions Subscription[]

  @@unique([organization_id, code])
  @@map("coupons")
}

// --- Invoicing ----------------------------------------------------------------------

/// 08 "Invoicing" — invoice templates: layout, branding and default texts. Organization branding (01 §15) is the fallback.
model InvoiceTemplate {
  id                   String    @id @default(uuid())
  organization_id      String
  name                 String
  is_default           Boolean   @default(false)
  /// Layout key or structure (sections, column visibility, colors).
  layout               Json?
  /// Branding overrides: logo_url, primary_color, font.
  branding             Json?
  locale               String?
  default_notes        String?
  default_footer       String?
  payment_instructions String?
  /// Default payment terms in days applied to invoices created with this template.
  payment_terms_days   Int?
  archived_at          DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  invoices     Invoice[]

  @@unique([organization_id, name])
  @@map("invoice_templates")
}

/// 08 "Invoicing" — the invoice. Numbering via NumberSequence (INV-2026-0001).
model Invoice {
  id                                String              @id @default(uuid())
  organization_id                   String
  branch_id                         String?
  number                            String
  status                            InvoiceStatus       @default(DRAFT)
  billing_profile_id                String
  company_id                        String
  /// Origins (ids with relations where the module exists).
  project_id                        String?
  proposal_id                       String?
  /// 08 "Proposals & Quotations" — accepted proposal version (03) this invoice was generated from; permanent link.
  proposal_version_id               String?
  /// 08 "Proposals & Quotations" — the accepted proposal's payment schedule item (03: deposit, milestone, instalment) this invoice realises; permanent link.
  proposal_payment_schedule_item_id String?
  contract_id                       String?
  subscription_id                   String?
  /// Revision lineage (08 "Invoice revisions").
  revises_invoice_id                String?             @unique
  billing_model                     BillingModel?
  currency                          String
  issue_date                        DateTime?           @db.Date
  due_date                          DateTime?           @db.Date
  /// For recurring/period invoices.
  period_start                      DateTime?           @db.Date
  period_end                        DateTime?           @db.Date
  subtotal                          Decimal             @default(0) @db.Decimal(18, 2)
  discount_total                    Decimal             @default(0) @db.Decimal(18, 2)
  tax_total                         Decimal             @default(0) @db.Decimal(18, 2)
  total                             Decimal             @default(0) @db.Decimal(18, 2)
  amount_paid                       Decimal             @default(0) @db.Decimal(18, 2)
  amount_due                        Decimal             @default(0) @db.Decimal(18, 2)
  coupon_id                         String?
  collection_method                 CollectionMethod    @default(SEND_INVOICE)
  /// Accepted payment method types for this invoice.
  accepted_methods                  PaymentMethodType[] @default([CARD, BANK_TRANSFER])
  notes                             String?
  payment_instructions              String?
  footer                            String?
  /// Template / branding override; organization branding (01 §15) is the fallback.
  template_id                       String?
  /// Generated PDF (17); id only.
  pdf_document_id                   String?
  /// 08 "Payment Providers" — connection that collects this invoice; null = paid outside a provider (bank transfer, cash).
  /// Fixed when the invoice is finalized or when the customer starts an online payment (08 routing rules).
  provider_connection_id            String?
  /// Invoice object at the provider when it has one (e.g. Stripe invoice); null when the platform issues the invoice itself.
  provider_invoice_id               String?
  /// Payment page for the customer: the provider's hosted page or the portal (07) pay link.
  hosted_invoice_url                String?
  is_recurring                      Boolean             @default(false)
  scheduled_send_at                 DateTime?
  sent_at                           DateTime?
  /// 08 "Invoicing" — the e-mail (11) that delivered the invoice; id of the CommMessage.
  sent_communication_id             String?
  /// First time the customer opened the hosted invoice page / portal view.
  viewed_at                         DateTime?
  paid_at                           DateTime?
  voided_at                         DateTime?
  cancelled_at                      DateTime?
  /// 08 "Invoicing" / "Recurring Billing" — MARK_UNCOLLECTIBLE: the unpaid rest is written off; status stays OVERDUE for reporting.
  uncollectible_at                  DateTime?
  uncollectible_reason              String?
  written_off_amount                Decimal             @default(0) @db.Decimal(18, 2)
  last_reminder_at                  DateTime?
  reminder_count                    Int                 @default(0)
  /// 08 "Invoicing" — explicit invoice approval (01 §95); must differ from created_by_user_id (separation of duties, 01 §96). Null = not approved / not required.
  approved_by_user_id               String?
  approved_at                       DateTime?
  created_by_user_id                String?
  created_at                        DateTime            @default(now())
  updated_at                        DateTime            @updatedAt

  organization        Organization               @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  provider_connection PaymentProviderConnection? @relation(fields: [provider_connection_id], references: [id], onDelete: SetNull)
  branch              Branch?                    @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  billing_profile     BillingProfile             @relation(fields: [billing_profile_id], references: [id], onDelete: Restrict)
  company             CrmCompany                 @relation(fields: [company_id], references: [id], onDelete: Restrict)
  project             Project?                   @relation(fields: [project_id], references: [id], onDelete: SetNull)
  contract            Contract?                  @relation(fields: [contract_id], references: [id], onDelete: SetNull)
  subscription        Subscription?              @relation(fields: [subscription_id], references: [id], onDelete: SetNull)
  coupon              Coupon?                    @relation(fields: [coupon_id], references: [id], onDelete: SetNull)
  template            InvoiceTemplate?           @relation(fields: [template_id], references: [id], onDelete: SetNull)
  revises             Invoice?                   @relation("InvoiceRevision", fields: [revises_invoice_id], references: [id], onDelete: SetNull)
  revised_by          Invoice?                   @relation("InvoiceRevision")
  sent_communication  CommMessage?               @relation("InvoiceSentCommunication", fields: [sent_communication_id], references: [id], onDelete: SetNull)

  line_items                     InvoiceLineItem[]
  allocations                    PaymentAllocation[]
  credit_notes                   CreditNote[]
  reminders                      InvoiceReminder[]
  payment_links                  PaymentLink[]
  proposals                      Proposal[]                   @relation("ProposalInvoice")
  ledger_record                  LedgerRecord?
  pdf_document                   Document?                    @relation("InvoicePdf", fields: [pdf_document_id], references: [id], onDelete: SetNull)
  time_entries                   TimeEntry[]
  proposal_payment_schedule_item ProposalPaymentScheduleItem? @relation(fields: [proposal_payment_schedule_item_id], references: [id], onDelete: SetNull)

  @@unique([provider_connection_id, provider_invoice_id])
  @@unique([organization_id, number])
  @@index([organization_id, status])
  @@index([company_id, status])
  @@index([due_date])
  @@index([project_id])
  @@index([proposal_payment_schedule_item_id])
  @@map("invoices")
}

/// 08 "Invoicing" — line items; milestone and time entries link project billing (05 §20, 18 §7).
model InvoiceLineItem {
  id                String    @id @default(uuid())
  invoice_id        String
  product_id        String?
  price_id          String?
  description       String
  quantity          Decimal   @default(1) @db.Decimal(12, 3)
  unit              String?
  unit_amount       Decimal   @default(0) @db.Decimal(18, 2)
  discount_amount   Decimal   @default(0) @db.Decimal(18, 2)
  tax_rate_id       String?
  tax_percent       Decimal?  @db.Decimal(5, 2)
  net_amount        Decimal   @default(0) @db.Decimal(18, 2)
  tax_amount        Decimal   @default(0) @db.Decimal(18, 2)
  gross_amount      Decimal   @default(0) @db.Decimal(18, 2)
  milestone_id      String?
  /// 08 "Project Billing" — write-off (negative) or write-up (positive) applied at invoicing time on top of billable time.
  adjustment_amount Decimal   @default(0) @db.Decimal(18, 2)
  adjustment_reason String?
  period_start      DateTime? @db.Date
  period_end        DateTime? @db.Date
  sort_order        Int       @default(0)

  invoice                Invoice               @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  product                Product?              @relation(fields: [product_id], references: [id], onDelete: SetNull)
  price                  Price?                @relation(fields: [price_id], references: [id], onDelete: SetNull)
  tax_rate               TaxRate?              @relation(fields: [tax_rate_id], references: [id], onDelete: SetNull)
  milestone              ProjectMilestone?     @relation(fields: [milestone_id], references: [id], onDelete: SetNull)
  time_entries           TimeEntry[]
  time_entry_adjustments TimeEntryAdjustment[]

  @@index([invoice_id, sort_order])
  @@map("invoice_line_items")
}

/// 08 "Automation" — reminder / dunning actions sent for an invoice. Delivery is 11/14.
model InvoiceReminder {
  id                   String        @id @default(uuid())
  invoice_id           String
  action               DunningAction @default(REMINDER)
  /// 08 "Automation" — 20 AutomationRun / ScheduledJobRun that produced this reminder (null = sent manually); ids only.
  automation_run_id    String?
  scheduled_job_run_id String?
  /// Days relative to due date (negative = before).
  offset_days          Int?
  communication_id     String?
  sent_at              DateTime      @default(now())

  invoice       Invoice      @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  communication CommMessage? @relation(fields: [communication_id], references: [id], onDelete: SetNull)

  @@index([invoice_id, sent_at])
  @@map("invoice_reminders")
}

// --- Payments -------------------------------------------------------------------------

/// 08 "Payments" — a payment received (online or manually recorded). Allocations split it across invoices.
model Payment {
  id                     String            @id @default(uuid())
  organization_id        String
  billing_profile_id     String?
  payment_method_id      String?
  provider               PaymentProvider
  /// 08 "Payment Providers" — connection that processed the payment; null for MANUAL / BANK.
  provider_connection_id String?
  /// Provider transaction id (Stripe payment intent, Viva Wallet transaction id …).
  provider_payment_id    String?
  /// Hosted checkout that started the payment (Stripe Checkout session, Viva Wallet order code).
  provider_checkout_id   String?
  method_type            PaymentMethodType @default(CARD)
  status                 PaymentStatus     @default(PENDING)
  currency               String
  amount                 Decimal           @db.Decimal(18, 2)
  fee_amount             Decimal           @default(0) @db.Decimal(18, 2)
  /// 08 "Payments" — tax / VAT portion of the amount, for the ledger (09 VAT management).
  tax_amount             Decimal           @default(0) @db.Decimal(18, 2)
  net_amount             Decimal?          @db.Decimal(18, 2)
  refunded_amount        Decimal           @default(0) @db.Decimal(18, 2)
  /// deposit | milestone | invoice | subscription | one_time
  kind                   String?
  reference              String?
  failure_code           String?
  failure_message        String?
  /// Receipt document (17); id only.
  receipt_document_id    String?
  received_at            DateTime?
  recorded_by_user_id    String?
  metadata               Json?
  /// 08 "Payment Providers" — payment link this payment was made through; null = not paid via a link.
  payment_link_id        String?
  created_at             DateTime          @default(now())
  updated_at             DateTime          @updatedAt

  organization         Organization               @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  billing_profile      BillingProfile?            @relation(fields: [billing_profile_id], references: [id], onDelete: SetNull)
  payment_method       PaymentMethod?             @relation(fields: [payment_method_id], references: [id], onDelete: SetNull)
  provider_connection  PaymentProviderConnection? @relation(fields: [provider_connection_id], references: [id], onDelete: SetNull)
  payment_link         PaymentLink?               @relation(fields: [payment_link_id], references: [id], onDelete: SetNull)
  allocations          PaymentAllocation[]
  refunds              Refund[]
  disputes             PaymentDispute[]
  origin_ledger_record LedgerRecord?              @relation("LedgerRecordOriginPayment")
  ledger_settlements   LedgerSettlement[]
  receipt_document     Document?                  @relation("PaymentReceipt", fields: [receipt_document_id], references: [id], onDelete: SetNull)

  @@unique([provider_connection_id, provider_payment_id])
  @@index([provider_connection_id, provider_checkout_id])
  @@index([organization_id, status])
  @@index([billing_profile_id])
  @@index([received_at])
  @@map("payments")
}

/// Partial and multi-invoice payments (08 "Partial payments").
model PaymentAllocation {
  id         String   @id @default(uuid())
  payment_id String
  invoice_id String
  amount     Decimal  @db.Decimal(18, 2)
  created_at DateTime @default(now())

  payment Payment @relation(fields: [payment_id], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@unique([payment_id, invoice_id])
  @@index([invoice_id])
  @@map("payment_allocations")
}

/// 08 "Payments" — refunds against a payment.
model Refund {
  id                   String       @id @default(uuid())
  payment_id           String
  provider_refund_id   String?
  status               RefundStatus @default(PENDING)
  amount               Decimal      @db.Decimal(18, 2)
  reason               String?
  requested_by_user_id String?
  processed_at         DateTime?
  created_at           DateTime     @default(now())

  payment            Payment            @relation(fields: [payment_id], references: [id], onDelete: Cascade)
  ledger_settlements LedgerSettlement[]

  @@unique([payment_id, provider_refund_id])
  @@index([payment_id])
  @@map("refunds")
}

/// 08 "Invoicing" — credit notes issued against an invoice. Numbered via NumberSequence.
model CreditNote {
  id                      String           @id @default(uuid())
  organization_id         String
  billing_profile_id      String
  invoice_id              String?
  number                  String
  status                  CreditNoteStatus @default(DRAFT)
  currency                String
  subtotal                Decimal          @default(0) @db.Decimal(18, 2)
  tax_total               Decimal          @default(0) @db.Decimal(18, 2)
  total                   Decimal          @default(0) @db.Decimal(18, 2)
  reason                  String?
  /// Line items mirrored from the invoice: [{ description, quantity, unit_amount, tax_percent, amount }].
  lines                   Json?
  pdf_document_id         String?
  provider_connection_id  String?
  provider_credit_note_id String?
  issued_at               DateTime?
  applied_at              DateTime?
  voided_at               DateTime?
  created_by_user_id      String?
  created_at              DateTime         @default(now())

  organization        Organization               @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  provider_connection PaymentProviderConnection? @relation(fields: [provider_connection_id], references: [id], onDelete: SetNull)
  billing_profile     BillingProfile             @relation(fields: [billing_profile_id], references: [id], onDelete: Restrict)
  invoice             Invoice?                   @relation(fields: [invoice_id], references: [id], onDelete: SetNull)
  pdf_document        Document?                  @relation("CreditNotePdf", fields: [pdf_document_id], references: [id], onDelete: SetNull)

  @@unique([provider_connection_id, provider_credit_note_id])
  @@unique([organization_id, number])
  @@index([invoice_id])
  @@map("credit_notes")
}

// --- Subscriptions ------------------------------------------------------------------------

/// 08 "Subscription Management" — multiple active subscriptions per customer.
model Subscription {
  id                       String             @id @default(uuid())
  organization_id          String
  billing_profile_id       String
  company_id               String
  project_id               String?
  contract_id              String?
  /// 08 "Proposals & Quotations" — accepted proposal version (03) that created this subscription; permanent link.
  proposal_version_id      String?
  status                   SubscriptionStatus @default(INCOMPLETE)
  currency                 String
  interval                 BillingInterval    @default(MONTH)
  interval_count           Int                @default(1)
  collection_method        CollectionMethod   @default(CHARGE_AUTOMATICALLY)
  coupon_id                String?
  trial_start              DateTime?
  trial_end                DateTime?
  current_period_start     DateTime?
  current_period_end       DateTime?
  started_at               DateTime?
  /// Scheduled cancellation at period end (08 "Scheduled cancellations").
  cancel_at                DateTime?
  cancel_at_period_end     Boolean            @default(false)
  cancelled_at             DateTime?
  cancellation_reason      String?
  paused_at                DateTime?
  resume_at                DateTime?
  ended_at                 DateTime?
  /// 08 "Payment Providers" — connection that charges this subscription.
  provider_connection_id   String?
  /// Subscription object at the provider (Stripe). Null when the platform runs the schedule itself
  /// (providers without native subscriptions, e.g. Viva Wallet recurring card tokens): 20 creates each invoice and
  /// charges the saved PaymentMethod.
  provider_subscription_id String?
  /// 08 "Subscription Management" — one-time setup fee charged on the first invoice; overrides Price.setup_fee for custom (proposal-derived) items.
  setup_fee                Decimal?           @db.Decimal(18, 2)
  setup_fee_invoiced_at    DateTime?
  /// Snapshot of recurring total per period.
  period_amount            Decimal            @default(0) @db.Decimal(18, 2)
  metadata                 Json?
  created_by_user_id       String?
  created_at               DateTime           @default(now())
  updated_at               DateTime           @updatedAt

  organization        Organization               @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  provider_connection PaymentProviderConnection? @relation(fields: [provider_connection_id], references: [id], onDelete: SetNull)
  billing_profile     BillingProfile             @relation(fields: [billing_profile_id], references: [id], onDelete: Restrict)
  company             CrmCompany                 @relation(fields: [company_id], references: [id], onDelete: Restrict)
  project             Project?                   @relation(fields: [project_id], references: [id], onDelete: SetNull)
  contract            Contract?                  @relation(fields: [contract_id], references: [id], onDelete: SetNull)
  coupon              Coupon?                    @relation(fields: [coupon_id], references: [id], onDelete: SetNull)
  items               SubscriptionItem[]
  invoices            Invoice[]
  proposals           Proposal[]                 @relation("ProposalSubscription")
  ledger_records      LedgerRecord[]

  @@unique([provider_connection_id, provider_subscription_id])
  @@index([organization_id, status])
  @@index([company_id, status])
  @@index([current_period_end])
  @@map("subscriptions")
}

/// 08 — plan lines of a subscription (upgrades/downgrades change items, history in audit_events).
model SubscriptionItem {
  id               String   @id @default(uuid())
  subscription_id  String
  product_id       String?
  price_id         String?
  description      String?
  quantity         Decimal  @default(1) @db.Decimal(12, 3)
  unit_amount      Decimal  @db.Decimal(18, 2)
  provider_item_id String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  subscription Subscription @relation(fields: [subscription_id], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [product_id], references: [id], onDelete: SetNull)
  price        Price?       @relation(fields: [price_id], references: [id], onDelete: SetNull)

  @@unique([subscription_id, provider_item_id])
  @@index([subscription_id])
  @@map("subscription_items")
}

/// 08 "Recurring Billing" — dunning policy; steps are scheduled by the Automation Engine (20).
model DunningPolicy {
  id                  String   @id @default(uuid())
  organization_id     String
  name                String
  is_default          Boolean  @default(false)
  /// [{ offset_days, action: DunningAction, template_key? }], offset relative to due date.
  steps               Json
  max_payment_retries Int      @default(3)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  organization     Organization     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  billing_profiles BillingProfile[]

  @@unique([organization_id, name])
  @@map("dunning_policies")
}

/// 08 "Project Billing" — how a project is billed (05 §63 consumes the result).
model ProjectBillingSettings {
  project_id              String           @id
  billing_model           BillingModel     @default(FIXED_PRICE)
  currency                String?
  /// Fixed price / retainer amount per period.
  fixed_amount            Decimal?         @db.Decimal(18, 2)
  retainer_interval       BillingInterval?
  /// Default hourly rate for time and materials; overrides catalog/employee rates.
  hourly_rate             Decimal?         @db.Decimal(18, 2)
  /// Default product used for T&M lines.
  default_product_id      String?
  /// Create an invoice automatically when a billing milestone completes (05 §20).
  auto_invoice_milestones Boolean          @default(false)
  /// Automatically bill approved billable time at period end.
  auto_invoice_time       Boolean          @default(false)
  billing_interval        BillingInterval?
  billing_day             Int?
  /// Budget alert threshold (percent of budget_amount in 05).
  budget_alert_percent    Int?
  updated_at              DateTime         @updatedAt

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@map("project_billing_settings")
}

/// 08 "Payment Providers" — one connected payment provider account of an organization. An organization can connect
/// several providers (Stripe, Viva Wallet) and several accounts of the same provider (per country, per
/// branch, test and live). Resolves incoming provider webhooks (ProviderWebhookEvent) to an organization and holds the
/// per-tenant provider identity; secrets live behind credentials_ref (envelope encryption, 17 §12), never in plain text.
model PaymentProviderConnection {
  id                        String                          @id @default(uuid())
  organization_id           String
  provider                  PaymentProvider
  /// Label shown to admins and, when several are offered, to customers at checkout ("Stripe EU", "Viva Wallet GR").
  display_name              String
  status                    PaymentProviderConnectionStatus @default(PENDING)
  /// Provider-side account identifier (Stripe acct_…, Viva Wallet merchant id).
  provider_account_id       String?
  /// live | test
  mode                      String                          @default("live")
  /// 01 §157 — the organization's own credentials for this provider account (API keys, webhook signing secret). Secrets never live on this row.
  integration_connection_id String?
  /// Non-secret provider options (statement descriptor, automatic tax, Viva Wallet source code, checkout branding).
  config                    Json?
  /// What the adapter supports for this account, refreshed on connect and on health checks:
  /// { recurring, saved_methods, refunds, partial_refunds, provider_invoices, provider_subscriptions, payouts }.
  capabilities              Json?
  /// Routing (08 "Payment Providers"): currencies and method types this connection collects; empty = everything the
  /// provider supports. Lower priority wins among matching connections; is_default breaks the remaining tie.
  currencies                String[]                        @default([])
  method_types              PaymentMethodType[]             @default([])
  priority                  Int                             @default(100)
  /// At most one default per organization and mode (enforced by the service).
  is_default                Boolean                         @default(false)
  /// 01 §34 — limit the connection to one branch; null = whole organization.
  branch_id                 String?
  /// 09 — ledger payment method that payouts and fees of this connection are booked against.
  ledger_payment_method_id  String?
  connected_by_user_id      String?
  connected_at              DateTime?
  disconnected_at           DateTime?
  last_checked_at           DateTime?
  last_error                String?
  created_at                DateTime                        @default(now())
  updated_at                DateTime                        @updatedAt

  organization           Organization            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  integration_connection IntegrationConnection?  @relation(fields: [integration_connection_id], references: [id], onDelete: SetNull)
  branch                 Branch?                 @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  ledger_payment_method  LedgerPaymentMethod?    @relation(fields: [ledger_payment_method_id], references: [id], onDelete: SetNull)
  provider_objects       PaymentProviderObject[]
  payment_methods        PaymentMethod[]
  payments               Payment[]
  invoices               Invoice[]
  credit_notes           CreditNote[]
  subscriptions          Subscription[]
  preferred_by_profiles  BillingProfile[]        @relation("BillingProfilePreferredProvider")
  webhook_events         ProviderWebhookEvent[]
  payment_links          PaymentLink[]
  payment_disputes       PaymentDispute[]
  payment_payouts        PaymentPayout[]

  @@unique([provider, provider_account_id, mode])
  @@index([organization_id, provider])
  @@index([organization_id, status])
  @@index([integration_connection_id])
  @@map("payment_provider_connections")
}

/// 08 "Payment Providers" — the copy of a platform billing record at one provider connection (customer, product,
/// price, tax rate, coupon). One row per record and connection, so the same product or customer can be synced to
/// Stripe and Viva Wallet at once. local_id is the id of the BillingProfile / Product / Price / TaxRate / Coupon
/// named by object_type.
model PaymentProviderObject {
  id                     String             @id @default(uuid())
  organization_id        String
  provider_connection_id String
  object_type            ProviderObjectType
  local_id               String
  provider_object_id     String
  last_synced_at         DateTime?
  last_error             String?
  metadata               Json?
  created_at             DateTime           @default(now())
  updated_at             DateTime           @updatedAt

  organization        Organization              @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  provider_connection PaymentProviderConnection @relation(fields: [provider_connection_id], references: [id], onDelete: Cascade)

  @@unique([provider_connection_id, object_type, local_id], map: "payment_provider_objects_connection_local_key")
  @@unique([provider_connection_id, object_type, provider_object_id], map: "payment_provider_objects_connection_remote_key")
  @@index([organization_id, object_type, local_id])
  @@map("payment_provider_objects")
}

/// Idempotent processing of provider webhooks (payment providers, email/SMS providers; signature providers also use SignatureEvent).
model ProviderWebhookEvent {
  id                     String    @id @default(uuid())
  organization_id        String?
  /// 08 "Payment Providers" — payment connection the webhook was verified against; null for non-payment providers.
  provider_connection_id String?
  provider               String
  provider_event_id      String
  event_type             String
  payload                Json
  received_at            DateTime  @default(now())
  processed_at           DateTime?
  error                  String?

  organization         Organization?              @relation(fields: [organization_id], references: [id], onDelete: SetNull)
  provider_connection  PaymentProviderConnection? @relation(fields: [provider_connection_id], references: [id], onDelete: SetNull)
  comm_delivery_events CommDeliveryEvent[]

  @@unique([provider, provider_event_id])
  @@index([provider, processed_at])
  @@map("provider_webhook_events")
}

// --- Payment links, disputes, payouts, approvals and report schedules (08) ----------------------

/// 08 "Payment Providers" — payment link lifecycle.
enum PaymentLinkStatus {
  ACTIVE
  EXPIRED
  DISABLED
  COMPLETED
}

/// 08 "Payment Providers" — dispute (chargeback) lifecycle mirrored from the provider (events dispute.opened / dispute.closed).
enum PaymentDisputeStatus {
  OPEN
  UNDER_REVIEW
  WON
  LOST
  CLOSED
}

/// 08 "Payment Providers" — payout lifecycle mirrored from the provider (event payout.paid).
enum PaymentPayoutStatus {
  PENDING
  IN_TRANSIT
  PAID
  FAILED
  CANCELLED
}

/// 08 "Taxes & Discounts" — outcome of the VAT number check (VIES).
enum VatValidationStatus {
  VALID
  INVALID
  UNKNOWN
}

/// 08 "Invoicing", "Payments" and 09 "Audit Trail" — what a finance approval decides.
enum FinanceApprovalEntityType {
  INVOICE
  REFUND
  CREDIT_NOTE
  WRITE_OFF
  LEDGER_RECORD
  EXPENSE_CLAIM
}

enum FinanceApprovalDecision {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// 08 "Financial Reporting" — export format of a stored report schedule.
enum FinanceReportFormat {
  PDF
  XLSX
  CSV
}

/// Platform numbering (NumberSequence) — when the counter restarts at 1.
enum NumberResetPolicy {
  NEVER
  YEARLY
}

/// 08 "Payment Providers" — a shareable, reusable hosted checkout: for one invoice, a price from the catalog or a
/// free / custom amount. The provider-side object (Stripe Payment Link, Viva Wallet order) is provider_link_id;
/// `url` is the public link the customer opens, `public_token` its slug. Payments made through it carry payment_link_id.
model PaymentLink {
  id                     String              @id @default(uuid())
  organization_id        String
  billing_profile_id     String?
  invoice_id             String?
  price_id               String?
  /// Connection that collects through this link; null = routing (08 "Payment Providers") picks one when the customer pays.
  provider_connection_id String?
  provider_link_id       String?
  public_token           String              @unique
  title                  String
  description            String?
  /// Fixed amount; null when allow_custom_amount is on or the amount comes from the price / invoice.
  amount                 Decimal?            @db.Decimal(18, 2)
  currency               String
  allow_custom_amount    Boolean             @default(false)
  url                    String
  status                 PaymentLinkStatus   @default(ACTIVE)
  accepted_methods       PaymentMethodType[] @default([CARD, BANK_TRANSFER])
  expires_at             DateTime?
  max_uses               Int?
  uses                   Int                 @default(0)
  completed_at           DateTime?
  created_by_user_id     String?
  created_at             DateTime            @default(now())
  updated_at             DateTime            @updatedAt

  organization        Organization               @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  billing_profile     BillingProfile?            @relation(fields: [billing_profile_id], references: [id], onDelete: SetNull)
  invoice             Invoice?                   @relation(fields: [invoice_id], references: [id], onDelete: SetNull)
  price               Price?                     @relation(fields: [price_id], references: [id], onDelete: SetNull)
  provider_connection PaymentProviderConnection? @relation(fields: [provider_connection_id], references: [id], onDelete: SetNull)
  payments            Payment[]

  @@unique([provider_connection_id, provider_link_id])
  @@index([organization_id, status])
  @@index([invoice_id])
  @@map("payment_links")
}

/// 08 "Payment Providers" — a dispute / chargeback opened at a provider against a payment. Created by the
/// dispute.opened webhook event, closed by dispute.closed; evidence is submitted through the adapter.
model PaymentDispute {
  id                     String               @id @default(uuid())
  organization_id        String
  provider_connection_id String
  payment_id             String?
  provider_dispute_id    String
  status                 PaymentDisputeStatus @default(OPEN)
  amount                 Decimal              @db.Decimal(18, 2)
  currency               String
  reason                 String?
  evidence_due_at        DateTime?
  evidence_submitted_at  DateTime?
  opened_at              DateTime             @default(now())
  closed_at              DateTime?
  outcome_note           String?
  metadata               Json?
  created_at             DateTime             @default(now())
  updated_at             DateTime             @updatedAt

  organization        Organization              @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  provider_connection PaymentProviderConnection @relation(fields: [provider_connection_id], references: [id], onDelete: Cascade)
  payment             Payment?                  @relation(fields: [payment_id], references: [id], onDelete: SetNull)

  @@unique([provider_connection_id, provider_dispute_id])
  @@index([organization_id, status])
  @@index([payment_id])
  @@map("payment_disputes")
}

/// 08 "Payment Providers" — a payout from a provider balance to the bank (event payout.paid). Reconciled against the
/// bank-side ledger record (09 LedgerSettlement) of the connection's ledger_payment_method_id.
model PaymentPayout {
  id                          String              @id @default(uuid())
  organization_id             String
  provider_connection_id      String
  provider_payout_id          String
  status                      PaymentPayoutStatus @default(PENDING)
  currency                    String
  /// Amount transferred to the bank.
  amount                      Decimal             @db.Decimal(18, 2)
  fee_amount                  Decimal             @default(0) @db.Decimal(18, 2)
  arrival_date                DateTime?           @db.Date
  paid_at                     DateTime?
  bank_reference              String?
  /// 09 — settlement / record this payout was matched to; null = not reconciled yet.
  reconciled_at               DateTime?
  reconciled_ledger_record_id String?
  metadata                    Json?
  created_at                  DateTime            @default(now())
  updated_at                  DateTime            @updatedAt

  organization        Organization              @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  provider_connection PaymentProviderConnection @relation(fields: [provider_connection_id], references: [id], onDelete: Cascade)

  @@unique([provider_connection_id, provider_payout_id])
  @@index([organization_id, status])
  @@index([arrival_date])
  @@map("payment_payouts")
}

/// 08 "Invoicing" / 09 "Audit Trail" — one approval policy for every money movement: invoices, refunds, credit notes,
/// write-offs (08) and ledger records, employee expense claims (09). The first matching enabled rule (by entity_type,
/// record_type, amount band, currency, branch; lowest priority first) requests its steps in order (FinanceApproval).
/// Mirrors ProposalApprovalRule / ContractApprovalRule. Replaces nothing: LedgerSettings.approval_threshold_amount stays
/// the simple default when no rule matches.
model FinanceApprovalRule {
  id                    String                    @id @default(uuid())
  organization_id       String
  name                  String
  entity_type           FinanceApprovalEntityType
  /// LEDGER_RECORD rules only: INCOME or EXPENSE; null = both.
  record_type           LedgerRecordType?
  /// Amount band (gross, in `currency`; null currency = organization reporting currency).
  min_amount            Decimal                   @default(0) @db.Decimal(18, 2)
  max_amount            Decimal?                  @db.Decimal(18, 2)
  currency              String?
  /// 01 §34 — limit to one branch / cost center; null = whole organization.
  branch_id             String?
  /// Ordered steps: [{ step, name, approver: { membership_id | role_id | team_id } }].
  steps                 Json
  /// The requester can never approve their own item (01 §96).
  require_distinct_user Boolean                   @default(true)
  priority              Int                       @default(100)
  enabled               Boolean                   @default(true)
  created_at            DateTime                  @default(now())
  updated_at            DateTime                  @updatedAt

  organization Organization      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  approvals    FinanceApproval[]

  @@index([organization_id, entity_type, enabled, priority])
  @@map("finance_approval_rules")
}

/// 08 "Invoicing" / 09 "Audit Trail" — an approval request and decision for one step on one item. `entity_id` is the
/// invoice, refund, credit note, ledger record or expense claim id (plain id: the target depends on entity_type);
/// WRITE_OFF points at the invoice being written off. The outcome is also stamped on the target
/// (Invoice.approved_by_user_id, LedgerRecord.approved_by_membership_id, ExpenseClaim.decided_by_membership_id).
model FinanceApproval {
  id                         String                    @id @default(uuid())
  organization_id            String
  entity_type                FinanceApprovalEntityType
  entity_id                  String
  /// Rule that requested this step; null = requested manually.
  rule_id                    String?
  step                       Int                       @default(1)
  /// Assigned approver, or any holder of approver_role_id when the step is role-based.
  approver_membership_id     String?
  approver_role_id           String?
  decision                   FinanceApprovalDecision   @default(PENDING)
  requested_by_membership_id String?
  decided_by_membership_id   String?
  /// Gross amount and currency at request time.
  amount                     Decimal?                  @db.Decimal(18, 2)
  currency                   String?
  comment                    String?
  rejection_reason           String?
  requested_at               DateTime                  @default(now())
  decided_at                 DateTime?

  organization Organization         @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  rule         FinanceApprovalRule? @relation(fields: [rule_id], references: [id], onDelete: SetNull)

  @@index([organization_id, entity_type, entity_id])
  @@index([approver_membership_id, decision])
  @@index([organization_id, decision])
  @@map("finance_approvals")
}

/// 08 "Financial Reporting" / 09 "Financial Dashboard" — a saved report definition with optional recurring e-mailed
/// export (monthly / quarterly report to the accountant). `report_key` names a report of 08 or 09; the run itself is
/// scheduled by 20 (scheduled_job_id) and delivered by 11; next_run_at / last_run_at only drive the settings screen.
model FinanceReportSchedule {
  id                       String              @id @default(uuid())
  organization_id          String
  name                     String
  /// e.g. revenue | invoices | tax | outstanding | cash_flow | profit_loss | vat | project_profitability.
  report_key               String
  filters                  Json?
  basis                    LedgerReportBasis?
  format                   FinanceReportFormat @default(PDF)
  frequency                BillingInterval     @default(MONTH)
  /// Day of the month / week the report is sent (frequency dependent).
  send_day                 Int?
  recipient_membership_ids String[]            @default([])
  recipient_emails         String[]            @default([])
  enabled                  Boolean             @default(true)
  /// 20 ScheduledJob that runs it; id only.
  scheduled_job_id         String?
  next_run_at              DateTime?
  last_run_at              DateTime?
  last_error               String?
  /// Last generated file (17); id only.
  last_document_id         String?
  created_by_membership_id String?
  created_at               DateTime            @default(now())
  updated_at               DateTime            @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id, enabled, next_run_at])
  @@map("finance_report_schedules")
}

// =====================================================================
// 09 Income & Expense Management — docs/features/09-income-expense-management.md (LOG-105)
// Owns: the agency ledger — income/expense records (LedgerRecord), settlements against them,
// ledger categories/subcategories, custom payment methods, supplier ledger profiles, supplier
// invoice intake (AI/OCR import jobs), recurring expenses, payroll schedules and entries, financial
// periods, stored period summaries (P&L / VAT / dashboard), project & customer profitability
// snapshots, AI insights and per-organization ledger settings.
// Does not own: customer invoices, payments, subscriptions, tax rates (08 — every 08 invoice/payment
// creates or updates an income record here), customers/vendors (02 CRM companies, type VENDOR = supplier),
// employees, departments and compensation terms (10), time entries and cost-rate snapshots (18),
// files (17 Documents, id only), recurrence/job scheduling (20), reminders (14), cost centers
// (01 §34 — Branch.cost_center_code; ledger records carry branch_id). Change history → audit_events.
// =====================================================================

/// 09 "Financial Records" — income or expense.
enum LedgerRecordType {
  INCOME
  EXPENSE
}

/// 09 "Financial Records", "Audit Trail" — record lifecycle. Records are never hard-deleted; VOIDED keeps
/// the audit history. PENDING_REVIEW is used for imported records awaiting verification and for manual
/// entries above the approval threshold (LedgerSettings). Voiding or cancelling an 08 invoice voids its
/// synced record (void_reason = INVOICE_VOIDED); an invoice revision (08 Invoice.revises_invoice_id) creates a
/// new record for the new invoice row and voids the old one (void_reason = INVOICE_REVISED).
enum LedgerRecordStatus {
  DRAFT
  PENDING_REVIEW
  POSTED
  VOIDED
}

/// 09 "Manual Financial Entries", "Income Management", "Automation" — how a record came into the ledger
/// (filter "Manual / Imported").
enum LedgerRecordSource {
  MANUAL
  INVOICE_SYNC
  PAYMENT_SYNC
  SUBSCRIPTION_SYNC
  SUPPLIER_INVOICE_IMPORT
  RECURRING_EXPENSE
  PAYROLL
  API
}

/// 09 "Payment & Settlement Tracking" — payment status of a ledger record.
enum LedgerPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

/// 09 "VAT Management" — VAT classification of a record (VAT-exempt, multiple/custom rates).
enum LedgerVatTreatment {
  STANDARD
  REDUCED
  ZERO_RATED
  EXEMPT
  REVERSE_CHARGE
  OUT_OF_SCOPE
}

/// 09 "Payment & Settlement Tracking" — kinds of settlement lines against a record.
enum LedgerSettlementKind {
  PAYMENT
  REFUND
  WRITE_OFF
  ADJUSTMENT
}

/// 09 "Attachments & Documentation"
enum LedgerAttachmentKind {
  INVOICE
  RECEIPT
  PAYMENT_CONFIRMATION
  CONTRACT
  EXPENSE_DOCUMENTATION
  OTHER
}

/// 09 "Financial Categories" — income vs expense category trees.
enum LedgerCategoryKind {
  INCOME
  EXPENSE
}

/// 09 "Profit & Loss" — P&L line a category rolls up into.
enum LedgerPlLine {
  REVENUE
  COST_OF_OPERATIONS
  EMPLOYEE_EXPENSES
  OFFICE_EXPENSES
  SOFTWARE_EXPENSES
  MARKETING_EXPENSES
  PROFESSIONAL_EXPENSES
  OTHER_OPERATING_EXPENSES
}

/// 09 "Invoice Upload & Automatic Processing" — lifecycle of an AI/OCR import job.
enum LedgerImportStatus {
  UPLOADED
  PROCESSING
  PENDING_REVIEW
  APPROVED
  REJECTED
  DUPLICATE
  FAILED
}

/// 09 "Recurring Expenses"
enum RecurringExpenseStatus {
  ACTIVE
  PAUSED
  ENDED
  CANCELLED
}

/// 09 "Employee Payments & Payroll Expenses" — kinds of employee-related expense.
enum PayrollEntryKind {
  SALARY
  MONTHLY_PAYMENT
  HOURLY_PAYMENT
  BONUS
  COMMISSION
  OVERTIME
  EMPLOYER_COST
  BENEFIT
  REIMBURSEMENT
  OTHER
}

/// 09 "Employee Payments & Payroll Expenses"
enum PayrollEntryStatus {
  DRAFT
  APPROVED
  POSTED
  CANCELLED
}

/// 09 "Financial Periods"
enum FinancialPeriodType {
  DAY
  WEEK
  MONTH
  QUARTER
  YEAR
  CUSTOM
}

/// 09 "Financial Periods" — closed periods reject new postings; locked periods also reject edits.
enum FinancialPeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

/// 09 "Financial Dashboard" — accrual-based vs actual cash view.
enum LedgerReportBasis {
  ACCRUAL
  CASH
}

/// 09 "Project Profitability" — subject of a profitability snapshot (05 §63, 02 §19).
enum LedgerProfitabilityScope {
  PROJECT
  CUSTOMER
}

/// 09 "AI Financial Assistant" — kinds of stored AI findings.
enum LedgerInsightKind {
  UNUSUAL_EXPENSE
  DUPLICATE_SUSPECTED
  MISSING_RECORD
  CATEGORY_SUGGESTION
  RECURRING_COST_DETECTED
  FORECAST
  MONTHLY_SUMMARY
  BUDGET_ALERT
  OTHER
}

enum LedgerInsightStatus {
  OPEN
  ACCEPTED
  DISMISSED
}

// --- Configuration ----------------------------------------------------------------

/// 09 "VAT Management", "Automation", "Audit Trail" — per-organization ledger settings: VAT defaults,
/// approval thresholds (separation of duties, 01), sync and AI toggles.
model LedgerSettings {
  organization_id                String      @id
  /// Reporting currency; falls back to Organization.default_currency (01 §14).
  reporting_currency             String?
  /// 09 "VAT Management" — default VAT rates (08 tax_rates) for new income / expense records.
  default_income_tax_rate_id     String?
  default_expense_tax_rate_id    String?
  default_pricing_mode           TaxBehavior @default(EXCLUSIVE)
  /// 09 "Financial Periods" — first month of the fiscal year (1–12).
  fiscal_year_start_month        Int         @default(1)
  /// 09 "Audit Trail" — manual records with gross amount above this need approval by a second member.
  approval_threshold_amount      Decimal?    @db.Decimal(18, 2)
  require_approval_for_imports   Boolean     @default(true)
  /// 09 "Automation" toggles.
  auto_sync_invoices             Boolean     @default(true)
  auto_sync_payments             Boolean     @default(true)
  auto_sync_subscriptions        Boolean     @default(true)
  auto_categorize_suppliers      Boolean     @default(true)
  duplicate_detection_enabled    Boolean     @default(true)
  /// Days before a due date to remind administrators (delivered by 14).
  upcoming_expense_reminder_days Int         @default(7)
  overdue_check_enabled          Boolean     @default(true)
  monthly_summary_enabled        Boolean     @default(true)
  /// 09 "AI Financial Assistant"
  ai_enabled                     Boolean     @default(true)
  ai_auto_categorize             Boolean     @default(true)
  updated_at                     DateTime    @updatedAt

  organization             Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  default_income_tax_rate  TaxRate?     @relation("LedgerSettingsDefaultIncomeTaxRate", fields: [default_income_tax_rate_id], references: [id], onDelete: SetNull)
  default_expense_tax_rate TaxRate?     @relation("LedgerSettingsDefaultExpenseTaxRate", fields: [default_expense_tax_rate_id], references: [id], onDelete: SetNull)

  @@map("ledger_settings")
}

/// 09 "Financial Categories" — income/expense categories and subcategories (parent_category_id), configurable
/// by administrators. `system_key` marks seeded defaults; `pl_line` maps the category onto the P&L overview.
model LedgerCategory {
  id                    String              @id @default(uuid())
  organization_id       String
  parent_category_id    String?
  kind                  LedgerCategoryKind
  name                  String
  slug                  String
  description           String?
  color                 String?
  icon                  String?
  /// Stable key for seeded categories (e.g. office.rent); null for custom ones.
  system_key            String?
  /// 09 "Profit & Loss" — P&L line this category rolls up into. Inherited from the parent when null.
  pl_line               LedgerPlLine?
  /// 09 "VAT Management" — default VAT rate (08 tax_rates) applied to new records in this category.
  default_tax_rate_id   String?
  default_vat_treatment LedgerVatTreatment?
  /// 09 "Financial Dashboard" — counts toward "operating expenses".
  is_operating          Boolean             @default(true)
  sort_order            Int                 @default(0)
  archived_at           DateTime?
  created_at            DateTime            @default(now())
  updated_at            DateTime            @updatedAt

  organization     Organization     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  parent           LedgerCategory?  @relation("LedgerCategoryHierarchy", fields: [parent_category_id], references: [id], onDelete: Restrict)
  children         LedgerCategory[] @relation("LedgerCategoryHierarchy")
  default_tax_rate TaxRate?         @relation(fields: [default_tax_rate_id], references: [id], onDelete: SetNull)

  records                 LedgerRecord[]          @relation("LedgerRecordCategory")
  subcategory_records     LedgerRecord[]          @relation("LedgerRecordSubcategory")
  recurring_expenses      RecurringExpense[]      @relation("RecurringExpenseCategory")
  recurring_subcategories RecurringExpense[]      @relation("RecurringExpenseSubcategory")
  supplier_defaults       LedgerSupplierProfile[]
  payroll_schedules       PayrollSchedule[]
  import_suggestions      LedgerInvoiceImport[]
  budget_lines            LedgerBudgetLine[]
  expense_claim_lines     ExpenseClaimLine[]

  @@unique([organization_id, slug])
  @@index([organization_id, kind])
  @@index([parent_category_id])
  @@map("ledger_categories")
}

/// 09 "Financial Categories" — custom payment methods (bank account X, cash, company card, Stripe, Viva Wallet …),
/// classified by the platform PaymentMethodType (08).
model LedgerPaymentMethod {
  id              String            @id @default(uuid())
  organization_id String
  name            String
  slug            String
  type            PaymentMethodType @default(BANK_TRANSFER)
  /// Masked account details / card label shown in lists.
  details         Json?
  /// 09 "Financial Dashboard" — bank accounts and cash boxes report a balance (cash position) when on.
  track_balance   Boolean           @default(false)
  currency        String?
  iban_last4      String?
  opening_balance Decimal?          @db.Decimal(18, 2)
  opening_date    DateTime?         @db.Date
  is_default      Boolean           @default(false)
  sort_order      Int               @default(0)
  archived_at     DateTime?
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  provider_connections PaymentProviderConnection[]
  records              LedgerRecord[]
  settlements          LedgerSettlement[]
  recurring_expenses   RecurringExpense[]
  payroll_schedules    PayrollSchedule[]
  payroll_entries      PayrollEntry[]
  balance_snapshots    LedgerBalanceSnapshot[]

  @@unique([organization_id, slug])
  @@map("ledger_payment_methods")
}

/// 09 "Expense Management", "Automation" (auto-categorizing known suppliers) — ledger defaults for a supplier.
/// Suppliers ARE CRM companies of type VENDOR (02 §2a); this profile only adds ledger behaviour, like
/// BillingProfile (08) does for customers.
model LedgerSupplierProfile {
  id                    String              @id @default(uuid())
  organization_id       String
  company_id            String              @unique
  default_category_id   String?
  default_tax_rate_id   String?
  default_vat_treatment LedgerVatTreatment?
  default_pricing_mode  TaxBehavior?
  /// Default payment terms in days (due date = invoice date + N).
  payment_terms_days    Int?
  /// Supplier names / VAT numbers / IBANs as they appear on uploaded invoices, used by OCR matching.
  matching_aliases      String[]            @default([])
  vat_number            String?
  /// Supplier's bank details for paying their invoices (IBAN masked in the UI).
  /// Encrypted at the application layer (envelope encryption with the organization VaultKey, 17 §12); never returned in list endpoints.
  bank_details          Json?
  notes                 String?
  created_at            DateTime            @default(now())
  updated_at            DateTime            @updatedAt

  organization     Organization    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  company          CrmCompany      @relation(fields: [company_id], references: [id], onDelete: Cascade)
  default_category LedgerCategory? @relation(fields: [default_category_id], references: [id], onDelete: SetNull)
  default_tax_rate TaxRate?        @relation(fields: [default_tax_rate_id], references: [id], onDelete: SetNull)

  @@index([organization_id])
  @@map("ledger_supplier_profiles")
}

// --- Ledger records -----------------------------------------------------------------

/// 09 "Income & Expense Management", "Financial Records", "Income Management", "Expense Management", "Search & Filtering" — the standardized income/expense record. Income records are created and kept in
/// sync by 08 invoices/payments/subscriptions (source INVOICE_SYNC / PAYMENT_SYNC / SUBSCRIPTION_SYNC); expenses
/// come from manual entry, supplier invoice imports, recurring expenses and payroll. Numbered via
/// NumberSequence (03) — e.g. INC-2026-0001 / EXP-2026-0001. Snapshot columns keep records historically
/// consistent when categories or suppliers change later (09 "Financial Periods").
model LedgerRecord {
  id                        String              @id @default(uuid())
  organization_id           String
  /// Cost center / branch context (01 §34).
  branch_id                 String?
  number                    String
  type                      LedgerRecordType
  status                    LedgerRecordStatus  @default(POSTED)
  source                    LedgerRecordSource  @default(MANUAL)
  /// 09 "Manual Financial Entries" — clearly identifies manually created records.
  is_manual                 Boolean             @default(true)
  category_id               String?
  subcategory_id            String?
  /// Snapshot "Category / Subcategory" at posting time.
  category_path_snapshot    String?
  description               String
  /// External reference: supplier invoice number, bank reference, receipt number …
  reference_number          String?
  transaction_date          DateTime            @db.Date
  due_date                  DateTime?           @db.Date
  /// Date fully paid (cash basis). Partial payments live in LedgerSettlement.
  payment_date              DateTime?           @db.Date
  /// Accounting period the record is posted to (set on posting; defaults to the period containing transaction_date).
  period_id                 String?
  // 09 "VAT Management" — amounts
  currency                  String
  /// FX rate to the reporting currency at transaction date; 1 when same currency.
  fx_rate                   Decimal?            @db.Decimal(18, 6)
  net_amount                Decimal             @default(0) @db.Decimal(18, 2)
  vat_percent               Decimal             @default(0) @db.Decimal(5, 2)
  vat_amount                Decimal             @default(0) @db.Decimal(18, 2)
  gross_amount              Decimal             @default(0) @db.Decimal(18, 2)
  /// Gross amount converted to the reporting currency.
  reporting_gross_amount    Decimal?            @db.Decimal(18, 2)
  /// 08 tax_rates reference the percentage was taken from; vat_percent is the snapshot.
  tax_rate_id               String?
  vat_treatment             LedgerVatTreatment  @default(STANDARD)
  /// VAT-inclusive vs VAT-exclusive entry (09 "VAT Management").
  pricing_mode              TaxBehavior         @default(EXCLUSIVE)
  /// True when an authorized user overrode the auto-calculated VAT/gross/net.
  amounts_overridden        Boolean             @default(false)
  // 09 "Payment & Settlement Tracking"
  payment_status            LedgerPaymentStatus @default(UNPAID)
  payment_method_id         String?
  amount_paid               Decimal             @default(0) @db.Decimal(18, 2)
  amount_remaining          Decimal             @default(0) @db.Decimal(18, 2)
  // 09 "Income Management" / "Expense Management" — counterparty and links
  /// Customer or supplier (CRM company, 02 §2a).
  company_id                String?
  /// Snapshot of the counterparty name at posting time.
  counterparty_name         String?
  project_id                String?
  milestone_id              String?
  /// 08 invoice that produced this income record: exactly one record per invoice row; a revised invoice is a
  /// new row and therefore a new record (the superseded record is VOIDED, see LedgerRecordStatus).
  invoice_id                String?             @unique
  /// 08 payment that produced this income record when it is not allocated to an invoice (one-off provider/bank/cash payment).
  origin_payment_id         String?             @unique
  subscription_id           String?
  contract_id               String?
  /// 10 Employee — related employee (employee expenses, payroll); id only.
  employee_id               String?
  /// Department = Team of kind DEPARTMENT (01 §43).
  department_id             String?
  recurring_expense_id      String?
  /// 1-based occurrence number within the recurring expense.
  recurrence_sequence       Int?
  /// 20 AutomationRule / ScheduledJob that generated the record; id only.
  automation_run_id         String?
  notes                     String?
  /// Line items (description, quantity, unit_price, net, vat, gross) copied from an import or entered manually.
  line_items                Json?
  /// 09 "AI Financial Assistant" — category suggestion, confidence, anomaly reasons.
  ai_suggestions            Json?
  flagged_unusual           Boolean             @default(false)
  metadata                  Json?
  // 09 "Audit Trail" — actors and lifecycle
  created_by_membership_id  String?
  approved_by_membership_id String?
  approved_at               DateTime?
  posted_at                 DateTime?
  voided_at                 DateTime?
  void_reason               String?
  /// Soft delete where deletion is permitted; audit history is preserved.
  deleted_at                DateTime?
  created_at                DateTime            @default(now())
  updated_at                DateTime            @updatedAt

  organization      Organization         @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  branch            Branch?              @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  category          LedgerCategory?      @relation("LedgerRecordCategory", fields: [category_id], references: [id], onDelete: SetNull)
  subcategory       LedgerCategory?      @relation("LedgerRecordSubcategory", fields: [subcategory_id], references: [id], onDelete: SetNull)
  period            FinancialPeriod?     @relation(fields: [period_id], references: [id], onDelete: SetNull)
  tax_rate          TaxRate?             @relation(fields: [tax_rate_id], references: [id], onDelete: SetNull)
  payment_method    LedgerPaymentMethod? @relation(fields: [payment_method_id], references: [id], onDelete: SetNull)
  company           CrmCompany?          @relation(fields: [company_id], references: [id], onDelete: SetNull)
  project           Project?             @relation(fields: [project_id], references: [id], onDelete: SetNull)
  milestone         ProjectMilestone?    @relation(fields: [milestone_id], references: [id], onDelete: SetNull)
  invoice           Invoice?             @relation(fields: [invoice_id], references: [id], onDelete: SetNull)
  origin_payment    Payment?             @relation("LedgerRecordOriginPayment", fields: [origin_payment_id], references: [id], onDelete: SetNull)
  subscription      Subscription?        @relation(fields: [subscription_id], references: [id], onDelete: SetNull)
  contract          Contract?            @relation(fields: [contract_id], references: [id], onDelete: SetNull)
  recurring_expense RecurringExpense?    @relation(fields: [recurring_expense_id], references: [id], onDelete: SetNull)
  created_by        Membership?          @relation("LedgerRecordCreator", fields: [created_by_membership_id], references: [id], onDelete: SetNull)
  approved_by       Membership?          @relation("LedgerRecordApprover", fields: [approved_by_membership_id], references: [id], onDelete: SetNull)

  settlements       LedgerSettlement[]
  attachments       LedgerAttachment[]
  import            LedgerInvoiceImport?  @relation("LedgerImportRecord")
  duplicate_imports LedgerInvoiceImport[] @relation("LedgerImportDuplicateRecord")
  payroll_entry     PayrollEntry?
  insights          LedgerInsight[]

  department Team? @relation("LedgerRecordDepartment", fields: [department_id], references: [id], onDelete: SetNull)

  @@unique([organization_id, number])
  @@index([organization_id, type, transaction_date])
  @@index([organization_id, status])
  @@index([organization_id, payment_status])
  @@index([organization_id, due_date])
  @@index([organization_id, payment_date])
  @@index([category_id])
  @@index([subcategory_id])
  @@index([company_id])
  @@index([project_id])
  @@index([period_id])
  @@index([employee_id])
  @@index([recurring_expense_id])
  @@index([branch_id])
  @@map("ledger_records")
}

/// 09 "Payment & Settlement Tracking" — one payment/refund/write-off against a record; multiple settlements
/// per record are allowed. For income synced from 08, settlements mirror PaymentAllocation / Refund.
model LedgerSettlement {
  id                        String               @id @default(uuid())
  record_id                 String
  kind                      LedgerSettlementKind @default(PAYMENT)
  /// Positive amount; REFUND/WRITE_OFF reduce amount_paid by kind.
  amount                    Decimal              @db.Decimal(18, 2)
  currency                  String
  settled_on                DateTime             @db.Date
  payment_method_id         String?
  /// Bank / provider reference ("Payment reference").
  reference                 String?
  /// 08 payment this settlement mirrors (allocation of a customer payment).
  payment_id                String?
  /// 08 refund this settlement mirrors.
  refund_id                 String?
  /// 17 Document — payment confirmation; id only.
  document_id               String?
  notes                     String?
  recorded_by_membership_id String?
  created_at                DateTime             @default(now())
  updated_at                DateTime             @updatedAt

  record         LedgerRecord         @relation(fields: [record_id], references: [id], onDelete: Cascade)
  payment_method LedgerPaymentMethod? @relation(fields: [payment_method_id], references: [id], onDelete: SetNull)
  payment        Payment?             @relation(fields: [payment_id], references: [id], onDelete: SetNull)
  refund         Refund?              @relation(fields: [refund_id], references: [id], onDelete: SetNull)
  recorded_by    Membership?          @relation("LedgerSettlementRecorder", fields: [recorded_by_membership_id], references: [id], onDelete: SetNull)

  @@index([record_id, settled_on])
  @@index([payment_id])
  @@index([refund_id])
  @@map("ledger_settlements")
}

/// 09 "Attachments & Documentation" — supporting documents of a record. Files are Documents (17); the
/// original uploaded supplier invoice is flagged is_original and kept for auditing.
model LedgerAttachment {
  id                     String               @id @default(uuid())
  record_id              String
  /// 17 Document; id only.
  document_id            String
  kind                   LedgerAttachmentKind @default(OTHER)
  /// The original uploaded document the record was created from (09 "Invoice Upload & Automatic Processing").
  is_original            Boolean              @default(false)
  title                  String?
  added_by_membership_id String?
  created_at             DateTime             @default(now())

  record LedgerRecord @relation(fields: [record_id], references: [id], onDelete: Cascade)

  @@unique([record_id, document_id])
  @@index([document_id])
  @@map("ledger_attachments")
}

// --- Supplier invoice intake (AI/OCR) ---------------------------------------------------

/// 09 "Invoice Upload & Automatic Processing" — an uploaded supplier invoice / receipt and its AI/OCR extraction.
/// Extracted values are editable during review; on approval a LedgerRecord is created and linked.
/// Duplicate detection uses file_hash plus supplier + invoice number + amount (09 "Automation").
model LedgerInvoiceImport {
  id                        String             @id @default(uuid())
  organization_id           String
  /// 17 Document — the uploaded file; id only.
  document_id               String
  file_name                 String?
  /// SHA-256 of the uploaded file for exact-duplicate detection.
  file_hash                 String?
  status                    LedgerImportStatus @default(UPLOADED)
  /// Expected record type; defaults to EXPENSE for supplier invoices, INCOME for external income documents.
  record_type               LedgerRecordType   @default(EXPENSE)
  uploaded_by_membership_id String?
  // Extraction results (09 "Invoice Upload & Automatic Processing" list)
  /// Full raw extraction payload from the AI/OCR provider.
  extraction_raw            Json?
  /// Extraction provider / model identifier.
  extraction_provider       String?
  /// Overall confidence 0–100.
  confidence                Decimal?           @db.Decimal(5, 2)
  /// Per-field confidences: { field: 0–100 }.
  field_confidence          Json?
  supplier_name             String?
  supplier_vat_number       String?
  customer_name             String?
  /// CRM company matched from supplier/customer data (02 §2a); confirmed in review.
  matched_company_id        String?
  suggested_category_id     String?
  invoice_number            String?
  invoice_date              DateTime?          @db.Date
  due_date                  DateTime?          @db.Date
  description               String?
  currency                  String?
  net_amount                Decimal?           @db.Decimal(18, 2)
  vat_percent               Decimal?           @db.Decimal(5, 2)
  vat_amount                Decimal?           @db.Decimal(18, 2)
  gross_amount              Decimal?           @db.Decimal(18, 2)
  /// Payment information printed on the document: { iban, bank, reference, terms, method }.
  payment_info              Json?
  // Review and outcome
  /// Record created on approval.
  ledger_record_id          String?            @unique
  duplicate_of_record_id    String?
  duplicate_of_import_id    String?
  reviewed_by_membership_id String?
  reviewed_at               DateTime?
  review_notes              String?
  error                     String?
  processing_started_at     DateTime?
  processed_at              DateTime?
  created_at                DateTime           @default(now())
  updated_at                DateTime           @updatedAt

  organization        Organization              @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  matched_company     CrmCompany?               @relation(fields: [matched_company_id], references: [id], onDelete: SetNull)
  suggested_category  LedgerCategory?           @relation(fields: [suggested_category_id], references: [id], onDelete: SetNull)
  ledger_record       LedgerRecord?             @relation("LedgerImportRecord", fields: [ledger_record_id], references: [id], onDelete: SetNull)
  duplicate_of_record LedgerRecord?             @relation("LedgerImportDuplicateRecord", fields: [duplicate_of_record_id], references: [id], onDelete: SetNull)
  duplicate_of_import LedgerInvoiceImport?      @relation("LedgerImportDuplicateImport", fields: [duplicate_of_import_id], references: [id], onDelete: SetNull)
  duplicates          LedgerInvoiceImport[]     @relation("LedgerImportDuplicateImport")
  uploaded_by         Membership?               @relation("LedgerImportUploader", fields: [uploaded_by_membership_id], references: [id], onDelete: SetNull)
  reviewed_by         Membership?               @relation("LedgerImportReviewer", fields: [reviewed_by_membership_id], references: [id], onDelete: SetNull)
  lines               LedgerInvoiceImportLine[]

  @@index([organization_id, status])
  @@index([organization_id, file_hash])
  @@index([organization_id, supplier_vat_number, invoice_number])
  @@index([matched_company_id])
  @@index([document_id])
  @@map("ledger_invoice_imports")
}

/// 09 "Invoice Upload & Automatic Processing" — extracted line items (quantities, unit prices), editable in review.
model LedgerInvoiceImportLine {
  id           String   @id @default(uuid())
  import_id    String
  description  String
  quantity     Decimal  @default(1) @db.Decimal(12, 3)
  unit_price   Decimal  @default(0) @db.Decimal(18, 2)
  net_amount   Decimal  @default(0) @db.Decimal(18, 2)
  vat_percent  Decimal? @db.Decimal(5, 2)
  vat_amount   Decimal  @default(0) @db.Decimal(18, 2)
  gross_amount Decimal  @default(0) @db.Decimal(18, 2)
  confidence   Decimal? @db.Decimal(5, 2)
  sort_order   Int      @default(0)

  import LedgerInvoiceImport @relation(fields: [import_id], references: [id], onDelete: Cascade)

  @@index([import_id, sort_order])
  @@map("ledger_invoice_import_lines")
}

// --- Recurring expenses -----------------------------------------------------------------

/// 09 "Recurring Expenses" — template that generates expense records on a schedule (run by 20). Generated
/// records stay individually editable; editing the template never rewrites past records.
model RecurringExpense {
  id                       String                 @id @default(uuid())
  organization_id          String
  branch_id                String?
  name                     String
  description              String?
  status                   RecurringExpenseStatus @default(ACTIVE)
  category_id              String?
  subcategory_id           String?
  /// Supplier (CRM company, 02 §2a).
  company_id               String?
  project_id               String?
  /// Department = Team of kind DEPARTMENT (01 §43).
  department_id            String?
  payment_method_id        String?
  currency                 String
  expected_net_amount      Decimal                @db.Decimal(18, 2)
  vat_percent              Decimal                @default(0) @db.Decimal(5, 2)
  expected_vat_amount      Decimal                @default(0) @db.Decimal(18, 2)
  expected_gross_amount    Decimal                @default(0) @db.Decimal(18, 2)
  tax_rate_id              String?
  vat_treatment            LedgerVatTreatment     @default(STANDARD)
  pricing_mode             TaxBehavior            @default(EXCLUSIVE)
  // Schedule
  /// MONTH / QUARTER / YEAR, or WEEK/DAY with interval_count for custom recurrence (08 BillingInterval).
  interval                 BillingInterval        @default(MONTH)
  interval_count           Int                    @default(1)
  /// iCalendar RRULE for custom recurrences that interval + interval_count cannot express.
  custom_rrule             String?
  start_date               DateTime               @db.Date
  end_date                 DateTime?              @db.Date
  /// Day of month the expense falls on (1–31, clamped), when interval is MONTH/QUARTER/YEAR.
  day_of_month             Int?
  /// Days after the occurrence date that the generated record is due.
  due_days                 Int?
  next_occurrence_date     DateTime?              @db.Date
  last_generated_at        DateTime?
  occurrences_generated    Int                    @default(0)
  /// Generate records automatically (true) or only remind (false).
  auto_generate            Boolean                @default(true)
  /// Days before the occurrence to send an upcoming-expense reminder (14); null = organization default.
  reminder_days_before     Int?
  /// 20 ScheduledJob registered for this template; id only.
  scheduled_job_id         String?
  notes                    String?
  created_by_membership_id String?
  paused_at                DateTime?
  ended_at                 DateTime?
  created_at               DateTime               @default(now())
  updated_at               DateTime               @updatedAt

  organization   Organization         @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  branch         Branch?              @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  category       LedgerCategory?      @relation("RecurringExpenseCategory", fields: [category_id], references: [id], onDelete: SetNull)
  subcategory    LedgerCategory?      @relation("RecurringExpenseSubcategory", fields: [subcategory_id], references: [id], onDelete: SetNull)
  company        CrmCompany?          @relation(fields: [company_id], references: [id], onDelete: SetNull)
  project        Project?             @relation(fields: [project_id], references: [id], onDelete: SetNull)
  payment_method LedgerPaymentMethod? @relation(fields: [payment_method_id], references: [id], onDelete: SetNull)
  tax_rate       TaxRate?             @relation(fields: [tax_rate_id], references: [id], onDelete: SetNull)
  records        LedgerRecord[]

  department Team? @relation("RecurringExpenseDepartment", fields: [department_id], references: [id], onDelete: SetNull)

  @@index([organization_id, status])
  @@index([organization_id, next_occurrence_date])
  @@index([company_id])
  @@index([category_id])
  @@map("recurring_expenses")
}

// --- Payroll & employee costs -----------------------------------------------------------

/// 09 "Employee Payments & Payroll Expenses" — recurring monthly employee payment template (base payment and
/// employer costs), so the same expense is not recreated by hand each month. Compensation terms themselves
/// are owned by 10 "Compensation" (01 §81); this stores the amounts to post, not the contract.
model PayrollSchedule {
  id                       String                 @id @default(uuid())
  organization_id          String
  /// 10 Employee; id only.
  employee_id              String
  /// Department = Team of kind DEPARTMENT (01 §43).
  department_id            String?
  kind                     PayrollEntryKind       @default(SALARY)
  category_id              String?
  payment_method_id        String?
  currency                 String
  /// Employee's base payment per occurrence.
  base_amount              Decimal                @db.Decimal(18, 2)
  /// Additional employer-related costs per occurrence (social contributions, insurance, benefits).
  employer_cost_amount     Decimal                @default(0) @db.Decimal(18, 2)
  interval                 BillingInterval        @default(MONTH)
  interval_count           Int                    @default(1)
  /// Day of month the payment is made.
  payment_day              Int?
  start_date               DateTime               @db.Date
  end_date                 DateTime?              @db.Date
  next_occurrence_date     DateTime?              @db.Date
  last_generated_at        DateTime?
  auto_generate            Boolean                @default(true)
  status                   RecurringExpenseStatus @default(ACTIVE)
  /// 20 ScheduledJob; id only.
  scheduled_job_id         String?
  notes                    String?
  created_by_membership_id String?
  created_at               DateTime               @default(now())
  updated_at               DateTime               @updatedAt

  organization   Organization         @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  category       LedgerCategory?      @relation(fields: [category_id], references: [id], onDelete: SetNull)
  payment_method LedgerPaymentMethod? @relation(fields: [payment_method_id], references: [id], onDelete: SetNull)
  entries        PayrollEntry[]

  department Team? @relation("PayrollScheduleDepartment", fields: [department_id], references: [id], onDelete: SetNull)

  @@index([organization_id, status])
  @@index([organization_id, employee_id])
  @@index([next_occurrence_date])
  @@map("payroll_schedules")
}

/// 09 "Employee Payments & Payroll Expenses" — one employee payment / employee cost for an accounting period.
/// Posting creates the linked expense LedgerRecord (source PAYROLL) so payroll is included in all reporting.
model PayrollEntry {
  id                        String             @id @default(uuid())
  organization_id           String
  /// 10 Employee; id only.
  employee_id               String
  /// Snapshot of the employee's display name at posting time.
  employee_name_snapshot    String?
  /// Department = Team of kind DEPARTMENT (01 §43).
  department_id             String?
  schedule_id               String?
  period_id                 String?
  /// Accounting period covered by the payment.
  period_start              DateTime           @db.Date
  period_end                DateTime           @db.Date
  kind                      PayrollEntryKind   @default(SALARY)
  status                    PayrollEntryStatus @default(DRAFT)
  currency                  String
  /// Employee's base payment (net of employer costs).
  base_amount               Decimal            @db.Decimal(18, 2)
  /// Employer-related costs on top of the base payment.
  employer_cost_amount      Decimal            @default(0) @db.Decimal(18, 2)
  total_amount              Decimal            @default(0) @db.Decimal(18, 2)
  /// Hourly payments: hours × rate = base_amount.
  hours                     Decimal?           @db.Decimal(8, 2)
  hourly_rate               Decimal?           @db.Decimal(18, 2)
  /// Breakdown of components: [{ kind, label, amount }].
  breakdown                 Json?
  description               String?
  payment_date              DateTime?          @db.Date
  payment_method_id         String?
  /// 17 Document — payslip / payment confirmation; id only.
  document_id               String?
  /// Expense record created on posting.
  ledger_record_id          String?            @unique
  notes                     String?
  created_by_membership_id  String?
  approved_by_membership_id String?
  approved_at               DateTime?
  posted_at                 DateTime?
  cancelled_at              DateTime?
  created_at                DateTime           @default(now())
  updated_at                DateTime           @updatedAt

  organization   Organization         @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  schedule       PayrollSchedule?     @relation(fields: [schedule_id], references: [id], onDelete: SetNull)
  period         FinancialPeriod?     @relation(fields: [period_id], references: [id], onDelete: SetNull)
  payment_method LedgerPaymentMethod? @relation(fields: [payment_method_id], references: [id], onDelete: SetNull)
  ledger_record  LedgerRecord?        @relation(fields: [ledger_record_id], references: [id], onDelete: SetNull)
  approved_by    Membership?          @relation("PayrollEntryApprover", fields: [approved_by_membership_id], references: [id], onDelete: SetNull)

  department    Team?         @relation("PayrollEntryDepartment", fields: [department_id], references: [id], onDelete: SetNull)
  expense_claim ExpenseClaim?

  @@unique([schedule_id, period_start])
  @@index([organization_id, employee_id, period_start])
  @@index([organization_id, status])
  @@index([period_id])
  @@map("payroll_entries")
}

// --- Periods, reports and profitability --------------------------------------------------

/// 09 "Financial Periods" — accounting periods (month/quarter/year/custom) that records and payroll entries post to.
/// Closing a period freezes its summaries; locking prevents edits of posted records.
model FinancialPeriod {
  id                      String                @id @default(uuid())
  organization_id         String
  type                    FinancialPeriodType
  name                    String
  fiscal_year             Int?
  start_date              DateTime              @db.Date
  end_date                DateTime              @db.Date
  status                  FinancialPeriodStatus @default(OPEN)
  closed_by_membership_id String?
  closed_at               DateTime?
  locked_at               DateTime?
  notes                   String?
  created_at              DateTime              @default(now())
  updated_at              DateTime              @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  closed_by    Membership?  @relation("FinancialPeriodCloser", fields: [closed_by_membership_id], references: [id], onDelete: SetNull)

  records                 LedgerRecord[]
  payroll_entries         PayrollEntry[]
  summaries               FinancialPeriodSummary[]
  profitability_snapshots LedgerProfitabilitySnapshot[]
  vat_returns             VatReturn[]

  @@unique([organization_id, type, start_date, end_date])
  @@index([organization_id, status])
  @@index([organization_id, start_date, end_date])
  @@map("financial_periods")
}

/// 09 "Financial Dashboard", "Profit & Loss", "VAT Management" (reporting), "Automation" (monthly financial
/// summaries) — stored totals for a period, per basis (accrual vs cash) and optional scope (branch, project,
/// customer). `scope_key` is "org", "branch:<id>", "project:<id>" or "company:<id>" to keep the unique key non-null.
/// One row per period x basis: ACCRUAL and CASH are both materialized when a period closes; for open periods the
/// row is recomputed on demand and refreshed.
model FinancialPeriodSummary {
  id                   String            @id @default(uuid())
  organization_id      String
  period_id            String
  basis                LedgerReportBasis @default(ACCRUAL)
  scope_key            String            @default("org")
  branch_id            String?
  project_id           String?
  company_id           String?
  currency             String
  // 09 "Financial Dashboard" totals
  total_income         Decimal           @default(0) @db.Decimal(18, 2)
  total_expenses       Decimal           @default(0) @db.Decimal(18, 2)
  net_profit           Decimal           @default(0) @db.Decimal(18, 2)
  gross_income         Decimal           @default(0) @db.Decimal(18, 2)
  outstanding_income   Decimal           @default(0) @db.Decimal(18, 2)
  paid_income          Decimal           @default(0) @db.Decimal(18, 2)
  outstanding_expenses Decimal           @default(0) @db.Decimal(18, 2)
  paid_expenses        Decimal           @default(0) @db.Decimal(18, 2)
  vat_collected        Decimal           @default(0) @db.Decimal(18, 2)
  vat_paid             Decimal           @default(0) @db.Decimal(18, 2)
  net_vat              Decimal           @default(0) @db.Decimal(18, 2)
  recurring_expenses   Decimal           @default(0) @db.Decimal(18, 2)
  payroll_expenses     Decimal           @default(0) @db.Decimal(18, 2)
  operating_expenses   Decimal           @default(0) @db.Decimal(18, 2)
  /// [{ category_id, name, amount }]
  income_by_category   Json?
  expenses_by_category Json?
  /// 09 "Profit & Loss" — { pl_line: amount } incl. REVENUE … OTHER_OPERATING_EXPENSES, total_expenses, net_operating_result.
  pl_lines             Json?
  /// 09 "VAT Management" — VAT by category and by counterparty: { by_category: [...], by_company: [...] }.
  vat_breakdown        Json?
  /// Cash-flow / trend series inside the period (daily or monthly buckets).
  trend                Json?
  /// 09 "AI Financial Assistant" — generated management summary for the period.
  ai_summary           String?
  generated_at         DateTime          @default(now())
  /// True once the period is closed; the summary is no longer recalculated.
  is_final             Boolean           @default(false)
  created_at           DateTime          @default(now())
  updated_at           DateTime          @updatedAt

  organization Organization    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  period       FinancialPeriod @relation(fields: [period_id], references: [id], onDelete: Cascade)
  branch       Branch?         @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  project      Project?        @relation(fields: [project_id], references: [id], onDelete: Cascade)
  company      CrmCompany?     @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([period_id, basis, scope_key])
  @@index([organization_id, period_id])
  @@index([project_id])
  @@index([company_id])
  @@map("financial_period_summaries")
}

/// 09 "Project Profitability" — stored profitability per project or customer and period. Employee cost comes
/// from approved time entries and cost-rate snapshots (18 §7). Consumed by 05 §63 and 02 §19; the calculation
/// is owned here. `subject_id` is the project or company id (unique key); the relation columns mirror it.
model LedgerProfitabilitySnapshot {
  id                  String                   @id @default(uuid())
  organization_id     String
  scope               LedgerProfitabilityScope
  subject_id          String
  project_id          String?
  company_id          String?
  period_id           String
  currency            String
  revenue             Decimal                  @default(0) @db.Decimal(18, 2)
  payments_received   Decimal                  @default(0) @db.Decimal(18, 2)
  outstanding_revenue Decimal                  @default(0) @db.Decimal(18, 2)
  direct_expenses     Decimal                  @default(0) @db.Decimal(18, 2)
  /// From 18 time entries × cost-rate snapshots.
  employee_costs      Decimal                  @default(0) @db.Decimal(18, 2)
  other_expenses      Decimal                  @default(0) @db.Decimal(18, 2)
  total_cost          Decimal                  @default(0) @db.Decimal(18, 2)
  gross_profit        Decimal                  @default(0) @db.Decimal(18, 2)
  margin_percent      Decimal?                 @db.Decimal(5, 2)
  /// Hours and cost per employee, expenses per category, etc.
  details             Json?
  calculated_at       DateTime                 @default(now())
  created_at          DateTime                 @default(now())
  updated_at          DateTime                 @updatedAt

  organization Organization    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  project      Project?        @relation(fields: [project_id], references: [id], onDelete: Cascade)
  company      CrmCompany?     @relation(fields: [company_id], references: [id], onDelete: Cascade)
  period       FinancialPeriod @relation(fields: [period_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, scope, subject_id, period_id])
  @@index([project_id])
  @@index([company_id])
  @@index([period_id])
  @@map("ledger_profitability_snapshots")
}

// --- AI insights ----------------------------------------------------------------------

/// 09 "AI Financial Assistant" — stored AI findings surfaced to administrators: unusual/unusually high expenses,
/// suspected duplicates, missing records, category suggestions, detected recurring costs, forecasts and
/// monthly summaries. Accepting a CATEGORY_SUGGESTION applies it to the record.
model LedgerInsight {
  id                        String              @id @default(uuid())
  organization_id           String
  kind                      LedgerInsightKind
  status                    LedgerInsightStatus @default(OPEN)
  /// 0–100
  confidence                Decimal?            @db.Decimal(5, 2)
  /// low | medium | high
  severity                  String?
  title                     String
  body                      String?
  record_id                 String?
  /// Structured payload: suggested category_id, compared records, forecast series, period ids …
  data                      Json?
  /// Period the insight refers to (forecasts, summaries); id only to keep the unique key simple.
  period_id                 String?
  resolved_by_membership_id String?
  resolved_at               DateTime?
  expires_at                DateTime?
  created_at                DateTime            @default(now())
  updated_at                DateTime            @updatedAt

  organization Organization  @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  record       LedgerRecord? @relation(fields: [record_id], references: [id], onDelete: Cascade)
  resolved_by  Membership?   @relation("LedgerInsightResolver", fields: [resolved_by_membership_id], references: [id], onDelete: SetNull)

  @@index([organization_id, status, kind])
  @@index([record_id])
  @@map("ledger_insights")
}

// --- Cash position, budgets, VAT returns and expense claims (09) --------------------------------

/// 09 "Financial Dashboard" — what a budget is planned against.
enum LedgerBudgetScope {
  CATEGORY
  PROJECT
  DEPARTMENT
}

enum LedgerBudgetStatus {
  DRAFT
  ACTIVE
  CLOSED
}

/// 09 "VAT Management" — filing state of a VAT return.
enum VatReturnStatus {
  DRAFT
  FILED
  PAID
}

/// 09 "Employee Payments & Payroll Expenses" — employee expense claim workflow.
enum ExpenseClaimStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

/// 09 "Financial Dashboard" — balance of a bank account / cash box (a LedgerPaymentMethod with track_balance) confirmed
/// at a date (bank statement, manual count). The live balance is opening_balance + settlements since opening_date.
model LedgerBalanceSnapshot {
  id                        String   @id @default(uuid())
  organization_id           String
  payment_method_id         String
  as_of                     DateTime @db.Date
  balance                   Decimal  @db.Decimal(18, 2)
  currency                  String
  /// manual | statement | provider
  source                    String   @default("manual")
  note                      String?
  recorded_by_membership_id String?
  created_at                DateTime @default(now())

  organization   Organization        @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  payment_method LedgerPaymentMethod @relation(fields: [payment_method_id], references: [id], onDelete: Cascade)

  @@unique([payment_method_id, as_of])
  @@index([organization_id, as_of])
  @@map("ledger_balance_snapshots")
}

/// 09 "Financial Dashboard" — a planned budget for a fiscal year, by category, project or department. Actuals are
/// computed from LedgerRecord on the chosen basis; crossing warn_percent raises a LedgerInsight (BUDGET_ALERT) and a
/// notification (14).
model LedgerBudget {
  id                  String             @id @default(uuid())
  organization_id     String
  name                String
  fiscal_year         Int
  scope               LedgerBudgetScope  @default(CATEGORY)
  basis               LedgerReportBasis  @default(ACCRUAL)
  currency            String
  owner_membership_id String?
  status              LedgerBudgetStatus @default(DRAFT)
  /// Percent of the planned amount at which the warning starts (default 80).
  warn_percent        Int                @default(80)
  notes               String?
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt

  organization Organization       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  lines        LedgerBudgetLine[]

  @@unique([organization_id, name, fiscal_year])
  @@index([organization_id, fiscal_year, status])
  @@map("ledger_budgets")
}

/// 09 "Financial Dashboard" — planned amount of one budget subject (category, project or department) for one month of
/// the fiscal year (1-12, counted from LedgerSettings.fiscal_year_start_month). `subject_key` is "category:<id>",
/// "project:<id>" or "department:<id>" to keep the unique key non-null; the relation columns mirror it.
model LedgerBudgetLine {
  id             String   @id @default(uuid())
  budget_id      String
  subject_key    String
  category_id    String?
  project_id     String?
  department_id  String?
  month          Int
  planned_amount Decimal  @db.Decimal(18, 2)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  budget     LedgerBudget    @relation(fields: [budget_id], references: [id], onDelete: Cascade)
  category   LedgerCategory? @relation(fields: [category_id], references: [id], onDelete: Cascade)
  project    Project?        @relation(fields: [project_id], references: [id], onDelete: Cascade)
  department Team?           @relation("LedgerBudgetLineDepartment", fields: [department_id], references: [id], onDelete: Cascade)

  @@unique([budget_id, subject_key, month])
  @@index([category_id])
  @@index([project_id])
  @@index([department_id])
  @@map("ledger_budget_lines")
}

/// 09 "VAT Management" — the VAT return of one period and basis: totals frozen when filed, the filing reference and
/// proof. Totals come from FinancialPeriodSummary; filing needs a CLOSED period.
model VatReturn {
  id                     String            @id @default(uuid())
  organization_id        String
  period_id              String
  basis                  LedgerReportBasis @default(ACCRUAL)
  currency               String
  vat_collected          Decimal           @default(0) @db.Decimal(18, 2)
  vat_paid               Decimal           @default(0) @db.Decimal(18, 2)
  net_vat                Decimal           @default(0) @db.Decimal(18, 2)
  status                 VatReturnStatus   @default(DRAFT)
  filed_at               DateTime?
  filed_by_membership_id String?
  /// Reference given by the tax authority on submission.
  authority_reference    String?
  paid_at                DateTime?
  /// 17 Document — filed return / proof of submission; id only.
  document_id            String?
  notes                  String?
  created_at             DateTime          @default(now())
  updated_at             DateTime          @updatedAt

  organization Organization    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  period       FinancialPeriod @relation(fields: [period_id], references: [id], onDelete: Restrict)

  @@unique([period_id, basis])
  @@index([organization_id, status])
  @@map("vat_returns")
}

/// 09 "Employee Payments & Payroll Expenses" — an employee's expense claim: receipts submitted for reimbursement,
/// approved by a manager (FinanceApproval, entity_type EXPENSE_CLAIM), then paid through a REIMBURSEMENT PayrollEntry.
/// Numbered via NumberSequence (entity_type expense_claim). Self-service from the employee side (10).
model ExpenseClaim {
  id                       String             @id @default(uuid())
  organization_id          String
  number                   String
  /// 10 Employee; id only.
  employee_id              String
  employee_name_snapshot   String?
  title                    String
  status                   ExpenseClaimStatus @default(DRAFT)
  currency                 String
  total_amount             Decimal            @default(0) @db.Decimal(18, 2)
  vat_total                Decimal            @default(0) @db.Decimal(18, 2)
  submitted_at             DateTime?
  approver_membership_id   String?
  decided_by_membership_id String?
  decided_at               DateTime?
  rejection_reason         String?
  paid_at                  DateTime?
  /// REIMBURSEMENT entry created on approval.
  payroll_entry_id         String?            @unique
  notes                    String?
  created_at               DateTime           @default(now())
  updated_at               DateTime           @updatedAt

  organization  Organization       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  payroll_entry PayrollEntry?      @relation(fields: [payroll_entry_id], references: [id], onDelete: SetNull)
  lines         ExpenseClaimLine[]

  @@unique([organization_id, number])
  @@index([organization_id, employee_id, status])
  @@index([organization_id, status])
  @@map("expense_claims")
}

/// 09 "Employee Payments & Payroll Expenses" — one receipt line of an expense claim.
model ExpenseClaimLine {
  id           String   @id @default(uuid())
  claim_id     String
  expense_date DateTime @db.Date
  category_id  String?
  project_id   String?
  description  String
  merchant     String?
  gross_amount Decimal  @db.Decimal(18, 2)
  vat_amount   Decimal  @default(0) @db.Decimal(18, 2)
  /// 17 Document — receipt; id only.
  document_id  String?
  sort_order   Int      @default(0)
  created_at   DateTime @default(now())

  claim    ExpenseClaim    @relation(fields: [claim_id], references: [id], onDelete: Cascade)
  category LedgerCategory? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  project  Project?        @relation(fields: [project_id], references: [id], onDelete: SetNull)

  @@index([claim_id])
  @@index([category_id])
  @@index([project_id])
  @@map("expense_claim_lines")
}

