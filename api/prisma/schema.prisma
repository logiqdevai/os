// =====================================================================
// Identity — 01 §4–7, §72, §74, §127
// =====================================================================

/// 01 §4 — a global human identity. Never tenant-scoped.
model User {
  id                      String     @id @default(uuid())
  email                   String     @unique
  phone                   String?    @unique
  password                String
  /// Platform-level role (01 §64). Organization permissions are modelled through Membership, not here.
  role                    AuthRole   @default(USER)
  status                  UserStatus @default(ACTIVE)
  first_name              String?
  last_name               String?
  display_name            String?
  profile_photo_url       String?
  locale                  String?
  timezone                String?
  language                String?
  email_verified_at       DateTime?
  phone_verified_at       DateTime?
  mfa_enabled             Boolean    @default(false)
  /// Last time the password was set or changed; with password_max_age_days (OrganizationSecurityPolicy) it drives forced rotation.
  password_changed_at     DateTime?
  last_login_at           DateTime?
  /// 01 §127 — not permissions.
  default_organization_id String?
  deactivated_at          DateTime?
  created_at              DateTime   @default(now())
  updated_at              DateTime   @updatedAt

  password_reset_tokens          PasswordResetToken[]
  auth_methods                   UserAuthMethod[]
  sessions                       UserSession[]
  preferences                    UserPreference?
  memberships                    Membership[]
  customer_memberships           CustomerPortalMembership[]
  invitations_sent               Invitation[]                         @relation("InvitationInviter")
  audit_events                   AuditEvent[]                         @relation("AuditActorUser")
  portal_profile_change_requests CustomerPortalProfileChangeRequest[] @relation("PortalProfileChangeRequester")
  external_channel_memberships   ChannelMember[]                      @relation("ChannelExternalMember")
  external_messages              Message[]                            @relation("MessageExternalAuthor")
  support_conversations          SupportConversation[]                @relation("SupportConversationCustomer")
  support_messages               SupportMessage[]                     @relation("SupportMessageAuthorUser")
  requested_tickets              Ticket[]                             @relation("TicketRequesterUser")
  support_csat_ratings           SupportCsatRating[]                  @relation("SupportCsatRatedBy")
  knowledge_article_feedback     KnowledgeArticleFeedback[]           @relation("KnowledgeArticleFeedbackUser")
  notifications                  Notification[]                       @relation("NotificationRecipientUser")
  push_devices                   NotificationPushDevice[]
  portal_document_shares         DocumentShare[]                      @relation("DocumentSharePortalUser")
  portal_document_approvals      DocumentApprover[]                   @relation("DocumentApproverPortalUser")
  portal_vault_grants            VaultEntryGrant[]                    @relation("VaultGrantPortalUser")
  vault_access_logs              VaultAccessLog[]                     @relation("VaultAccessActorUser")
  calendar_event_attendances     CalendarEventAttendee[]
  calendar_bookings              CalendarBooking[]
  platform_events                PlatformEvent[]                      @relation("PlatformEventActor")
  known_devices                  UserDevice[]

  @@index([email])
  @@index([phone])
  @@index([status])
  @@map("users")
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  token_hash String    @unique
  user_uuid  String
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_uuid], references: [id], onDelete: Cascade)

  @@index([user_uuid])
  @@index([expires_at])
  @@map("password_reset_tokens")
}

/// 01 §6, §74 — configured authentication factors per user (passkeys, OAuth links, MFA).
model UserAuthMethod {
  id           String         @id @default(uuid())
  user_id      String
  type         AuthMethodType
  /// Provider or credential identifier: OAuth subject, passkey credential id, phone number, etc.
  identifier   String?
  /// Hashed secret where applicable (TOTP seed, recovery codes). Never plain text.
  secret_hash  String?
  label        String?
  /// Provider-specific data (OAuth provider name, passkey public key, transports, …).
  metadata     Json?
  verified_at  DateTime?
  last_used_at DateTime?
  disabled_at  DateTime?
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, type, identifier])
  @@index([user_id])
  @@map("user_auth_methods")
}

/// 01 §72 — active sessions, revocable by the user or by security policy.
model UserSession {
  id                     String    @id @default(uuid())
  user_id                String
  /// Organization active in this session (01 §26). Null before the user picks one.
  active_organization_id String?
  /// 01 §27 — selected branch context; null means entire organization.
  active_branch_id       String?
  /// 01 §27 — several selected branches (multiple selected branches). Empty and active_branch_id null = entire organization.
  active_branch_ids      String[]  @default([])
  token_hash             String    @unique
  device                 String?
  browser                String?
  ip_address             String?
  location_approx        String?
  user_agent             String?
  last_activity_at       DateTime  @default(now())
  expires_at             DateTime
  revoked_at             DateTime?
  revoked_reason         String?
  created_at             DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("user_sessions")
}

/// 01 §72, §74 — browsers and devices a User has signed in from, for "trusted device" (skip MFA) and known-device alerts.
/// User-level like UserSession (a device is not tenant-specific); only a hash of the fingerprint is stored.
model UserDevice {
  id               String    @id @default(uuid())
  user_id          String
  fingerprint_hash String
  label            String?
  platform         String?
  browser          String?
  last_ip          String?
  first_seen_at    DateTime  @default(now())
  last_seen_at     DateTime  @default(now())
  /// Set when the user marked the device as trusted (MFA may be skipped while the policy allows it).
  trusted_at       DateTime?
  revoked_at       DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, fingerprint_hash])
  @@index([user_id, revoked_at])
  @@map("user_devices")
}

/// 01 §127 — user-specific preferences. These are not permissions.
model UserPreference {
  user_id                 String   @id
  theme                   String?
  default_organization_id String?
  default_branch_id       String?
  default_team_id         String?
  dashboard_layout        Json?
  updated_at              DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

