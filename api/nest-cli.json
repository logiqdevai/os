{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": "swc",
    "typeCheck": false,
    "deleteOutDir": true,
    "watchAssets": false,
    "assets": [
      {
        "include": "integrations/notifications/templates/**/*",
        "outDir": "dist"
      },
      {
        "include": "generated/**/*",
        "outDir": "dist"
      }
    ]
  }
}
